{
  // N3 note (2026-10-31): src/lib/family-sync.ts exports a
  // FamilyRoomDurableObject and /api/account/sync forwards to an
  // env.FAMILY_ROOM_DO binding when it exists — but NO durable_objects
  // binding is declared here, so the D1 polling scaffolding is what
  // actually runs. If the binding is ever added, keep the DO scoped
  // by idFromName(userId) (it already is, in the sync route) and keep
  // the session check in the route before the stub call.
  "name": "bigbrainshelf",
  "compatibility_date": "2026-10-16",
  "compatibility_flags": ["nodejs_als"],
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "e1da6223-d7ab-496f-97e8-4c97111e8b8d",
      "database_name": "kidsbook-hub"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BOOKS",
      "bucket_name": "kidsbook-factory"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "triggers": {
    "crons": ["*/15 * * * *"]
  }
}
