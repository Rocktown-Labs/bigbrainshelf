---
// SiteHeader: the one public header for the whole storefront.
//
// House rules (CG, 2026-10-28): the header carries the logo and actions
// only. No page titles in the header, ever (a page names itself in its
// own hero, not in the chrome). About lives in the footer, not here.
// Cart is an icon button; Sign in / My library / Admin are real buttons.
//
// Props:
//   search    — the storefront search field, on every public page
//               (the reader view is the one exception; it never passes
//               this). It sits inline on sm+ and drops to its own
//               full-width row below the action row on phones, so the
//               action row itself is a single nowrap row that cannot
//               wrap or hit the logo. The widget behavior ships with
//               this component (see the script at the bottom), so any
//               page that renders the field gets the full dropdown.
//   cartMode  — "sheet" on pages that carry the slide-over cart markup
//               (the button keeps the js-cart-open class and the
//               #cart-count badge those page scripts drive); "link"
//               navigates to /cart like the old text link did.
//   authAction — login/signup cross-link rendered as a button instead
//               of the store actions (auth pages carry no cart).
interface Props {
  search?: boolean;
  cartMode?: "sheet" | "link";
  authAction?: { href: string; label: string };
}
import CartStore from "./CartStore.astro";
const { search = false, cartMode = "link", authAction } = Astro.props;
const adminUser = Astro.locals.user;

const btnBase =
  "inline-flex items-center justify-center min-h-11 px-4 rounded-full text-sm font-semibold whitespace-nowrap select-none transition duration-100 active:scale-[0.97]";
const btnPrimary = "bg-orange-600 text-white hover:bg-orange-700";
const btnOutline = "border border-orange-600/60 text-orange-700 hover:bg-orange-50";
---

<header
  class="sticky top-0 z-50 bg-white/95 backdrop-blur border-b border-stone-200 [padding-left:env(safe-area-inset-left)] [padding-right:env(safe-area-inset-right)]"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-wrap sm:flex-nowrap items-center gap-x-2 gap-y-2 sm:gap-3 py-2.5 sm:py-0 sm:h-16">
    <a
      href="/"
      aria-label="Big Brain Shelf home"
      class="shrink-0 inline-flex items-center rounded-full bg-[#1a3454] px-3.5 py-2 sm:px-4 sm:py-1.5 text-base sm:text-lg font-extrabold leading-none tracking-tight text-white"
    >big<span class="text-orange-400">brain</span>shelf</a>

    {search && (
      <div class="order-3 w-full sm:order-none sm:w-auto sm:flex-1 sm:px-2">
        <div id="site-search" class="relative w-full max-w-md sm:mx-auto">
          <input
            id="q"
            type="search"
            role="combobox"
            aria-expanded="false"
            aria-controls="search-results"
            aria-autocomplete="list"
            placeholder="Search books, cast, audiobooks..."
            autocomplete="off"
            autocapitalize="off"
            spellcheck="false"
            enterkeyhint="search"
            aria-label="Search books, cast and audiobooks"
            class="w-full block bg-stone-100 border border-transparent rounded-full px-5 py-2.5 sm:py-2 text-sm outline-none focus:bg-white focus:border-orange-600 focus:ring-2 focus:ring-orange-600/20 transition"
          />
          <div
            id="search-dropdown"
            class="hidden absolute left-0 right-0 top-full mt-2 z-30 overflow-hidden rounded-2xl border border-stone-200 bg-white shadow-[0_24px_50px_-12px_rgba(0,0,0,0.35)]"
          >
            <div
              id="search-results"
              role="listbox"
              aria-label="Search results"
              class="max-h-[min(78dvh,30rem)] overflow-y-auto overscroll-contain py-1"
            ></div>
            <p id="search-status" role="status" class="sr-only"></p>
          </div>
        </div>
      </div>
    )}

    <nav class="ml-auto flex items-center gap-1.5 sm:gap-2 shrink-0" aria-label="Store">
      {authAction ? (
        <a href={authAction.href} class={`${btnBase} ${btnPrimary}`}>{authAction.label}</a>
      ) : (
        <>
          <a
            href="/cart"
            class={`${cartMode === "sheet" ? "js-cart-open " : ""}relative inline-flex items-center justify-center w-11 h-11 shrink-0 rounded-full text-stone-600 hover:bg-stone-100 hover:text-stone-900 select-none transition duration-100 active:scale-[0.97]`}
            aria-label="Cart"
          >
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
            {cartMode === "sheet" && (
              <span id="cart-count" class="hidden absolute top-0.5 right-0.5 bg-orange-600 text-white text-[10px] font-bold rounded-full min-w-4 h-4 px-0.5 items-center justify-center"></span>
            )}
          </a>
          {!adminUser && (
            <a id="account-link" href="/login" class={`${btnBase} ${btnPrimary}`}>Sign in</a>
          )}
          <div
            id="user-account-menu-wrap"
            class={`${adminUser ? "relative inline-block" : "hidden relative"}`}
            data-ssr-admin={adminUser ? "1" : "0"}
            data-ssr-email={adminUser?.email || ""}
          >
            <button
              type="button"
              id="user-account-menu-btn"
              aria-haspopup="menu"
              aria-expanded="false"
              aria-controls="user-account-menu-dropdown"
              class="inline-flex items-center gap-2 min-h-11 pl-2 pr-3.5 rounded-full border border-stone-300 bg-white text-sm font-bold text-stone-800 hover:border-stone-500 hover:bg-stone-50 select-none transition duration-100 active:scale-[0.97]"
            >
              <span
                id="user-account-avatar"
                class="w-7 h-7 rounded-full bg-[#1a3454] text-white text-xs font-extrabold inline-flex items-center justify-center uppercase shrink-0"
              >
                {adminUser?.email ? String(adminUser.email)[0].toUpperCase() : "U"}
              </span>
              <span id="user-account-menu-label" class="max-w-[9rem] truncate">
                {adminUser?.email ? String(adminUser.email).split("@")[0] : "Account"}
              </span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="text-stone-400 shrink-0"><path d="m6 9 6 6 6-6"/></svg>
            </button>

            <div
              id="user-account-menu-dropdown"
              role="menu"
              aria-label="User account menu"
              class="hidden absolute right-0 top-full mt-2 w-64 z-50 rounded-2xl border border-stone-200 bg-white p-2 shadow-[0_20px_45px_-12px_rgba(0,0,0,0.28)]"
            >
              <div class="px-3 py-2.5 border-b border-stone-100">
                <div class="flex items-center justify-between gap-2">
                  <p id="user-menu-display-name" class="text-xs font-extrabold text-stone-900 truncate">
                    {adminUser?.email ? String(adminUser.email).split("@")[0] : "Reader"}
                  </p>
                  <span
                    id="user-menu-role-badge"
                    class={`rounded-full px-2 py-0.5 text-[10px] font-extrabold uppercase tracking-wider ${
                      adminUser ? "bg-[#1a3454] text-white" : "bg-orange-100 text-orange-800"
                    }`}
                  >
                    {adminUser ? "Admin" : "Reader"}
                  </span>
                </div>
                <p id="user-menu-email" class="text-[11px] text-stone-500 truncate mt-0.5">
                  {adminUser?.email || ""}
                </p>
              </div>

              <div class="py-1 space-y-0.5">
                <a
                  href="/account"
                  data-astro-reload
                  role="menuitem"
                  class="flex items-center justify-between gap-2 rounded-xl px-3 py-2 text-xs font-bold text-stone-800 hover:bg-orange-50 hover:text-orange-900"
                >
                  <span>My Shelf &amp; Library</span>
                  <span class="rounded-full bg-stone-100 px-2 py-0.5 text-[10px] font-bold text-stone-600">/account</span>
                </a>
                <a
                  href="/account/club"
                  data-astro-reload
                  role="menuitem"
                  class="flex items-center justify-between gap-2 rounded-xl px-3 py-2 text-xs font-semibold text-stone-700 hover:bg-stone-100"
                >
                  <span>Book &amp; Audio Club</span>
                  <span class="text-[10px] font-bold text-orange-700">Clubs</span>
                </a>
                <a
                  href="/account/kids"
                  data-astro-reload
                  role="menuitem"
                  class="flex items-center justify-between gap-2 rounded-xl px-3 py-2 text-xs font-semibold text-stone-700 hover:bg-stone-100"
                >
                  <span>Kids &amp; Family Profiles</span>
                </a>
                <a
                  href="/account/orders"
                  data-astro-reload
                  role="menuitem"
                  class="flex items-center justify-between gap-2 rounded-xl px-3 py-2 text-xs font-semibold text-stone-700 hover:bg-stone-100"
                >
                  <span>Orders &amp; Receipts</span>
                </a>
                <a
                  id="user-menu-admin-link"
                  href="/admin"
                  data-astro-reload
                  role="menuitem"
                  class={`${adminUser ? "flex" : "hidden"} items-center justify-between gap-2 rounded-xl px-3 py-2 text-xs font-extrabold text-[#1a3454] bg-stone-50 hover:bg-stone-100`}
                >
                  <span>Admin Dashboard</span>
                  <span class="rounded-full bg-[#1a3454] text-white px-2 py-0.5 text-[10px] font-bold">/admin</span>
                </a>
              </div>

              <div class="pt-1 mt-1 border-t border-stone-100">
                <button
                  type="button"
                  id="user-menu-signout-btn"
                  role="menuitem"
                  class="w-full text-left flex items-center justify-between rounded-xl px-3 py-2 text-xs font-semibold text-red-600 hover:bg-red-50"
                >
                  <span>Sign out</span>
                </button>
              </div>
            </div>
          </div>
        </>
      )}
    </nav>
  </div>
</header>

<!-- The shared cart store ships with the header so window.bbsCart
     exists before any page script runs, on every public page. It
     renders only a script; the header markup above is unchanged. -->
<CartStore />

<script is:inline>
  // User Account Button Menu wiring (works for both Customer Better Auth
  // sessions and Admin sessions on every storefront page).
  (function () {
    function initUserAccountMenu() {
      var wrap = document.getElementById("user-account-menu-wrap");
      var btn = document.getElementById("user-account-menu-btn");
      var drop = document.getElementById("user-account-menu-dropdown");
      var signoutBtn = document.getElementById("user-menu-signout-btn");
      var accountLink = document.getElementById("account-link");
      if (!wrap || !btn || !drop) return;

      if (!btn.__menuBound) {
        btn.__menuBound = true;
        btn.addEventListener("click", function (ev) {
          ev.stopPropagation();
          var isHidden = drop.classList.contains("hidden");
          drop.classList.toggle("hidden", !isHidden);
          btn.setAttribute("aria-expanded", isHidden ? "true" : "false");
        });
      }

      if (signoutBtn && !signoutBtn.__bound) {
        signoutBtn.__bound = true;
        signoutBtn.addEventListener("click", async function () {
          await fetch("/api/auth/sign-out", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: "{}",
          }).catch(function () {});
          await fetch("/api/admin-auth/logout", { method: "POST" }).catch(function () {});
          window.location.href = "/";
        });
      }

      function applyUserToMenu(u) {
        if (!u || !u.email) return;
        wrap.classList.remove("hidden");
        wrap.classList.add("inline-block");
        if (accountLink) {
          accountLink.textContent = "My library";
          accountLink.href = "/account";
          accountLink.classList.add("hidden");
        }
        var handle = u.displayUsername
          ? "@" + u.displayUsername
          : u.username
            ? "@" + u.username
            : u.name || String(u.email).split("@")[0];
        var labelEl = document.getElementById("user-account-menu-label");
        var avatarEl = document.getElementById("user-account-avatar");
        var nameEl = document.getElementById("user-menu-display-name");
        var emailEl = document.getElementById("user-menu-email");
        var roleEl = document.getElementById("user-menu-role-badge");
        var adminLink = document.getElementById("user-menu-admin-link");

        if (labelEl) labelEl.textContent = handle;
        if (avatarEl) {
          var ch = (u.displayUsername || u.username || u.name || u.email || "U")
            .replace(/^@+/, "")
            .charAt(0)
            .toUpperCase();
          avatarEl.textContent = ch || "U";
        }
        if (nameEl) nameEl.textContent = handle;
        if (emailEl) emailEl.textContent = u.email || "";
        if (roleEl) {
          roleEl.textContent = u.isAdmin || u.role === "admin" ? "Admin" : "Family";
          roleEl.className =
            "rounded-full px-2 py-0.5 text-[10px] font-extrabold uppercase tracking-wider " +
            (u.isAdmin || u.role === "admin"
              ? "bg-[#1a3454] text-white"
              : "bg-orange-100 text-orange-800");
        }
        if (adminLink) {
          if (u.isAdmin || u.role === "admin") {
            adminLink.classList.remove("hidden");
            adminLink.classList.add("flex");
          } else {
            adminLink.classList.add("hidden");
            adminLink.classList.remove("flex");
          }
        }
      }

      fetch("/api/account/me")
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (d) {
          if (d && d.user) applyUserToMenu(d.user);
        })
        .catch(function () {});
    }

    if (!window.__bbsUserMenuDoc) {
      window.__bbsUserMenuDoc = true;
      document.addEventListener("pointerdown", function (e) {
        var wrap = document.getElementById("user-account-menu-wrap");
        var drop = document.getElementById("user-account-menu-dropdown");
        var btn = document.getElementById("user-account-menu-btn");
        if (wrap && drop && !wrap.contains(e.target)) {
          drop.classList.add("hidden");
          if (btn) btn.setAttribute("aria-expanded", "false");
        }
      });
    }
    initUserAccountMenu();
    document.addEventListener("astro:page-load", initUserAccountMenu);
  })();
</script>

{search && (
<script is:inline>
  // Sectioned search widget: the behavior half of the header search
  // field. A combobox over GET /api/search (debounced ~200ms, in-flight
  // requests aborted on new keystrokes, sequence counter so a stale
  // response can never overwrite a newer one). Results arrive
  // pre-grouped (Books, Cast, Audio, Video) and EVERY section renders
  // as a horizontal snap-scroll row of compact cards, so the panel
  // stays short: its height is capped and it scrolls internally only
  // as a backstop.
  //
  // Enter behavior: a highlighted option always opens. With nothing
  // highlighted, the home page owns Enter (it filters the shelf grid
  // in place) through the window.__bbsHomeSearch hook, which returns
  // true when it handled the key; anywhere else, Enter opens the top
  // result when the dropdown is showing one, and otherwise just
  // closes the dropdown. Least surprise on both surfaces: home keeps
  // its filter, everywhere else Enter means "take me to the best
  // match". Clearing the input likewise delegates to the home hook
  // (restores the full shelf) and simply closes elsewhere.
  (function () {
    function esc(s) {
      return String(s == null ? "" : s).replace(/[&<>"']/g, function (c) {
        return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
      });
    }
    var SECTION_LABELS = { books: "Books", cast: "Cast", audio: "Audio", video: "Video" };

    function initSearch() {
      var box = document.getElementById("site-search");
      if (!box || box.__bbsBound) return;
      var input = document.getElementById("q");
      var drop = document.getElementById("search-dropdown");
      var results = document.getElementById("search-results");
      var status = document.getElementById("search-status");
      if (!input || !drop || !results || !status) return;
      box.__bbsBound = true;

      var flatOptions = [];
      var activeIdx = -1;
      var seq = 0;
      var timer = null;
      var ctrl = null;
      var lastTrackedQuery = "";

      function homeHook() {
        var h = window.__bbsHomeSearch;
        // The hook only counts while the home shelf grid is on the
        // page; after a view-transition away from home the window
        // outlives the grid, and the stale hook must not claim keys.
        if (h && document.getElementById("grid")) return h;
        return null;
      }
      function setActive(i) {
        activeIdx = i;
        flatOptions.forEach(function (opt, j) {
          var el = document.getElementById(opt.id);
          if (!el) return;
          var on = j === i;
          el.setAttribute("aria-selected", on ? "true" : "false");
          el.classList.toggle("bg-orange-50", on);
          el.classList.toggle("ring-2", on);
          el.classList.toggle("ring-inset", on);
          el.classList.toggle("ring-orange-600/50", on);
        });
        input.setAttribute("aria-activedescendant", i >= 0 && flatOptions[i] ? flatOptions[i].id : "");
        if (i >= 0 && flatOptions[i]) {
          var active = document.getElementById(flatOptions[i].id);
          if (active && active.scrollIntoView) active.scrollIntoView({ block: "nearest", inline: "nearest" });
        }
      }
      function openDrop() {
        drop.classList.remove("hidden");
        input.setAttribute("aria-expanded", "true");
      }
      function closeDrop() {
        if (ctrl) { ctrl.abort(); ctrl = null; }
        seq++;
        drop.classList.add("hidden");
        input.setAttribute("aria-expanded", "false");
        setActive(-1);
      }
      function coverCard(item, id, badge) {
        // Cover-only card (CG, 2026-10-28: "slim it up"). The section
        // header already names the kind and the cover art carries the
        // book's title, so no title/subtitle text renders under book,
        // audio, or video covers. The full title survives for people
        // and machines in the card's title attribute, its aria-label,
        // and the image alt. A coverless item falls back to its title
        // inside the frame so it never renders as an anonymous box.
        return '<a href="' + esc(item.href) + '" id="' + id + '" role="option" aria-selected="false" title="' + esc(item.title) + '" aria-label="' + esc(item.title) + '" class="search-opt block w-[5.25rem] shrink-0 snap-start rounded-xl p-1 outline-none">' +
          '<span class="relative block w-full aspect-[3/4] rounded-lg bg-stone-100 overflow-hidden">' +
          (item.imageUrl
            ? '<img src="' + esc(item.imageUrl) + '" alt="' + esc(item.title) + '" loading="lazy" class="absolute inset-0 w-full h-full object-cover" />'
            : '<span class="absolute inset-0 flex items-center justify-center px-1.5 text-center text-[10px] font-semibold leading-tight text-stone-500">' + esc(item.title) + "</span>") +
          (badge || "") + "</span></a>";
      }
      function optionHtml(item, id) {
        if (item.type === "cast") {
          // Compact cast card: circular portrait, name, role alone.
          // The full "role · book title" subtitle lives in the title
          // attribute; at card width it only ever truncated anyway.
          var role = (item.meta && item.meta.role) || item.subtitle || "";
          return '<a href="' + esc(item.href) + '" id="' + id + '" role="option" aria-selected="false" title="' + esc(item.subtitle) + '" class="search-opt block w-[4.5rem] shrink-0 snap-start rounded-xl px-1 py-1.5 text-center outline-none">' +
            (item.imageUrl
              ? '<img src="' + esc(item.imageUrl) + '" alt="" loading="lazy" class="w-12 h-12 mx-auto rounded-full object-cover bg-stone-100" />'
              : '<span class="block w-12 h-12 mx-auto rounded-full bg-stone-100"></span>') +
            '<span class="block mt-1 text-[11px] font-semibold leading-tight truncate">' + esc(item.title) + "</span>" +
            '<span class="block text-[10px] text-stone-500 leading-tight truncate">' + esc(role) + "</span></a>";
        }
        if (item.type === "audio") {
          return coverCard(item, id, '<span class="absolute bottom-1 right-1 w-5 h-5 rounded-full bg-orange-600 text-white flex items-center justify-center"><svg width="9" height="9" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 10v4h4l5 5V5L7 10H3zm13.5 2a4.5 4.5 0 0 0-2.5-4v8a4.5 4.5 0 0 0 2.5-4z"/></svg></span>');
        }
        if (item.type === "video") {
          return coverCard(item, id, '<span class="absolute inset-0 flex items-center justify-center"><span class="w-7 h-7 rounded-full bg-stone-950/60 text-white flex items-center justify-center"><svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg></span></span>');
        }
        return coverCard(item, id, "");
      }
      function renderSearch(q, sections) {
        flatOptions = [];
        var total = 0;
        var html = sections.map(function (section) {
          var label = SECTION_LABELS[section.type] || section.type;
          var itemsHtml = section.items.map(function (item) {
            var id = "search-opt-" + section.type + "-" + flatOptions.length;
            flatOptions.push({ id: id, href: item.href });
            total++;
            return optionHtml(item, id);
          }).join("");
          return '<div role="group" aria-label="' + esc(label) + '"><p class="px-4 pt-2 pb-0.5 text-[11px] font-semibold uppercase tracking-wider text-stone-500">' + esc(label) + "</p>" +
            '<div class="flex gap-1 overflow-x-auto px-2 pb-1.5 snap-x">' + itemsHtml + "</div></div>";
        }).join("");
        if (!total) {
          results.innerHTML = '<div class="px-5 py-6 text-center"><p class="text-sm font-semibold text-stone-900">Nothing on the shelf matches &ldquo;' + esc(q) + "&rdquo; yet.</p>" +
            '<p class="text-sm text-stone-500 mt-1">Try a name like Mira, or a shelf like money.</p></div>';
          status.textContent = "No results for " + q + ".";
        } else {
          results.innerHTML = html;
          status.textContent = total + (total === 1 ? " result" : " results") + " for " + q + ".";
        }
        setActive(-1);
        openDrop();
        // One search event per distinct query, only whether it found
        // anything: the query text itself never leaves the browser.
        if (window.bbsTraks && q !== lastTrackedQuery) {
          lastTrackedQuery = q;
          window.bbsTraks("search", { has_results: total > 0 ? "yes" : "no" });
        }
      }
      function runSearch(q) {
        var my = ++seq;
        if (ctrl) ctrl.abort();
        ctrl = typeof AbortController !== "undefined" ? new AbortController() : null;
        fetch("/api/search?q=" + encodeURIComponent(q), ctrl ? { signal: ctrl.signal } : {})
          .then(function (r) { return r.json(); })
          .then(function (data) {
            if (my !== seq) return; // a newer keystroke already won
            renderSearch(q, (data && data.sections) || []);
          })
          .catch(function (err) {
            if ((err && err.name === "AbortError") || my !== seq) return;
            results.innerHTML = '<div class="px-5 py-6 text-center"><p class="text-sm font-semibold text-stone-900">Search hiccuped.</p><p class="text-sm text-stone-500 mt-1">Give it another try.</p></div>';
            status.textContent = "Search failed.";
            openDrop();
          });
      }
      input.addEventListener("input", function () {
        var q = input.value.trim();
        if (timer) clearTimeout(timer);
        if (!q) {
          closeDrop();
          var h = homeHook();
          if (h && h.clear) h.clear();
          return;
        }
        timer = setTimeout(function () { runSearch(q); }, 200);
      });
      input.addEventListener("keydown", function (e) {
        var open = !drop.classList.contains("hidden");
        if (e.key === "ArrowDown" || e.key === "ArrowUp") {
          if (!open || !flatOptions.length) return;
          e.preventDefault();
          var next = e.key === "ArrowDown"
            ? (activeIdx + 1) % flatOptions.length
            : (activeIdx - 1 + flatOptions.length) % flatOptions.length;
          setActive(next);
        } else if (e.key === "Enter") {
          if (open && activeIdx >= 0 && flatOptions[activeIdx]) {
            e.preventDefault();
            window.location.href = flatOptions[activeIdx].href;
            return;
          }
          var h = homeHook();
          if (h && h.submit && h.submit(input.value)) { closeDrop(); return; }
          if (open && flatOptions.length) {
            e.preventDefault();
            window.location.href = flatOptions[0].href;
          } else {
            closeDrop();
          }
        } else if (e.key === "Escape") {
          if (open) { e.preventDefault(); closeDrop(); }
        } else if (e.key === "Tab") {
          closeDrop();
        }
      });
      input.addEventListener("focus", function () {
        if (input.value.trim() && results.querySelector(".search-opt")) openDrop();
      });
      results.addEventListener("mousemove", function (e) {
        var opt = e.target.closest(".search-opt");
        if (!opt) return;
        var idx = flatOptions.findIndex(function (o) { return o.id === opt.id; });
        if (idx >= 0 && idx !== activeIdx) setActive(idx);
      });
      results.addEventListener("click", function () { closeDrop(); });
    }

    // Outside tap or click dismisses. Bound once per document; it
    // looks the live elements up, so it survives view transitions.
    if (!window.__bbsSearchDoc) {
      window.__bbsSearchDoc = true;
      document.addEventListener("pointerdown", function (e) {
        var box = document.getElementById("site-search");
        var drop = document.getElementById("search-dropdown");
        var input = document.getElementById("q");
        if (box && drop && !box.contains(e.target)) {
          drop.classList.add("hidden");
          if (input) input.setAttribute("aria-expanded", "false");
        }
      });
    }
    initSearch();
    if (!window.__bbsSearchPL) {
      window.__bbsSearchPL = true;
      document.addEventListener("astro:page-load", initSearch);
    }
  })();
</script>
