---
// Language pill for localized book pages (CG's design, revised
// 2026-10-30): localized editions keep the English cover, because
// the translated-title cover only exists after a localized factory
// assembly. This pill names the language of the book inside IN that
// language (the endonym, from src/lib/i18n.ts), so a buyer who lands
// on the familiar English cover knows the pages behind the click are
// not English.
//
// Shape: a horizontal PILL in the brand pair (navy #1a3454, cream
// text), styled like the bigbrainshelf logo pill in the cover's
// footer band. Position: absolutely placed inside the hero cover
// container, horizontally centered, JUST BELOW the cover's baked-in
// title band. The title band is part of the composed cover art: on
// the 960x1280 hero derivative its bottom edge measures y=272 of
// 1280, 21.25% of the image height (the factory cover template is
// the same across books). The pill's top sits at 22.5%: fully in the
// art area with a small gap under the title, never over the title
// text, never down at the footer band. It is a badge, not a control:
// no link, no pointer events. Renders nothing for English, and the
// book page mounts it only in localized renders, so English output
// never carries it.
import { languageDef, type LangCode } from "../lib/i18n";

const { locale } = Astro.props as { locale: LangCode };
const def = languageDef(locale);
const name = def.endonym;
---
{def.code !== "en" && (
  <span
    class="absolute left-1/2 top-[22.5%] z-30 -translate-x-1/2 inline-flex items-center justify-center rounded-full bg-[#1a3454] text-[#f7f2e6] px-4 py-1.5 text-[13px] sm:text-sm font-bold leading-none whitespace-nowrap select-none pointer-events-none"
    style="box-shadow: 0 0 0 2px #f7f2e6, 0 10px 20px -10px rgba(26,52,84,.55)"
  >{name}</span>
)}
