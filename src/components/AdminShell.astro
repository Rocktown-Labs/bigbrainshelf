---
// Admin shell (pass 4, 2026-10-29): a collapsible sidebar in the
// shadcn sidebar pattern, hand-rolled in the project's own stack
// (Astro + Tailwind-era utility CSS + a small vanilla script), so
// nothing new enters the raw Workers deploy. Where it follows the
// shadcn spec: a left rail with grouped navigation, a collapse
// toggle, an icon-only collapsed state with labels on hover, the
// expanded/collapsed choice persisted (localStorage), the wordmark
// at the top, sign out pinned at the bottom, and a neutral SaaS
// look (white rail, stone borders and text, one accent for the
// active item).
//
// Behavior rules:
// - Editor routes (lib/admin-nav isEditorRoute: book and character
//   editors, crop tools, story review, the cast studios) start
//   collapsed to the icon rail so the editor gets the width; the
//   toggle still expands it there.
// - Everywhere else the sidebar starts from the persisted choice.
// - Mobile: the rail is off-canvas behind a slim top bar with a
//   menu button; nothing about phone admin changes hands.
// Auth gating is untouched: the middleware still guards /admin.
import { ADMIN_NAV, isEditorRoute } from "../lib/admin-nav";

const { current = "" } = Astro.props;
const editor = isEditorRoute(Astro.url.pathname);

const ICONS: Record<string, string> = {
  dashboard: '<rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/>',
  book: '<path d="M2 3.5h6A4 4 0 0 1 12 7.5v13a3 3 0 0 0-3-3H2z"/><path d="M22 3.5h-6a4 4 0 0 0-4 4v13a3 3 0 0 1 3-3h7z"/>',
  audio: '<path d="M3 18v-6a9 9 0 0 1 18 0v6"/><path d="M3 14h3.5v4H5a2 2 0 0 1-2-2v-2z"/><path d="M21 14h-3.5v4H19a2 2 0 0 0 2-2v-2z"/>',
  scroll: '<rect x="5" y="3" width="14" height="18" rx="2"/><path d="M9 8.5h6M9 12.5h6"/>',
  characters: '<circle cx="9" cy="8" r="3.5"/><path d="M2.8 20c.7-3.1 3.2-4.9 6.2-4.9s5.5 1.8 6.2 4.9"/><circle cx="17.3" cy="9" r="2.6"/><path d="M16.2 15.3c2.2.3 3.9 1.8 4.4 4.2"/>',
  casting: '<rect x="9" y="2.5" width="6" height="11" rx="3"/><path d="M5.5 11.5a6.5 6.5 0 0 0 13 0"/><path d="M12 18v3.5"/>',
  orders: '<path d="M5.5 8h13l-1 12.5h-11z"/><path d="M9 10V6.5a3 3 0 0 1 6 0V10"/>',
  club: '<path d="M12 2.8 20 7v10l-8 4.2L4 17V7z"/><path d="M4.3 7.3 12 11l7.7-3.7"/><path d="M12 11v10"/>',
  reviews: '<path d="m12 3.2 2.7 5.6 6.1.8-4.5 4.2 1.1 6-5.4-2.9-5.4 2.9 1.1-6L3.2 9.6l6.1-.8z"/>',
  video: '<rect x="3" y="5.5" width="18" height="14" rx="2"/><path d="M3 10h18"/><path d="m10.8 13.2 4.2 2.3-4.2 2.3z"/>',
  store: '<path d="M3.5 9.3 5.2 3.5h13.6l1.7 5.8"/><path d="M3.5 9.3a2.9 2.9 0 0 0 5.5.8 2.9 2.9 0 0 0 6 0 2.9 2.9 0 0 0 5.5-.8"/><path d="M5 12.6V20.5h14v-7.9"/><path d="M9.7 20.5v-5.4h4.6v5.4"/>',
  signout: '<path d="M9 20.5H5.5a2 2 0 0 1-2-2v-13a2 2 0 0 1 2-2H9"/><path d="m16 16.5 5-4.5-5-4.5"/><path d="M21 12H9.5"/>',
  panel: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M9.5 4v16"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
};
const icon = (name: string) =>
  `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${ICONS[name] || ""}</svg>`;
---

<script is:inline define:vars={{ editor }}>
  // Set the initial sidebar state before the rail paints: editor
  // routes start collapsed; everywhere else the persisted choice
  // (default expanded) wins.
  (function () {
    var stored = null;
    try { stored = window.localStorage.getItem("bbs-admin-sidebar"); } catch (e) {}
    var state = editor ? "collapsed" : stored === "collapsed" ? "collapsed" : "expanded";
    document.documentElement.setAttribute("data-sidebar", state);
    document.documentElement.setAttribute("data-mobile-nav", "closed");
  })();
</script>

<style is:global>
  .bbs-sidebar {
    position: fixed; top: 0; bottom: 0; left: 0; z-index: 60;
    width: 16rem; background: #fff; border-right: 1px solid #e7e5e4;
    display: flex; flex-direction: column;
    transition: width 0.18s ease, transform 0.18s ease;
  }
  .bbs-side-head {
    display: flex; align-items: center; gap: 0.5rem;
    padding: 0.8rem 0.9rem; border-bottom: 1px solid #f0efed; min-height: 3.6rem;
  }
  .bbs-wordmark {
    display: inline-flex; align-items: center; border-radius: 999px;
    background: #1a3454; color: #fff; padding: 0.32rem 0.8rem;
    font-size: 0.95rem; font-weight: 800; letter-spacing: -0.02em;
    line-height: 1; text-decoration: none; white-space: nowrap;
  }
  .bbs-wordmark .bbs-wm-orange { color: #fb923c; }
  .bbs-mono {
    display: none; width: 2rem; height: 2rem; border-radius: 999px;
    background: #1a3454; color: #fff; font-weight: 800; font-size: 0.8rem;
    align-items: center; justify-content: center; text-decoration: none;
  }
  .bbs-admin-tag {
    font-size: 0.62rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.16em; color: #a8a29e; white-space: nowrap;
  }
  .bbs-toggle, .bbs-menu-btn {
    margin-left: auto; display: inline-flex; align-items: center; justify-content: center;
    width: 2rem; height: 2rem; border-radius: 0.5rem; border: 1px solid transparent;
    background: transparent; color: #78716c; cursor: pointer; flex: none;
  }
  .bbs-toggle:hover, .bbs-menu-btn:hover { background: #f5f5f4; color: #1c1917; }
  .bbs-nav { flex: 1; overflow-y: auto; overflow-x: hidden; padding: 0.6rem 0.6rem 1rem; }
  .bbs-group { margin-top: 1rem; }
  .bbs-group:first-child { margin-top: 0.2rem; }
  .bbs-group-label {
    margin: 0 0 0.3rem; padding: 0 0.5rem; font-size: 0.65rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.14em; color: #a8a29e; white-space: nowrap;
  }
  .bbs-item {
    position: relative; display: flex; align-items: center; gap: 0.65rem;
    padding: 0.5rem 0.55rem; margin: 0.1rem 0; border-radius: 0.55rem;
    color: #57534e; font-size: 0.9rem; font-weight: 500; text-decoration: none;
    white-space: nowrap;
  }
  .bbs-item svg { flex: none; }
  .bbs-item:hover { background: #f5f5f4; color: #1c1917; }
  .bbs-item.bbs-active { background: #f5f5f4; color: #1c1917; font-weight: 650; box-shadow: inset 2.5px 0 0 #ea580c; }
  .bbs-side-foot { border-top: 1px solid #f0efed; padding: 0.6rem; }
  .bbs-mobilebar { display: none; }
  .bbs-backdrop { display: none; }

  /* New-order badge on the Orders item: completed orders in
     the last 24 hours (fed by /api/admin/orders-badge). */
  .bbs-orders-badge { margin-left: auto; background: #ea580c; color: #fff; font-size: 0.68rem; font-weight: 800; line-height: 1; padding: 0.22rem 0.45rem; border-radius: 999px; font-variant-numeric: tabular-nums; }
  html[data-sidebar="collapsed"] .bbs-orders-badge { margin-left: 0; }

  /* Collapsed (icon rail) on desktop */
  @media (min-width: 1024px) {
    html[data-sidebar] body { padding-left: 16rem; transition: padding-left 0.18s ease; }
    html[data-sidebar="collapsed"] body { padding-left: 4.25rem; }
    html[data-sidebar="collapsed"] .bbs-sidebar { width: 4.25rem; }
    html[data-sidebar="collapsed"] .bbs-wordmark,
    html[data-sidebar="collapsed"] .bbs-admin-tag,
    html[data-sidebar="collapsed"] .bbs-group-label,
    html[data-sidebar="collapsed"] .bbs-item-label { display: none; }
    html[data-sidebar="collapsed"] .bbs-mono { display: inline-flex; }
    html[data-sidebar="collapsed"] .bbs-item { justify-content: center; padding: 0.55rem 0; }
    html[data-sidebar="collapsed"] .bbs-side-head { justify-content: center; flex-direction: column; gap: 0.55rem; padding: 0.8rem 0.3rem; }
    html[data-sidebar="collapsed"] .bbs-toggle { margin-left: 0; }
    /* Labels on hover in the icon rail (the shadcn tooltip slot) */
    html[data-sidebar="collapsed"] .bbs-item::after {
      content: attr(data-label); position: absolute; left: calc(100% + 10px); top: 50%;
      transform: translateY(-50%) translateX(-4px); background: #1c1917; color: #fff;
      font-size: 0.78rem; font-weight: 500; padding: 0.32rem 0.6rem; border-radius: 0.45rem;
      opacity: 0; pointer-events: none; transition: opacity 0.12s ease, transform 0.12s ease; z-index: 70;
    }
    html[data-sidebar="collapsed"] .bbs-item:hover::after { opacity: 1; transform: translateY(-50%) translateX(0); }
  }

  /* Mobile: off-canvas rail + slim top bar */
  @media (max-width: 1023.98px) {
    html[data-sidebar] body { padding-top: 3.4rem; }
    .bbs-sidebar { transform: translateX(-106%); width: 16rem; box-shadow: 0 10px 40px rgba(28,25,23,0.18); }
    html[data-mobile-nav="open"] .bbs-sidebar { transform: none; }
    .bbs-mobilebar {
      display: flex; align-items: center; gap: 0.6rem; position: fixed;
      top: 0; left: 0; right: 0; z-index: 55; height: 3.4rem; padding: 0 0.8rem;
      background: #fff; border-bottom: 1px solid #e7e5e4;
    }
    .bbs-menu-btn { margin-left: auto; }
    html[data-mobile-nav="open"] .bbs-backdrop {
      display: block; position: fixed; inset: 0; z-index: 58;
      background: rgba(28,25,23,0.35);
    }
  }
</style>

<div class="bbs-mobilebar">
  <a class="bbs-wordmark" href="/admin">big<span class="bbs-wm-orange">brain</span>shelf</a>
  <span class="bbs-admin-tag">Admin</span>
  <button class="bbs-menu-btn" id="bbs-menu-btn" type="button" aria-label="Open the admin menu">
    <Fragment set:html={icon("menu")} />
  </button>
</div>
<div class="bbs-backdrop" id="bbs-backdrop"></div>

<aside class="bbs-sidebar" aria-label="Admin">
  <div class="bbs-side-head">
    <a class="bbs-wordmark" href="/admin">big<span class="bbs-wm-orange">brain</span>shelf</a>
    <a class="bbs-mono" href="/admin" aria-label="Big Brain Shelf admin home">B</a>
    <span class="bbs-admin-tag">Admin</span>
    <button class="bbs-toggle" id="bbs-side-toggle" type="button" aria-label="Collapse or expand the sidebar">
      <Fragment set:html={icon("panel")} />
    </button>
  </div>
  <nav class="bbs-nav" aria-label="Admin sections">
    {ADMIN_NAV.map((group) => (
      <div class="bbs-group">
        <p class="bbs-group-label">{group.label}</p>
        {group.items.map((item) => (
          <a class={`bbs-item${item.href === current ? " bbs-active" : ""}`} href={item.href} data-label={item.label} aria-label={item.label}>
            <Fragment set:html={icon(item.icon)} />
            <span class="bbs-item-label">{item.label}</span>
            {item.href === "/admin/orders" && (
              <span class="bbs-orders-badge" data-orders-badge hidden></span>
            )}
            {item.href === "/admin/club" && (
              <span class="bbs-orders-badge" data-club-badge hidden></span>
            )}
            {item.href === "/admin/reviews" && (
              <span class="bbs-orders-badge" data-reviews-badge hidden></span>
            )}
          </a>
        ))}
      </div>
    ))}
  </nav>
  <div class="bbs-side-foot">
    <a class="bbs-item js-signout" id="bbs-signout" href="#" data-label="Sign out" aria-label="Sign out">
      <Fragment set:html={icon("signout")} />
      <span class="bbs-item-label">Sign out</span>
    </a>
  </div>
</aside>

<script is:inline>
  (function () {
    var root = document.documentElement;
    var toggle = document.getElementById("bbs-side-toggle");
    if (toggle) {
      toggle.addEventListener("click", function () {
        var next = root.getAttribute("data-sidebar") === "collapsed" ? "expanded" : "collapsed";
        root.setAttribute("data-sidebar", next);
        try { window.localStorage.setItem("bbs-admin-sidebar", next); } catch (e) {}
      });
    }
    var menuBtn = document.getElementById("bbs-menu-btn");
    if (menuBtn) {
      menuBtn.addEventListener("click", function () {
        root.setAttribute("data-mobile-nav", root.getAttribute("data-mobile-nav") === "open" ? "closed" : "open");
      });
    }
    var backdrop = document.getElementById("bbs-backdrop");
    if (backdrop) {
      backdrop.addEventListener("click", function () { root.setAttribute("data-mobile-nav", "closed"); });
    }
    document.querySelectorAll(".bbs-sidebar .bbs-item").forEach(function (el) {
      el.addEventListener("click", function () { root.setAttribute("data-mobile-nav", "closed"); });
    });
    // Sidebar attention badges (orders, club, reviews) from the
    // one counts endpoint; each shows only when its count is > 0.
    function fillBadge(sel, n) {
      var el = document.querySelector(sel);
      if (el && n > 0) {
        el.textContent = String(n);
        el.hidden = false;
      }
    }
    if (document.querySelector("[data-orders-badge], [data-club-badge], [data-reviews-badge]")) {
      fetch("/api/admin/orders-badge")
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (j) {
          if (!j) return;
          fillBadge("[data-orders-badge]", j.count);
          fillBadge("[data-club-badge]", j.club);
          fillBadge("[data-reviews-badge]", j.reviews);
        })
        .catch(function () {});
    }
    var signout = document.getElementById("bbs-signout");
    if (signout && !signout.dataset.shellBound) {
      signout.dataset.shellBound = "1";
      signout.addEventListener("click", async function (e) {
        e.preventDefault();
        await fetch("/api/admin-auth/logout", { method: "POST" }).catch(function () {});
        await fetch("/api/auth/sign-out", { method: "POST", headers: { "Content-Type": "application/json" }, body: "{}" }).catch(function () {});
        window.location.href = "/login";
      });
    }
  })();
</script>
