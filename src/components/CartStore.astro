---
// CartStore: the ONE cart store for the whole storefront.
//
// The cart used to be copy-pasted into every surface that touched
// it (the slide-over sheet scripts on five pages, the /cart page,
// the buy buttons), each with its own getCart/setCart over the
// localStorage key "bbs-cart" and no shared change signal, so
// surfaces fell out of sync: the badge went stale on the cart page,
// and a book page's buy button kept saying "In your cart" after the
// item was removed in the sheet. This component is the single owner
// of the cart now. It renders one inline script (through SiteHeader,
// so every public page carries it exactly once) exposing
// window.bbsCart:
//
//   get()       the normalized cart: [{ slug, format }]
//   set(next)   replace the cart (normalized before it is stored)
//   add(slug, format)    -> true when the entry was new
//   remove(slug, format)
//   clear()
//   has(slug, format)
//   bbsGuestId()         the guest checkout id (bbs-guest-id)
//   loadBooks()          cached GET /api/books?scope=cart
//   priceOf(bySlug, item) / flagOf(book, flag, key)
//   hasPhysical(items) / needsAddress(items) / money(cents) / paintBadge()
//   setGift(slug, format, gift) / isClubSlug(slug) / clubInfo(item)
//
// Club lines (CG, 2026-11-07) are cart items too: reserved slugs
// book-club / audio-club with the billing period as the format, at
// most one per cart, priced from the club constants in
// src/lib/offers.ts. Book lines may carry gift: true.
//
// Every mutation writes localStorage, repaints the header badge,
// and dispatches a document CustomEvent "bbs:cart-changed" with the
// new cart in detail.cart. Surfaces subscribe to that event and
// re-render from the store; nobody keeps a private copy anymore.
// A storage listener mirrors the same event for carts changed in
// another tab. Pricing semantics are the canonical ones from
// src/lib/cart-pricing.ts, carried here in plain script form
// because the raw Workers deploy serves inline scripts as-is.
---

<script is:inline>
  if (!window.bbsCart) {
    (function () {
      var KEY = "bbs-cart";
      var R2 = "https://media.bigbrainshelf.com/";
      var booksCache = null;
      var paintSeq = 0;

      function clampQty(q) {
        var n = Math.floor(Number(q));
        if (!isFinite(n) || n < 1) return 1;
        return Math.min(99, n);
      }
      // Single-copy formats (digital, audio): owned once, no gifting
      // flow, so quantity is always 1. Club billing periods are
      // single-copy for the same reason (one membership per buyer).
      // Mirrors lineQty in src/lib/orders.ts; checkout enforces the
      // same rule server-side.
      function clampFor(format, q) {
        return format === "digital" || format === "audio" || format === "quarterly" || format === "annual" || format === "monthly" ? 1 : clampQty(q);
      }
      // Club lines (CG, 2026-11-07): the clubs are cart products with
      // reserved slugs; a club line's format is its billing period.
      // Prices are the club constants from src/lib/offers.ts
      // (CLUB_PRICE_CENTS 6000, CLUB_ANNUAL_PRICE_CENTS 19900,
      // AUDIO_CLUB_PRICE_CENTS 599, AUDIO_CLUB_ANNUAL_PRICE_CENTS
      // 4900), baked in like the gift set and audiobook flat prices
      // in priceOf below: club slugs are not books, so the catalog
      // lookup can never price them.
      var CLUB_LINES = {
        "book-club": { title: "The Book Club", periods: { quarterly: { price: 6000, label: "Every 3 months" }, annual: { price: 19900, label: "Yearly" } } },
        "audio-club": { title: "The Audio Club", periods: { monthly: { price: 599, label: "Monthly" }, annual: { price: 4900, label: "Yearly" } } }
      };
      function isClubSlug(slug) { return !!CLUB_LINES[slug]; }
      function clubInfo(it) {
        var c = CLUB_LINES[it.slug];
        if (!c) return null;
        var p = c.periods[it.format];
        return p ? { title: c.title, periodLabel: p.label, price: p.price } : null;
      }
      function normalize(c) {
        // One entry per slug + format, quantities merged: the
        // badge, the sheet, and the checkout all count the same
        // cart (CG, 2026-10-31: quantities are real now).
        var byKey = {};
        var order = [];
        (c || []).forEach(function (x) {
          var it = typeof x === "string" ? { slug: x, format: "digital" } : x;
          if (!it || !it.slug) return;
          if (isClubSlug(it.slug)) {
            // At most ONE club line in the cart: a later club entry
            // replaces any earlier one (switching plans or billing
            // periods), quantity locked to 1, never a gift.
            var prior = -1;
            for (var i = 0; i < order.length; i++) if (isClubSlug(order[i].slug)) { prior = i; break; }
            if (prior >= 0) order.splice(prior, 1);
            order.push({ slug: it.slug, format: it.format || "", qty: 1 });
            return;
          }
          var k = it.slug + ":" + (it.format || "digital");
          if (byKey[k]) {
            byKey[k].qty = clampFor(byKey[k].format, byKey[k].qty + clampQty(it.qty));
            if (it.gift) byKey[k].gift = true;
          } else {
            var entry = { slug: it.slug, format: it.format || "digital", qty: clampFor(it.format || "digital", it.qty) };
            // The per-line gift flag (CG, 2026-11-07) rides book
            // lines through every surface to the order.
            if (it.gift) entry.gift = true;
            byKey[k] = entry;
            order.push(entry);
          }
        });
        return order;
      }
      function getCart() {
        try { return normalize(JSON.parse(localStorage.getItem(KEY) || "[]")); } catch (e) { return []; }
      }
      function announce(cart) {
        try {
          document.dispatchEvent(new CustomEvent("bbs:cart-changed", { detail: { cart: cart } }));
        } catch (e) {}
      }
      function setCart(next) {
        var cart = normalize(next);
        try { localStorage.setItem(KEY, JSON.stringify(cart)); } catch (e) {}
        paintBadge();
        announce(cart);
        return cart;
      }
      function bbsGuestId() { try { var g = localStorage.getItem("bbs-guest-id"); if (!g) { g = (window.crypto && crypto.randomUUID) ? crypto.randomUUID() : "guest" + Date.now() + Math.floor(Math.random() * 1e9); localStorage.setItem("bbs-guest-id", g); } return g; } catch (e) { return ""; } }
      function money(c) { return "$" + (c / 100).toFixed(2); }
      function paintBadgeCount(n) {
        var badge = document.getElementById("cart-count");
        if (!badge) return;
        badge.textContent = n;
        badge.classList.toggle("hidden", !n);
        badge.classList.toggle("flex", !!n);
      }
      // The badge counts what the sheet and the cart page can
      // actually sell, never raw localStorage entries: paint the
      // stored count at once, then repaint with the purchasable
      // count once the catalog resolves. (Raw counting once let the
      // badge say 1 over a sheet that showed nothing purchasable.)
      // The sequence token keeps a slower earlier resolution from
      // landing after a newer mutation and repainting a stale count.
      function paintBadge() {
        var cart = getCart();
        paintBadgeCount(cart.length);
        var seq = ++paintSeq;
        loadBooks().then(function (books) {
          if (seq !== paintSeq) return;
          if (!books || !books.length) return;
          var bySlug = {};
          books.forEach(function (b) { bySlug[b.slug] = b; });
          paintBadgeCount(cart.filter(function (it) { return priceOf(bySlug, it) > 0; }).length);
        }).catch(function () {});
      }
      function loadBooks() {
        if (!booksCache) booksCache = fetch("/api/books?scope=cart").then(function (r) { return r.json(); }).catch(function () { return []; });
        return booksCache;
      }
      // Availability: the public catalog shape carries has_* flags;
      // an admin session's full rows carry the raw *_key columns
      // instead. Read the flag when present, the key otherwise, so
      // resolution is identical for every session.
      function flagOf(b, flag, key) { return b[flag] !== undefined ? !!b[flag] : !!b[key]; }
      function priceOf(bySlug, it) {
        // Club lines price from the club constants WITHOUT the books
        // catalog (special-cased first: the catalog has no such slug
        // and the generic path would price the line at 0, making it
        // vanish from every surface). An invalid period prices at 0
        // the same way an unavailable book does.
        if (isClubSlug(it.slug)) {
          var ci = clubInfo(it);
          return ci ? ci.price : 0;
        }
        var b = bySlug[it.slug];
        if (!b) return 0;
        if (it.format === "printed") return Math.round(Number(b.price_print || 0));
        // Gift Set: flat $35 (GIFT_SET_PRICE_CENTS in src/lib/offers.ts),
        // only for books with both a story book and a coloring book.
        if (it.format === "giftset") return (flagOf(b, "has_picture_book", "picture_book_key") && flagOf(b, "has_coloring_book", "coloring_book_key")) ? 3500 : 0;
        // Audiobook only: flat $5.99 (AUDIO_PRICE_CENTS in offers.ts),
        // only for books with an audiobook.
        if (it.format === "audio") return flagOf(b, "has_audiobook", "audiobook_key") ? 599 : 0;
        // Digital at the audiobook owner's unlock price when the
        // page computed one for this visitor: the checkout page's map
        // (window.__bbsUpgrades), or the book page's own book
        // (window.__bbsUpgrade). Checkout settles the same credit
        // server-side either way.
        if (it.format === "digital" && window.__bbsUpgrades && Object.prototype.hasOwnProperty.call(window.__bbsUpgrades, it.slug)) return window.__bbsUpgrades[it.slug];
        if (it.format === "digital" && window.__bbsUpgrade && window.__bbsUpgrade.slug === it.slug) return window.__bbsUpgrade.digitalCents;
        return Math.round(Number(b.price || 0));
      }
      // Shipping is quoted from the buyer's address on the cart page
      // and charged rounded up to the next whole dollar. The surfaces
      // never name an amount; they only know whether the cart needs
      // that step. Physical means physical BOOK lines: a club line
      // never enters a shipping quote and never adds a shipping
      // charge (club shipping is included in the membership).
      function hasPhysical(items) {
        return items.some(function (it) { return it.format === "printed" || it.format === "giftset"; });
      }
      // The address step's trigger is wider: physical book lines, or
      // a Book Club line (its first box ships to the buyer, so the
      // address is collected and stored on the order even though no
      // shipping is charged for it). An Audio Club line needs no
      // address: nothing ships.
      function needsAddress(items) {
        return hasPhysical(items) || items.some(function (it) { return it.slug === "book-club" && !!clubInfo(it); });
      }

      window.bbsCart = {
        R2: R2,
        get: getCart,
        normalize: normalize,
        set: setCart,
        add: function (slug, format) {
          format = format || "digital";
          if (isClubSlug(slug)) {
            // Adding a club replaces any club line already in the
            // cart (one membership per buyer): plan switches and
            // period switches both land here.
            var clubCart = getCart().filter(function (x) { return !isClubSlug(x.slug); });
            clubCart.push({ slug: slug, format: format, qty: 1 });
            setCart(clubCart);
            return true;
          }
          var cart = getCart();
          var existing = cart.find(function (x) { return x.slug === slug && x.format === format; });
          if (existing) {
            // Adding what is already in the cart means one more
            // copy (the natural cart behavior), capped at 99, except
            // single-copy formats, which stay at 1 by rule.
            existing.qty = clampFor(format, (existing.qty || 1) + 1);
            setCart(cart);
            return true;
          }
          cart.push({ slug: slug, format: format, qty: 1 });
          setCart(cart);
          return true;
        },
        setQty: function (slug, format, qty) {
          format = format || "digital";
          var cart = getCart();
          var entry = cart.find(function (x) { return x.slug === slug && x.format === format; });
          if (!entry) return;
          entry.qty = clampFor(format, qty);
          setCart(cart);
        },
        // Flip a book line's gift flag (club lines never carry one).
        setGift: function (slug, format, gift) {
          format = format || "digital";
          if (isClubSlug(slug)) return;
          var cart = getCart();
          var entry = cart.find(function (x) { return x.slug === slug && x.format === format; });
          if (!entry) return;
          if (gift) entry.gift = true; else delete entry.gift;
          setCart(cart);
        },
        remove: function (slug, format) {
          format = format || "digital";
          setCart(getCart().filter(function (x) {
            return !(x.slug === slug && x.format === format);
          }));
        },
        clear: function () { setCart([]); },
        has: function (slug, format) {
          format = format || "digital";
          return getCart().some(function (x) { return x.slug === slug && x.format === format; });
        },
        bbsGuestId: bbsGuestId,
        loadBooks: loadBooks,
        flagOf: flagOf,
        priceOf: priceOf,
        hasPhysical: hasPhysical,
        needsAddress: needsAddress,
        isClubSlug: isClubSlug,
        clubInfo: clubInfo,
        money: money,
        paintBadge: paintBadge,
        onChange: function (fn) {
          document.addEventListener("bbs:cart-changed", fn);
          return function () { document.removeEventListener("bbs:cart-changed", fn); };
        },
      };
      window.bbsPaintBadge = paintBadge;

      // A cart changed in another tab arrives as a storage event;
      // mirror it into the same change signal (and badge repaint) so
      // every open surface stays in sync.
      window.addEventListener("storage", function (e) {
        if (e.key !== KEY) return;
        paintBadge();
        announce(getCart());
      });

      paintBadge();
    })();
  }
  // Repaint the badge for the header each view transition swaps in.
  if (!window.__bbsCartStorePL) {
    window.__bbsCartStorePL = true;
    document.addEventListener("astro:page-load", function () {
      if (window.bbsCart) window.bbsCart.paintBadge();
    });
  }
</script>
