---
// Format chip for server-rendered order views (the guest order page
// and the account order history). The colors and pill shape come
// from the shared format system in src/styles/global.css (.fchip +
// .fmt-*), the same system the admin order pages render from their
// scripts: digital = green, book icon; printed = yellow, pencil
// icon; audio = red, headphones icon; gift set rides the printed
// treatment because it is a printed bundle.
const { format } = Astro.props as { format: string };
const META: Record<string, { cls: string; label: string }> = {
  audio: { cls: "fmt-audio", label: "Audio" },
  digital: { cls: "fmt-digital", label: "Digital" },
  printed: { cls: "fmt-printed", label: "Printed" },
  giftset: { cls: "fmt-printed", label: "Gift set" },
};
const m = META[String(format || "digital")] || META.digital;
---
<span class={`fchip ${m.cls}`}>
  {format === "audio" ? (
    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 14v-2a8 8 0 0 1 16 0v2"/><rect x="2.5" y="14" width="4" height="6.5" rx="1.6"/><rect x="17.5" y="14" width="4" height="6.5" rx="1.6"/></svg>
  ) : format === "digital" ? (
    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 6.2C10.3 4.7 8.2 4.2 5 4.2v13.6c3.2 0 5.3.5 7 2 1.7-1.5 3.8-2 7-2V4.2c-3.2 0-5.3.5-7 2Z"/><path d="M12 6.2v13.6"/></svg>
  ) : (
    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16.9 3.9a2.05 2.05 0 0 1 2.9 0l.3.3a2.05 2.05 0 0 1 0 2.9L8.2 19l-4.2 1.1L5.1 15.9Z"/><path d="m14.7 6.1 3.2 3.2"/></svg>
  )}
  {m.label}
</span>
