---
import { SLEEP_TIMER_PRESETS } from "../lib/family";

interface AudioBookItem {
  slug: string;
  title: string;
  coverUrl?: string | null;
  audiobook_key?: string;
}

interface Props {
  books: AudioBookItem[];
  defaultSleepMinutes?: number;
}

const { books = [], defaultSleepMinutes = 60 } = Astro.props;
const audioBooks = books.filter((b) => Boolean(b.audiobook_key));
---

<!-- Audio Engine & Persistent Bottom Mini-Player (no duplicate inline card) -->
<div id="audio-slot" class="sr-only" aria-hidden="true">
  {audioBooks.length > 0 && (
    <div>
      <select id="dock-book-select" tabindex="-1">
        {audioBooks.map((b, i) => (
          <option value={b.slug} data-cover={b.coverUrl || ""} selected={i === 0}>
            {b.title}
          </option>
        ))}
      </select>
      <img id="dock-cover-img" src={audioBooks[0]?.coverUrl || ""} alt="" />
      <span id="dock-book-title">{audioBooks[0]?.title}</span>
      <span id="dock-track-title">Introduction</span>
      <span id="dock-track-sub">Ready to play</span>
      <span id="dock-time-cur">0:00</span>
      <span id="dock-time-dur">0:00</span>
      <input id="dock-scrubber" type="range" min="0" max="100" value="0" step="0.1" />
      <button type="button" id="dock-prev-ch">Prev</button>
      <button type="button" id="dock-prev-15">-15s</button>
      <button type="button" id="dock-play-btn">▶</button>
      <button type="button" id="dock-next-15">+15s</button>
      <button type="button" id="dock-next-ch">Next</button>
      <select id="dock-sleep-select">
        {SLEEP_TIMER_PRESETS.map((p) => (
          <option value={String(p.minutes)} selected={p.minutes === defaultSleepMinutes}>
            {p.label}
          </option>
        ))}
        <option value="chapter">End of chapter</option>
        <option value="0">Off</option>
      </select>
      <button type="button" id="dock-sleep-add15">+15m</button>
      <select id="dock-speed-select">
        <option value="0.85">0.85×</option>
        <option value="0.95">0.95×</option>
        <option value="1" selected>1×</option>
        <option value="1.15">1.15×</option>
        <option value="1.25">1.25×</option>
      </select>
      <div id="dock-chapter-pills"></div>
      <span id="dock-sleep-status-pill">🌙 Sleep in <span id="dock-sleep-countdown">60:00</span></span>
      <audio id="dock-audio-el" preload="metadata"></audio>
    </div>
  )}
</div>

<!-- Persistent Bottom Bar when playing -->
<div
  id="cust-bottom-dock"
  class="fixed bottom-14 lg:bottom-0 right-0 left-0 lg:left-[248px] z-30 hidden border-t border-stone-200 bg-white/95 backdrop-blur-md px-4 py-2.5 shadow-lg"
>
  <div class="max-w-6xl mx-auto flex items-center justify-between gap-3">
    <div class="flex items-center gap-3 min-w-0">
      <button
        type="button"
        id="bottom-dock-play"
        class="cust-pressable w-9 h-9 rounded-full bg-orange-600 text-white font-extrabold text-xs flex items-center justify-center shrink-0 cursor-pointer"
        aria-label="Play or pause"
      >
        ▶
      </button>
      <div class="min-w-0">
        <p id="bottom-dock-title" class="text-xs font-extrabold text-stone-900 truncate">
          Audiobook Player
        </p>
        <p id="bottom-dock-sub" class="text-[11px] text-stone-500 truncate">
          Chapter 1 · Sleep timer active
        </p>
      </div>
    </div>
    <div class="flex items-center gap-3 shrink-0">
      <span id="bottom-dock-timer" class="rounded-full bg-orange-100 text-orange-800 px-2.5 py-0.5 text-[11px] font-bold">
        🌙 60:00
      </span>
      <a
        href="#shelf-stage"
        class="text-xs font-extrabold text-[#1a3454] hover:underline"
      >
        Reader ↑
      </a>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    function initAudioEngine() {
      var audioEl = document.getElementById("dock-audio-el");
      var bookSelect = document.getElementById("dock-book-select");
      var coverImg = document.getElementById("dock-cover-img");
      var bookTitleEl = document.getElementById("dock-book-title");
      var trackTitleEl = document.getElementById("dock-track-title");
      var trackSubEl = document.getElementById("dock-track-sub");
      var curEl = document.getElementById("dock-time-cur");
      var durEl = document.getElementById("dock-time-dur");
      var scrubber = document.getElementById("dock-scrubber");
      var playBtn = document.getElementById("dock-play-btn");
      var prevChBtn = document.getElementById("dock-prev-ch");
      var nextChBtn = document.getElementById("dock-next-ch");
      var prev15Btn = document.getElementById("dock-prev-15");
      var next15Btn = document.getElementById("dock-next-15");
      var sleepSelect = document.getElementById("dock-sleep-select");
      var sleepAdd15Btn = document.getElementById("dock-sleep-add15");
      var sleepCountdownEl = document.getElementById("dock-sleep-countdown");
      var stageSleepCountdownEl = document.getElementById("stage-sleep-countdown");
      var speedSelect = document.getElementById("dock-speed-select");
      var pillsWrap = document.getElementById("dock-chapter-pills");

      var bottomDock = document.getElementById("cust-bottom-dock");
      var bottomPlay = document.getElementById("bottom-dock-play");
      var bottomTitle = document.getElementById("bottom-dock-title");
      var bottomSub = document.getElementById("bottom-dock-sub");
      var bottomTimer = document.getElementById("bottom-dock-timer");

      if (!audioEl || !bookSelect) return;
      if (audioEl.dataset.boundEngine === "1") return;
      audioEl.dataset.boundEngine = "1";

      var state = {
        slug: bookSelect.value,
        tracks: [],
        trackIndex: 0,
        sleepRemainingSeconds: Number(sleepSelect ? sleepSelect.value : 60) * 60,
        sleepMode: "minutes",
        sleepInterval: null,
      };

      function fmtTime(sec) {
        if (!sec || !isFinite(sec) || sec < 0) return "0:00";
        var s = Math.floor(sec);
        var h = Math.floor(s / 3600);
        var m = Math.floor((s % 3600) / 60);
        var r = s % 60;
        if (h > 0) {
          return h + ":" + (m < 10 ? "0" : "") + m + ":" + (r < 10 ? "0" : "") + r;
        }
        return m + ":" + (r < 10 ? "0" : "") + r;
      }

      function updateSleepUI() {
        var label = "";
        if (state.sleepMode === "off") {
          label = "Off";
        } else if (state.sleepMode === "chapter") {
          label = "End of Ch";
        } else {
          label = fmtTime(state.sleepRemainingSeconds);
        }
        if (sleepCountdownEl) sleepCountdownEl.textContent = label;
        if (stageSleepCountdownEl) stageSleepCountdownEl.textContent = label;
        if (bottomTimer) bottomTimer.textContent = "🌙 " + label;
      }

      function resetSleepTimerFromSelect() {
        if (!sleepSelect) return;
        var val = sleepSelect.value;
        if (val === "0") {
          state.sleepMode = "off";
          state.sleepRemainingSeconds = 0;
        } else if (val === "chapter") {
          state.sleepMode = "chapter";
          state.sleepRemainingSeconds = 0;
        } else {
          state.sleepMode = "minutes";
          state.sleepRemainingSeconds = Math.max(60, Number(val || 60) * 60);
        }
        updateSleepUI();
      }

      function startSleepTicker() {
        if (state.sleepInterval) clearInterval(state.sleepInterval);
        state.sleepInterval = setInterval(function () {
          if (audioEl.paused) return;
          if (state.sleepMode === "minutes" && state.sleepRemainingSeconds > 0) {
            state.sleepRemainingSeconds -= 1;
            updateSleepUI();
            if (state.sleepRemainingSeconds <= 0) {
              audioEl.pause();
              if (trackSubEl) trackSubEl.textContent = "🌙 Bedtime sleep timer paused playback.";
            }
          }
        }, 1000);
      }

      function renderChapterPills() {
        if (!pillsWrap) return;
        if (!state.tracks.length) {
          pillsWrap.innerHTML = "";
          return;
        }
        pillsWrap.innerHTML = state.tracks
          .map(function (t, i) {
            return '<button type="button" data-track-idx="' + i + '">' + t.label + "</button>";
          })
          .join("");
      }

      function loadTrack(idx, autoPlay) {
        if (!state.tracks.length) return;
        var clamped = Math.max(0, Math.min(state.tracks.length - 1, idx));
        state.trackIndex = clamped;
        var tr = state.tracks[clamped];
        audioEl.src = tr.url;
        audioEl.playbackRate = Number(speedSelect ? speedSelect.value : 1) || 1;
        if (trackTitleEl) trackTitleEl.textContent = tr.label + (tr.title ? " — " + tr.title : "");
        if (trackSubEl) trackSubEl.textContent = "Synced with Story Reader";
        if (bottomTitle && bookTitleEl) bottomTitle.textContent = bookTitleEl.textContent || "Audiobook";
        if (bottomSub) bottomSub.textContent = tr.label;
        renderChapterPills();

        window.dispatchEvent(
          new CustomEvent("bbs:audio-chapter-active", {
            detail: {
              slug: state.slug,
              chapterNum: tr.num,
              trackIndex: clamped,
            },
          })
        );

        if (autoPlay) {
          audioEl.play().catch(function () {});
        }
      }

      function fetchTracksForBook(slug, autoPlay) {
        state.slug = slug;
        var opt = Array.from(bookSelect.options).find(function (o) {
          return o.value === slug;
        });
        if (opt) {
          if (bookTitleEl) bookTitleEl.textContent = opt.textContent || "";
          var cov = opt.getAttribute("data-cover");
          if (coverImg && cov) coverImg.src = cov;
        }

        fetch("/api/account/book-viewer?slug=" + encodeURIComponent(slug))
          .then(function (r) {
            return r.json();
          })
          .then(function (data) {
            if (data && data.ok && Array.isArray(data.audioTracks) && data.audioTracks.length) {
              state.tracks = data.audioTracks;
              loadTrack(0, Boolean(autoPlay));
            }
          })
          .catch(function () {});
      }

      function togglePlay() {
        if (!audioEl.src && state.tracks.length) {
          loadTrack(0, true);
          return;
        }
        if (audioEl.paused) {
          if (state.sleepMode === "minutes" && state.sleepRemainingSeconds <= 0) {
            resetSleepTimerFromSelect();
          }
          audioEl.play().catch(function () {});
        } else {
          audioEl.pause();
        }
      }

      if (playBtn) playBtn.addEventListener("click", togglePlay);
      if (bottomPlay) bottomPlay.addEventListener("click", togglePlay);

      audioEl.addEventListener("play", function () {
        if (playBtn) playBtn.textContent = "❚❚";
        if (bottomPlay) bottomPlay.textContent = "❚❚";
        if (bottomDock) bottomDock.classList.remove("hidden");
        startSleepTicker();
        var tr = state.tracks[state.trackIndex];
        window.dispatchEvent(
          new CustomEvent("bbs:audio-timeupdate", {
            detail: {
              slug: state.slug,
              chapterNum: tr ? tr.num : 0,
              chapterLabel: tr ? tr.label : "Audiobook",
              currentTime: audioEl.currentTime || 0,
              duration: audioEl.duration || 0,
              paused: false,
            },
          })
        );
      });

      audioEl.addEventListener("pause", function () {
        if (playBtn) playBtn.textContent = "▶";
        if (bottomPlay) bottomPlay.textContent = "▶";
        var tr = state.tracks[state.trackIndex];
        window.dispatchEvent(
          new CustomEvent("bbs:audio-timeupdate", {
            detail: {
              slug: state.slug,
              chapterNum: tr ? tr.num : 0,
              chapterLabel: tr ? tr.label : "Audiobook",
              currentTime: audioEl.currentTime || 0,
              duration: audioEl.duration || 0,
              paused: true,
            },
          })
        );
      });

      audioEl.addEventListener("timeupdate", function () {
        if (curEl) curEl.textContent = fmtTime(audioEl.currentTime);
        if (durEl) durEl.textContent = fmtTime(audioEl.duration);
        if (scrubber && audioEl.duration > 0) {
          scrubber.value = String((audioEl.currentTime / audioEl.duration) * 100);
        }
        var tr = state.tracks[state.trackIndex];
        window.dispatchEvent(
          new CustomEvent("bbs:audio-timeupdate", {
            detail: {
              slug: state.slug,
              chapterNum: tr ? tr.num : 0,
              chapterLabel: tr ? tr.label : "Audiobook",
              currentTime: audioEl.currentTime || 0,
              duration: audioEl.duration || 0,
              paused: audioEl.paused,
            },
          })
        );
      });

      audioEl.addEventListener("ended", function () {
        if (state.sleepMode === "chapter") {
          if (trackSubEl) trackSubEl.textContent = "🌙 Paused at end of chapter (Sleep Timer).";
          return;
        }
        if (state.trackIndex < state.tracks.length - 1) {
          loadTrack(state.trackIndex + 1, true);
        }
      });

      if (prev15Btn) {
        prev15Btn.addEventListener("click", function () {
          audioEl.currentTime = Math.max(0, (audioEl.currentTime || 0) - 15);
        });
      }
      if (next15Btn) {
        next15Btn.addEventListener("click", function () {
          audioEl.currentTime = Math.min(audioEl.duration || 0, (audioEl.currentTime || 0) + 15);
        });
      }
      if (prevChBtn) {
        prevChBtn.addEventListener("click", function () {
          loadTrack(state.trackIndex - 1, true);
        });
      }
      if (nextChBtn) {
        nextChBtn.addEventListener("click", function () {
          loadTrack(state.trackIndex + 1, true);
        });
      }

      if (sleepSelect) {
        sleepSelect.addEventListener("change", resetSleepTimerFromSelect);
      }
      if (sleepAdd15Btn) {
        sleepAdd15Btn.addEventListener("click", function () {
          state.sleepMode = "minutes";
          state.sleepRemainingSeconds += 15 * 60;
          updateSleepUI();
        });
      }
      if (speedSelect) {
        speedSelect.addEventListener("change", function () {
          audioEl.playbackRate = Number(speedSelect.value) || 1;
        });
      }

      window.addEventListener("bbs:book-viewer-loaded", function (ev) {
        var d = (ev && ev.detail) || {};
        if (d.slug === state.slug && Array.isArray(d.audioTracks) && d.audioTracks.length && !state.tracks.length) {
          state.tracks = d.audioTracks;
          loadTrack(0, false);
        }
      });

      window.addEventListener("bbs:viewer-chapter-select", function (ev) {
        var d = (ev && ev.detail) || {};
        if (!d.slug) return;
        var idx = state.tracks.findIndex(function (t) {
          return t.num === d.chapterNum;
        });
        if (idx >= 0 && idx !== state.trackIndex) {
          loadTrack(idx, !audioEl.paused);
        }
      });

      window.addEventListener("bbs:profile-change", function (ev) {
        var d = (ev && ev.detail) || {};
        if (d.sleepMinutes && sleepSelect) {
          sleepSelect.value = String(d.sleepMinutes);
          resetSleepTimerFromSelect();
        }
      });

      window.addEventListener("bbs:open-audiobook-in-dock", function (ev) {
        var d = (ev && ev.detail) || {};
        if (d.slug) {
          bookSelect.value = d.slug;
          fetchTracksForBook(d.slug, true);
        }
      });

      window.addEventListener("bbs:audio-play-chapter", function (ev) {
        var d = (ev && ev.detail) || {};
        if (!d.slug) return;
        if (d.slug !== state.slug) {
          bookSelect.value = d.slug;
          fetchTracksForBook(d.slug, true);
          return;
        }
        var idx = state.tracks.findIndex(function (t) {
          return t.num === d.chapterNum;
        });
        loadTrack(idx >= 0 ? idx : 0, Boolean(d.autoPlay));
      });

      window.addEventListener("bbs:readalong-toggle", function (ev) {
        var d = (ev && ev.detail) || {};
        var slug = d.slug || state.slug;
        if (slug && slug !== state.slug) {
          bookSelect.value = slug;
          fetchTracksForBook(slug, true);
          return;
        }
        var targetNum = typeof d.chapterNum === "number" ? d.chapterNum : 1;
        var idx = state.tracks.findIndex(function (t) {
          return t.num === targetNum;
        });
        if (idx >= 0 && idx !== state.trackIndex) {
          loadTrack(idx, true);
          return;
        }
        togglePlay();
      });

      resetSleepTimerFromSelect();
      fetchTracksForBook(state.slug, false);
    }

    initAudioEngine();
    document.addEventListener("astro:page-load", initAudioEngine);
  })();
</script>
