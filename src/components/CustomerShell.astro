---
import { KID_AVATARS, type KidProfileRecord } from "../lib/family";

interface Props {
  currentSection?: string;
  userEmail?: string;
  kidProfiles?: KidProfileRecord[];
  hasParentPin?: boolean;
  bookCount?: number;
  audioCount?: number;
}

const {
  currentSection = "shelf",
  userEmail = "",
  kidProfiles = [],
  hasParentPin = false,
  bookCount = 0,
  audioCount = 0,
} = Astro.props;

const NAV_GROUPS = [
  {
    label: "Reading & Listening",
    items: [
      { id: "shelf", href: "#shelf", label: "My Shelf", icon: "book", badge: bookCount > 0 ? String(bookCount) : null },
      { id: "qc-viewer", href: "#qc-viewer", label: "Book Viewer", icon: "viewer", badge: "QC" },
      { id: "audio-slot", href: "#audio-slot", label: "Audiobook Player", icon: "audio", badge: audioCount > 0 ? String(audioCount) : null },
    ],
  },
  {
    label: "Family & Profiles",
    items: [
      { id: "kids-family", href: "#kids-family", label: "Kids & Limits", icon: "characters", badge: kidProfiles.length > 0 ? String(kidProfiles.length) : null, parentOnly: true },
      { id: "referrals", href: "#referrals", label: "Refer a Friend", icon: "reviews", badge: "$10", parentOnly: true },
    ],
  },
  {
    label: "Account",
    items: [
      { id: "book-club", href: "#book-club", label: "Book Club", icon: "club", parentOnly: true },
      { id: "orders", href: "#orders", label: "Your Orders", icon: "orders", parentOnly: true },
      { id: "reviews", href: "#reviews", label: "My Reviews", icon: "reviews", parentOnly: true },
      { id: "store", href: "/", label: "Browse Storefront", icon: "store", external: true },
    ],
  },
];

const ICONS: Record<string, string> = {
  book: '<path d="M2 3.5h6A4 4 0 0 1 12 7.5v13a3 3 0 0 0-3-3H2z"/><path d="M22 3.5h-6a4 4 0 0 0-4 4v13a3 3 0 0 1 3-3h7z"/>',
  viewer: '<rect x="3" y="3" width="18" height="18" rx="2.5"/><path d="M9 3v18"/><path d="M13 8h5M13 12h5M13 16h3"/>',
  audio: '<path d="M3 18v-6a9 9 0 0 1 18 0v6"/><path d="M3 14h3.5v4H5a2 2 0 0 1-2-2v-2z"/><path d="M21 14h-3.5v4H19a2 2 0 0 0 2-2v-2z"/>',
  characters: '<circle cx="9" cy="8" r="3.5"/><path d="M2.8 20c.7-3.1 3.2-4.9 6.2-4.9s5.5 1.8 6.2 4.9"/><circle cx="17.3" cy="9" r="2.6"/><path d="M16.2 15.3c2.2.3 3.9 1.8 4.4 4.2"/>',
  orders: '<path d="M5.5 8h13l-1 12.5h-11z"/><path d="M9 10V6.5a3 3 0 0 1 6 0V10"/>',
  club: '<path d="M12 2.8 20 7v10l-8 4.2L4 17V7z"/><path d="M4.3 7.3 12 11l7.7-3.7"/><path d="M12 11v10"/>',
  reviews: '<path d="m12 3.2 2.7 5.6 6.1.8-4.5 4.2 1.1 6-5.4-2.9-5.4 2.9 1.1-6L3.2 9.6l6.1-.8z"/>',
  store: '<path d="M3.5 9.3 5.2 3.5h13.6l1.7 5.8"/><path d="M3.5 9.3a2.9 2.9 0 0 0 5.5.8 2.9 2.9 0 0 0 6 0 2.9 2.9 0 0 0 5.5-.8"/><path d="M5 12.6V20.5h14v-7.9"/><path d="M9.7 20.5v-5.4h4.6v5.4"/>',
  signout: '<path d="M9 20.5H5.5a2 2 0 0 1-2-2v-13a2 2 0 0 1 2-2H9"/><path d="m16 16.5 5-4.5-5-4.5"/><path d="M21 12H9.5"/>',
  panel: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M9.5 4v16"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  lock: '<rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>',
};

const icon = (name: string) =>
  `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.85" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${ICONS[name] || ""}</svg>`;

const avatarMap = new Map(KID_AVATARS.map((a) => [a.id, a]));
---

<script is:inline>
  (function () {
    var stored = null;
    try { stored = window.localStorage.getItem("bbs-customer-sidebar"); } catch (e) {}
    var state = stored === "collapsed" ? "collapsed" : "expanded";
    document.documentElement.setAttribute("data-cust-sidebar", state);
    document.documentElement.setAttribute("data-cust-mobile-nav", "closed");
  })();
</script>

<style is:global>
  .bbs-cust-sidebar {
    position: fixed;
    top: 0;
    bottom: 0;
    left: 0;
    z-index: 60;
    width: 16.5rem;
    height: 100dvh;
    background: #ffffff;
    border-right: 1px solid #e7e5e4;
    display: flex;
    flex-direction: column;
    padding-top: env(safe-area-inset-top, 0px);
    padding-bottom: env(safe-area-inset-bottom, 0px);
    transition: width 0.18s ease, transform 0.18s ease;
    -webkit-tap-highlight-color: transparent;
  }
  .bbs-cust-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 0.9rem;
    border-bottom: 1px solid #f0efed;
    min-height: 3.75rem;
  }
  .bbs-cust-wordmark {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    background: #1a3454;
    color: #fff;
    padding: 0.35rem 0.85rem;
    font-size: 0.95rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
  }
  .bbs-cust-wordmark .bbs-wm-orange { color: #fb923c; }
  .bbs-cust-mono {
    display: none;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 999px;
    background: #1a3454;
    color: #fff;
    font-weight: 800;
    font-size: 0.85rem;
    align-items: center;
    justify-content: center;
    text-decoration: none;
  }
  .bbs-cust-tag {
    font-size: 0.62rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: #ea580c;
    background: #fff7ed;
    border: 1px solid #fed7aa;
    padding: 0.15rem 0.45rem;
    border-radius: 999px;
    white-space: nowrap;
  }
  .bbs-cust-toggle, .bbs-cust-menu-btn {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 0.6rem;
    border: 1px solid transparent;
    background: transparent;
    color: #78716c;
    cursor: pointer;
    flex: none;
    touch-action: manipulation;
  }
  .bbs-cust-toggle:active, .bbs-cust-menu-btn:active {
    transform: scale(0.96);
  }
  @media (hover: hover) and (pointer: fine) {
    .bbs-cust-toggle:hover, .bbs-cust-menu-btn:hover {
      background: #f5f5f4;
      color: #1c1917;
    }
  }
  .bbs-cust-profile-box {
    margin: 0.65rem 0.7rem 0.25rem;
    padding: 0.6rem 0.65rem;
    border-radius: 0.85rem;
    background: #fafaf9;
    border: 1px solid #e7e5e4;
  }
  .bbs-cust-nav {
    flex: 1;
    overflow-y: auto;
    overflow-x: hidden;
    padding: 0.5rem 0.65rem 1rem;
    overscroll-behavior: contain;
  }
  .bbs-cust-group { margin-top: 1rem; }
  .bbs-cust-group:first-child { margin-top: 0.2rem; }
  .bbs-cust-group-label {
    margin: 0 0 0.35rem;
    padding: 0 0.55rem;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: #a8a29e;
    white-space: nowrap;
  }
  .bbs-cust-item {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.6rem 0.65rem;
    margin: 0.15rem 0;
    min-height: 2.75rem;
    border-radius: 0.65rem;
    color: #57534e;
    font-size: 0.92rem;
    font-weight: 550;
    text-decoration: none;
    white-space: nowrap;
    touch-action: manipulation;
    transition: background-color 0.12s ease, color 0.12s ease, transform 0.1s ease;
  }
  .bbs-cust-item:active {
    transform: scale(0.98);
  }
  .bbs-cust-item svg { flex: none; }
  @media (hover: hover) and (pointer: fine) {
    .bbs-cust-item:hover {
      background: #f5f5f4;
      color: #1c1917;
    }
  }
  .bbs-cust-item.bbs-cust-active {
    background: #fff7ed;
    color: #9a3412;
    font-weight: 700;
    box-shadow: inset 3px 0 0 #ea580c;
  }
  .bbs-cust-badge {
    margin-left: auto;
    background: #f5f5f4;
    color: #57534e;
    font-size: 0.68rem;
    font-weight: 700;
    line-height: 1;
    padding: 0.24rem 0.5rem;
    border-radius: 999px;
    font-variant-numeric: tabular-nums;
  }
  .bbs-cust-item.bbs-cust-active .bbs-cust-badge {
    background: #ffedd5;
    color: #9a3412;
  }
  .bbs-cust-foot {
    border-top: 1px solid #f0efed;
    padding: 0.65rem;
  }
  .bbs-cust-mobilebar { display: none; }
  .bbs-cust-backdrop { display: none; }

  /* Kid mode hides parent-only billing/order sections so kids ages 4-8 stay in a safe reading/listening space */
  html[data-kid-mode="active"] [data-parent-only="true"] {
    display: none !important;
  }

  @media (min-width: 1024px) {
    html[data-cust-sidebar] body {
      padding-left: 16.5rem;
      transition: padding-left 0.18s ease;
    }
    html[data-cust-sidebar="collapsed"] body {
      padding-left: 4.5rem;
    }
    html[data-cust-sidebar="collapsed"] .bbs-cust-sidebar {
      width: 4.5rem;
    }
    html[data-cust-sidebar="collapsed"] .bbs-cust-wordmark,
    html[data-cust-sidebar="collapsed"] .bbs-cust-tag,
    html[data-cust-sidebar="collapsed"] .bbs-cust-group-label,
    html[data-cust-sidebar="collapsed"] .bbs-cust-item-label,
    html[data-cust-sidebar="collapsed"] .bbs-cust-badge,
    html[data-cust-sidebar="collapsed"] .bbs-cust-profile-details {
      display: none;
    }
    html[data-cust-sidebar="collapsed"] .bbs-cust-mono {
      display: inline-flex;
    }
    html[data-cust-sidebar="collapsed"] .bbs-cust-item {
      justify-content: center;
      padding: 0.6rem 0;
    }
    html[data-cust-sidebar="collapsed"] .bbs-cust-head {
      justify-content: center;
      flex-direction: column;
      gap: 0.5rem;
      padding: 0.8rem 0.3rem;
    }
    html[data-cust-sidebar="collapsed"] .bbs-cust-toggle {
      margin-left: 0;
    }
  }

  @media (max-width: 1023.98px) {
    html[data-cust-sidebar] body {
      padding-top: calc(3.6rem + env(safe-area-inset-top, 0px));
    }
    .bbs-cust-sidebar {
      transform: translateX(-106%);
      width: 17.5rem;
      box-shadow: 0 12px 42px rgba(28, 25, 23, 0.22);
    }
    html[data-cust-mobile-nav="open"] .bbs-cust-sidebar {
      transform: none;
    }
    .bbs-cust-mobilebar {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 55;
      height: calc(3.6rem + env(safe-area-inset-top, 0px));
      padding: env(safe-area-inset-top, 0px) 0.9rem 0;
      background: rgba(255, 255, 255, 0.96);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid #e7e5e4;
    }
    html[data-cust-mobile-nav="open"] .bbs-cust-backdrop {
      display: block;
      position: fixed;
      inset: 0;
      z-index: 58;
      background: rgba(28, 25, 23, 0.38);
    }
  }
</style>

<div class="bbs-cust-mobilebar">
  <a class="bbs-cust-wordmark" href="/">big<span class="bbs-wm-orange">brain</span>shelf</a>
  <span class="bbs-cust-tag" id="mobile-active-mode-badge">Family Hub</span>
  <button class="bbs-cust-menu-btn" id="bbs-cust-menu-btn" type="button" aria-label="Open family navigation menu">
    <Fragment set:html={icon("menu")} />
  </button>
</div>
<div class="bbs-cust-backdrop" id="bbs-cust-backdrop"></div>

<aside class="bbs-cust-sidebar" aria-label="Family Hub Navigation">
  <div class="bbs-cust-head">
    <a class="bbs-cust-wordmark" href="/" aria-label="Big Brain Shelf home">big<span class="bbs-wm-orange">brain</span>shelf</a>
    <a class="bbs-cust-mono" href="/" aria-label="Big Brain Shelf home">B</a>
    <span class="bbs-cust-tag">Hub</span>
    <button class="bbs-cust-toggle" id="bbs-cust-side-toggle" type="button" aria-label="Collapse or expand sidebar">
      <Fragment set:html={icon("panel")} />
    </button>
  </div>

  {/* Active Reader / Kid Profile Switcher */}
  <div class="bbs-cust-profile-box" id="sidebar-profile-switcher" data-has-pin={hasParentPin ? "1" : "0"}>
    <div class="flex items-center gap-2.5">
      <span
        id="active-profile-avatar"
        class="w-9 h-9 rounded-full bg-amber-100 text-amber-900 font-extrabold text-base flex items-center justify-center shrink-0 border border-amber-300"
      >
        👨‍👩‍👧
      </span>
      <div class="bbs-cust-profile-details min-w-0 flex-1">
        <p class="text-[11px] font-bold uppercase tracking-wider text-stone-400">Who is reading?</p>
        <select
          id="active-profile-select"
          aria-label="Switch reader profile"
          class="mt-0.5 w-full bg-transparent text-xs font-bold text-stone-900 focus:outline-none cursor-pointer truncate"
        >
          <option value="parent">Parent View (All access)</option>
          {kidProfiles.map((kp) => {
            const av = avatarMap.get(kp.avatar_key);
            return (
              <option
                value={kp.id}
                data-name={kp.name}
                data-age-group={kp.age_group}
                data-emoji={av?.emoji || "🦊"}
                data-sleep={kp.default_sleep_timer_minutes}
                data-limit={kp.daily_limit_minutes}
                data-used={kp.daily_minutes_used}
              >
                {av?.emoji || "🦊"} {kp.name} (Ages {kp.age_group})
              </option>
            );
          })}
        </select>
      </div>
    </div>
    <div id="active-kid-limit-pill" class="bbs-cust-profile-details hidden mt-2 pt-2 border-t border-stone-200/80 flex items-center justify-between text-[11px] text-stone-600">
      <span id="active-kid-limit-text">Daily limit: 60m</span>
      <button type="button" id="exit-kid-mode-btn" class="font-bold text-orange-700 hover:underline">Parent PIN</button>
    </div>
  </div>

  <nav class="bbs-cust-nav" aria-label="Account sections">
    {NAV_GROUPS.map((group) => (
      <div class="bbs-cust-group" data-parent-only={group.label === "Family & Profiles" ? "true" : undefined}>
        <p class="bbs-cust-group-label">{group.label}</p>
        {group.items.map((item) => (
          <a
            class={`bbs-cust-item${item.id === currentSection ? " bbs-cust-active" : ""}`}
            href={item.href}
            data-nav-id={item.id}
            data-parent-only={item.parentOnly ? "true" : undefined}
            aria-label={item.label}
          >
            <Fragment set:html={icon(item.icon)} />
            <span class="bbs-cust-item-label">{item.label}</span>
            {item.badge && <span class="bbs-cust-badge">{item.badge}</span>}
          </a>
        ))}
      </div>
    ))}
  </nav>

  <div class="bbs-cust-foot">
    {userEmail && (
      <p class="bbs-cust-item-label px-2 pb-1.5 text-[11px] text-stone-400 truncate" title={userEmail}>
        {userEmail}
      </p>
    )}
    <button
      type="button"
      id="signout"
      class="bbs-cust-item w-full text-left cursor-pointer bg-transparent border-0"
      data-parent-only="true"
      aria-label="Sign out"
    >
      <Fragment set:html={icon("signout")} />
      <span class="bbs-cust-item-label">Sign out</span>
    </button>
  </div>
</aside>

{/* Parent PIN Gate Modal when switching out of Kid Mode */}
<div
  id="parent-pin-modal"
  class="hidden fixed inset-0 z-70 bg-stone-950/50 backdrop-blur-xs flex items-center justify-center p-4"
  role="dialog"
  aria-modal="true"
  aria-labelledby="parent-pin-title"
>
  <div class="w-full max-w-sm rounded-2xl bg-white border border-stone-200 p-6 shadow-xl">
    <h3 id="parent-pin-title" class="text-lg font-extrabold text-stone-900">Enter Parent PIN</h3>
    <p class="text-xs text-stone-500 mt-1">Enter your 4-digit Parent PIN to switch back to Parent View and manage limits.</p>
    <form id="parent-pin-form" class="mt-4">
      <input
        type="password"
        id="parent-pin-input"
        inputmode="numeric"
        pattern="[0-9]*"
        maxlength="6"
        placeholder="••••"
        class="w-full text-center text-2xl tracking-[0.4em] font-extrabold rounded-xl border border-stone-300 px-4 py-3 focus:border-orange-600 focus:outline-none"
      />
      <p id="parent-pin-error" class="text-xs text-red-600 mt-2 hidden"></p>
      <div class="mt-4 flex items-center justify-end gap-2">
        <button type="button" id="parent-pin-cancel" class="rounded-full border border-stone-300 px-4 py-2 text-xs font-semibold text-stone-700">
          Stay in Kid View
        </button>
        <button type="submit" class="rounded-full bg-[#1a3454] text-white px-5 py-2 text-xs font-bold hover:bg-[#132741]">
          Unlock Parent View
        </button>
      </div>
    </form>
  </div>
</div>

<script is:inline>
  (function () {
    var root = document.documentElement;
    var toggle = document.getElementById("bbs-cust-side-toggle");
    if (toggle && !toggle.__bound) {
      toggle.__bound = true;
      toggle.addEventListener("click", function () {
        var next = root.getAttribute("data-cust-sidebar") === "collapsed" ? "expanded" : "collapsed";
        root.setAttribute("data-cust-sidebar", next);
        try { window.localStorage.setItem("bbs-customer-sidebar", next); } catch (e) {}
      });
    }
    var menuBtn = document.getElementById("bbs-cust-menu-btn");
    if (menuBtn && !menuBtn.__bound) {
      menuBtn.__bound = true;
      menuBtn.addEventListener("click", function () {
        root.setAttribute(
          "data-cust-mobile-nav",
          root.getAttribute("data-cust-mobile-nav") === "open" ? "closed" : "open"
        );
      });
    }
    var backdrop = document.getElementById("bbs-cust-backdrop");
    if (backdrop && !backdrop.__bound) {
      backdrop.__bound = true;
      backdrop.addEventListener("click", function () {
        root.setAttribute("data-cust-mobile-nav", "closed");
      });
    }
    document.querySelectorAll(".bbs-cust-sidebar .bbs-cust-item").forEach(function (el) {
      el.addEventListener("click", function () {
        root.setAttribute("data-cust-mobile-nav", "closed");
        var navId = el.getAttribute("data-nav-id");
        if (navId && navId !== "store") {
          document.querySelectorAll(".bbs-cust-sidebar .bbs-cust-item").forEach(function (item) {
            item.classList.toggle("bbs-cust-active", item.getAttribute("data-nav-id") === navId);
          });
        }
      });
    });
  })();
</script>
