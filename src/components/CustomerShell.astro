---
// CustomerShell: the account-area chrome (DESIGN.md, 2026-10-31).
//
// The store top bar never leaves: SiteHeader (logo, search, cart,
// account menu) renders on every account page, with the cart sheet so
// buying works without leaving /account. Under it, one slim bar holds
// the family switcher (who is reading) and the section links. There is
// no sidebar. On phones a bottom tab bar carries the main sections.
//
// Kid View is a body state: [data-parent-only] elements hide while a
// kid profile is active, and leaving Kid View can require the parent
// PIN. The switcher contract (select id, option data attributes, the
// bbs:profile-change event) is stable: the shelf and reader listen.
import { KID_AVATARS, type KidProfile } from "../lib/family";
import SiteHeader from "./SiteHeader.astro";
import CartSheet from "./CartSheet.astro";

interface Props {
  currentSection?: string;
  userEmail: string;
  username?: string | null;
  displayName?: string | null;
  isAdmin?: boolean;
  kidProfiles?: KidProfile[];
  hasParentPin?: boolean;
  bookCount?: number;
  audioCount?: number;
  onboardingComplete?: boolean;
}

const {
  currentSection = "shelf",
  kidProfiles = [],
  hasParentPin = false,
  bookCount = 0,
  onboardingComplete = false,
} = Astro.props;

const avatarEmojiMap = new Map(KID_AVATARS.map((a) => [a.key, a.emoji]));

interface NavItem {
  id: string;
  href: string;
  label: string;
  icon: string;
  badge?: string;
  parentOnly?: boolean;
}

const NAV_ITEMS: NavItem[] = [
  { id: "shelf", href: "/account", label: "My Shelf", icon: "shelf", badge: bookCount > 0 ? String(bookCount) : undefined },
  { id: "club", href: "/account/club", label: "Clubs", icon: "club", parentOnly: true },
  { id: "orders", href: "/account/orders", label: "Orders", icon: "orders", parentOnly: true },
  { id: "reviews", href: "/account/reviews", label: "Reviews", icon: "star", parentOnly: true },
  { id: "kids", href: "/account/kids", label: "Kids & Limits", icon: "kids", parentOnly: true },
  { id: "onboarding", href: "/account/onboarding", label: "Family Setup", icon: "sparkles", badge: onboardingComplete ? undefined : "1 min", parentOnly: true },
  { id: "referrals", href: "/account/referrals", label: "Give $10, Get $10", icon: "gift", parentOnly: true },
  { id: "settings", href: "/account/settings", label: "Settings", icon: "shield", parentOnly: true },
];

const ICONS: Record<string, string> = {
  shelf: `<path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/><path d="M9 7h6"/><path d="M9 11h4"/>`,
  kids: `<circle cx="9" cy="7" r="3"/><circle cx="17" cy="9" r="2.5"/><path d="M3 20v-1.5A4.5 4.5 0 0 1 7.5 14h3A4.5 4.5 0 0 1 15 18.5V20"/><path d="M15 14.5h2.5A3.5 3.5 0 0 1 21 18v2"/>`,
  sparkles: `<path d="M12 3l1.9 5.8a2 2 0 0 0 1.3 1.3L21 12l-5.8 1.9a2 2 0 0 0-1.3 1.3L12 21l-1.9-5.8a2 2 0 0 0-1.3-1.3L3 12l5.8-1.9a2 2 0 0 0 1.3-1.3L12 3z"/>`,
  gift: `<polyline points="20 12 20 22 4 22 4 12"/><rect x="2" y="7" width="20" height="5"/><line x1="12" y1="22" x2="12" y2="7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/>`,
  club: `<path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/>`,
  orders: `<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 8h10"/><path d="M7 12h6"/><path d="M7 16h4"/>`,
  star: `<polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>`,
  shield: `<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/>`,
};
---

<style is:global>
  :root {
    --cust-ease-out: cubic-bezier(0.23, 1, 0.32, 1);
  }
  html {
    -webkit-tap-highlight-color: transparent;
    -webkit-text-size-adjust: 100%;
  }
  button,
  a,
  [role="button"] {
    touch-action: manipulation;
    user-select: none;
    -webkit-user-select: none;
  }
  @media (pointer: coarse) {
    input,
    textarea,
    select {
      font-size: 16px;
    }
  }
  @media (max-width: 1023px) {
    body {
      padding-bottom: calc(4.75rem + env(safe-area-inset-bottom, 0px)) !important;
    }
  }
  body[data-kid-mode="true"] [data-parent-only="true"] {
    display: none !important;
  }
  .cust-pressable {
    transition:
      transform 140ms var(--cust-ease-out),
      background-color 150ms var(--cust-ease-out),
      border-color 150ms var(--cust-ease-out),
      color 150ms var(--cust-ease-out);
  }
  .cust-pressable:active {
    transform: scale(0.97);
  }
  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>

<style>
  .cust-bar {
    background: #fcfaf6;
    border-bottom: 1px solid #ece6dc;
    font-family:
      "Plus Jakarta Sans",
      -apple-system,
      BlinkMacSystemFont,
      sans-serif;
  }
  .cust-bar-in {
    max-width: 80rem;
    margin: 0 auto;
    padding: 0.5rem 1rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  @media (min-width: 640px) {
    .cust-bar-in {
      padding-left: 1.5rem;
      padding-right: 1.5rem;
    }
  }
  .cust-switcher {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }
  .cust-switcher select {
    font-size: 0.8125rem;
    font-weight: 700;
    color: #1c1917;
    background: #fff;
    border: 1px solid #e7e0d3;
    border-radius: 9999px;
    padding: 0.42rem 0.7rem;
    cursor: pointer;
    max-width: 13.5rem;
  }
  .cust-mode-pill {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #9a3412;
    background: #ffedd5;
    padding: 0.18rem 0.5rem;
    border-radius: 9999px;
    white-space: nowrap;
  }
  .cust-nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin-left: auto;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .cust-nav::-webkit-scrollbar {
    display: none;
  }
  .cust-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.83rem;
    font-weight: 600;
    color: #57534e;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color 150ms var(--cust-ease-out),
      color 150ms var(--cust-ease-out),
      transform 120ms var(--cust-ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .cust-chip:hover {
      background: #f3ede2;
      color: #1c1917;
    }
  }
  .cust-chip:active {
    transform: scale(0.97);
  }
  .cust-chip[aria-current="page"] {
    background: #ffedd5;
    color: #9a3412;
    font-weight: 800;
  }
  .cust-ico {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
    stroke: currentColor;
    fill: none;
    stroke-width: 1.9;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.85;
  }
  .cust-chip[aria-current="page"] .cust-ico {
    opacity: 1;
    stroke: #ea580c;
  }
  .cust-badge {
    font-size: 0.66rem;
    font-weight: 800;
    padding: 0.08rem 0.42rem;
    border-radius: 9999px;
    background: #f5f0e6;
    color: #57534e;
  }
  .cust-chip[aria-current="page"] .cust-badge {
    background: #fed7aa;
    color: #9a3412;
  }

  /* Mobile bottom navigation bar for native app feel */
  .cust-bottom-tabs {
    display: none;
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 36;
    background: rgba(252, 250, 246, 0.96);
    backdrop-filter: blur(12px);
    border-top: 1px solid #ece6dc;
    padding: 0.35rem 0.5rem calc(0.35rem + env(safe-area-inset-bottom, 0px));
    justify-content: space-around;
    align-items: center;
    font-family:
      "Plus Jakarta Sans",
      -apple-system,
      BlinkMacSystemFont,
      sans-serif;
  }
  .cust-tab-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.18rem;
    padding: 0.3rem 0.65rem;
    border-radius: 0.65rem;
    text-decoration: none;
    color: #78716c;
    font-size: 0.68rem;
    font-weight: 700;
    min-width: 3.8rem;
    transition:
      color 140ms var(--cust-ease-out),
      transform 120ms var(--cust-ease-out);
  }
  .cust-tab-item:active {
    transform: scale(0.95);
  }
  .cust-tab-item[aria-current="page"] {
    color: #ea580c;
    font-weight: 800;
  }
  @media (max-width: 1023px) {
    .cust-bottom-tabs {
      display: flex;
    }
  }
</style>

<SiteHeader search cartMode="sheet" />
<CartSheet />

<div class="cust-bar" data-has-pin={hasParentPin ? "true" : "false"} id="cust-bar">
  <div class="cust-bar-in">
    <div class="cust-switcher">
      <select
        id="cust-profile-switcher"
        aria-label="Switch between Parent View and Child Profiles"
      >
        <option value="parent">👩‍👧 Parent View (All pages)</option>
        {kidProfiles.map((kid) => {
          const emoji = avatarEmojiMap.get(kid.avatar_key) || "🦊";
          return (
            <option
              value={kid.id}
              data-kid-name={kid.name}
              data-sleep-minutes={kid.default_sleep_timer_minutes}
              data-daily-limit={kid.daily_limit_minutes}
            >
              {emoji} {kid.name} ({kid.age_group} · {kid.default_sleep_timer_minutes}m timer)
            </option>
          );
        })}
      </select>
      <span id="cust-mode-pill" class="cust-mode-pill">Parent View</span>
      {kidProfiles.length === 0 && (
        <a
          href="/account/onboarding"
          data-parent-only="true"
          class="hidden sm:inline-block text-[11px] font-bold text-orange-700 hover:underline whitespace-nowrap"
        >
          + Add a child profile
        </a>
      )}
    </div>

    <nav class="cust-nav" aria-label="Account sections">
      {NAV_ITEMS.map((item) => (
        <a
          href={item.href}
          data-nav-id={item.id}
          data-parent-only={item.parentOnly ? "true" : undefined}
          aria-current={currentSection === item.id ? "page" : undefined}
          class="cust-chip cust-pressable"
        >
          <svg class="cust-ico" viewBox="0 0 24 24" set:html={ICONS[item.icon] || ICONS.shelf} />
          <span>{item.label}</span>
          {item.badge && <span class="cust-badge">{item.badge}</span>}
        </a>
      ))}
    </nav>
  </div>
</div>

<!-- Mobile Bottom Tab Bar -->
<nav class="cust-bottom-tabs" aria-label="Quick navigation">
  <a
    href="/account"
    aria-current={currentSection === "shelf" ? "page" : undefined}
    class="cust-tab-item"
  >
    <svg class="cust-ico" viewBox="0 0 24 24" set:html={ICONS.shelf} />
    <span>My Shelf</span>
  </a>
  <a
    href="/account/kids"
    data-parent-only="true"
    aria-current={currentSection === "kids" || currentSection === "onboarding" ? "page" : undefined}
    class="cust-tab-item"
  >
    <svg class="cust-ico" viewBox="0 0 24 24" set:html={ICONS.kids} />
    <span>Kids</span>
  </a>
  <a
    href="/account/club"
    data-parent-only="true"
    aria-current={currentSection === "club" ? "page" : undefined}
    class="cust-tab-item"
  >
    <svg class="cust-ico" viewBox="0 0 24 24" set:html={ICONS.club} />
    <span>Club</span>
  </a>
  <a
    href="/account/orders"
    data-parent-only="true"
    aria-current={currentSection === "orders" ? "page" : undefined}
    class="cust-tab-item"
  >
    <svg class="cust-ico" viewBox="0 0 24 24" set:html={ICONS.orders} />
    <span>Orders</span>
  </a>
  <a
    href="/account/settings"
    data-parent-only="true"
    aria-current={currentSection === "settings" || currentSection === "referrals" || currentSection === "reviews" ? "page" : undefined}
    class="cust-tab-item"
  >
    <svg class="cust-ico" viewBox="0 0 24 24" set:html={ICONS.shield} />
    <span>Account</span>
  </a>
</nav>

<!-- Parent PIN Modal for exiting Kid View -->
<div
  id="cust-pin-modal"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-stone-950/60 p-4"
  role="dialog"
  aria-modal="true"
  aria-labelledby="cust-pin-title"
>
  <div class="w-full max-w-sm rounded-2xl bg-white p-6 shadow-xl border border-stone-200">
    <h3 id="cust-pin-title" class="text-lg font-extrabold text-stone-900">Enter Parent PIN</h3>
    <p class="mt-1 text-xs text-stone-600">
      Enter your 4-digit parent PIN to leave Kid View and open parent settings.
    </p>
    <form id="cust-pin-form" class="mt-4 space-y-3">
      <input
        type="password"
        id="cust-pin-input"
        inputmode="numeric"
        maxlength="8"
        placeholder="••••"
        class="w-full rounded-xl border border-stone-300 px-3.5 py-2.5 text-center text-lg font-extrabold tracking-widest focus:border-orange-500 focus:outline-none"
      />
      <p id="cust-pin-error" class="hidden text-xs font-semibold text-red-600"></p>
      <div class="flex items-center justify-end gap-2 pt-1">
        <button
          type="button"
          id="cust-pin-cancel"
          class="rounded-full border border-stone-300 px-4 py-2 text-xs font-bold text-stone-700 hover:border-stone-500"
        >
          Stay in Kid View
        </button>
        <button
          type="submit"
          class="rounded-full bg-[#1a3454] px-4 py-2 text-xs font-bold text-white hover:bg-[#132741]"
        >
          Unlock Parent View
        </button>
      </div>
    </form>
  </div>
</div>

<script is:inline>
  (function () {
    function initCustomerShell() {
      var bar = document.getElementById("cust-bar");
      var switcher = document.getElementById("cust-profile-switcher");
      var modePill = document.getElementById("cust-mode-pill");
      var pinModal = document.getElementById("cust-pin-modal");
      var pinForm = document.getElementById("cust-pin-form");
      var pinInput = document.getElementById("cust-pin-input");
      var pinError = document.getElementById("cust-pin-error");
      var pinCancel = document.getElementById("cust-pin-cancel");

      var STORAGE_KEY = "bbs.activeProfileId";
      var currentProfile = localStorage.getItem(STORAGE_KEY) || "parent";

      function applyProfileMode(profileId) {
        var isKid = profileId && profileId !== "parent";
        document.body.setAttribute("data-kid-mode", isKid ? "true" : "false");
        document.body.setAttribute("data-active-kid-id", isKid ? profileId : "");
        if (modePill) {
          modePill.textContent = isKid ? "Kid View" : "Parent View";
        }
        if (switcher && switcher.value !== profileId) {
          var exists = Array.from(switcher.options).some(function (o) {
            return o.value === profileId;
          });
          switcher.value = exists ? profileId : "parent";
        }
        var selectedOpt = switcher && switcher.selectedOptions ? switcher.selectedOptions[0] : null;
        var sleepMins = selectedOpt ? Number(selectedOpt.getAttribute("data-sleep-minutes") || "60") : 60;
        var kidName = selectedOpt ? selectedOpt.getAttribute("data-kid-name") || "" : "";

        // If user switches to Kid View while on a parent-only page, take them to My Shelf (/account)
        if (isKid && window.location.pathname !== "/account" && window.location.pathname !== "/account/") {
          window.location.href = "/account";
          return;
        }

        window.dispatchEvent(
          new CustomEvent("bbs:profile-change", {
            detail: {
              profileId: isKid ? profileId : null,
              isKid: Boolean(isKid),
              kidName: kidName,
              sleepMinutes: sleepMins,
            },
          })
        );
      }

      if (switcher) {
        var validOption = Array.from(switcher.options).some(function (o) {
          return o.value === currentProfile;
        });
        if (!validOption) currentProfile = "parent";
        applyProfileMode(currentProfile);

        if (!switcher.dataset.bound) {
          switcher.dataset.bound = "1";
          switcher.addEventListener("change", function () {
            var nextVal = switcher.value;
            var wasKid = currentProfile && currentProfile !== "parent";
            var hasPin = bar && bar.getAttribute("data-has-pin") === "true";

            if (wasKid && nextVal === "parent" && hasPin && pinModal) {
              switcher.value = currentProfile;
              pinModal.classList.remove("hidden");
              pinModal.classList.add("flex");
              if (pinError) pinError.classList.add("hidden");
              if (pinInput) {
                pinInput.value = "";
                pinInput.focus();
              }
              return;
            }

            currentProfile = nextVal;
            localStorage.setItem(STORAGE_KEY, currentProfile);
            applyProfileMode(currentProfile);
          });
        }
      }

      if (pinCancel && pinModal && !pinCancel.dataset.bound) {
        pinCancel.dataset.bound = "1";
        pinCancel.addEventListener("click", function () {
          pinModal.classList.add("hidden");
          pinModal.classList.remove("flex");
        });
      }

      if (pinForm && pinModal && !pinForm.dataset.bound) {
        pinForm.dataset.bound = "1";
        pinForm.addEventListener("submit", function (ev) {
          ev.preventDefault();
          var pin = pinInput ? pinInput.value.trim() : "";
          fetch("/api/account/family", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ action: "verify_pin", pin: pin }),
          })
            .then(function (r) {
              return r.json();
            })
            .then(function (data) {
              if (data && data.ok) {
                currentProfile = "parent";
                localStorage.setItem(STORAGE_KEY, "parent");
                if (switcher) switcher.value = "parent";
                applyProfileMode("parent");
                pinModal.classList.add("hidden");
                pinModal.classList.remove("flex");
              } else if (pinError) {
                pinError.textContent = "Incorrect PIN. Try again.";
                pinError.classList.remove("hidden");
              }
            })
            .catch(function () {
              if (pinError) {
                pinError.textContent = "Could not verify PIN right now.";
                pinError.classList.remove("hidden");
              }
            });
        });
      }
    }

    initCustomerShell();
    document.addEventListener("astro:page-load", initCustomerShell);
  })();
</script>
