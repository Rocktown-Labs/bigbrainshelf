---
import { catalogLeadDisplayName } from "../lib/catalog";

// Central social / OpenGraph / Twitter metadata for public pages.
//
// Pages keep owning their own <title> and search meta description; this
// component adds everything social crawlers need on top of them:
// canonical URL, OpenGraph tags, Twitter card tags, and optional
// JSON-LD. Social descriptions are kept to ~125 characters (social
// previews truncate around there) even when the search description on
// the page runs longer: callers pass a short socialDescription, or the
// shelf-wide default below is used.
interface Props {
  title?: string;
  socialDescription?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  type?: string;
  jsonLd?: Record<string, unknown>;
}

const SITE = "https://bigbrainshelf.com";
const SITE_NAME = "Big Brain Shelf";
const DEFAULT_TITLE = "Big Brain Shelf · Big ideas for little brains";
const DEFAULT_SOCIAL =
  "Story + coloring books that teach big ideas to little readers. Watch, practice, keep going.";
const DEFAULT_IMAGE = `${SITE}/og-image.jpg`;
const DEFAULT_IMAGE_ALT = `Big Brain Shelf book covers, including ${catalogLeadDisplayName("mira-the-heron-and-the-still-water")}, ${catalogLeadDisplayName("algorithms")} and ${catalogLeadDisplayName("docker")}`;

const {
  title = DEFAULT_TITLE,
  socialDescription,
  image = DEFAULT_IMAGE,
  imageAlt = DEFAULT_IMAGE_ALT,
  imageWidth,
  imageHeight,
  type = "website",
  jsonLd,
} = Astro.props;

// Trim an over-long social description at a word boundary so previews
// never cut mid-word.
function socialCut(text?: string): string {
  const t = String(text || "").trim();
  if (!t) return DEFAULT_SOCIAL;
  if (t.length <= 125) return t;
  const cut = t.slice(0, 122);
  const sp = cut.lastIndexOf(" ");
  return (sp > 60 ? cut.slice(0, sp) : cut).trim();
}

const social = socialCut(socialDescription);
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE).href;
const isDefaultImage = image === DEFAULT_IMAGE;
const width = imageWidth ?? (isDefaultImage ? 1200 : undefined);
const height = imageHeight ?? (isDefaultImage ? 630 : undefined);
---

<link rel="preconnect" href="https://media.bigbrainshelf.com" crossorigin />
<link rel="canonical" href={canonical} />
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:title" content={title} />
<meta property="og:description" content={social} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
{width && <meta property="og:image:width" content={String(width)} />}
{height && <meta property="og:image:height" content={String(height)} />}
<meta property="og:image:alt" content={imageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={social} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={imageAlt} />
{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
