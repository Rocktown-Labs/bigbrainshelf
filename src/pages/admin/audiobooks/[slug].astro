---
import "../../../styles/global.css";
import { ClientRouter } from "astro:transitions";
import { env } from "cloudflare:workers";
import AdminShell from "../../../components/AdminShell.astro";
import { inspectAudiobook, formatClock } from "../../../lib/audiobooks";
import { publicSlugFor } from "../../../lib/public-slugs";

export const prerender = false;
if (!Astro.locals.user) {
  return Astro.redirect("/admin/login");
}

// Audiobook player for one book. Tracks are whatever R2 actually holds
// (inspectAudiobook): the introduction, the chapter MP3s, and the
// closing first class, the full-book MP3 as a one-file mode, and the
// chaptered M4B as a download (it is the file with embedded chapter
// markers, but AAC in an MP4 wrapper does not play in every browser,
// so it is not a playback source).
const e = env as any;
const slug = String(Astro.params.slug || "");
const book = (await e.DB.prepare(
  "SELECT slug, public_slug, title, status, cover_key, audiobook_key FROM books WHERE slug = ?"
).bind(slug).first()) as any;

const R2 = "https://media.bigbrainshelf.com/";
let info = null;
if (book?.audiobook_key) info = await inspectAudiobook(e, book);
const totalSecs = info ? info.tracks.reduce((s, c) => s + (c.duration || 0), 0) : 0;
const playerData = info
  ? {
      slug: book.slug,
      full: info.full,
      chapters: info.chapters,
      tracks: info.tracks,
      m4bUrl: info.m4b ? `/api/admin/audiobook/${book.slug}/m4b` : null,
    }
  : null;
const mb = (n: number) => (n / 1048576).toFixed(1) + " MB";
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{book ? `${book.title} · Audiobook` : "Audiobook"} · Big Brain Shelf Admin</title>
  <ClientRouter />
</head>
<body class="bg-stone-50 text-stone-900 antialiased">
  <AdminShell current="/admin/audiobooks" />

  <main class="mx-auto max-w-4xl px-4 py-8">
    <p class="text-sm"><a href="/admin/audiobooks" class="text-orange-700 font-semibold">← All audiobooks</a></p>
    {book && (
      <p class="text-sm mt-1.5"><a href={`/admin/books/${publicSlugFor(book)}/review`} class="text-orange-700 font-semibold">Story Review: listen while you scroll the pages →</a></p>
    )}

    {!book && (
      <p class="mt-6 text-sm text-stone-500">That book was not found.</p>
    )}

    {book && !info && (
      <>
        <h1 class="mt-3 text-2xl font-bold tracking-tight">{book.title}</h1>
        <p class="mt-2 text-sm text-stone-500">No audiobook yet for this book. When its audiobook is generated and the key is set, the player appears here.</p>
      </>
    )}

    {book && info && (
      <>
        <div class="mt-3 flex items-start gap-4">
          {book.cover_key
            ? <img src={R2 + book.cover_key} alt="" class="w-[74px] h-[98px] object-cover rounded-md border border-stone-200 shrink-0" />
            : <div class="w-[74px] h-[98px] rounded-md bg-stone-100 border border-stone-200 shrink-0"></div>}
          <div class="min-w-0">
            <h1 class="text-2xl font-bold tracking-tight leading-snug">{book.title}</h1>
            <p class="text-sm text-stone-500 mt-1">
              {info.chapters.length} chapter{info.chapters.length === 1 ? "" : "s"}
              {totalSecs > 0 && <> · about {formatClock(totalSecs)} of listening</>}
            </p>
          </div>
        </div>

        <div class="mt-6 rounded-lg bg-white border border-stone-200 px-4 py-4">
          <div class="flex items-baseline gap-3">
            <span class="text-sm font-semibold" id="now-playing">Pick a chapter to start</span>
            <span class="text-sm text-red-600" id="player-status"></span>
          </div>

          

          <div class="mt-4 flex items-center gap-3">
            <button id="prev-btn" class="rounded-full border border-stone-300 bg-white h-11 w-11 grid place-items-center hover:border-stone-500 disabled:opacity-40" aria-label="Previous chapter">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6 5h2.5v14H6zM19 5v14L9.5 12z"/></svg>
            </button>
            <button id="play-btn" class="rounded-full bg-orange-600 text-white h-14 w-14 grid place-items-center hover:bg-orange-700 shrink-0" aria-label="Play or pause">
              <svg id="icon-play" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
              <svg id="icon-pause" class="hidden" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.5 5h4v14h-4zM13.5 5h4v14h-4z"/></svg>
            </button>
            <button id="next-btn" class="rounded-full border border-stone-300 bg-white h-11 w-11 grid place-items-center hover:border-stone-500 disabled:opacity-40" aria-label="Next chapter">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M15.5 5H18v14h-2.5zM5 5v14l9.5-7z"/></svg>
            </button>
            <span class="text-sm tabular-nums text-stone-600 ml-1"><span id="time-elapsed">0:00</span> / <span id="time-total">0:00</span></span>
            <label class="ml-auto inline-flex items-center gap-2 text-sm text-stone-600">
              Speed
              <select id="speed" class="rounded-lg border border-stone-300 px-2 py-1.5 text-sm">
                <option value="0.75">0.75x</option>
                <option value="1" selected>1x</option>
                <option value="1.25">1.25x</option>
                <option value="1.5">1.5x</option>
                <option value="2">2x</option>
              </select>
            </label>
          </div>

          <input id="seek" type="range" min="0" max="1000" value="0" step="1" class="mt-3 w-full accent-orange-600" aria-label="Seek" />

          <div class="mt-4 flex flex-wrap gap-2" role="group" aria-label="Listening mode">
            <button id="mode-chapters" class="rounded-full bg-[#1a3454] text-white px-4 py-2 text-sm font-semibold">Chapters</button>
            {info.full && (
              <button id="mode-full" class="rounded-full bg-white text-stone-700 border border-stone-300 hover:border-stone-500 px-4 py-2 text-sm font-semibold">Full book</button>
            )}
          </div>
        </div>

        <ol id="track-list" class="mt-4 divide-y divide-stone-200 rounded-lg bg-white border border-stone-200 overflow-hidden"></ol>

        {info.m4b && (
          <div class="mt-6 rounded-lg bg-white border border-stone-200 px-4 py-4">
            <h2 class="text-sm font-semibold">The chaptered audiobook file</h2>
            <p class="mt-1 text-sm text-stone-500">The M4B is the master file buyers receive: one file with chapter markers, the introduction, and the closing. The track list above plays the same book as MP3s, introduction and closing included. It does not play in every browser, so it is a download, not a player source.</p>
            <p class="mt-3">
              <a href={playerData.m4bUrl} download class="inline-block rounded-full bg-white text-stone-800 border border-stone-300 hover:border-stone-500 text-sm font-semibold px-5 py-2">Download the M4B ({mb(info.m4b.size)})</a>
            </p>
          </div>
        )}
      </>
    )}
  </main>

  {playerData && (
    <script is:inline define:vars={{ playerData }}>
      var audio = window.BBSPlayer.audio;
      if (window.BBSPlayer) window.BBSPlayer.host({ slug: playerData.slug, title: playerData.title || document.title, cover: playerData.cover || "", bookUrl: window.location.pathname });
      var playBtn = document.getElementById("play-btn");
      var iconPlay = document.getElementById("icon-play");
      var iconPause = document.getElementById("icon-pause");
      var prevBtn = document.getElementById("prev-btn");
      var nextBtn = document.getElementById("next-btn");
      var seek = document.getElementById("seek");
      var elapsedEl = document.getElementById("time-elapsed");
      var totalEl = document.getElementById("time-total");
      var nowPlaying = document.getElementById("now-playing");
      var statusEl = document.getElementById("player-status");
      var listEl = document.getElementById("track-list");
      var speedSel = document.getElementById("speed");
      var modeChBtn = document.getElementById("mode-chapters");
      var modeFullBtn = document.getElementById("mode-full");

      var mode = "chapters"; // or "full"
      var index = -1;
      var seeking = false;

      function playlist() {
        return mode === "full" && playerData.full ? [playerData.full] : playerData.tracks;
      }
      function fmt(s) {
        if (s == null || !isFinite(s) || s < 0) return "0:00";
        s = Math.round(s);
        var h = Math.floor(s / 3600), m = Math.floor((s % 3600) / 60), r = s % 60;
        var mm = h > 0 ? String(m).padStart(2, "0") : String(m);
        return (h > 0 ? h + ":" : "") + mm + ":" + String(r).padStart(2, "0");
      }
      function esc(s) {
        return String(s == null ? "" : s).replace(/[&<>"]/g, function (c) {
          return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c];
        });
      }
      function renderList() {
        var tracks = playlist();
        listEl.innerHTML = tracks.map(function (t, i) {
          var active = i === index;
          return '<li><button type="button" data-i="' + i + '" class="w-full flex items-center gap-3 px-4 py-3 text-left ' +
            (active ? "bg-orange-50" : "hover:bg-stone-50") + '">' +
            '<span class="text-xs font-bold text-stone-400 w-6 shrink-0">' + (mode === "full" ? "▶" : (t.chapter != null ? t.chapter : "")) + "</span>" +
            '<span class="flex-1 min-w-0"><span class="block text-sm font-medium ' + (active ? "text-orange-900" : "") + '">' + esc(t.label) + "</span>" +
            (t.detail ? '<span class="block text-xs text-stone-400">' + esc(t.detail) + "</span>" : "") + "</span>" +
            '<span class="text-xs tabular-nums text-stone-400 shrink-0">' + (t.duration ? fmt(t.duration) : "") + "</span>" +
            "</button></li>";
        }).join("");
        prevBtn.disabled = mode === "full" || index <= 0;
        nextBtn.disabled = mode === "full" || index >= tracks.length - 1;
      }
      function setPlayingUi(playing) {
        iconPlay.classList.toggle("hidden", playing);
        iconPause.classList.toggle("hidden", !playing);
      }
      function loadTrack(i, autoplay) {
        var tracks = playlist();
        if (i < 0 || i >= tracks.length) return;
        index = i;
        if (window.BBSPlayer) window.BBSPlayer.notePlaylist(playlist(), index, { slug: playerData.slug, title: playerData.title || document.title, cover: playerData.cover || "", bookUrl: window.location.pathname });
        var t = tracks[i];
        statusEl.textContent = "";
        audio.src = t.url;
        audio.playbackRate = Number(speedSel.value) || 1;
        nowPlaying.textContent = t.label;
        totalEl.textContent = t.duration ? fmt(t.duration) : "0:00";
        elapsedEl.textContent = "0:00";
        seek.value = 0;
        renderList();
        if (autoplay) audio.play().catch(function () {});
      }
      function setMode(next) {
        if (next === mode) return;
        mode = next;
        var on = "rounded-full bg-[#1a3454] text-white px-4 py-2 text-sm font-semibold";
        var off = "rounded-full bg-white text-stone-700 border border-stone-300 hover:border-stone-500 px-4 py-2 text-sm font-semibold";
        modeChBtn.className = mode === "chapters" ? on : off;
        if (modeFullBtn) modeFullBtn.className = mode === "full" ? on : off;
        loadTrack(0, false);
      }

      playBtn.addEventListener("click", function () {
        if (index < 0) { loadTrack(0, true); return; }
        if (audio.paused) audio.play().catch(function () {});
        else audio.pause();
      });
      prevBtn.addEventListener("click", function () { if (index > 0) loadTrack(index - 1, true); });
      nextBtn.addEventListener("click", function () { if (index < playlist().length - 1) loadTrack(index + 1, true); });
      if (modeChBtn) modeChBtn.addEventListener("click", function () { setMode("chapters"); });
      if (modeFullBtn) modeFullBtn.addEventListener("click", function () { setMode("full"); });
      listEl.addEventListener("click", function (ev) {
        var btn = ev.target.closest("button[data-i]");
        if (!btn) return;
        loadTrack(Number(btn.getAttribute("data-i")), true);
      });
      speedSel.addEventListener("change", function () { audio.playbackRate = Number(speedSel.value) || 1; });

      audio.addEventListener("play", function () { setPlayingUi(true); });
      audio.addEventListener("pause", function () { setPlayingUi(false); });
      audio.addEventListener("loadedmetadata", function () {
        if (isFinite(audio.duration)) totalEl.textContent = fmt(audio.duration);
      });
      audio.addEventListener("timeupdate", function () {
        if (!isFinite(audio.duration) || audio.duration <= 0) return;
        elapsedEl.textContent = fmt(audio.currentTime);
        if (!seeking) seek.value = Math.round((audio.currentTime / audio.duration) * 1000);
      });
      audio.addEventListener("ended", function () {
        setPlayingUi(false);
        if (mode === "chapters" && index < playlist().length - 1) loadTrack(index + 1, true);
      });
      audio.addEventListener("error", function () {
        if (index >= 0) statusEl.textContent = "That track could not be loaded.";
      });
      seek.addEventListener("input", function () { seeking = true; });
      seek.addEventListener("change", function () {
        seeking = false;
        if (isFinite(audio.duration) && audio.duration > 0) {
          audio.currentTime = (Number(seek.value) / 1000) * audio.duration;
        }
      });

      renderList();
    </script>
  )}

  <script is:inline>
    document.querySelectorAll(".js-signout").forEach(function (el) {
      el.addEventListener("click", async function (e) {
        e.preventDefault();
        await fetch("/api/admin-auth/logout", { method: "POST" });
        await fetch("/api/auth/sign-out", { method: "POST", headers: { "Content-Type": "application/json" }, body: "{}" }).catch(function () {});
        window.location.href = "/login";
      });
    });
  </script>
</body>
</html>
