---
import "../../../styles/global.css";
import AdminShell from "../../../components/AdminShell.astro";
import { getQcVideo, mediaUrl, fmtTime } from "../../../lib/video-qc";
if (!Astro.locals.user) {
  return Astro.redirect("/admin/login");
}
const video = getQcVideo(String(Astro.params.slug || ""));
if (!video) {
  return Astro.redirect("/admin/videos");
}
---

<html lang="en">
<head>
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#1a3454" />
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width" />
  <title>{video.title} ({video.style}) · Promo QC</title>
  <style is:global>
    body{font-family:ui-sans-serif,system-ui,sans-serif;background:#fafaf9;color:#1c1917;margin:0}
    .wrap{max-width:72rem;margin:0 auto;padding:1.75rem 1rem 4rem}
    h1{font-size:1.7rem;font-weight:800;letter-spacing:-.02em;margin:.25rem 0 .25rem}
    h2{font-size:1.2rem;font-weight:800;margin:1.75rem 0 .75rem}
    .back{color:#c2410c;text-decoration:none;font-weight:600;font-size:.92rem}
    .style{color:#c2410c;font-weight:600;margin:0 0 10px}
    .nums{display:flex;flex-wrap:wrap;gap:6px 16px;font-size:.9rem;color:#44403c;margin:0 0 6px}
    .nums b{color:#1c1917}
    .chip{display:inline-block;padding:2px 9px;border-radius:999px;font-size:.75rem;font-weight:700;background:#f5f5f4;color:#44403c}
    .chip.bad{background:#fee2e2;color:#991b1b}
    .sz-bad{color:#b91c1c;font-weight:700}.sz-ok{color:#166534;font-weight:700}
    video.vid{width:100%;max-width:400px;border-radius:12px;background:#000;display:block}
    .layout{display:flex;gap:28px;flex-wrap:wrap;align-items:flex-start}
    .strip{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:14px}
    .scard{background:#fff;border:1px solid #e7e5e4;border-radius:12px;overflow:hidden;text-decoration:none;color:inherit;display:block;box-shadow:0 1px 2px rgba(28,25,23,.05)}
    .scard:hover{border-color:#fdba74}
    .scard img{width:100%;aspect-ratio:1080/700;object-fit:cover;object-position:top;display:block;background:#1a3454}
    .scard .b{padding:10px 12px 12px}
    .scard h3{margin:0 0 2px;font-size:1rem}
    .scard .t{color:#78716c;font-size:.8rem;margin:0 0 6px}
    .scard .l{font-size:.86rem;color:#44403c;margin:0;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
    .panel{background:#fff;border:1px solid #e7e5e4;border-radius:12px;padding:16px;box-shadow:0 1px 2px rgba(28,25,23,.05)}
    .tagbtn{border:1px solid #d6d3d1;background:#fff;border-radius:999px;padding:7px 16px;font-weight:700;cursor:pointer;font-size:.88rem;margin:0 6px 6px 0}
    .tagbtn.on-fix{background:#fee2e2;border-color:#b91c1c;color:#991b1b}
    .tagbtn.on-steal{background:#fef3c7;border-color:#d97706;color:#92400e}
    .tagbtn.on-keep{background:#dcfce7;border-color:#16a34a;color:#166534}
    .tagbtn.on-question{background:#e0e7ff;border-color:#4f46e5;color:#3730a3}
    .savebtn{background:#ea580c;color:#fff;border:0;border-radius:999px;padding:9px 20px;font-weight:700;cursor:pointer;font-size:.9rem}
    .savebtn:disabled{opacity:.55}
    textarea{width:100%;box-sizing:border-box;border:1px solid #d6d3d1;border-radius:8px;padding:8px 10px;font:inherit;font-size:.9rem;min-height:56px}
    .tagrow{border-top:1px solid #f0efed;padding:8px 0;font-size:.88rem}
    .tagrow .tg{font-weight:800;text-transform:uppercase;font-size:.72rem;letter-spacing:.06em}
    .tg-fix{color:#b91c1c}.tg-steal{color:#d97706}.tg-keep{color:#16a34a}.tg-question{color:#4f46e5}
    .muted{color:#78716c;font-size:.85rem}
  </style>
</head>
<body>
  <AdminShell current="/admin/videos" />
  <main class="wrap">
    <a class="back" href="/admin/videos">&larr; All videos</a>
    <h1>{video.title}</h1>
    <p class="style">{video.style} · {video.product}</p>
    <p class="nums">
      <span><b>{fmtTime(video.duration_s)}</b> long</span>
      <span>{video.lufs != null ? <b>{video.lufs.toFixed(1)} LUFS</b> : "LUFS n/a"}{video.true_peak_db != null ? ` · ${video.true_peak_db.toFixed(1)} dB peak` : ""}</span>
      <span>transcript {video.transcript ? (video.transcript.ratio != null ? <b>{video.transcript.ratio.toFixed(2)}</b> : <b>pass</b>) : "n/a"}</span>
      <span>safe zone {video.safezone_fg_violations == null ? "unmeasured" : video.safezone_fg_violations === 0 ? <span class="sz-ok">0 violations</span> : <span class="sz-bad">{video.safezone_fg_violations} foreground violations</span>}{video.safezone_elements_measured != null ? ` of ${video.safezone_elements_measured} elements` : ""}</span>
      <span>ledger verdict <b>{video.verdict || "none"}</b> ({video.attempt_id})</span>
    </p>
    {video.defect_tags.length > 0 && (
      <p style="margin:4px 0 0">{video.defect_tags.map((t) => <span class="chip bad">{t}</span>)}</p>
    )}

    <div class="layout" style="margin-top:18px">
      <div>
        <video class="vid" controls preload="metadata" src={mediaUrl(video.video_key)} poster={video.poster_key ? mediaUrl(video.poster_key) : undefined}></video>
      </div>
      <div style="flex:1;min-width:290px;max-width:520px">
        <div class="panel">
          <h2 style="margin-top:0">Tag this video</h2>
          <p class="muted" style="margin-top:0">Whole-video call. For scene or element calls, open the scene below.</p>
          <div id="tagbtns">
            <button class="tagbtn" data-tag="fix">Fix</button>
            <button class="tagbtn" data-tag="steal">Steal</button>
            <button class="tagbtn" data-tag="keep">Keep</button>
            <button class="tagbtn" data-tag="question">Question</button>
          </div>
          <textarea id="tagnote" placeholder="Note (optional)"></textarea>
          <p style="margin:10px 0 0"><button class="savebtn" id="tagsave" disabled>Save tag</button> <span class="muted" id="tagmsg"></span></p>
        </div>
        <div class="panel" style="margin-top:14px">
          <h2 style="margin-top:0">Tags on this video</h2>
          <div id="taglist"><p class="muted">Loading...</p></div>
        </div>
      </div>
    </div>

    <h2>Scenes, intro to cost</h2>
    <div class="strip">
      {video.scenes.map((s) => (
        <a class="scard" href={`/admin/videos/${video.slug}/${s.id}`}>
          <img src={mediaUrl(s.frame_key)} alt="" loading="lazy" />
          <div class="b">
            <h3>{s.name}</h3>
            <p class="t">{fmtTime(s.start_s)} to {fmtTime(s.end_s)} · {fmtTime(s.duration_s)}</p>
            <p class="l">{s.line || "No spoken line."}</p>
            <p style="margin:8px 0 0">
              <span class="chip">{s.elements.length} elements</span>
              {s.measured_fg_violations == null
                ? <span class="chip">safe zone unmeasured</span>
                : s.measured_fg_violations === 0
                  ? <span class="chip" style="background:#dcfce7;color:#166534">0 measured violations</span>
                  : <span class="chip" style="background:#fee2e2;color:#991b1b">{s.measured_fg_violations} measured violations</span>}
            </p>
          </div>
        </a>
      ))}
    </div>
  </main>

  <script is:inline define:vars={{ slug: video.slug }}>
    var chosen = "";
    function esc(s) { return String(s == null ? "" : s).replace(/[&<>"]/g, function (c) { return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]; }); }
    var btns = document.querySelectorAll("#tagbtns .tagbtn");
    btns.forEach(function (b) {
      b.addEventListener("click", function () {
        chosen = b.getAttribute("data-tag");
        btns.forEach(function (x) { x.className = "tagbtn" + (x === b ? " on-" + chosen : ""); });
        document.getElementById("tagsave").disabled = false;
      });
    });
    document.getElementById("tagsave").addEventListener("click", function () {
      if (!chosen) return;
      var btn = this;
      btn.disabled = true;
      fetch("/api/admin/video-feedback", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ video_slug: slug, scene_id: "", element_id: "", tag: chosen, note: document.getElementById("tagnote").value })
      }).then(function (r) { return r.json(); }).then(function (d) {
        document.getElementById("tagmsg").textContent = d.ok ? "Saved." : ("Error: " + (d.error || "unknown"));
        btn.disabled = false;
        if (d.ok) { document.getElementById("tagnote").value = ""; loadTags(); }
      }).catch(function () { document.getElementById("tagmsg").textContent = "Network error."; btn.disabled = false; });
    });
    function scopeLabel(f) {
      if (f.element_id) return "element " + f.element_id;
      if (f.scene_id) return "scene " + f.scene_id;
      return "whole video";
    }
    function loadTags() {
      fetch("/api/admin/video-feedback?video=" + encodeURIComponent(slug)).then(function (r) { return r.json(); }).then(function (d) {
        var el = document.getElementById("taglist");
        var rows = (d.feedback || []);
        if (!rows.length) { el.innerHTML = '<p class="muted">No tags yet.</p>'; return; }
        el.innerHTML = rows.map(function (f) {
          return '<div class="tagrow"><span class="tg tg-' + esc(f.tag) + '">' + esc(f.tag) + '</span> · ' + esc(scopeLabel(f)) +
            (f.note ? '<br>' + esc(f.note) : "") +
            '<br><span class="muted">' + new Date(f.created_at * 1000).toLocaleString() + '</span></div>';
        }).join("");
      }).catch(function () { document.getElementById("taglist").innerHTML = '<p class="muted">Could not load tags.</p>'; });
    }
    loadTags();
  </script>
</body>
</html>
