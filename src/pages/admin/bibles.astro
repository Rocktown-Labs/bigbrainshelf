---
import "../../styles/global.css";
import AdminShell from "../../components/AdminShell.astro";
if (!Astro.locals.user) {
  return Astro.redirect("/admin/login");
}
---


<html lang="en">
<head>
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#1a3454" />
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width" />
  <title>Bibles · Big Brain Shelf admin</title>
  <style is:global>
    body{font-family:ui-sans-serif,system-ui,sans-serif;background:#fafaf9;color:#1c1917;margin:0}
    .wrap{max-width:64rem;margin:0 auto;padding:1.75rem 1rem 4rem}
    h1{font-size:1.7rem;font-weight:800;letter-spacing:-.02em;margin:.25rem 0 1rem}
    .card{background:#fff;border:1px solid #e7e5e4;border-radius:12px;padding:20px;margin:16px 0;box-shadow:0 1px 2px rgba(28,25,23,.05)}
    .card h2,.card h3{margin-top:0}
    .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:20px;margin-top:24px}
    .status{display:inline-block;padding:4px 12px;border-radius:999px;font-size:.85em;font-weight:600}
    .draft{background:#f5f5f4;color:#44403c}.queued{background:#dbeafe;color:#1e40af}.building{background:#fef3c7;color:#92400e}.ready_for_qa{background:#cffafe;color:#155e75}.in_progress{background:#fef3c7;color:#92400e}.complete{background:#dcfce7;color:#166534}.failed{background:#fee2e2;color:#991b1b}
    .meta{color:#78716c;font-size:.88em}
    a{color:#c2410c}
    .btn{display:inline-block;background:#ea580c;color:#fff;padding:10px 22px;border-radius:999px;font-weight:600;text-decoration:none;border:0;cursor:pointer;font-size:14px}
    .btn:hover{background:#c2410c}
    .ghostbtn{display:inline-block;background:#fff;color:#1c1917;border:1px solid #d6d3d1;padding:9px 18px;border-radius:999px;font-weight:600;cursor:pointer;font-size:14px;text-decoration:none}
    .tabs{margin:16px 0}.tabs button{padding:8px 16px;margin-right:8px;border:1px solid #d6d3d1;border-radius:999px;background:#fff;cursor:pointer;font-size:.95em}
    .tabs button.active{background:#1a3454;color:#fff;border-color:#1a3454}
    .group-title{margin:32px 0 12px;font-size:1.3em;font-weight:700}
    /* Bible shelf (2026-11-03): the same shelf as /admin/books and
       /admin/characters, which is the customer /account library
       pattern. Covers rest on wooden planks, four to a board; the
       public title and the bible's gate chip sit under each cover;
       the whole cover links to that book's bible page. The cover box
       is display:block: aspect-ratio forms no box on an inline
       element, which is what let covers overflow their rows on the
       first books shelf. */
    .shelf-board{margin-top:26px}
    .shelf-board:first-of-type{margin-top:10px}
    .shelf-row{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;padding:0 4px}
    @media (max-width:640px){.shelf-row{grid-template-columns:repeat(2,1fr)}}
    .shelf-plank{height:.65rem;margin-top:.55rem;border-radius:.3rem;background:linear-gradient(180deg,#b08954 0%,#8a6844 55%,#6f5133 100%);box-shadow:0 10px 14px -8px rgba(90,62,27,.55),inset 0 1px 0 rgba(255,235,200,.5)}
    .shelf-item{display:block;text-decoration:none;color:inherit}
    .shelf-cover{display:block;aspect-ratio:3/4;border-radius:10px;overflow:hidden;border:1px solid #e7e5e4;background:#f5f5f4;box-shadow:0 1px 2px rgba(28,25,23,.06)}
    .shelf-cover img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .2s ease}
    .shelf-item:hover .shelf-cover img{transform:scale(1.02)}
    .shelf-title{display:block;font-weight:700;font-size:.95rem;line-height:1.3;margin-top:10px}
    .shelf-chip{display:block;margin-top:6px;min-height:24px}
    .card img{max-width:100%;border-radius:8px;background:#f5f5f4}
    label{display:block;margin:16px 0 6px;font-weight:600;font-size:14px}
    input,select,textarea{width:100%;padding:10px 12px;font-size:14px;border:1px solid #d6d3d1;border-radius:8px;box-sizing:border-box;background:#fff}
    .hint{color:#78716c;font-size:.85em}
  </style>
  </head>
<body>
  <AdminShell current="/admin/bibles" />
  <main class="wrap">
  <h1>Story Bibles</h1>
  <div class="card" id="attach">
    <h2>Attach a bible to a book</h2>
    <p class="hint">Bibles arrive as .json files (RGM authors them). Pick the book, pick the file, attach. When the factory builds that book it uses this bible instead of inventing one, so the framing, cast, and chapter ladder are the approved ones.</p>
    <label for="attach-book">Book</label>
    <select id="attach-book"><option value="">Choose a book...</option></select>
    <label for="attach-file">Bible file (.json)</label>
    <input id="attach-file" type="file" accept=".json,application/json" />
    <p style="margin-top:14px"><button class="btn" id="bible-attach" type="button">Attach bible</button></p>
    <details style="margin-top:10px">
      <summary class="hint" style="cursor:pointer">Paste JSON instead</summary>
      <label for="bible-json">Bible JSON</label>
      <textarea id="bible-json" rows="8" placeholder='{"bookTitle": "...", "bigIdea": "...", "setting": "...", "characters": [...], "conceptLadder": [...]}'></textarea>
      <p style="margin-top:10px"><button class="ghostbtn" id="bible-attach-paste" type="button">Attach pasted bible</button></p>
    </details>
    <p class="hint" id="bible-status"></p>
  </div>
  <script is:inline>
    var statusEl = document.getElementById('bible-status');
    fetch('/api/books').then(function (r) { return r.json(); }).then(function (books) {
      var sel = document.getElementById('attach-book');
      (books || []).forEach(function (b) {
        var o = document.createElement('option');
        o.value = b.slug;
        o.textContent = b.title || "Untitled book";
        sel.appendChild(o);
      });
    }).catch(function () {});
    function submitBible(slug, data) {
      if (!slug) { statusEl.textContent = 'Choose the book first.'; return; }
      if (!data || !data.conceptLadder || !data.conceptLadder.length) { statusEl.textContent = 'That bible has no conceptLadder chapters. Nothing attached.'; return; }
      statusEl.textContent = 'Attaching...';
      fetch('/api/bibles', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ bookSlug: slug, bookTitle: data.bookTitle || '', bigIdea: data.bigIdea || '', setting: data.setting || '', data: data })
      }).then(function (r) { return r.json(); }).then(function (res) {
        if (res && res.id) { statusEl.textContent = 'Attached "' + (data.bookTitle || "the bible") + '". Reloading...'; setTimeout(function () { location.reload(); }, 900); }
        else { statusEl.textContent = 'Attach failed: ' + JSON.stringify(res); }
      }).catch(function (e) { statusEl.textContent = 'Attach failed: ' + e.message; });
    }
    document.getElementById('bible-attach').addEventListener('click', function () {
      var slug = document.getElementById('attach-book').value;
      var file = document.getElementById('attach-file').files[0];
      if (!slug) { statusEl.textContent = 'Choose the book first.'; return; }
      if (!file) { statusEl.textContent = 'Choose the bible .json file.'; return; }
      var reader = new FileReader();
      reader.onload = function () {
        var data;
        try { data = JSON.parse(String(reader.result)); } catch (e) { statusEl.textContent = 'That file is not valid JSON: ' + e.message; return; }
        submitBible(slug, data);
      };
      reader.readAsText(file);
    });
    document.getElementById('bible-attach-paste').addEventListener('click', function () {
      var slug = document.getElementById('attach-book').value;
      var raw = document.getElementById('bible-json').value.trim();
      var data;
      try { data = JSON.parse(raw); } catch (e) { statusEl.textContent = 'That is not valid JSON: ' + e.message; return; }
      submitBible(slug, data);
    });
  </script>
  <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin:4px 0 8px">
    <input id="bible-q" type="text" placeholder="Search title or slug..." style="flex:1;min-width:170px;width:auto" />
  </div>
  <div id="bibles"><p>Loading...</p></div>
  <script is:inline>
    var R2 = "https://media.bigbrainshelf.com/";
    var shelfItems = [];
    function escH(s) { return String(s == null ? "" : s).replace(/[&<>"']/g, function (c) { return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]; }); }
    // The chip under each cover is the bible's factory-gate state,
    // in the same words the old stacked cards used. A book with no
    // bible says so instead of borrowing a gate state.
    function chipFor(bible) {
      if (!bible) return { cls: "draft", label: "No bible yet" };
      if (bible.gate === null || bible.gate === undefined) return { cls: "draft", label: "Gate: not checked" };
      if (bible.gate.ok) return { cls: "complete", label: "Passes the factory gate" };
      return { cls: "failed", label: "Gate fails" };
    }
    function shelfItemHtml(it) {
      var chip = chipFor(it.bible);
      var cover = it.cover
        ? '<img src="' + R2 + it.cover + '" alt="' + escH(it.title) + '" loading="lazy" />'
        : '';
      return '<a class="shelf-item" href="/admin/bibles/' + escH(it.pub) + '">' +
        '<span class="shelf-cover">' + cover + '</span>' +
        '<span class="shelf-title">' + escH(it.title) + '</span>' +
        '<span class="shelf-chip"><span class="status ' + chip.cls + '">' + chip.label + '</span></span>' +
        '</a>';
    }
    function shelfBoardsHtml(items) {
      // Four covers to a board, a wooden plank under each board:
      // the customer library shelf pattern.
      var html = '';
      for (var i = 0; i < items.length; i += 4) {
        html += '<div class="shelf-board"><div class="shelf-row">' +
          items.slice(i, i + 4).map(shelfItemHtml).join('') +
          '</div><div class="shelf-plank" aria-hidden="true"></div></div>';
      }
      return html;
    }
    function renderShelf() {
      var q = document.getElementById('bible-q').value.trim().toLowerCase();
      var el = document.getElementById('bibles');
      if (!shelfItems.length) {
        el.innerHTML = '<div class="card"><h2 style="margin-top:0">No books yet</h2><p class="meta">The shelf is empty. Start the first book and it will appear here.</p><p style="margin-bottom:0"><a class="btn" href="/admin/books/new">+ New book</a></p></div>';
        return;
      }
      var list = shelfItems.filter(function (it) {
        return !q || (it.title + " " + it.slug + " " + it.pub).toLowerCase().indexOf(q) >= 0;
      });
      if (!list.length) {
        el.innerHTML = '<div class="card shelf-noresults"><h2 style="margin-top:0">No books match your search</h2><p class="meta">Nothing on the shelf matches that search.</p><p style="margin-bottom:0"><button class="btn" id="bible-clear-search" type="button">Clear search</button></p></div>';
        document.getElementById('bible-clear-search').addEventListener('click', function () {
          document.getElementById('bible-q').value = '';
          renderShelf();
        });
        return;
      }
      el.innerHTML = shelfBoardsHtml(list);
    }
    // One shelf slot per BOOK (the books payload drives the shelf,
    // like the sibling shelves), with the bible for that book joined
    // in for its chip. Admin bible links wear the PUBLIC slug
    // (owner, 2026-10-29); the join and the APIs key on the
    // internal slug.
    Promise.all([
      fetch('/api/bibles').then(function (r) { return r.json(); }).catch(function () { return []; }),
      fetch('/api/books').then(function (r) { return r.json(); }).catch(function () { return []; })
    ]).then(function (pair) {
      var bibles = pair[0] || [];
      var books = pair[1] || [];
      var biblesBySlug = {};
      bibles.forEach(function (b) { if (b.book_slug) biblesBySlug[b.book_slug] = b; });
      var pubByInternal = {};
      books.forEach(function (bk) { if (bk.public_slug) pubByInternal[bk.slug] = bk.public_slug; });
      var seen = {};
      books.forEach(function (bk) {
        seen[bk.slug] = 1;
        shelfItems.push({
          title: bk.title || "Untitled book",
          slug: bk.slug,
          pub: bk.public_slug || bk.slug,
          cover: bk.cover_key || "",
          bible: biblesBySlug[bk.slug] || null
        });
      });
      bibles.forEach(function (b) {
        if (!b.book_slug || seen[b.book_slug]) return;
        // A bible whose book has left the books table still gets a
        // shelf slot (no cover) so it stays reachable; its link maps
        // to the public slug when one is known.
        shelfItems.push({
          title: b.book_title || "Untitled bible",
          slug: b.book_slug,
          pub: pubByInternal[b.book_slug] || b.book_slug,
          cover: "",
          bible: b
        });
      });
      shelfItems.sort(function (a, b) { return String(a.title).localeCompare(String(b.title)); });
      renderShelf();
    });
    document.getElementById('bible-q').addEventListener('input', renderShelf);
  </script>
  </main>
  <script is:inline>
    document.querySelectorAll(".js-signout").forEach(function (el) {
      el.addEventListener("click", async function (e) {
        e.preventDefault();
        await fetch("/api/admin-auth/logout", { method: "POST" });
        await fetch("/api/auth/sign-out", { method: "POST", headers: { "Content-Type": "application/json" }, body: "{}" }).catch(function () {});
        window.location.href = "/login";
      });
    });
  </script>
</body>
</html>
