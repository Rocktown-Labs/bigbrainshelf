---
import { env } from "cloudflare:workers";
import "../../styles/global.css";
import AdminShell from "../../components/AdminShell.astro";
import {
  clusterParentTopicDemand,
  getGenerationCostSummary,
  detectBraintrustBackend,
} from "../../lib/braintrust";
import { getFulfillmentRouterSummary } from "../../lib/fulfillment-router";
import { getReadingDropoffSummary } from "../../lib/telemetry";
import { getRevOpsDashboardMetrics } from "../../lib/revops";

export const prerender = false;

const e = env as any;
const db = e.DB;

const [revops, aiCogs, topicDemand, fulfillmentSummary, readingDropoff] = await Promise.all([
  getRevOpsDashboardMetrics(db),
  getGenerationCostSummary(db),
  clusterParentTopicDemand(db),
  getFulfillmentRouterSummary(db),
  getReadingDropoffSummary(db),
]);

const braintrustBackend = detectBraintrustBackend(e);
const hasFamilyRoomDo = Boolean(e.FAMILY_ROOM_DO);
const hasAnalyticsEngine = Boolean(e.READING_TELEMETRY);
const hasBasin = Boolean(e.BASIN_STREAM || e.BASIN_PIPELINE_URL);
const hasVideoQueue = Boolean(e.VIDEO_QUEUE);
const hasVercelAiGateway = Boolean(e.VERCEL_AI_GATEWAY_URL);
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>RevOps, Supply Chain &amp; Transmedia Scale · Big Brain Shelf Admin</title>
</head>
<body class="bg-stone-50 text-stone-900 antialiased">
  <AdminShell current="/admin/revops" />

  <main class="max-w-6xl mx-auto px-4 py-8 space-y-8" style="padding-bottom:calc(2rem + env(safe-area-inset-bottom, 0px))">
    <header class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-stone-200 pb-5">
      <div>
        <span class="text-xs font-extrabold uppercase tracking-wider text-amber-700">
          5-Pillar Scale Command Center
        </span>
        <h1 class="text-2xl font-extrabold text-stone-900">
          RevOps, Unit Economics &amp; Transmedia Flywheel
        </h1>
        <p class="text-xs text-stone-600 mt-1">
          Grounded in live <code>offers.ts</code> pricing, Vercel AI Gateway COGS, Hybrid Fulfillment Routing, and Traks/Basin telemetry.
        </p>
      </div>
      <div class="flex flex-wrap gap-2">
        <button
          id="btn-reindex-braintrust"
          type="button"
          class="rounded-xl bg-stone-900 hover:bg-stone-800 text-white text-xs font-extrabold px-4 py-2.5 cursor-pointer"
        >
          Sync Canon &amp; Curriculum Vectors
        </button>
      </div>
    </header>

    {/* Honest Binding vs. Local D1 Scaffolding Status Matrix */}
    <section class="rounded-2xl border border-stone-200 bg-stone-50 p-5">
      <div class="flex items-center justify-between mb-3">
        <h2 class="text-xs font-extrabold uppercase tracking-wider text-stone-700">
          Infrastructure Binding Status (Live Cloudflare Bindings vs. D1 Local Scaffolding)
        </h2>
        <span class="text-[11px] text-stone-500">Transparent runtime inspection</span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 text-xs">
        <div class="rounded-xl border border-stone-200 bg-white p-3">
          <div class="flex items-center justify-between">
            <span class="font-bold text-stone-800">1. Braintrust Vectors</span>
            <span class={`px-2 py-0.5 rounded-full text-[10px] font-extrabold ${braintrustBackend === "vectorize_edge" ? "bg-emerald-100 text-emerald-900" : "bg-amber-100 text-amber-900"}`}>
              {braintrustBackend === "vectorize_edge" ? "LIVE: Vectorize + Workers AI" : "SCAFFOLDING: D1 32-d Concept"}
            </span>
          </div>
          <p class="text-[11px] text-stone-500 mt-1">
            Uses <code>VECTORIZE_CANON</code> / <code>VECTORIZE_CURRICULUM</code> + <code>AI</code> when bound; falls back to <code>vector_embeddings</code> in D1.
          </p>
        </div>

        <div class="rounded-xl border border-stone-200 bg-white p-3">
          <div class="flex items-center justify-between">
            <span class="font-bold text-stone-800">2. Video Pipeline</span>
            <span class={`px-2 py-0.5 rounded-full text-[10px] font-extrabold ${hasVideoQueue ? "bg-emerald-100 text-emerald-900" : "bg-blue-100 text-blue-900"}`}>
              {hasVideoQueue ? "LIVE: Queue + D1 video_jobs" : "VM RUNNER: D1 video_jobs"}
            </span>
          </div>
          <p class="text-[11px] text-stone-500 mt-1">
            Compositions owned by RGM's Remotion (<code>kidsbook-video</code>) pipeline; hub queues via <code>video_jobs</code> + optional <code>VIDEO_QUEUE</code>.
          </p>
        </div>

        <div class="rounded-xl border border-stone-200 bg-white p-3">
          <div class="flex items-center justify-between">
            <span class="font-bold text-stone-800">3. FamilyRoom Sync</span>
            <span class={`px-2 py-0.5 rounded-full text-[10px] font-extrabold ${hasFamilyRoomDo ? "bg-emerald-100 text-emerald-900" : "bg-amber-100 text-amber-900"}`}>
              {hasFamilyRoomDo ? "LIVE: Durable Object WS" : "SCAFFOLDING: D1 Polling"}
            </span>
          </div>
          <p class="text-[11px] text-stone-500 mt-1">
            Exports <code>FamilyRoomDurableObject</code> for <code>FAMILY_ROOM_DO</code>; falls back to D1 <code>family_sync_rooms</code>.
          </p>
        </div>

        <div class="rounded-xl border border-stone-200 bg-white p-3">
          <div class="flex items-center justify-between">
            <span class="font-bold text-stone-800">4. Cast Companion LLM</span>
            <span class={`px-2 py-0.5 rounded-full text-[10px] font-extrabold ${hasVercelAiGateway ? "bg-emerald-100 text-emerald-900" : "bg-amber-100 text-amber-900"}`}>
              {hasVercelAiGateway ? "LIVE: Vercel AI Gateway" : "SCAFFOLDING: Story Canon"}
            </span>
          </div>
          <p class="text-[11px] text-stone-500 mt-1">
            Routes to <code>VERCEL_AI_GATEWAY_URL</code> when configured; falls back to deterministic book-canon replies.
          </p>
        </div>

        <div class="rounded-xl border border-stone-200 bg-white p-3">
          <div class="flex items-center justify-between">
            <span class="font-bold text-stone-800">5. Supply Chain Router</span>
            <span class="px-2 py-0.5 rounded-full text-[10px] font-extrabold bg-amber-100 text-amber-900">
              LIVE Shippo + POD/3PL Ledger
            </span>
          </div>
          <p class="text-[11px] text-stone-500 mt-1">
            Mode A uses live <code>shippo.ts</code>; Modes B (POD) &amp; C (3PL) record routing &amp; COGS in <code>fulfillment_routes</code>.
          </p>
        </div>

        <div class="rounded-xl border border-stone-200 bg-white p-3">
          <div class="flex items-center justify-between">
            <span class="font-bold text-stone-800">6. Telemetry &amp; Basin</span>
            <span class={`px-2 py-0.5 rounded-full text-[10px] font-extrabold ${hasAnalyticsEngine || hasBasin ? "bg-emerald-100 text-emerald-900" : "bg-amber-100 text-amber-900"}`}>
              {hasAnalyticsEngine || hasBasin ? "LIVE: WAE / Basin" : "SCAFFOLDING: D1 Outbox/Rollup"}
            </span>
          </div>
          <p class="text-[11px] text-stone-500 mt-1">
            Writes to <code>READING_TELEMETRY</code> &amp; <code>BASIN_PIPELINE_URL</code> when bound; persists rollups in D1.
          </p>
        </div>
      </div>
    </section>

    {/* Canonical Pricing & Unit Economics Strip */}
    <section class="grid grid-cols-2 sm:grid-cols-4 gap-4">
      <div class="rounded-2xl border border-stone-200 bg-white p-4">
        <div class="text-xs text-stone-500 font-semibold">Storefront Revenue</div>
        <div class="text-2xl font-extrabold text-stone-900 mt-1">${revops.totalRevenueUsd.toFixed(2)}</div>
        <div class="text-[11px] text-stone-500 mt-1">
          $1.99 Audio · $8.99 Digital · $20 Print · $25 Gift Set
        </div>
      </div>
      <div class="rounded-2xl border border-stone-200 bg-white p-4">
        <div class="text-xs text-stone-500 font-semibold">The Book Club (Physical)</div>
        <div class="text-2xl font-extrabold text-emerald-900 mt-1">{revops.activeBookClubCount}</div>
        <div class="text-[11px] text-stone-500 mt-1">$60/quarter or $199/year</div>
      </div>
      <div class="rounded-2xl border border-stone-200 bg-white p-4">
        <div class="text-xs text-stone-500 font-semibold">The Audio Club</div>
        <div class="text-2xl font-extrabold text-indigo-900 mt-1">{revops.activeAudioClubCount}</div>
        <div class="text-[11px] text-stone-500 mt-1">$5.99/month or $49/year</div>
      </div>
      <div class="rounded-2xl border border-stone-200 bg-white p-4">
        <div class="text-xs text-stone-500 font-semibold">AI Production COGS</div>
        <div class="text-2xl font-extrabold text-amber-800 mt-1">${aiCogs.totalCostUsd.toFixed(4)}</div>
        <div class="text-[11px] text-stone-500 mt-1">Vercel AI Gateway + Gemini Direct</div>
      </div>
    </section>

    {/* Pillar 1: Parent Topic Demand vs. Curriculum Supply */}
    <section class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <div class="rounded-2xl border border-stone-200 bg-white p-5">
        <h2 class="text-sm font-extrabold uppercase tracking-wider text-stone-800">
          Pillar 1 · Parent Topic Demand vs. Catalog Supply
        </h2>
        <p class="text-xs text-stone-500 mt-1">
          Aggregated from onboarding <code>favorite_topics</code>, <code>future_topics</code>, &amp; semantic clustering of <code>custom_topic_request</code>.
        </p>
        <div class="mt-4 divide-y divide-stone-100">
          {topicDemand.map((item) => (
            <div class="py-2.5 flex items-center justify-between text-xs">
              <div>
                <div class="font-bold text-stone-900">{item.label}</div>
                <div class="text-stone-500">{item.sampleCurriculumTitle}</div>
              </div>
              <div class="text-right">
                <span class="inline-flex items-center rounded-full bg-amber-100 text-amber-900 px-2.5 py-0.5 font-extrabold">
                  Score {item.demandScore}
                </span>
                <div class="text-[11px] text-stone-400 mt-0.5">
                  {item.parentVotes} votes · {item.matchingNoteCount} note matches
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      {/* Pillar 4 & 5: Hybrid Fulfillment Router & Lifecycle Plays */}
      <div class="space-y-6">
        <div class="rounded-2xl border border-stone-200 bg-white p-5">
          <h2 class="text-sm font-extrabold uppercase tracking-wider text-stone-800">
            Pillar 4 · Hybrid Fulfillment Router (Shippo → POD → 3PL)
          </h2>
          <p class="text-xs text-stone-500 mt-1">
            Mode A: US single print/gift ($20/$25) via Home Shippo · Mode B: International POD · Mode C: $60/qtr Club Boxes &amp; multi-unit via 3PL.
          </p>
          <div class="mt-3 space-y-2 text-xs">
            {fulfillmentSummary.length === 0 ? (
              <p class="text-stone-400 py-2">No physical orders routed yet.</p>
            ) : (
              fulfillmentSummary.map((f) => (
                <div class="flex items-center justify-between rounded-xl bg-stone-50 px-3 py-2">
                  <span class="font-bold text-stone-800">{f.mode} ({f.provider})</span>
                  <span class="text-stone-600">{f.ordersCount} orders · ${f.totalCogsUsd.toFixed(2)} COGS</span>
                </div>
              ))
            )}
          </div>
        </div>

        <div class="rounded-2xl border border-stone-200 bg-white p-5">
          <h2 class="text-sm font-extrabold uppercase tracking-wider text-stone-800">
            Pillar 5 · Automated RevOps Lifecycle Plays
          </h2>
          <p class="text-xs text-stone-500 mt-1">
            Birthday Gift (<code>BDAY10</code> $10 off $25 Gift Set), 80% Completion Upsell ($5.99/mo Audio Club or $60/qtr Book Club), and Retention Saves.
          </p>
          <div class="mt-3 space-y-2 text-xs">
            {revops.lifecyclePlaysCount.length === 0 ? (
              <p class="text-stone-400 py-2">No lifecycle plays triggered yet.</p>
            ) : (
              revops.lifecyclePlaysCount.map((p) => (
                <div class="flex items-center justify-between rounded-xl bg-stone-50 px-3 py-2">
                  <span class="font-bold text-stone-800">{p.playType}</span>
                  <span class="font-extrabold text-emerald-800">{p.count} triggered</span>
                </div>
              ))
            )}
          </div>
        </div>
      </div>
    </section>

    {/* Reading Telemetry Rollups */}
    <section class="rounded-2xl border border-stone-200 bg-white p-5">
      <h2 class="text-sm font-extrabold uppercase tracking-wider text-stone-800">
        Pillar 5 · Chapter &amp; Page Attention Telemetry (Analytics Engine + D1 Rollup)
      </h2>
      <div class="mt-3 overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead>
            <tr class="border-b border-stone-200 text-stone-500">
              <th class="py-2">Book Slug</th>
              <th class="py-2">Chapter</th>
              <th class="py-2">Page</th>
              <th class="py-2">Event</th>
              <th class="py-2">Total Events</th>
              <th class="py-2">Avg Dwell (s)</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-stone-100">
            {readingDropoff.length === 0 ? (
              <tr>
                <td colspan="6" class="py-4 text-stone-400">No reading telemetry events recorded yet.</td>
              </tr>
            ) : (
              readingDropoff.map((r) => (
                <tr>
                  <td class="py-2 font-bold text-stone-800">{r.bookSlug}</td>
                  <td class="py-2">{r.chapterIndex}</td>
                  <td class="py-2">{r.pageIndex}</td>
                  <td class="py-2">{r.eventType}</td>
                  <td class="py-2 font-bold">{r.totalEvents}</td>
                  <td class="py-2">{r.avgDwellSeconds}s</td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>
    </section>
  </main>

  <script is:inline>
    (function () {
      var btn = document.getElementById("btn-reindex-braintrust");
      if (!btn) return;
      btn.addEventListener("click", function () {
        btn.disabled = true;
        btn.textContent = "Indexing Canon & Curriculum...";
        fetch("/api/braintrust", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ action: "index" }),
        })
          .then(function (r) { return r.json(); })
          .then(function (d) {
            btn.disabled = false;
            btn.textContent = d && d.ok ? ("Indexed " + d.indexedCount + " vectors (" + d.backend + ")") : "Index failed";
          })
          .catch(function () {
            btn.disabled = false;
            btn.textContent = "Sync Canon & Curriculum Vectors";
          });
      });
    })();
  </script>
</body>
</html>
