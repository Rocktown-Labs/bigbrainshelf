---
import { env } from "cloudflare:workers";
import "../../styles/global.css";
import AdminShell from "../../components/AdminShell.astro";
import {
  clusterParentTopicDemand,
  getGenerationCostSummary,
  detectBraintrustBackend,
} from "../../lib/braintrust";
import { getReadingDropoffSummary } from "../../lib/telemetry";
import { getRevOpsDashboardMetrics } from "../../lib/revops";
import { publicSlugFor } from "../../lib/public-slugs";

export const prerender = false;
if (!Astro.locals.user) {
  return Astro.redirect("/admin/login");
}

const e = env as any;
const db = e.DB;

const [revops, aiCogs, topicDemand, readingDropoff, booksRes] = await Promise.all([
  getRevOpsDashboardMetrics(db),
  getGenerationCostSummary(db),
  clusterParentTopicDemand(db),
  getReadingDropoffSummary(db),
  db.prepare("SELECT slug, public_slug, title FROM books").all().catch(() => ({ results: [] })),
]);

// Resolve internal/public slugs into real book titles + admin links.
const bookByAnySlug = new Map<string, { title: string; adminHref: string }>();
for (const b of (booksRes?.results || []) as any[]) {
  const entry = {
    title: String(b.title || b.slug),
    adminHref: `/admin/books/${publicSlugFor(b)}`,
  };
  if (b.slug) bookByAnySlug.set(String(b.slug), entry);
  if (b.public_slug) bookByAnySlug.set(String(b.public_slug), entry);
}

// Aggregate reading telemetry by resolved book so mixed internal/public slugs merge cleanly.
interface BookEngagementRow {
  title: string;
  adminHref: string | null;
  events: number;
  weightedDwell: number;
  chaptersReached: number;
}
const engagementByBook = new Map<string, BookEngagementRow>();
for (const r of readingDropoff) {
  const resolved = bookByAnySlug.get(String(r.bookSlug || ""));
  const key = resolved ? resolved.title : String(r.bookSlug || "Unknown book");
  const prev = engagementByBook.get(key) || {
    title: resolved ? resolved.title : "Unlisted title",
    adminHref: resolved ? resolved.adminHref : null,
    events: 0,
    weightedDwell: 0,
    chaptersReached: 0,
  };
  prev.events += Number(r.totalEvents || 0);
  prev.weightedDwell += Number(r.avgDwellSeconds || 0) * Number(r.totalEvents || 0);
  prev.chaptersReached = Math.max(prev.chaptersReached, Number(r.chapterIndex || 0));
  engagementByBook.set(key, prev);
}
const engagementRows = Array.from(engagementByBook.values())
  .map((row) => ({
    ...row,
    avgDwellSec: row.events > 0 ? Math.round(row.weightedDwell / row.events) : 0,
  }))
  .sort((a, b) => b.events - a.events);

const PLAY_LABELS: Record<string, string> = {
  completion_upsell_80: "80% Book Completion -> Club Invite",
  birthday_bday10: "Kid Birthday Gift (BDAY10)",
};
const totalPlays = revops.lifecyclePlaysCount.reduce((s, p) => s + p.count, 0);
const activeClubsTotal = revops.activeBookClubCount + revops.activeAudioClubCount;
const maxDemand = Math.max(1, ...topicDemand.map((t) => t.demandScore));

const braintrustBackend = detectBraintrustBackend(e);
const hasFamilyRoomDo = Boolean(e.FAMILY_ROOM_DO);
const hasAnalyticsEngine = Boolean(e.READING_TELEMETRY);
const hasBasin = Boolean(e.BASIN_STREAM || e.BASIN_PIPELINE_URL);
const hasVideoQueue = Boolean(e.VIDEO_QUEUE);
const hasVercelAiGateway = Boolean(e.VERCEL_AI_GATEWAY_URL);
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>Insights · Big Brain Shelf Admin</title>
</head>
<body class="bg-stone-50 text-stone-900 antialiased">
  <AdminShell current="/admin/revops" />

  <main class="max-w-6xl mx-auto px-4 py-8 space-y-6" style="padding-bottom:calc(2rem + env(safe-area-inset-bottom, 0px))">
    <header class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3">
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-stone-900">Growth &amp; Insights</h1>
        <p class="text-sm text-stone-500 mt-1">
          Storefront revenue, active clubs, what parents are asking for next, automated lifecycle emails, and reader engagement.
        </p>
      </div>
      <div class="flex flex-wrap gap-2 text-xs font-semibold">
        <a href="/admin/orders" class="rounded-full border border-stone-300 bg-white px-3.5 py-1.5 text-stone-700 hover:bg-stone-100">Orders</a>
        <a href="/admin/club" class="rounded-full border border-stone-300 bg-white px-3.5 py-1.5 text-stone-700 hover:bg-stone-100">Clubs</a>
        <a href="/admin/users" class="rounded-full border border-stone-300 bg-white px-3.5 py-1.5 text-stone-700 hover:bg-stone-100">Users</a>
      </div>
    </header>

    {/* Top KPI Strip */}
    <section class="grid grid-cols-2 lg:grid-cols-4 gap-3.5">
      <a href="/admin/orders" class="rounded-2xl border border-stone-200 bg-white p-4 hover:border-stone-300 transition shadow-xs">
        <div class="text-[11px] font-bold uppercase tracking-wider text-stone-400">Storefront revenue</div>
        <div class="text-2xl font-extrabold text-stone-900 mt-1 tabular-nums">${revops.totalRevenueUsd.toFixed(2)}</div>
        <div class="text-xs text-stone-500 mt-1">
          ${revops.revenue30dUsd.toFixed(2)} last 30d · {revops.completedOrderCount} {revops.completedOrderCount === 1 ? "order" : "orders"}
        </div>
      </a>

      <a href="/admin/club" class="rounded-2xl border border-stone-200 bg-white p-4 hover:border-stone-300 transition shadow-xs">
        <div class="text-[11px] font-bold uppercase tracking-wider text-stone-400">Active club members</div>
        <div class="text-2xl font-extrabold text-emerald-800 mt-1 tabular-nums">{activeClubsTotal}</div>
        <div class="text-xs text-stone-500 mt-1">
          {revops.activeBookClubCount} Book Club · {revops.activeAudioClubCount} Audio Club
        </div>
      </a>

      <a href="/admin/users" class="rounded-2xl border border-stone-200 bg-white p-4 hover:border-stone-300 transition shadow-xs">
        <div class="text-[11px] font-bold uppercase tracking-wider text-stone-400">Audience</div>
        <div class="text-2xl font-extrabold text-stone-900 mt-1 tabular-nums">{revops.subscriberCount}</div>
        <div class="text-xs text-stone-500 mt-1">
          Newsletter subscribers · {revops.customerCount} {revops.customerCount === 1 ? "account" : "accounts"}
        </div>
      </a>

      <div class="rounded-2xl border border-stone-200 bg-white p-4 shadow-xs">
        <div class="text-[11px] font-bold uppercase tracking-wider text-stone-400">Lifecycle emails</div>
        <div class="text-2xl font-extrabold text-orange-700 mt-1 tabular-nums">{totalPlays}</div>
        <div class="text-xs text-stone-500 mt-1">
          Birthday &amp; 80% completion invites
        </div>
      </div>
    </section>

    {/* Topic Demand + Automated Lifecycle Emails */}
    <section class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <div class="rounded-2xl border border-stone-200 bg-white p-5 shadow-xs">
        <h2 class="text-sm font-bold text-stone-900">What parents want next</h2>
        <p class="text-xs text-stone-500 mt-0.5">
          Ranked from parent onboarding topic picks and custom topic requests.
        </p>
        <div class="mt-4 space-y-3">
          {topicDemand.map((item) => {
            const pct = Math.max(8, Math.round((item.demandScore / maxDemand) * 100));
            return (
              <div>
                <div class="flex items-baseline justify-between gap-2 text-xs">
                  <div class="min-w-0">
                    <span class="font-semibold text-stone-900">{item.label}</span>
                    {item.sampleCurriculumTitle && (
                      <span class="text-stone-400 ml-1.5 hidden sm:inline">· {item.sampleCurriculumTitle}</span>
                    )}
                  </div>
                  <span class="shrink-0 text-stone-500 tabular-nums">
                    {item.parentVotes} {item.parentVotes === 1 ? "vote" : "votes"}
                    {item.matchingNoteCount > 0 ? ` · ${item.matchingNoteCount} requests` : ""}
                  </span>
                </div>
                <div class="mt-1.5 h-1.5 rounded-full bg-stone-100 overflow-hidden">
                  <div class="h-full rounded-full bg-orange-500" style={`width:${pct}%`}></div>
                </div>
              </div>
            );
          })}
        </div>
      </div>

      <div class="rounded-2xl border border-stone-200 bg-white p-5 shadow-xs flex flex-col">
        <h2 class="text-sm font-bold text-stone-900">Automated lifecycle emails</h2>
        <p class="text-xs text-stone-500 mt-0.5">
          Triggered automatically on kid birthdays (<code>BDAY10</code>) and when non-club readers pass 80% of a book.
        </p>
        <div class="mt-4 space-y-2 text-xs">
          {revops.lifecyclePlaysCount.length === 0 ? (
            <p class="text-stone-400 py-2">No automated emails triggered yet.</p>
          ) : (
            revops.lifecyclePlaysCount.map((p) => (
              <div class="flex items-center justify-between rounded-xl bg-stone-50 border border-stone-100 px-3.5 py-2.5">
                <span class="font-semibold text-stone-800">{PLAY_LABELS[p.playType] || p.playType}</span>
                <span class="font-bold text-emerald-800 tabular-nums">{p.count} sent</span>
              </div>
            ))
          )}
        </div>
        {revops.recentPlays.length > 0 && (
          <div class="mt-5 pt-4 border-t border-stone-100">
            <h3 class="text-[11px] font-bold uppercase tracking-wider text-stone-400 mb-2">Recent triggers</h3>
            <div class="divide-y divide-stone-100 text-xs">
              {revops.recentPlays.map((rp) => {
                const resolved = rp.bookSlug ? bookByAnySlug.get(rp.bookSlug) : null;
                return (
                  <div class="py-2 flex items-center justify-between gap-2">
                    <div class="min-w-0">
                      <span class="font-medium text-stone-800 truncate block">{rp.email}</span>
                      <span class="text-stone-500">
                        {PLAY_LABELS[rp.playType] || rp.playType}
                        {resolved ? ` · ${resolved.title}` : ""}
                      </span>
                    </div>
                    <span class="shrink-0 text-stone-400 tabular-nums">
                      {rp.createdAt ? new Date(rp.createdAt).toLocaleDateString("en-US", { month: "short", day: "numeric" }) : ""}
                    </span>
                  </div>
                );
              })}
            </div>
          </div>
        )}
      </div>
    </section>

    {/* Reader Engagement by Book (public titles, never raw slugs) */}
    <section class="rounded-2xl border border-stone-200 bg-white p-5 shadow-xs">
      <div class="flex items-baseline justify-between gap-2">
        <div>
          <h2 class="text-sm font-bold text-stone-900">Reader engagement by book</h2>
          <p class="text-xs text-stone-500 mt-0.5">
            Page views and average dwell time recorded in the customer reader.
          </p>
        </div>
      </div>
      <div class="mt-4 overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="border-b border-stone-200 text-[11px] font-bold uppercase tracking-wider text-stone-400">
              <th class="py-2 pr-4">Book</th>
              <th class="py-2 px-3">Page views</th>
              <th class="py-2 px-3">Furthest chapter</th>
              <th class="py-2 pl-3">Avg dwell</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-stone-100">
            {engagementRows.length === 0 ? (
              <tr>
                <td colspan="4" class="py-6 text-sm text-stone-400">No reader activity recorded yet.</td>
              </tr>
            ) : (
              engagementRows.map((r) => (
                <tr>
                  <td class="py-2.5 pr-4 font-semibold text-stone-900">
                    {r.adminHref ? (
                      <a href={r.adminHref} class="hover:text-orange-700 hover:underline">{r.title}</a>
                    ) : (
                      r.title
                    )}
                  </td>
                  <td class="py-2.5 px-3 font-semibold tabular-nums">{r.events}</td>
                  <td class="py-2.5 px-3 text-stone-600 tabular-nums">
                    {r.chaptersReached > 0 ? `Chapter ${r.chaptersReached}` : "Cover / intro"}
                  </td>
                  <td class="py-2.5 pl-3 text-stone-600 tabular-nums">{r.avgDwellSec}s</td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>
    </section>

    {/* Developer-only infrastructure & search index controls, tucked out of the way */}
    <details class="rounded-2xl border border-stone-200 bg-white px-5 py-3.5 text-xs text-stone-600">
      <summary class="cursor-pointer font-semibold text-stone-700 select-none">
        System &amp; search index details (developer)
      </summary>
      <div class="mt-4 space-y-4">
        <div class="flex flex-wrap items-center justify-between gap-3 rounded-xl bg-stone-50 border border-stone-200 p-3">
          <div>
            <div class="font-semibold text-stone-800">Catalog search vectors &amp; AI cost log</div>
            <div class="text-stone-500 mt-0.5">
              Tracked AI generation cost: <strong>${aiCogs.totalCostUsd.toFixed(4)}</strong> · Backend: <code>{braintrustBackend}</code>
            </div>
          </div>
          <button
            id="btn-reindex-braintrust"
            type="button"
            class="rounded-lg bg-stone-900 hover:bg-stone-800 text-white text-xs font-semibold px-3.5 py-2 cursor-pointer"
          >
            Rebuild search index
          </button>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2.5">
          <div class="rounded-lg border border-stone-200 p-2.5">
            <span class="font-semibold text-stone-800">Video queue:</span>{" "}
            <span>{hasVideoQueue ? "Queue + D1" : "D1 jobs"}</span>
          </div>
          <div class="rounded-lg border border-stone-200 p-2.5">
            <span class="font-semibold text-stone-800">Family sync:</span>{" "}
            <span>{hasFamilyRoomDo ? "Durable Object" : "D1 polling"}</span>
          </div>
          <div class="rounded-lg border border-stone-200 p-2.5">
            <span class="font-semibold text-stone-800">Companion LLM:</span>{" "}
            <span>{hasVercelAiGateway ? "AI Gateway" : "Story canon"}</span>
          </div>
          <div class="rounded-lg border border-stone-200 p-2.5">
            <span class="font-semibold text-stone-800">Telemetry:</span>{" "}
            <span>{hasAnalyticsEngine || hasBasin ? "Analytics / Basin" : "D1 rollup"}</span>
          </div>
        </div>
      </div>
    </details>
  </main>

  <script is:inline>
    (function () {
      var btn = document.getElementById("btn-reindex-braintrust");
      if (!btn) return;
      btn.addEventListener("click", function () {
        btn.disabled = true;
        btn.textContent = "Rebuilding...";
        fetch("/api/braintrust", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ action: "index" }),
        })
          .then(function (r) { return r.json(); })
          .then(function (d) {
            btn.disabled = false;
            btn.textContent = d && d.ok ? ("Indexed " + d.indexedCount + " entries") : "Rebuild failed";
          })
          .catch(function () {
            btn.disabled = false;
            btn.textContent = "Rebuild search index";
          });
      });
    })();
  </script>
</body>
</html>
