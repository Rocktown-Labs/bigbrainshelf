---
import "../../styles/global.css";
import AdminShell from "../../components/AdminShell.astro";
export const prerender = false;
// Book Club admin (operator redesign, 2026-10-29): three stat cards
// (boxes to pack, active members, club revenue per month), then the
// work in operator order — boxes needing action as cards with the
// resolve/status/tracking controls, members as clean rows, and
// reservations/canceled/founding cap in a quiet bottom section.
// Data comes from /api/admin/club (admin session required); every
// box action posts the same update_box action as before.
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>Book Club · Big Brain Shelf Admin</title>
  <style>
    html{-webkit-tap-highlight-color:transparent}
    .stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:18px 0 4px}
    .stat{background:#fff;border:1px solid #e7e5e4;border-radius:12px;padding:12px;box-shadow:0 1px 2px rgba(28,25,23,.05)}
    .stat .k{font-size:.64rem;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:#a8a29e;margin:0;line-height:1.3}
    .stat .v{font-size:1.45rem;font-weight:800;letter-spacing:-.02em;margin:.25rem 0 .1rem;font-variant-numeric:tabular-nums}
    .stat .s{font-size:.72rem;color:#78716c;margin:0;line-height:1.35}
    @media (min-width:640px){
      .stats{gap:14px}
      .stat{padding:16px 18px}
      .stat .k{font-size:.72rem;letter-spacing:.12em}
      .stat .v{font-size:1.9rem}
      .stat .s{font-size:.8rem}
    }
    .tap{touch-action:manipulation;-webkit-tap-highlight-color:transparent;user-select:none;-webkit-user-select:none;-webkit-touch-callout:none}
    .tap:active{background:#f5f5f4}
    @media (hover:hover) and (pointer:fine){ .tap:hover{background:#fafaf9} }
    .bchip{display:inline-flex;align-items:center;font-size:.7rem;font-weight:700;padding:2px 8px;border-radius:999px;background:#f5f5f4;color:#57534e;white-space:nowrap}
    .bchip-needs_attention{background:#fef2f2;color:#b91c1c}
    .bchip-awaiting_selection,.bchip-preparing{background:#fffbeb;color:#b45309}
    .bchip-locked{background:#eef4fb;color:#1a3454}
    .bchip-shipped,.bchip-delivered{background:#ecfdf5;color:#047857}
    .bchip-good{background:#ecfdf5;color:#047857}
    .bchip-bad{background:#fef2f2;color:#b91c1c}
    .mono{font-family:ui-monospace,monospace;font-size:.72rem;word-break:break-all}
    input,select,textarea{font-size:16px}
    .ctl{width:100%;min-height:44px;border:1px solid #d6d3d1;border-radius:8px;padding:8px 10px;background:#fff}
    .abtn{min-height:44px;border-radius:8px;background:#1c1917;color:#fff;font-weight:700;font-size:.85rem;padding:8px 16px;white-space:nowrap}
    .abtn:active{background:#44403c}
  </style>
  </head>
<body class="bg-stone-50 text-stone-900 antialiased">
  <AdminShell current="/admin/club" />

  <main class="mx-auto max-w-6xl px-4 py-8" style="padding-bottom:calc(2rem + env(safe-area-inset-bottom, 0px))">
    <h1 class="text-2xl font-bold tracking-tight">Book Club</h1>
    <p class="text-sm text-stone-500 mt-1">Members, their boxes, and what needs packing.</p>

    <div class="stats">
      <div class="stat">
        <p class="k">Boxes to pack</p>
        <p class="v" id="stat-pack">–</p>
        <p class="s">Due now or flagged needs attention.</p>
      </div>
      <div class="stat">
        <p class="k">Active members</p>
        <p class="v" id="stat-members">–</p>
        <p class="s" id="stat-members-sub">Paid members, both clubs.</p>
      </div>
      <div class="stat">
        <p class="k">Club revenue / mo</p>
        <p class="v" id="stat-revenue">–</p>
        <p class="s">Monthly equivalent, both clubs.</p>
      </div>
    </div>

    <h2 class="mt-9 text-xl font-bold tracking-tight">Boxes to pack</h2>
    <p id="box-counts" class="mt-1.5 flex flex-wrap gap-1.5 text-xs text-stone-400"></p>
    <div id="pack-list" class="mt-3 flex flex-col gap-3">
      <p class="text-stone-400 text-sm">Loading...</p>
    </div>
    <p id="box-msg" class="mt-3 text-sm text-stone-500" role="status"></p>

    <h2 class="mt-10 text-xl font-bold tracking-tight">Members</h2>
    <div class="mt-3 overflow-x-auto rounded-xl border border-stone-200 bg-white">
      <table class="w-full text-sm" id="member-table">
        <thead>
          <tr class="text-left text-xs uppercase tracking-wide text-stone-400 border-b border-stone-200">
            <th class="px-4 py-2.5 font-bold"><button type="button" class="msort hover:text-orange-700" data-key="name">Member</button></th>
            <th class="px-4 py-2.5 font-bold"><button type="button" class="msort hover:text-orange-700" data-key="plan">Plan</button></th>
            <th class="px-4 py-2.5 font-bold"><button type="button" class="msort hover:text-orange-700" data-key="billing">Billing</button></th>
            <th class="px-4 py-2.5 font-bold"><button type="button" class="msort hover:text-orange-700" data-key="joined">Joined</button></th>
            <th class="px-4 py-2.5 font-bold">Next</th>
          </tr>
        </thead>
        <tbody id="member-rows">
          <tr><td colspan="5" class="px-4 py-3 text-stone-400">Loading...</td></tr>
        </tbody>
      </table>
    </div>
    <div id="member-pager" class="mt-3 hidden items-center justify-between gap-3">
      <button id="mpage-prev" type="button" class="rounded-lg bg-white border border-stone-300 text-sm font-semibold px-4 min-h-[40px]">‹ Prev</button>
      <span id="mpage-label" class="text-sm text-stone-500"></span>
      <button id="mpage-next" type="button" class="rounded-lg bg-white border border-stone-300 text-sm font-semibold px-4 min-h-[40px]">Next ›</button>
    </div>

    <!-- Member detail drawer: slides in from the right so the
         table never has to stretch (CG, 2026-10-31). -->
    <div id="member-drawer" class="fixed inset-0 z-50 hidden" role="dialog" aria-modal="true" aria-label="Member details">
      <div class="absolute inset-0 bg-stone-950/50" data-mdrawer-close></div>
      <aside class="panel absolute right-0 top-0 h-full w-[min(92vw,430px)] bg-white shadow-2xl overflow-y-auto">
        <div class="sticky top-0 bg-white border-b-2 border-orange-500 px-5 py-3 flex items-center justify-between z-10">
          <span class="flex items-center gap-2.5">
            <img src="/logo-stacked.png" alt="Big Brain Shelf" class="h-7 w-auto" />
            <h3 class="font-extrabold tracking-tight">Member</h3>
          </span>
          <button id="mdrawer-close" type="button" class="text-2xl leading-none text-stone-400 hover:text-stone-700 px-1" aria-label="Close member details">&times;</button>
        </div>
        <div id="member-drawer-body" class="px-5 py-4"></div>
      </aside>
    </div>

    <div id="more-boxes-wrap" class="hidden">
      <h2 class="mt-10 text-xl font-bold tracking-tight">More boxes</h2>
      <p class="text-sm text-stone-500 mt-1">Shipped boxes still in transit, and finished ones.</p>
      <div id="more-boxes" class="mt-3 flex flex-col gap-3"></div>
    </div>

    <div class="mt-12 border-t border-stone-200 pt-5">
      <h2 class="text-sm font-bold uppercase tracking-wide text-stone-400">Reservations &amp; canceled</h2>
      <p id="founding-line" class="text-sm text-stone-400 mt-2"></p>
      <div id="bottom-list" class="mt-2 flex flex-col"></div>
    </div>
  </main>

  <script is:inline>
    function esc(s) {
      return String(s == null ? "" : s).replace(/[&<>"']/g, function (c) {
        return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
      });
    }
    function fmtDate(ts) {
      return new Date((ts || 0) * 1000).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });
    }
    function money(cents) { return "$" + ((cents || 0) / 100).toFixed(2); }
    function chicagoToday() {
      var parts = new Intl.DateTimeFormat("en-US", { timeZone: "America/Chicago", year: "numeric", month: "2-digit", day: "2-digit" }).formatToParts(new Date());
      var g = function (t) { var p = parts.find(function (x) { return x.type === t; }); return p ? p.value : ""; };
      return g("year") + "-" + g("month") + "-" + g("day");
    }
    function fmtShipDate(s) {
      var p = String(s || "").split("-");
      if (p.length !== 3) return String(s || "");
      return new Date(Number(p[0]), Number(p[1]) - 1, Number(p[2])).toLocaleDateString("en-US", { month: "short", day: "numeric" });
    }
    function humanStatus(s) { return String(s || "").replace(/_/g, " "); }

    var BOX_STATUSES = ["awaiting_selection", "locked", "preparing", "shipped", "delivered", "needs_attention", "skipped", "canceled"];
    var TERMINAL = ["delivered", "skipped", "canceled"];
    var bookOptionsHtml = "";

    function needsPacking(b, today) {
      if (b.status === "needs_attention") return true;
      return ["awaiting_selection", "locked", "preparing"].indexOf(b.status) >= 0 && String(b.ship_date) <= today;
    }
    function dueBadge(b, today) {
      if (TERMINAL.indexOf(b.status) >= 0) return "";
      if (String(b.ship_date) < today) return ' · <span class="text-red-600 font-semibold">overdue</span>';
      if (String(b.ship_date) === today) return ' · <span class="text-amber-600 font-semibold">due today</span>';
      return "";
    }

    function boxCard(b, today) {
      var choice = b.selected_book_slug ? ("Member pick" + (b.allow_repeat ? " (repeat/gift)" : "")) : (b.selection_source === "admin" ? "Admin" : "Surprise me");
      var bookLabel = b.resolved_title || b.selected_title || ((b.selected_book_slug || b.resolved_book_slug) ? "Title unavailable" : "Not resolved yet");
      var secondLabel = b.second_resolved_title || b.second_selected_title || ((b.second_selected_book_slug || b.second_resolved_book_slug) ? "Title unavailable" : "Not resolved yet");
      var terminal = TERMINAL.indexOf(b.status) >= 0;
      var statusOptions = BOX_STATUSES.map(function (s) {
        return "<option value='" + s + "'" + (s === b.status ? " selected" : "") + ">" + humanStatus(s) + "</option>";
      }).join("");
      var card = document.createElement("div");
      card.className = "rounded-xl bg-white border border-stone-200 px-4 py-3.5";
      card.setAttribute("data-box-id", b.id);
      var controls = terminal
        ? '<p class="text-sm text-stone-400 mt-3">Done</p>'
        : '<div class="mt-3.5 flex flex-col gap-2.5">' +
            '<div class="flex gap-2 items-end"><label class="flex-1 min-w-0"><span class="block text-xs font-semibold text-stone-400 mb-1">Club book (gift set)</span>' +
              "<select class='box-book ctl'><option value=''>Resolve club book...</option>" + bookOptionsHtml + "</select></label>" +
              "<button type='button' class='box-resolve abtn tap'>Resolve</button></div>" +
            '<div class="flex gap-2 items-end"><label class="flex-1 min-w-0"><span class="block text-xs font-semibold text-stone-400 mb-1">Second book</span>' +
              "<select class='box-book-2 ctl'><option value=''>Resolve second book...</option>" + bookOptionsHtml + "</select></label>" +
              "<button type='button' class='box-resolve-2 abtn tap'>Resolve</button></div>" +
            '<div class="flex gap-2 items-end"><label class="flex-1 min-w-0"><span class="block text-xs font-semibold text-stone-400 mb-1">Box status</span>' +
              "<select class='box-status ctl'>" + statusOptions + "</select></label>" +
              "<button type='button' class='box-save-status abtn tap'>Save</button></div>" +
            '<div class="flex gap-2"><label class="w-28"><span class="block text-xs font-semibold text-stone-400 mb-1">Carrier</span>' +
              "<input class='box-carrier ctl' placeholder='Carrier' value='" + esc(b.carrier || "") + "'></label>" +
              '<label class="flex-1"><span class="block text-xs font-semibold text-stone-400 mb-1">Tracking number</span>' +
              "<input class='box-tracking ctl' placeholder='Tracking number' value='" + esc(b.tracking_number || "") + "'></label></div>" +
          "</div>";
      card.innerHTML =
        '<div class="flex items-start gap-2">' +
          '<span class="font-bold min-w-0">' + esc(b.member_name || b.member_email || "Member") + "</span>" +
          '<span class="bchip bchip-' + esc(b.status) + ' ml-auto flex-none">' + esc(humanStatus(b.status)) + "</span>" +
        "</div>" +
        '<p class="text-sm text-stone-500 mt-0.5">' + esc(b.member_email || "") +
          " · Ships " + fmtShipDate(b.ship_date) + dueBadge(b, today) + " · " + esc(choice) +
          (b.member_subscription_status && b.member_subscription_status !== "active" ? '<br><span class="text-amber-600 font-medium">billing: ' + esc(humanStatus(b.member_subscription_status)) + "</span>" : "") +
        "</p>" +
        '<div class="text-sm mt-2.5 leading-relaxed">' +
          "<div><span class='text-stone-400'>Club book:</span> " + esc(bookLabel) + " <span class='text-stone-400'>(gift set)</span></div>" +
          "<div><span class='text-stone-400'>Second:</span> " + esc(secondLabel) + "</div>" +
          "<div class='text-stone-400'>Extras: sticker sheet + little extra</div>" +
          (b.tracking_number ? "<div class='mt-1 text-stone-500'>Tracking: " + esc((b.carrier ? b.carrier + " " : "") + b.tracking_number) + "</div>" : "") +
        "</div>" + controls;
      return card;
    }

    async function load() {
      var r = await fetch("/api/admin/club");
      var data = await r.json();
      var packList = document.getElementById("pack-list");
      if (!data.signups) {
        packList.innerHTML = '<p class="text-stone-400 text-sm">Could not load the club queue.</p>';
        return;
      }
      var today = chicagoToday();
      var shelfNames = { tech: "Tech", money: "Money", courage: "Courage" };

      // ---- Stat cards -------------------------------------------------
      document.getElementById("stat-pack").textContent = data.boxesToPack != null ? data.boxesToPack : "–";
      var paidPhysical = data.paidCount || 0;
      var paidAudio = data.paidAudioCount || 0;
      document.getElementById("stat-members").textContent = paidPhysical + paidAudio;
      document.getElementById("stat-members-sub").textContent = paidPhysical + " Book Club · " + paidAudio + " Audio Club";
      var monthlyCents = Math.round((data.quarterlyRevenueCents || 0) / 3) + (data.audioMonthlyRevenueCents || 0);
      document.getElementById("stat-revenue").textContent = money(monthlyCents);

      // ---- Boxes -------------------------------------------------------
      bookOptionsHtml = (data.eligibleBooks || []).map(function (b) {
        return "<option value='" + esc(b.slug) + "'>" + esc(b.title) + "</option>";
      }).join("");
      var byStatus = data.boxByStatus || {};
      document.getElementById("box-counts").innerHTML = BOX_STATUSES.filter(function (s) { return byStatus[s]; }).map(function (s) {
        return "<span class='rounded-full bg-white border border-stone-200 px-2.5 py-0.5'>" + esc(humanStatus(s)) + ": " + byStatus[s] + "</span>";
      }).join("") || "<span>No boxes yet. The scheduler creates them for paid members.</span>";
      var boxes = data.boxes || [];
      var pack = boxes.filter(function (b) { return needsPacking(b, today); });
      var rest = boxes.filter(function (b) { return !needsPacking(b, today); });
      packList.innerHTML = "";
      if (!pack.length) {
        packList.innerHTML = '<p class="text-stone-400 text-sm">Nothing to pack. You are caught up.</p>';
      }
      pack.forEach(function (b) { packList.appendChild(boxCard(b, today)); });
      var moreWrap = document.getElementById("more-boxes-wrap");
      var more = document.getElementById("more-boxes");
      more.innerHTML = "";
      if (rest.length) {
        moreWrap.classList.remove("hidden");
        rest.forEach(function (b) { more.appendChild(boxCard(b, today)); });
      } else {
        moreWrap.classList.add("hidden");
      }

      // ---- Members -----------------------------------------------------
      var statusText = function (s) {
        if (s.status === "paid") return "Paid member";
        if (s.status === "canceled") return "Canceled";
        if (s.status === "live") return "Live";
        return "Founding, queued";
      };
      var planText = function (s) {
        if (s.status !== "paid") return "";
        var period = s.plan === "annual" ? "Annual" : s.plan === "monthly" ? "Monthly" : "Quarterly";
        return (s.club_plan === "audio" ? "Audio Club · " : "Book Club · ") + period;
      };
      var members = data.signups.filter(function (s) { return s.status === "paid"; });
      // Sortable data table (CG, 2026-10-31): click a column
      // header to sort by it, click again to flip direction.
      // Rows link to the member page. Sorts the loaded set; the
      // API caps at 500 members, past which this goes server
      // paged like the reviews table.
      var memberSort = { key: "joined", dir: -1 };
      var sortVal = function (s, key) {
        if (key === "name") return String(s.name || s.email || "").toLowerCase();
        if (key === "plan") return planText(s);
        if (key === "billing") return String(s.subscription_status || "active");
        return Number(s.created_at || 0);
      };
      // Member detail opens in the right-side drawer (CG,
      // 2026-10-31): inline expansion does not scale, so the
      // table stays a table (sortable, 10 per page) and one
      // member's full picture (orders, boxes, billing) loads
      // into the drawer from the same API the list uses.
      var memberCache = {};
      var memberPage = 1;
      var MEMBER_PAGE_SIZE = 10;
      var drawerMemberId = null;
      var moneyC = function (c) { return "$" + ((Number(c) || 0) / 100).toFixed(2); };
      var shortOid = function (id) { return "#" + String(id || "").replace(/-/g, "").slice(0, 8).toUpperCase(); };
      var fmtTs = function (ts) {
        // Account rows carry millisecond epochs; club rows seconds.
        if (!ts) return "–";
        var ms = typeof ts === "number" ? (ts > 4102444800 ? ts : ts * 1000) : ts;
        return new Date(ms).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });
      };
      var panelHtml = function (d) {
        var m = d.member || {};
        var ords = d.orders || [];
        var acct = d.account || null;
        var boxes = d.boxes || [];
        var revs = d.reviews || [];
        var fact = function (k, v) { return '<div class="flex justify-between gap-4 py-1 border-b border-stone-100 last:border-0"><span class="text-stone-500">' + k + '</span><span class="font-semibold text-right">' + v + "</span></div>"; };
        var section = function (t) { return '<p class="mt-5 mb-1 text-xs font-bold uppercase tracking-wide text-stone-400">' + t + "</p>"; };
        var clubLabel = (m.club_plan === "audio" ? "The Audio Club" : "The Book Club") + " · " + (m.plan === "annual" ? "Annual" : m.plan === "monthly" ? "Monthly" : "Quarterly");
        var billing = m.canceled_at ? '<span class="bchip bchip-bad">Canceled ' + esc(fmtDate(m.canceled_at)) + "</span>"
          : m.payment_failed_at ? '<span class="bchip bchip-bad">Payment failed ' + esc(fmtDate(m.payment_failed_at)) + "</span>"
          : '<span class="bchip bchip-good">' + esc(humanStatus(m.subscription_status || m.status || "active")) + "</span>";
        // Identity header: who this customer is, at a glance.
        var h = '<div class="rounded-xl bg-stone-50 border border-stone-200 px-4 py-3.5">' +
          '<p class="text-lg font-extrabold tracking-tight leading-tight">' + esc(m.name || acct?.name || m.email || "Member") + "</p>" +
          '<p class="text-sm text-stone-500">' + esc(m.email || "") + "</p>" +
          '<p class="mt-2 flex flex-wrap gap-1.5"><span class="bchip" style="background:#1c1917;color:#fff">' + esc(clubLabel) + "</span> " + billing + "</p></div>";
        // Club and billing.
        h += section("Club & billing") + '<div class="text-sm">' +
          fact("Joined the club", esc(fmtDate(m.created_at))) +
          (m.paid_at ? fact("First paid", esc(fmtDate(m.paid_at))) : "") +
          (m.first_ship_date ? fact("First box ships", esc(m.first_ship_date)) : "") +
          (m.shelf ? fact("Shelf", esc(humanStatus(m.shelf))) : "") +
          "</div>";
        // Store account.
        h += section("Store account");
        if (acct) {
          h += '<div class="text-sm">' +
            fact("Account", "Linked" + (acct.emailVerified ? " · email verified" : "")) +
            (acct.name && acct.name !== m.name ? fact("Account name", esc(acct.name)) : "") +
            fact("Member since", esc(fmtTs(acct.createdAt))) +
            (acct.role && acct.role !== "user" ? fact("Role", esc(acct.role)) : "") +
            (acct.banned ? fact("Standing", '<span class="bchip bchip-bad">Banned</span>') : "") +
            "</div>";
        } else {
          h += '<p class="text-sm text-stone-500">No store account linked yet. Their orders still match by email.</p>';
        }
        // Orders.
        h += section("Orders · " + ords.length + " · " + moneyC(d.total_spent_cents) + " lifetime");
        if (ords.length) {
          h += ords.map(function (o) {
            return '<div class="flex justify-between gap-4 py-1.5 border-b border-stone-100 last:border-0 text-sm"><span><a class="font-semibold text-orange-700" href="/admin/orders/' + o.id + '">' + shortOid(o.id) + "</a> <span class=\"text-stone-400\">" + esc(fmtDate(o.created_at)) + "</span><br><span class=\"text-stone-600\">" + (o.items_display || []).map(esc).join("<br>") + "</span></span>" +
              '<span class="font-semibold whitespace-nowrap text-right">' + moneyC(o.amount) + (o.shipping_cents ? '<br><span class="text-xs font-medium text-stone-400">+ ' + moneyC(o.shipping_cents) + " shipping</span>" : "") + (o.physical_status ? '<br><span class="bchip">' + esc(humanStatus(o.physical_status)) + "</span>" : "") + "</span></div>";
          }).join("");
        } else {
          h += '<p class="text-sm text-stone-500">No store orders yet.</p>';
        }
        // Ships to.
        if (d.shipping && (d.shipping.name || d.shipping.address)) {
          var a = d.shipping.address || {};
          var lines = a.raw ? [a.raw] : [a.line1, a.line2, [a.city, a.state, a.postal_code].filter(Boolean).join(", "), a.country].filter(Boolean);
          h += section("Ships to") + '<p class="text-sm">' + (d.shipping.name ? "<span class=\"font-semibold\">" + esc(d.shipping.name) + "</span><br>" : "") + lines.map(esc).join("<br>") + "</p>";
        }
        // Boxes.
        if (boxes.length) {
          h += section("Boxes") + boxes.map(function (b) {
            return '<div class="flex justify-between py-1 border-b border-stone-100 last:border-0 text-sm"><span>' + esc(b.ship_date) + '</span><span class="font-semibold">' + esc(humanStatus(b.status)) + (b.tracking_number ? ' <span class="text-stone-400">' + esc(b.tracking_number) + "</span>" : "") + "</span></div>";
          }).join("");
        }
        // Reviews they wrote.
        if (revs.length) {
          h += section("Their reviews") + revs.map(function (r) {
            var stars = "★★★★★".slice(0, Math.max(0, Math.min(5, Number(r.rating) || 0)));
            return '<div class="flex justify-between gap-4 py-1 border-b border-stone-100 last:border-0 text-sm"><span>' + esc(r.book_title || "A book") + ' <span class="text-stone-400">' + esc(fmtDate(r.created_at)) + '</span></span><span class="whitespace-nowrap"><span style="color:#f59e0b">' + stars + '</span> <span class="bchip">' + esc(humanStatus(r.status)) + "</span></span></div>";
          }).join("");
        }
        // IDs, small and copyable.
        h += '<div class="mt-5 rounded-xl bg-stone-50 border border-stone-200 px-4 py-3 text-xs text-stone-500 flex flex-col gap-1">' +
          "<span>Club Stripe customer · <span class=\"mono\">" + esc(m.stripe_customer_id || "–") + "</span></span>" +
          "<span>Subscription · <span class=\"mono\">" + esc(m.stripe_subscription_id || "–") + "</span></span>" +
          (acct?.stripe_customer_id && acct.stripe_customer_id !== m.stripe_customer_id ? "<span>Account Stripe customer · <span class=\"mono\">" + esc(acct.stripe_customer_id) + "</span></span>" : "") +
          '<span class="mt-1"><a class="text-orange-700 font-semibold text-sm" href="/admin/club/' + m.id + '">Open member page</a></span></div>';
        return h;
      };
      var openDrawer = function (id) {
        drawerMemberId = id;
        var drawer = document.getElementById("member-drawer");
        var bodyEl = document.getElementById("member-drawer-body");
        drawer.classList.remove("hidden");
        document.body.style.overflow = "hidden";
        var cached = memberCache[id];
        if (cached && cached !== "loading") { bodyEl.innerHTML = panelHtml(cached); return; }
        bodyEl.innerHTML = '<p class="text-sm text-stone-400">Loading member...</p>';
        memberCache[id] = "loading";
        fetch("/api/admin/club?member_id=" + encodeURIComponent(id)).then(function (r) { return r.json(); }).then(function (d) {
          memberCache[id] = d;
          if (drawerMemberId === id) bodyEl.innerHTML = panelHtml(d);
        }).catch(function () {
          memberCache[id] = null;
          if (drawerMemberId === id) bodyEl.innerHTML = '<p class="text-sm text-red-600">Could not load this member.</p>';
        });
      };
      var closeDrawer = function () {
        drawerMemberId = null;
        document.getElementById("member-drawer").classList.add("hidden");
        document.body.style.overflow = "";
      };
      document.getElementById("mdrawer-close").addEventListener("click", closeDrawer);
      document.querySelector("[data-mdrawer-close]").addEventListener("click", closeDrawer);
      document.addEventListener("keydown", function (ev) { if (ev.key === "Escape" && drawerMemberId) closeDrawer(); });
      var renderMembers = function () {
        var tbody = document.getElementById("member-rows");
        if (!tbody) return;
        var sorted = members.slice().sort(function (a, b) {
          var va = sortVal(a, memberSort.key), vb = sortVal(b, memberSort.key);
          if (va < vb) return -1 * memberSort.dir;
          if (va > vb) return 1 * memberSort.dir;
          return 0;
        });
        var pager = document.getElementById("member-pager");
        if (!sorted.length) {
          tbody.innerHTML = '<tr><td colspan="5" class="px-4 py-3 text-stone-400">No paid members yet.</td></tr>';
          pager.classList.add("hidden");
          pager.classList.remove("flex");
          return;
        }
        var pages = Math.max(1, Math.ceil(sorted.length / MEMBER_PAGE_SIZE));
        if (memberPage > pages) memberPage = pages;
        var pageRows = sorted.slice((memberPage - 1) * MEMBER_PAGE_SIZE, memberPage * MEMBER_PAGE_SIZE);
        tbody.innerHTML = pageRows.map(function (s) {
          var billing = s.subscription_status && s.subscription_status !== "active"
            ? '<span class="bchip" style="background:#fffbeb;color:#b45309">' + esc(humanStatus(s.subscription_status)) + "</span>"
            : '<span class="text-stone-500">Active</span>';
          var nextLine = s.club_plan !== "audio" && s.next_box_due
            ? "Box " + esc(s.next_box_due) + (s.next_box_status ? " · " + esc(humanStatus(s.next_box_status)) : "")
            : (s.club_plan === "audio" ? "Listening only" : "");
          return '<tr class="border-b border-stone-100 last:border-0 hover:bg-stone-50">' +
            '<td class="px-4 py-2.5"><button type="button" class="mtoggle font-bold text-orange-700 text-left" data-mid="' + s.id + '">' + esc(s.name || s.email) + "</button>" +
              (s.name ? '<div class="text-xs text-stone-400 truncate">' + esc(s.email) + "</div>" : "") + "</td>" +
            '<td class="px-4 py-2.5 whitespace-nowrap">' + esc(planText(s)) + "</td>" +
            '<td class="px-4 py-2.5">' + billing + "</td>" +
            '<td class="px-4 py-2.5 whitespace-nowrap">' + esc(fmtDate(s.created_at)) + "</td>" +
            '<td class="px-4 py-2.5 text-stone-500">' + esc(nextLine) + "</td></tr>";
        }).join("");
        pager.classList.remove("hidden");
        pager.classList.add("flex");
        document.getElementById("mpage-label").textContent = "Page " + memberPage + " of " + pages + " · " + sorted.length + (sorted.length === 1 ? " member" : " members");
        document.getElementById("mpage-prev").disabled = memberPage <= 1;
        document.getElementById("mpage-next").disabled = memberPage >= pages;
        document.querySelectorAll(".msort").forEach(function (btn) {
          var arrow = btn.getAttribute("data-key") === memberSort.key ? (memberSort.dir === 1 ? " ↑" : " ↓") : "";
          btn.textContent = btn.getAttribute("data-label") + arrow;
        });
        tbody.querySelectorAll(".mtoggle").forEach(function (btn) {
          btn.addEventListener("click", function () { openDrawer(btn.getAttribute("data-mid")); });
        });
      };
      document.getElementById("mpage-prev").addEventListener("click", function () { if (memberPage > 1) { memberPage -= 1; renderMembers(); } });
      document.getElementById("mpage-next").addEventListener("click", function () { memberPage += 1; renderMembers(); });
      document.querySelectorAll(".msort").forEach(function (btn) {
        btn.setAttribute("data-label", btn.textContent);
        btn.addEventListener("click", function () {
          var key = btn.getAttribute("data-key");
          if (memberSort.key === key) memberSort.dir *= -1;
          else memberSort = { key: key, dir: 1 };
          memberPage = 1;
          renderMembers();
        });
      });
      renderMembers();

      // ---- Quiet bottom: reservations, canceled ----------------------
      document.getElementById("founding-line").textContent =
        paidPhysical + " paid physical members";
      var bottom = document.getElementById("bottom-list");
      bottom.innerHTML = "";
      var quiet = data.signups.filter(function (s) { return s.status !== "paid"; });
      if (!quiet.length) {
        bottom.innerHTML = '<p class="text-sm text-stone-400">No queued reservations or canceled accounts.</p>';
      }
      quiet.forEach(function (s) {
        var row = document.createElement("div");
        row.className = "py-2 border-b border-stone-100 last:border-0 flex items-baseline gap-2 text-sm text-stone-400";
        row.innerHTML =
          '<a class="font-medium text-stone-500 hover:text-orange-700" href="/admin/club/' + s.id + '">' + esc(s.name || s.email) + "</a>" +
          (s.name ? '<span class="truncate">' + esc(s.email) + "</span>" : "") +
          '<span class="ml-auto flex-none">' + esc(statusText(s)) + " · " + esc(shelfNames[s.shelf] || s.shelf || "") + " shelf · " + fmtDate(s.created_at) + "</span>";
        bottom.appendChild(row);
      });
    }

    async function boxAction(boxId, payload) {
      var msg = document.getElementById("box-msg");
      msg.textContent = "Saving...";
      var r = await fetch("/api/admin/club", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(Object.assign({ action: "update_box", box_id: boxId }, payload)),
      });
      var data = await r.json().catch(function () { return {}; });
      if (!r.ok) {
        msg.textContent = data.error || "Could not update the box.";
        return;
      }
      msg.textContent = "Box updated.";
      load();
    }

    document.addEventListener("click", function (e) {
      var resolveBtn = e.target.closest(".box-resolve");
      var resolve2Btn = e.target.closest(".box-resolve-2");
      var statusBtn = e.target.closest(".box-save-status");
      if (!resolveBtn && !resolve2Btn && !statusBtn) return;
      var card = e.target.closest("[data-box-id]");
      if (!card) return;
      var boxId = card.getAttribute("data-box-id");
      if (resolveBtn || resolve2Btn) {
        var slug = card.querySelector(resolveBtn ? ".box-book" : ".box-book-2").value;
        if (!slug) { document.getElementById("box-msg").textContent = "Pick a book first."; return; }
        boxAction(boxId, resolveBtn ? { book_slug: slug } : { book_slug: slug, slot: 2 });
      } else {
        boxAction(boxId, {
          status: card.querySelector(".box-status").value,
          carrier: card.querySelector(".box-carrier").value || null,
          tracking_number: card.querySelector(".box-tracking").value || null,
        });
      }
    });

    load();
  </script>
  <script is:inline>
    document.querySelectorAll(".js-signout").forEach(function (el) {
      el.addEventListener("click", async function (e) {
        e.preventDefault();
        await fetch("/api/admin-auth/logout", { method: "POST" });
        await fetch("/api/auth/sign-out", { method: "POST", headers: { "Content-Type": "application/json" }, body: "{}" }).catch(function () {});
        window.location.href = "/login";
      });
    });
  </script>
</body>
</html>
