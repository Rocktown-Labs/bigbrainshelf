---
import "../../styles/global.css";
import AdminShell from "../../components/AdminShell.astro";
export const prerender = false;
// Orders admin (operator redesign, 2026-10-29): three stat cards, a
// slim outbox strip, filter tabs, and the orders as a slim table
// (Date | Customer + Order ID | Items | Price | Format circles |
// next step) in the daisyUI table aesthetic, hand-rolled per the
// shadcn precedent. The customer cell leads with the buyer name
// (ship_name, email as the fallback) so rows are told apart at a
// glance; the short order id rides under it.
// The full order (buyer, address, label flow, email history) lives
// on /admin/orders/[id]. Data comes from /api/admin/orders (admin
// session required).
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>Orders · Big Brain Shelf Admin</title>
  <!-- is:global on purpose: the table rows are injected by the page
       script at runtime, and Astro's scoped styles carry a
       data-astro-cid attribute that injected nodes never get, so
       scoped rules silently miss them (that defect shipped giant
       unconstrained chip SVGs in these rows). Global rules reach
       injected DOM. Class names here are page-specific. -->
  <style is:global>
    html{-webkit-tap-highlight-color:transparent}
    /* Stat row: exactly three across at every width (dashboard style). */
    .stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:18px 0 4px}
    .stat{background:#fff;border:1px solid #e7e5e4;border-radius:12px;padding:12px;box-shadow:0 1px 2px rgba(28,25,23,.05)}
    .stat .k{font-size:.64rem;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:#a8a29e;margin:0;line-height:1.3}
    .stat .v{font-size:1.45rem;font-weight:800;letter-spacing:-.02em;margin:.25rem 0 .1rem;font-variant-numeric:tabular-nums}
    .stat .s{font-size:.72rem;color:#78716c;margin:0;line-height:1.35}
    @media (min-width:640px){
      .stats{gap:14px}
      .stat{padding:16px 18px}
      .stat .k{font-size:.72rem;letter-spacing:.12em}
      .stat .v{font-size:1.9rem}
      .stat .s{font-size:.8rem}
    }
    .tap{touch-action:manipulation;-webkit-tap-highlight-color:transparent;user-select:none;-webkit-user-select:none;-webkit-touch-callout:none}
    /* Filter tabs: segmented pills with counts, 44px touch targets. */
    .tabbtn{touch-action:manipulation;-webkit-tap-highlight-color:transparent;user-select:none;-webkit-user-select:none;display:inline-flex;align-items:center;gap:6px;min-height:44px;padding:8px 14px;border-radius:999px;border:1px solid #e7e5e4;background:#fff;font-size:.85rem;font-weight:600;color:#57534e;cursor:pointer}
    .tabbtn .n{font-variant-numeric:tabular-nums;font-weight:800}
    .tabbtn[aria-selected="true"]{background:#1c1917;border-color:#1c1917;color:#fff}
    .tabbtn:active{transform:scale(.97)}
    /* Orders admin redo (prototype v3): lane banner, filter chips,
       search, bulk bar, cover thumbs, stage pills. */
    .lane-banner{margin-top:14px;border-radius:10px;padding:9px 14px;font-size:.85rem;font-weight:600;border:1px solid #fde68a;background:#fffbeb;color:#92400e}
    .lane-banner.on{border-color:#bbf7d0;background:#f0fdf4;color:#166534}
    .filterbar{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-top:16px}
    .searchbox{flex:1;min-width:180px;display:flex;align-items:center;gap:8px;background:#fff;border:1px solid #e7e5e4;border-radius:10px;padding:0 12px;min-height:44px}
    .searchbox input{border:0;outline:0;flex:1;font-size:16px;background:transparent;min-height:42px}
    .kchip{touch-action:manipulation;display:inline-flex;align-items:center;gap:6px;min-height:38px;padding:6px 13px;border-radius:999px;border:1px solid #e7e5e4;background:#fff;font-size:.83rem;font-weight:600;color:#57534e;cursor:pointer}
    .kchip .n{font-variant-numeric:tabular-nums;font-weight:800}
    .kchip[aria-pressed="true"]{background:#1c1917;border-color:#1c1917;color:#fff}
    .kchip:active{transform:scale(.97)}
    .kchip.saved[aria-pressed="true"]{background:#9a3412;border-color:#9a3412}
    .stagesel,.perpagesel{min-height:44px;border:1px solid #e7e5e4;border-radius:10px;background:#fff;padding:6px 10px;font-size:.85rem;font-weight:600;color:#44403c}
    .bulkbar{display:none;margin-top:12px;background:#1c1917;color:#fff;border-radius:12px;padding:8px 12px;align-items:center;gap:8px;flex-wrap:wrap}
    .bulkbar.show{display:flex}
    .bulkbar .n{font-weight:800;font-size:.88rem;margin-right:2px}
    .bulkbar button{background:#fff;color:#1c1917;border:0;border-radius:8px;padding:8px 13px;font-size:.82rem;font-weight:700;cursor:pointer;min-height:38px}
    .bulkbar button.clear{background:transparent;color:#d6d3d1}
    .bulkbar .res{font-size:.8rem;color:#fde68a;width:100%}
    .covers-line{display:flex;gap:4px;margin-bottom:4px}
    .covers-line img{width:26px;height:34px;object-fit:cover;border-radius:3px;border:1px solid #e7e5e4;background:#f5f5f4;display:block}
    .stagepill{display:inline-block;font-size:.72rem;font-weight:800;border-radius:999px;padding:3px 9px;white-space:nowrap}
    .stagepill.ok{background:#ecfdf5;color:#047857}
    .stagepill.progress{background:#eff6ff;color:#1d4ed8}
    .stagepill.attention{background:#fffbeb;color:#b45309}
    .stagepill.exception{background:#fef2f2;color:#b91c1c}
    .stagepill.muted{background:#f5f5f4;color:#57534e}
    .age-cell{font-size:.8rem;color:#78716c;white-space:nowrap;font-variant-numeric:tabular-nums}
    .kind-cell{font-size:.8rem;font-weight:700;color:#44403c;white-space:nowrap}
    .c-check{width:40px}
    .c-order{width:19%}
    .c-contents{width:32%}
    .c-kind{width:11%}
    .c-stage{width:19%}
    .c-age{display:none}
    .c-total{width:11%}
    .c-act2{width:48px}
    @media (min-width:768px){ .c-age{display:table-cell;width:9%} .c-order{width:16%} .c-contents{width:29%} }
    /* The orders table (daisyUI table aesthetic, hand-rolled in the
       admin's CSS per the shadcn precedent: slim rows, zebra
       striping, hover highlight, quiet uppercase headers). Fixed
       layout with budgeted widths, so it never stretches; on mobile
       only the priority columns render (Order ID, Items, Price,
       Format, Action) and Date joins at md and up. The format
       circles themselves (.fcircle, .fmt-*) live in the global
       stylesheet, shared with the other order views. */
    .otable{width:100%;border-collapse:collapse;table-layout:fixed;background:#fff}
    .otable th{font-size:.68rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:#a8a29e;text-align:left;padding:9px 12px;border-bottom:1px solid #e7e5e4;background:#fafaf9}
    .otable td{padding:10px 12px;border-bottom:1px solid #f5f5f4;vertical-align:middle}
    .otable tbody tr{cursor:pointer}
    .otable tbody tr:nth-child(even){background:#fafaf9}
    .otable tbody tr:last-child td{border-bottom:0}
    .otable tbody tr:active{background:#f5f5f4}
    @media (hover:hover) and (pointer:fine){
      .otable tbody tr:hover{background:#f5f5f4}
    }
    .c-id{width:23%}.c-items{width:31%}.c-price{width:13%}.c-fmt{width:15%}.c-act{width:18%}
    .c-date{display:none}
    @media (min-width:768px){
      .c-date{display:table-cell;width:11%}
      .c-id{width:15%}.c-items{width:32%}.c-price{width:10%}.c-fmt{width:13%}.c-act{width:19%}
    }
    .pick-more{color:#a8a29e;font-weight:600}
    /* Row kebab (three-dots) menu: the button sits beside the next-
       step button in the actions cell with a full 44px tap target.
       The menu itself is ONE shared element on document.body with
       position:fixed, because the table wrapper clips overflow and
       a per-row dropdown would be cut off; the script positions it
       from the tapped button and clamps it inside the viewport. */
    .kebab{display:inline-flex;align-items:center;justify-content:center;width:44px;height:44px;flex:none;border-radius:10px;color:#57534e;cursor:pointer;touch-action:manipulation;-webkit-tap-highlight-color:transparent}
    .kebab:active{background:#f5f5f4;transform:scale(.94)}
    @media (hover:hover) and (pointer:fine){.kebab:hover{background:#f5f5f4}}
    .rowmenu{position:fixed;z-index:60;min-width:214px;max-width:calc(100vw - 16px);background:#fff;border:1px solid #e7e5e4;border-radius:12px;box-shadow:0 12px 32px rgba(28,25,23,.18);padding:6px}
    .rowmenu-item{display:flex;align-items:center;width:100%;min-height:44px;padding:8px 12px;border-radius:8px;font-size:.9rem;font-weight:600;color:#1c1917;text-align:left;cursor:pointer;text-decoration:none;box-sizing:border-box;touch-action:manipulation;-webkit-tap-highlight-color:transparent}
    .rowmenu-item:active{background:#f5f5f4}
    @media (hover:hover) and (pointer:fine){.rowmenu-item:hover{background:#f5f5f4}}
    /* Packing shelf (S4): compact cards for everything awaiting
       fulfillment, store orders and club boxes together. A card is
       cover + ref + contents count + stage; tapping opens the one
       fulfillment view for that parcel. */
    .packshelf{display:flex;gap:10px;overflow-x:auto;padding:2px 2px 8px;-webkit-overflow-scrolling:touch}
    .packcard{flex:none;width:128px;background:#fff;border:1px solid #e7e5e4;border-radius:12px;padding:8px;text-decoration:none;color:inherit;box-shadow:0 1px 2px rgba(28,25,23,.05)}
    .packcard:active{transform:scale(.98)}
    .packcard img,.packcard .pack-nocover{display:block;width:100%;height:96px;object-fit:cover;border-radius:8px;background:#f5f5f4}
    .packcard .pack-nocover{display:grid;place-items:center;color:#a8a29e;font-size:.7rem;font-weight:700}
    .packcard .pack-ref{display:block;font-size:.78rem;font-weight:800;letter-spacing:-.01em;margin-top:7px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .packcard .pack-meta{display:block;font-size:.7rem;color:#78716c;margin-top:1px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .packcard .pack-stage{display:inline-block;font-size:.64rem;font-weight:800;text-transform:uppercase;letter-spacing:.06em;color:#9a3412;background:#ffedd5;border-radius:999px;padding:2px 7px;margin-top:6px}
    .packcard .pack-stage.pick{color:#7c2d12;background:#fee2e2}
    .packcard .pack-stage.done{color:#065f46;background:#d1fae5}
    /* Completed section: finished parcels live behind one collapsed
       summary so the shelf above stays waiting work only. */
    #completed-details summary{list-style:none;min-height:32px;display:flex;align-items:center;gap:6px}
    #completed-details summary::-webkit-details-marker{display:none}
    #completed-details summary::after{content:"▾";color:#a8a29e;font-weight:800}
    #completed-details:not([open]) summary::after{content:"▸"}
    input,select,textarea{font-size:16px}
  </style>
  </head>
<body class="bg-stone-50 text-stone-900 antialiased">
  <AdminShell current="/admin/orders" />

  <main class="mx-auto max-w-6xl px-4 py-8" style="padding-bottom:calc(2rem + env(safe-area-inset-bottom, 0px))">
    <div class="flex flex-wrap items-start gap-3">
      <div class="flex-1 min-w-[220px]">
        <h1 class="text-2xl font-bold tracking-tight">Orders</h1>
        <p class="text-sm text-stone-500 mt-1">New orders, what needs shipping, and the email outbox.</p>
      </div>
      <a href="/admin/orders/new" class="tap inline-flex items-center rounded-lg bg-stone-900 text-white text-sm font-semibold px-4 min-h-[44px] no-underline">New manual order</a>
    </div>

    <div class="stats">
      <div class="stat">
        <p class="k">To fulfill</p>
        <p class="v" id="stat-fulfill">–</p>
        <p class="s">Printed orders received, in print, or packed, not yet shipped.</p>
      </div>
      <div class="stat">
        <p class="k">Orders, last 7 days</p>
        <p class="v" id="stat-orders7">–</p>
        <p class="s" id="stat-orders-total">All statuses.</p>
      </div>
      <div class="stat">
        <p class="k">Revenue, last 30 days</p>
        <p class="v" id="stat-revenue">–</p>
        <p class="s">Completed orders only.</p>
      </div>
    </div>

    <div id="outbox-strip" class="mt-5 rounded-xl bg-white border border-stone-200 px-4 py-3 flex flex-wrap items-center gap-x-3 gap-y-2">
      <span class="text-sm font-semibold">Email outbox</span>
      <span id="outbox-counts" class="text-sm text-stone-500">loading...</span>
      <span id="retry-result" class="text-sm text-stone-500"></span>
      <button id="retry-emails" class="tap ml-auto rounded-lg bg-stone-900 text-white text-sm font-semibold px-4 min-h-[44px] hover:bg-stone-700">Retry pending emails</button>
    </div>

    <div id="shippo-banner" class="mt-3 rounded-xl border px-4 py-2.5 text-sm hidden"></div>

    <section id="packing-shelf" class="mt-6 hidden" aria-label="Packing queue">
      <h2 class="text-base font-bold tracking-tight">What do we pack and ship?</h2>
      <p class="text-[13px] text-stone-500 mt-0.5">Store orders and club boxes waiting on us. Tap one to open it and pack it.</p>
      <div id="packing-cards" class="packshelf mt-3"></div>
    </section>
    <div id="packing-empty" class="mt-6 hidden rounded-xl bg-white border border-stone-200 px-4 py-4">
      <p class="text-sm font-semibold">Nothing waiting to pack.</p>
      <p class="text-[13px] text-stone-500 mt-0.5">New printed orders and club boxes land here as they come in.</p>
      <a href="/admin/books" class="tap inline-flex items-center mt-3 rounded-lg bg-stone-900 text-white text-sm font-semibold px-4 min-h-[44px]">Browse the book shelf</a>
    </div>

    <section id="completed-shelf" class="mt-4 hidden" aria-label="Completed parcels">
      <details id="completed-details" class="rounded-xl bg-white border border-stone-200 px-4 py-3 shadow-sm">
        <summary class="tap cursor-pointer text-sm font-bold">Completed <span id="completed-count" class="text-stone-500 font-semibold"></span></summary>
        <p class="text-[13px] text-stone-500 mt-1">Shipped and delivered parcels, newest first. Finished work lives here, off the packing shelf. Tap one to reopen it.</p>
        <div id="completed-cards" class="packshelf mt-3"></div>
      </details>
    </section>

    <div id="lane-banner" class="lane-banner">Lulu lane: checking…</div>

    <div class="filterbar" aria-label="Order filters">
      <label class="searchbox">
        <span aria-hidden="true">⌕</span>
        <input id="orders-search" type="search" placeholder="Search order id, email, tracking…" autocomplete="off" />
      </label>
      <select id="stage-select" class="stagesel" aria-label="Stage filter">
        <option value="all">All stages</option>
        <option value="needs_attention">Needs attention</option>
        <option value="queued">Job queued / cancel window</option>
        <option value="in_production">In production</option>
        <option value="home">At home (packing)</option>
        <option value="shipped">Shipped</option>
        <option value="delivered">Delivered</option>
      </select>
      <select id="per-page" class="perpagesel" aria-label="Orders per page">
        <option value="10">10 / page</option>
        <option value="25">25 / page</option>
        <option value="50">50 / page</option>
      </select>
    </div>
    <div class="filterbar" style="margin-top:8px" aria-label="Kind and saved filters">
      <span id="kind-chips" class="contents"></span>
      <button class="kchip saved" data-saved="needs_action" aria-pressed="false">Needs action</button>
      <button class="kchip saved" data-saved="shipping_today" aria-pressed="false">Shipping today</button>
      <button class="kchip saved" data-saved="stuck" aria-pressed="false">Stuck</button>
      <button class="kchip saved" data-saved="manual_waiting" aria-pressed="false">Manual waiting</button>
    </div>

    <div id="bulk-bar" class="bulkbar" aria-live="polite">
      <span class="n" id="bulk-count">0 selected</span>
      <button type="button" id="bulk-create-jobs">Create print jobs</button>
      <button type="button" id="bulk-sync">Sync Lulu status</button>
      <button type="button" id="bulk-export">Export CSV</button>
      <button type="button" class="clear" id="bulk-clear">Clear</button>
      <span class="res" id="bulk-result"></span>
    </div>

    <div class="mt-4 overflow-hidden rounded-xl border border-stone-200 bg-white shadow-sm">
      <table class="otable">
        <thead>
          <tr>
            <th class="c-check" scope="col"><input type="checkbox" id="check-all" aria-label="Select all on this page" /></th>
            <th class="c-order" scope="col">Order</th>
            <th class="c-contents" scope="col">Contents</th>
            <th class="c-kind" scope="col">Kind</th>
            <th class="c-stage" scope="col">Stage</th>
            <th class="c-age" scope="col">Age</th>
            <th class="c-total" scope="col">Total</th>
            <th class="c-act2" scope="col"><span class="sr-only">Action</span></th>
          </tr>
        </thead>
        <tbody id="orders-rows">
          <tr><td colspan="8" class="text-stone-400 text-sm">Loading...</td></tr>
        </tbody>
      </table>
      <p id="orders-empty" class="hidden px-4 py-6 text-sm text-stone-400"></p>
    </div>
    <div id="orders-pager" class="mt-4 hidden items-center justify-between gap-3">
      <button id="page-prev" class="tap rounded-lg bg-white border border-stone-300 text-sm font-semibold px-4 min-h-[44px]">‹ Newer</button>
      <span id="page-label" class="text-sm text-stone-500"></span>
      <button id="page-next" class="tap rounded-lg bg-white border border-stone-300 text-sm font-semibold px-4 min-h-[44px]">Older ›</button>
    </div>
  </main>

  <!-- Shared row actions menu (see .rowmenu styles above). -->
  <div id="row-menu" class="rowmenu" role="menu" hidden></div>

  <script is:inline>
    var FLOW = ["preorder_received", "in_print", "packed", "shipped", "delivered"];
    var LABELS = { preorder_received: "Received", in_print: "In print", packed: "Packed", shipped: "Shipped", delivered: "Delivered" };

    function esc(s) {
      return String(s == null ? "" : s).replace(/[&<>"']/g, function (c) {
        return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
      });
    }
    function fmtDay(ts) {
      var d = new Date((ts || 0) * 1000);
      var opts = { month: "short", day: "numeric" };
      if (d.getFullYear() !== new Date().getFullYear()) opts.year = "numeric";
      return d.toLocaleDateString("en-US", opts);
    }
    // Pick-list summary: the operator fulfills by character name
    // ("we need 1 Penny, 2 Miras"), so the Items cell shows short
    // names with counts; the Format cell carries one colored circle
    // per format in the order. The owner's color language: digital =
    // green circle, download icon; printed = yellow circle, book
    // icon; gift set = yellow circle, GIFT BOX icon (its own circle:
    // a gift set is not just a printed book, CG 2026-11-03); audio =
    // red circle, headphones icon (it fulfills automatically). The
    // full titles live on the order detail page; items_display
    // remains the fallback if a pick list is missing. The SVGs carry
    // fixed width/height attributes AND the .fcircle size rules in
    // the global stylesheet, so they can never balloon again.
    // Orders admin redo (prototype v3): the Contents cell holds the
    // covers and the item naming ONLY ("Mira digital bundle"); all
    // status language lives in the Stage column, and the prose
    // explanations live on the order page (CG, 2026-11-10).
    var FORMAT_NAMING = { digital: "digital bundle", printed: "printed", giftset: "gift set", audio: "audiobook", monthly: "club", quarterly: "club", annual: "club", yearly: "club" };
    var KIND_LABELS = { digital: "Digital", pod: "Printed (POD)", club: "Club" };
    function contentsHtml(o) {
      var pick = o.items_pick || [];
      var covers = (o.covers && o.covers.length ? o.covers : pick.map(function (g) { return g.cover; }).filter(Boolean).slice(0, 4));
      var thumbs = covers.length
        ? '<span class="covers-line">' + covers.map(function (c) { return '<img src="' + esc(c) + '" alt="" loading="lazy">'; }).join("") + "</span>"
        : "";
      var names;
      if (pick.length) {
        names = pick.map(function (g) {
          return esc((g.count > 1 ? g.count + " " : "") + g.name + " " + (FORMAT_NAMING[g.format] || g.format));
        }).join(", ");
      } else if (o.items_display && o.items_display.length) {
        names = esc(o.items_display.join(", "));
      } else {
        names = "Items unavailable";
      }
      return thumbs + '<span class="block truncate text-sm font-medium text-stone-700">' + names +
        (o.has_gift ? ' <span class="inline-block rounded-full bg-orange-100 text-orange-800 text-[10px] font-bold px-1.5 py-0.5 align-middle">Gift</span>' : "") +
        (o.pricing_mode === "admin_cost" ? ' <span class="inline-block rounded-full bg-sky-100 text-sky-800 text-[10px] font-bold px-1.5 py-0.5 align-middle">Admin cost</span>' : "") + "</span>";
    }
    function stagePill(stage) {
      if (!stage) return '<span class="stagepill muted">—</span>';
      return '<span class="stagepill ' + esc(stage.tone || "muted") + '">' + esc(stage.label || "") + "</span>";
    }
    function ageText(ts) {
      var s = Math.max(0, Math.floor(Date.now() / 1000) - (ts || 0));
      if (s < 3600) return Math.max(1, Math.floor(s / 60)) + "m";
      if (s < 86400) return Math.floor(s / 3600) + "h";
      var d = Math.floor(s / 86400);
      return d + (d === 1 ? " day" : " days");
    }
    function nextStatus(o) {
      var i = FLOW.indexOf(o.physical_status || "preorder_received");
      return i >= 0 && i < FLOW.length - 1 ? FLOW[i + 1] : null;
    }
    function money(cents) { return "$" + ((cents || 0) / 100).toFixed(2); }

    // Redo filter state. Selection holds across pages and filters
    // (prototype v3); the bulk bar reports per-row results.
    var F = { kind: "all", stage: "all", saved: "", q: "", perPage: 10, page: 1 };
    var selected = {};
    var ordersById = {};

    // ---- Row kebab menu -------------------------------------------
    // One shared fixed-position menu (see .rowmenu): items are the
    // order's real actions only. Stage items POST the same
    // set_physical_status action as the advance button and the
    // detail page; Print label deep-links to the detail page's
    // label section, where the quote + buy flow lives.
    var DOTS = '<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="12" cy="5" r="1.9"/><circle cx="12" cy="12" r="1.9"/><circle cx="12" cy="19" r="1.9"/></svg>';
    var menuEl = document.getElementById("row-menu");
    var menuOrderId = null;
    function closeMenu() {
      menuEl.hidden = true;
      menuEl.innerHTML = "";
      menuOrderId = null;
    }
    function menuItemsFor(o) {
      var items = [{ label: "View order", href: "/admin/orders/" + o.id }];
      if (o.physical_status && o.status === "complete") {
        if (!o.label_url) items.push({ label: "Print label", href: "/admin/orders/" + o.id + "#label" });
        var i = FLOW.indexOf(o.physical_status);
        if (i >= 0) {
          FLOW.slice(i + 1).forEach(function (s) {
            items.push({ label: "Mark " + LABELS[s], status: s });
          });
        }
      }
      items.push({ label: "Copy order ID", copy: true });
      return items;
    }
    function openMenu(o, anchor) {
      menuEl.innerHTML = "";
      menuItemsFor(o).forEach(function (it) {
        var el;
        if (it.href) {
          el = document.createElement("a");
          el.href = it.href;
        } else {
          el = document.createElement("button");
          el.type = "button";
        }
        el.className = "rowmenu-item";
        el.setAttribute("role", "menuitem");
        el.textContent = it.label;
        el.addEventListener("click", async function (ev) {
          ev.stopPropagation();
          if (it.status) {
            if (el.tagName === "BUTTON") el.disabled = true;
            closeMenu();
            var kr = await fetch("/api/admin/orders", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ action: "set_physical_status", order_id: o.id, status: it.status }),
            });
            if (!kr.ok) {
              var kerr = await kr.json().catch(function () { return {}; });
              alert(kerr.error || "That step is not ready yet. Open the order to see what is missing.");
            }
            load();
          } else if (it.copy) {
            try { await navigator.clipboard.writeText(o.id); } catch (e) { /* clipboard unavailable */ }
            closeMenu();
          } else {
            closeMenu();
          }
        });
        menuEl.appendChild(el);
      });
      menuEl.hidden = false;
      menuOrderId = o.id;
      // Position from the button, clamped inside the viewport;
      // opens upward when there is no room below.
      var r = anchor.getBoundingClientRect();
      var mw = menuEl.offsetWidth;
      var mh = menuEl.offsetHeight;
      var left = Math.max(8, Math.min(r.right - mw, window.innerWidth - mw - 8));
      var top = r.bottom + 6;
      if (top + mh > window.innerHeight - 8) top = Math.max(8, r.top - mh - 6);
      menuEl.style.left = left + "px";
      menuEl.style.top = top + "px";
    }
    document.addEventListener("click", function (ev) {
      if (!menuEl.hidden && !menuEl.contains(ev.target)) closeMenu();
    });
    document.addEventListener("keydown", function (ev) {
      if (ev.key === "Escape") closeMenu();
    });
    window.addEventListener("resize", closeMenu);
    document.addEventListener("scroll", closeMenu, true);

    // The packing shelf renders from the list payload's `packing`
    // queue (lib/packing.ts): compact cards, one per parcel awaiting
    // fulfillment. Empty queue shows the empty state with its CTA.
    function renderPacking(packing) {
      var shelf = document.getElementById("packing-shelf");
      var empty = document.getElementById("packing-empty");
      var cards = document.getElementById("packing-cards");
      var list = Array.isArray(packing) ? packing : [];
      if (!list.length) {
        shelf.classList.add("hidden");
        empty.classList.remove("hidden");
        return;
      }
      empty.classList.add("hidden");
      shelf.classList.remove("hidden");
      cards.innerHTML = list.map(function (p) {
        var meta = p.needsPick ? "Mystery box: pick the books" : (p.lines + (p.lines === 1 ? " item" : " items") + " to pack");
        return '<a class="packcard tap" href="' + esc(p.href) + '">' +
          (p.cover ? '<img src="' + esc(p.cover) + '" alt="" loading="lazy">' : '<span class="pack-nocover">Big Brain Shelf</span>') +
          '<span class="pack-ref">' + esc(p.ref) + "</span>" +
          '<span class="pack-meta">' + esc(meta) + "</span>" +
          '<span class="pack-stage' + (p.needsPick ? " pick" : "") + '">' + esc(p.stage) + "</span></a>";
      }).join("");
    }

    // The Completed section renders from the list payload's
    // packing_completed list (lib/packing.ts getCompletedParcels):
    // shipped and delivered parcels, collapsed by default, so the
    // shelf above it is waiting work only.
    function renderCompleted(list) {
      var section = document.getElementById("completed-shelf");
      var cards = document.getElementById("completed-cards");
      var count = document.getElementById("completed-count");
      var items = Array.isArray(list) ? list : [];
      if (!items.length) {
        section.classList.add("hidden");
        return;
      }
      section.classList.remove("hidden");
      count.textContent = "(" + items.length + ")";
      cards.innerHTML = items.map(function (p) {
        var meta = p.lines + (p.lines === 1 ? " item" : " items");
        return '<a class="packcard tap" href="' + esc(p.href) + '">' +
          (p.cover ? '<img src="' + esc(p.cover) + '" alt="" loading="lazy">' : '<span class="pack-nocover">Big Brain Shelf</span>') +
          '<span class="pack-ref">' + esc(p.ref) + "</span>" +
          '<span class="pack-meta">' + esc(meta) + "</span>" +
          '<span class="pack-stage done">' + esc(p.stage) + "</span></a>";
      }).join("");
    }

    function renderKindChips(counts) {
      var defs = [
        { key: "all", label: "All" },
        { key: "needs_attention", label: "Needs attention" },
        { key: "digital", label: "Digital" },
        { key: "pod", label: "Printed (POD)" },
        { key: "club", label: "Club boxes" }
      ];
      var wrap = document.getElementById("kind-chips");
      wrap.innerHTML = defs.map(function (d) {
        var n = d.key === "all" ? counts.all : d.key === "needs_attention" ? counts.needsAttention : counts[d.key];
        var pressed = d.key === "needs_attention" ? F.stage === "needs_attention" : F.kind === d.key;
        return '<button class="kchip" data-kind="' + d.key + '" aria-pressed="' + (pressed ? "true" : "false") + '">' + d.label + (n != null ? ' <span class="n">' + n + "</span>" : "") + "</button>";
      }).join("");
      wrap.querySelectorAll("[data-kind]").forEach(function (b) {
        b.addEventListener("click", function () {
          var k = b.getAttribute("data-kind");
          if (k === "needs_attention") {
            F.stage = F.stage === "needs_attention" ? "all" : "needs_attention";
            document.getElementById("stage-select").value = F.stage;
          } else {
            F.kind = k;
          }
          F.page = 1;
          load();
        });
      });
    }

    function renderBulk() {
      var ids = Object.keys(selected);
      var bar = document.getElementById("bulk-bar");
      bar.classList.toggle("show", ids.length > 0);
      document.getElementById("bulk-count").textContent = ids.length + " selected";
    }

    async function load() {
      var params = new URLSearchParams();
      params.set("per_page", String(F.perPage));
      params.set("page", String(F.page));
      if (F.kind !== "all") params.set("kind", F.kind);
      if (F.stage !== "all") params.set("stage", F.stage);
      if (F.saved) params.set("saved", F.saved);
      if (F.q) params.set("q", F.q);
      var r = await fetch("/api/admin/orders?" + params.toString());
      var data = await r.json();
      F.page = data.page || 1;
      renderPacking(data.packing);
      renderCompleted(data.packing_completed);
      renderKindChips(data.kindCounts || {});

      var banner = document.getElementById("lane-banner");
      if (data.podActive) {
        banner.className = "lane-banner on";
        banner.textContent = "Lulu lane: ON · print jobs go to Lulu; home packing still covers orders without a job.";
      } else {
        banner.className = "lane-banner";
        banner.textContent = "Lulu lane: OFF · orders pack at home until the flip.";
      }

      var stats = data.stats || {};
      document.getElementById("stat-fulfill").textContent = stats.toFulfill != null ? stats.toFulfill : "–";
      document.getElementById("stat-orders7").textContent = stats.orders7d != null ? stats.orders7d : "–";
      document.getElementById("stat-orders-total").textContent =
        (stats.ordersTotal != null ? stats.ordersTotal + " all time · " : "") + "All statuses.";
      document.getElementById("stat-revenue").textContent = stats.revenue30dCents != null ? money(stats.revenue30dCents) : "–";

      var shippo = data.shippo || { configured: false, originConfigured: false, ready: false, missing: ["SHIPPO_API_KEY"] };
      var sbanner = document.getElementById("shippo-banner");
      sbanner.classList.remove("hidden");
      if (shippo.missing && shippo.missing.length) {
        sbanner.className = "mt-3 rounded-xl border border-amber-200 bg-amber-50 px-4 py-2.5 text-sm text-amber-800";
        sbanner.innerHTML = "<strong>Shippo setup is incomplete.</strong> Still missing: " +
          shippo.missing.map(function (m) { return '<code class="font-mono text-xs bg-amber-100 rounded px-1">' + esc(m) + "</code>"; }).join(", ") +
          ". Add each as a worker secret and label buying appears on each order's page.";
      } else {
        sbanner.className = "mt-3 rounded-xl border border-green-200 bg-green-50 px-4 py-2.5 text-sm text-green-800";
        sbanner.textContent = "Shippo connected. Open any printed order to get a rate and buy its label.";
      }

      var counts = data.outbox || {};
      var failed = counts.failed || 0;
      document.getElementById("outbox-counts").textContent =
        "pending: " + (counts.pending || 0) + " · sent: " + (counts.sent || 0) + " · failed: " + failed;
      document.getElementById("outbox-strip").className =
        "mt-5 rounded-xl border px-4 py-3 flex flex-wrap items-center gap-x-3 gap-y-2 " +
        (failed > 0 ? "bg-red-50 border-red-200" : "bg-white border-stone-200");

      var tbody = document.getElementById("orders-rows");
      var emptyEl = document.getElementById("orders-empty");
      var pager = document.getElementById("orders-pager");
      var pages = data.pages || 1;
      if ((data.total || 0) > F.perPage || pages > 1) {
        pager.classList.remove("hidden");
        pager.classList.add("flex");
        document.getElementById("page-label").textContent =
          "Page " + F.page + " of " + pages + " · " + (data.total || 0) + " orders";
        var prev = document.getElementById("page-prev");
        var nextB = document.getElementById("page-next");
        prev.disabled = F.page <= 1;
        nextB.disabled = F.page >= pages;
        prev.style.opacity = F.page <= 1 ? ".4" : "";
        nextB.style.opacity = F.page >= pages ? ".4" : "";
      } else {
        pager.classList.add("hidden");
        pager.classList.remove("flex");
      }
      if (!data.orders || !data.orders.length) {
        tbody.innerHTML = "";
        emptyEl.textContent = "No orders match these filters.";
        emptyEl.classList.remove("hidden");
        renderBulk();
        return;
      }
      emptyEl.classList.add("hidden");
      tbody.innerHTML = "";
      closeMenu();
      ordersById = {};
      data.orders.forEach(function (o) { ordersById[o.id] = o; });
      data.orders.forEach(function (o) {
        var tr = document.createElement("tr");
        var custName = String(o.ship_name || "").trim() || String(o.email || "").trim();
        var checked = selected[o.id] ? " checked" : "";
        tr.innerHTML =
          '<td class="c-check"><input type="checkbox" data-check="' + esc(o.id) + '"' + checked + ' aria-label="Select order ' + esc(o.short_id || o.id) + '" style="width:18px;height:18px"></td>' +
          '<td class="c-order">' +
            (custName ? '<span class="block font-extrabold tracking-tight truncate leading-tight">' + esc(custName) + "</span>" : "") +
            '<span class="block truncate ' + (custName ? "text-[11px] text-stone-400 mt-0.5" : "font-extrabold tracking-tight leading-tight") + '">' + esc(o.short_id || o.id) + "</span>" +
            '<span class="block text-[11px] text-stone-400 mt-0.5 truncate">' + esc(fmtDay(o.created_at)) + "</span></td>" +
          '<td class="c-contents">' + contentsHtml(o) + "</td>" +
          '<td class="c-kind"><span class="kind-cell">' + esc(KIND_LABELS[o.kind] || "Digital") + "</span></td>" +
          '<td class="c-stage">' + stagePill(o.stage) + "</td>" +
          '<td class="c-age"><span class="age-cell">' + esc(ageText(o.created_at)) + "</span></td>" +
          '<td class="c-total"><span class="font-bold tabular-nums text-sm whitespace-nowrap">' + money(o.amount) + "</span></td>" +
          '<td class="c-act2"><button type="button" class="kebab" data-kebab="' + esc(o.id) + '" aria-haspopup="menu" aria-label="More actions for order ' + esc(o.short_id || o.id) + '">' + DOTS + "</button></td>";
        tr.addEventListener("click", function () {
          window.location.href = "/admin/orders/" + o.id;
        });
        tbody.appendChild(tr);
      });
      tbody.querySelectorAll("[data-check]").forEach(function (el) {
        el.addEventListener("click", function (ev) { ev.stopPropagation(); });
        el.addEventListener("change", function () {
          var id = el.getAttribute("data-check");
          if (el.checked) selected[id] = true; else delete selected[id];
          renderBulk();
        });
      });
      tbody.querySelectorAll("[data-kebab]").forEach(function (el) {
        el.addEventListener("click", function (ev) {
          ev.preventDefault();
          ev.stopPropagation();
          var o = ordersById[el.getAttribute("data-kebab")];
          if (!o) return;
          if (!menuEl.hidden && menuOrderId === o.id) closeMenu();
          else openMenu(o, el);
        });
      });
      renderBulk();
    }

    async function bulkRun(action) {
      var ids = Object.keys(selected);
      if (!ids.length) return;
      var res = document.getElementById("bulk-result");
      res.textContent = "Working…";
      try {
        var r = await fetch("/api/admin/orders", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ action: action, order_ids: ids }),
        });
        var j = await r.json();
        if (action === "export_csv" && j.csv) {
          var blob = new Blob([j.csv], { type: "text/csv" });
          var a = document.createElement("a");
          a.href = URL.createObjectURL(blob);
          a.download = j.filename || "orders-export.csv";
          a.click();
          setTimeout(function () { URL.revokeObjectURL(a.href); }, 4000);
          res.textContent = "Exported " + ids.length + " orders.";
          return;
        }
        if (Array.isArray(j.results)) {
          var ok = j.results.filter(function (x) { return x.ok; }).length;
          res.textContent = ok + " of " + j.results.length + " done. " +
            j.results.filter(function (x) { return !x.ok; }).slice(0, 3).map(function (x) { return x.message; }).join(" · ");
        } else {
          res.textContent = j.error || "Done.";
        }
      } catch (e) {
        res.textContent = "That batch failed to run.";
      }
      load();
    }

    document.getElementById("retry-emails").addEventListener("click", async function () {
      var out = document.getElementById("retry-result");
      out.textContent = "Sending...";
      var r = await fetch("/api/admin/orders", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ action: "retry_emails" }),
      });
      var data = await r.json().catch(function () { return {}; });
      var f = data.flush || {};
      out.textContent = "attempted " + (f.attempted || 0) + ", sent " + (f.sent || 0) + ", failed " + (f.failed || 0) + (f.skipped ? ", skipped " + f.skipped + " (no email key yet)" : "");
      load();
    });

    document.querySelectorAll("[data-saved]").forEach(function (b) {
      b.addEventListener("click", function () {
        var s = b.getAttribute("data-saved");
        F.saved = F.saved === s ? "" : s;
        document.querySelectorAll("[data-saved]").forEach(function (x) {
          x.setAttribute("aria-pressed", x.getAttribute("data-saved") === F.saved ? "true" : "false");
        });
        F.page = 1;
        load();
      });
    });
    document.getElementById("stage-select").addEventListener("change", function (ev) {
      F.stage = ev.target.value;
      F.page = 1;
      load();
    });
    document.getElementById("per-page").addEventListener("change", function (ev) {
      F.perPage = Number(ev.target.value) || 10;
      F.page = 1;
      load();
    });
    var searchTimer = null;
    document.getElementById("orders-search").addEventListener("input", function (ev) {
      clearTimeout(searchTimer);
      searchTimer = setTimeout(function () {
        F.q = String(ev.target.value || "").trim();
        F.page = 1;
        load();
      }, 300);
    });
    document.getElementById("check-all").addEventListener("change", function (ev) {
      document.querySelectorAll("[data-check]").forEach(function (el) {
        el.checked = ev.target.checked;
        var id = el.getAttribute("data-check");
        if (ev.target.checked) selected[id] = true; else delete selected[id];
      });
      renderBulk();
    });
    document.getElementById("bulk-clear").addEventListener("click", function () {
      selected = {};
      document.getElementById("bulk-result").textContent = "";
      load();
    });
    document.getElementById("bulk-create-jobs").addEventListener("click", function () { bulkRun("batch_create_print_jobs"); });
    document.getElementById("bulk-sync").addEventListener("click", function () { bulkRun("batch_sync_print_jobs"); });
    document.getElementById("bulk-export").addEventListener("click", function () { bulkRun("export_csv"); });
    document.getElementById("page-prev").addEventListener("click", function () {
      if (F.page > 1) { F.page -= 1; load(); window.scrollTo({ top: 0 }); }
    });
    document.getElementById("page-next").addEventListener("click", function () {
      F.page += 1; load(); window.scrollTo({ top: 0 });
    });

    load();
  </script>
  <script is:inline>
    document.querySelectorAll(".js-signout").forEach(function (el) {
      el.addEventListener("click", async function (e) {
        e.preventDefault();
        await fetch("/api/admin-auth/logout", { method: "POST" });
        await fetch("/api/auth/sign-out", { method: "POST", headers: { "Content-Type": "application/json" }, body: "{}" }).catch(function () {});
        window.location.href = "/login";
      });
    });
  </script>
</body>
</html>
