---
import "../../styles/global.css";
const token = Astro.url.searchParams.get("token") || "";
---

<html lang="en">
<head>
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#1a3454" />
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width" />
  <title>Set admin password · Big Brain Shelf</title>
  <style>
    body{font-family:ui-sans-serif,system-ui,sans-serif;background:#fafaf9;color:#1c1917;margin:0}
    .shell{max-width:26rem;margin:0 auto;padding:4.5rem 1.25rem 3rem}
    .brandrow{text-align:center;margin-bottom:22px}
    .card{background:#fff;border:1px solid #e7e5e4;border-radius:16px;padding:28px;box-shadow:0 8px 30px rgba(28,25,23,.06)}
    h1{font-size:1.35rem;font-weight:800;letter-spacing:-.02em;margin:0 0 .25rem}
    .sub{color:#78716c;font-size:14px;margin:0 0 8px}
    label{display:block;margin:16px 0 6px;font-weight:600;font-size:14px}
    input{width:100%;padding:11px 12px;font-size:15px;border:1px solid #d6d3d1;border-radius:8px;box-sizing:border-box;background:#fff}
    button{width:100%;margin-top:20px;padding:12px;font-size:15px;font-weight:600;background:#ea580c;color:#fff;border:0;border-radius:999px;cursor:pointer}
    button:hover{background:#c2410c}
    button:disabled{background:#a8a29e;cursor:wait}
    .google-btn{background:#fff;color:#1c1917;border:1px solid #d6d3d1;margin-top:14px}
    .google-btn:hover{background:#f5f5f4}
    .divider{text-align:center;margin:20px 0 4px;color:#a8a29e;font-size:13px}
    #error{color:#b91c1c;margin-top:12px;min-height:1.2em;font-size:14px}
  </style>
  </head>
<body>
  <div class="shell">
    <div class="brandrow"><span class="inline-flex items-center rounded-full bg-[#1a3454] px-4 py-1.5 text-lg font-extrabold leading-none tracking-tight text-white">big<span class="text-orange-400">brain</span>shelf</span></div>
    <div class="card">
  <h1>Set a new admin password</h1>
  <p style="color:#555">Pick a new password for the bookstore admin. You will use it at the admin login with your admin email. (We no longer list the addresses on this public page: they are the admin identity, so they are not advertised here.)</p>
  <form id="reset-form">
    <label for="password">New password (8+ characters)</label>
    <input type="password" id="password" name="password" required minlength="8" autocomplete="new-password" />
    <label for="confirm">Confirm password</label>
    <input type="password" id="confirm" name="confirm" required minlength="8" autocomplete="new-password" />
    <button type="submit" id="submit">Set password</button>
    <p id="error"></p>
    <p id="ok"></p>
  </form>
    </div>
  </div>
  <script is:inline define:vars={{ token }}>
    const form = document.getElementById("reset-form");
    const errorEl = document.getElementById("error");
    const okEl = document.getElementById("ok");
    const submitBtn = document.getElementById("submit");
    if (!token) {
      errorEl.textContent = "This link is missing its reset token.";
      submitBtn.disabled = true;
    }
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      errorEl.textContent = "";
      okEl.textContent = "";
      const password = document.getElementById("password").value;
      const confirm = document.getElementById("confirm").value;
      if (password !== confirm) {
        errorEl.textContent = "Passwords do not match.";
        return;
      }
      submitBtn.disabled = true;
      try {
        const res = await fetch("/api/admin-auth/reset", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ token, password }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error || "Reset failed.");
        okEl.textContent = "Password set. Taking you to the login page...";
        setTimeout(() => { window.location.href = "/admin/login"; }, 1200);
      } catch (err) {
        errorEl.textContent = err.message || "Reset failed.";
        submitBtn.disabled = false;
      }
    });
  </script>
</body>
</html>
