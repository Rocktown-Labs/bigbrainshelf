---
import "../../styles/global.css";
import AdminShell from "../../components/AdminShell.astro";
export const prerender = false;
// Audio Cast: audition Deepgram Aura-2 voices on real lines from the
// books, and record a verdict per voice. Data comes from
// src/data/cast/{voices,snippets}.json; generation goes through
// /api/admin/cast-audition (admin session required).
import voicesData from "../../data/cast/voices.json";
import snippetsData from "../../data/cast/snippets.json";
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Audio Cast · Big Brain Shelf Admin</title>
  </head>
<body class="bg-stone-50 text-stone-900 antialiased">
  <AdminShell current="/admin/cast" />

  <main class="mx-auto max-w-6xl px-4 py-8">
    <h1 class="text-2xl font-bold tracking-tight">Audio Cast · B Team</h1>
    <p class="text-sm text-stone-500 mt-1">Hear each voice read real lines from the books, then mark your verdict. First play generates the audio; after that it replays instantly.</p>

    <div class="mt-6 rounded-lg bg-white border border-stone-200 px-4 py-4">
      <div class="flex flex-wrap items-center gap-3">
        <label class="text-sm font-semibold" for="book-picker">Book</label>
        <select id="book-picker" class="rounded-lg border border-stone-300 px-3 py-2 text-sm"></select>
        <span class="text-xs text-stone-400">More books join the list as their lines are transcribed.</span>
      </div>
      <div class="mt-4 flex flex-wrap items-center gap-2" id="lang-pills" role="group" aria-label="Language"></div>
    </div>

    <div class="mt-4 rounded-lg bg-white border border-stone-200 px-4 py-4">
      <div class="text-sm font-semibold">Pick a line to audition</div>
      <div class="mt-3 flex flex-wrap gap-2" id="snippet-chips"></div>
      <div class="mt-4 rounded-lg bg-stone-50 border border-stone-200 px-4 py-3">
        <div class="text-[11px] font-bold uppercase tracking-[0.14em] text-stone-400" id="snippet-character"></div>
        <p class="mt-1 text-base leading-relaxed" id="snippet-text"></p>
      </div>
      <p class="mt-3 text-xs text-stone-400">Voices read the English snippet until translated texts exist. A Spanish voice reading English is the accent preview for casting future translations.</p>
    </div>

    <div class="mt-4 rounded-lg bg-white border border-stone-200 px-4 py-4">
      <div class="flex flex-wrap items-center gap-3">
        <span class="text-sm font-semibold" id="now-playing">Nothing playing</span>
        <span class="text-sm text-red-600" id="cast-status"></span>
      </div>
      <audio id="player" controls class="mt-3 w-full"></audio>
      <div class="mt-4 flex flex-wrap items-center gap-3">
        <label class="inline-flex items-center gap-2 text-sm font-medium cursor-pointer">
          <input type="checkbox" id="featured-only" class="h-5 w-5 accent-[#1a3454]" />
          Featured only
        </label>
        <input id="voice-search" type="search" placeholder="Search voices or traits" class="rounded-lg border border-stone-300 px-3 py-2 text-sm w-56" />
        <button id="play-all" class="rounded-lg bg-orange-600 text-white text-sm font-semibold px-4 py-2 hover:bg-orange-700">Play all featured</button>
        <button id="stop-all" class="hidden rounded-lg bg-stone-900 text-white text-sm font-semibold px-4 py-2 hover:bg-stone-700">Stop</button>
        <span class="text-sm text-stone-500" id="voice-count"></span>
      </div>
    </div>

    <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3" id="voice-grid"></div>
  </main>

  <script is:inline define:vars={{ voicesData, snippetsData }}>
    var LANG_ORDER = ["en", "es", "de", "fr", "nl", "it", "ja"];
    var state = {
      bookId: snippetsData.books[0].id,
      lang: "en",
      snippetId: snippetsData.books[0].snippets[0].id,
      featuredOnly: false,
      search: "",
      ratings: {},
    };
    var blobCache = {};
    var queue = null;
    var currentSpeaker = null;
    var player = document.getElementById("player");
    var statusEl = document.getElementById("cast-status");
    var nowPlayingEl = document.getElementById("now-playing");

    function book() {
      return snippetsData.books.find(function (b) { return b.id === state.bookId; }) || snippetsData.books[0];
    }
    function snippet() {
      return book().snippets.find(function (s) { return s.id === state.snippetId; }) || book().snippets[0];
    }
    function voices() {
      var list = (voicesData.languages[state.lang] || []).slice();
      list.sort(function (a, b) {
        if (a.featured !== b.featured) return a.featured ? -1 : 1;
        return a.name.localeCompare(b.name);
      });
      return list;
    }
    function cap(s) { return s ? s.charAt(0).toUpperCase() + s.slice(1) : s; }
    function setStatus(msg) { statusEl.textContent = msg || ""; }

    function renderBooks() {
      var sel = document.getElementById("book-picker");
      sel.innerHTML = "";
      snippetsData.books.forEach(function (b) {
        var opt = document.createElement("option");
        opt.value = b.id;
        opt.textContent = b.title;
        sel.appendChild(opt);
      });
      sel.value = state.bookId;
    }

    function renderLangs() {
      var wrap = document.getElementById("lang-pills");
      wrap.innerHTML = "";
      LANG_ORDER.forEach(function (lang) {
        if (!voicesData.languages[lang]) return;
        var btn = document.createElement("button");
        btn.textContent = lang.toUpperCase() + " · " + voicesData.languages[lang].length;
        btn.className = "rounded-full px-4 py-2 text-sm font-semibold border " +
          (state.lang === lang ? "bg-[#1a3454] text-white border-[#1a3454]" : "bg-white text-stone-700 border-stone-300 hover:border-stone-500");
        btn.addEventListener("click", function () {
          if (state.lang === lang) return;
          stopAll();
          state.lang = lang;
          renderLangs();
          renderVoices();
        });
        wrap.appendChild(btn);
      });
    }

    function renderSnippets() {
      var wrap = document.getElementById("snippet-chips");
      wrap.innerHTML = "";
      book().snippets.forEach(function (s) {
        var btn = document.createElement("button");
        btn.className = "rounded-lg px-3 py-2 text-left border " +
          (state.snippetId === s.id ? "bg-[#1a3454] text-white border-[#1a3454]" : "bg-white text-stone-700 border-stone-300 hover:border-stone-500");
        var top = document.createElement("div");
        top.className = "text-sm font-semibold";
        top.textContent = s.character;
        var sub = document.createElement("div");
        sub.className = "text-xs " + (state.snippetId === s.id ? "text-white/70" : "text-stone-400");
        sub.textContent = s.label;
        btn.appendChild(top);
        btn.appendChild(sub);
        btn.addEventListener("click", function () {
          state.snippetId = s.id;
          renderSnippets();
        });
        wrap.appendChild(btn);
      });
      var s = snippet();
      document.getElementById("snippet-character").textContent = s.character + " · " + s.label;
      document.getElementById("snippet-text").textContent = s.text;
    }

    function verdictButton(voice, label, value, activeClass) {
      var key = state.lang + "|" + voice.model;
      var active = state.ratings[key] === value;
      var btn = document.createElement("button");
      btn.textContent = label;
      btn.className = "rounded-md px-3 py-1.5 text-xs font-semibold border " +
        (active ? activeClass : "bg-white text-stone-500 border-stone-300 hover:border-stone-500");
      btn.addEventListener("click", function () { setVerdict(voice, value); });
      return btn;
    }

    function renderVoices() {
      var grid = document.getElementById("voice-grid");
      grid.innerHTML = "";
      var q = state.search.trim().toLowerCase();
      var list = voices().filter(function (v) {
        if (state.featuredOnly && !v.featured) return false;
        if (!q) return true;
        var hay = (v.name + " " + (v.characteristics || []).join(" ") + " " + (v.use_cases || []).join(" ")).toLowerCase();
        return hay.indexOf(q) !== -1;
      });
      document.getElementById("voice-count").textContent = list.length + " voices";
      if (!list.length) {
        var empty = document.createElement("div");
        empty.className = "text-sm text-stone-400";
        empty.textContent = "No voices match. Clear the search or the Featured only toggle.";
        grid.appendChild(empty);
        return;
      }
      list.forEach(function (v) { grid.appendChild(voiceCard(v)); });
      markPlayingCard();
    }

    function voiceCard(v) {
      var card = document.createElement("div");
      card.className = "rounded-lg bg-white border border-stone-200 p-4 flex flex-col gap-2";
      card.setAttribute("data-speaker", v.name);

      var top = document.createElement("div");
      top.className = "flex items-center gap-2";
      var name = document.createElement("span");
      name.className = "font-bold";
      name.textContent = cap(v.name);
      top.appendChild(name);
      if (v.featured) {
        var star = document.createElement("span");
        star.className = "text-amber-500";
        star.title = "Featured voice";
        star.textContent = "★";
        top.appendChild(star);
      }
      if (v.codeswitching) {
        var cs = document.createElement("span");
        cs.className = "rounded-full bg-sky-100 text-sky-800 text-[10px] font-bold px-2 py-0.5 uppercase tracking-wide";
        cs.textContent = "EN/ES";
        top.appendChild(cs);
      }
      var play = document.createElement("button");
      play.className = "ml-auto rounded-md bg-[#1a3454] text-white text-sm font-semibold px-4 py-2 hover:bg-[#24466e]";
      play.textContent = "Play";
      play.setAttribute("data-play", v.name);
      play.addEventListener("click", function () {
        queue = null;
        syncPlayAllButtons();
        playVoice(v, play);
      });
      top.appendChild(play);
      card.appendChild(top);

      var meta = document.createElement("div");
      meta.className = "text-xs text-stone-500";
      meta.textContent = [cap(v.gender), v.age, v.accent].filter(Boolean).join(" · ");
      card.appendChild(meta);

      var traits = document.createElement("div");
      traits.className = "text-sm text-stone-600";
      traits.textContent = (v.characteristics || []).join(", ");
      card.appendChild(traits);

      var uses = document.createElement("div");
      uses.className = "text-xs text-stone-400";
      uses.textContent = (v.use_cases || []).join(" · ");
      card.appendChild(uses);

      var verdicts = document.createElement("div");
      verdicts.className = "mt-auto flex items-center gap-2 pt-2";
      var vlabel = document.createElement("span");
      vlabel.className = "text-xs font-semibold text-stone-400";
      vlabel.textContent = "Verdict";
      verdicts.appendChild(vlabel);
      verdicts.appendChild(verdictButton(v, "No", "no", "bg-red-600 text-white border-red-600"));
      verdicts.appendChild(verdictButton(v, "Maybe", "maybe", "bg-amber-500 text-white border-amber-500"));
      verdicts.appendChild(verdictButton(v, "Yes", "yes", "bg-green-600 text-white border-green-600"));
      card.appendChild(verdicts);
      return card;
    }

    function markPlayingCard() {
      document.querySelectorAll("[data-speaker]").forEach(function (el) {
        var on = el.getAttribute("data-speaker") === currentSpeaker;
        el.classList.toggle("ring-2", on);
        el.classList.toggle("ring-orange-500", on);
        el.classList.toggle("border-orange-300", on);
      });
    }

    function audioUrlFor(v, s) {
      var ck = state.lang + "|" + v.name + "|" + s.id;
      if (blobCache[ck]) return Promise.resolve(blobCache[ck]);
      return fetch("/api/admin/cast-audition", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ speaker: v.name, lang: state.lang, text: s.text }),
      }).then(function (r) {
        if (!r.ok) {
          return r.json().catch(function () { return {}; }).then(function (j) {
            throw new Error(j.error || ("Generation failed (" + r.status + ")"));
          });
        }
        return r.blob();
      }).then(function (blob) {
        var url = URL.createObjectURL(blob);
        blobCache[ck] = url;
        return url;
      });
    }

    function playVoice(v, btn) {
      var s = snippet();
      if (btn) { btn.disabled = true; btn.textContent = "Voicing..."; }
      setStatus("");
      return audioUrlFor(v, s).then(function (url) {
        currentSpeaker = v.name;
        player.src = url;
        nowPlayingEl.textContent = "Now playing: " + cap(v.name) + " reading " + s.label;
        markPlayingCard();
        return player.play().catch(function () {});
      }).catch(function (err) {
        setStatus(err.message || "Generation failed.");
        if (queue) { queue = null; syncPlayAllButtons(); }
      }).finally(function () {
        if (btn) { btn.disabled = false; btn.textContent = "Play"; }
      });
    }

    function syncPlayAllButtons() {
      document.getElementById("play-all").classList.toggle("hidden", !!queue);
      document.getElementById("stop-all").classList.toggle("hidden", !queue);
    }
    function stopAll() {
      queue = null;
      player.pause();
      syncPlayAllButtons();
    }
    function playQueueStep() {
      if (!queue) return;
      if (queue.idx >= queue.list.length) { stopAll(); return; }
      var v = queue.list[queue.idx];
      var btn = document.querySelector('[data-play="' + v.name + '"]');
      playVoice(v, btn);
    }

    player.addEventListener("ended", function () {
      if (queue) { queue.idx += 1; playQueueStep(); }
    });
    player.addEventListener("pause", function () {
      if (!queue) { /* single play paused by CG; keep the highlight */ }
    });

    function setVerdict(v, value) {
      var key = state.lang + "|" + v.model;
      var next = state.ratings[key] === value ? "" : value;
      if (next) state.ratings[key] = next; else delete state.ratings[key];
      renderVoices();
      fetch("/api/admin/cast-ratings", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ voice_model: v.model, lang: state.lang, verdict: next }),
      }).catch(function () { setStatus("Could not save that verdict. Try again."); });
    }

    async function loadRatings() {
      try {
        var r = await fetch("/api/admin/cast-ratings");
        var j = await r.json();
        (j.ratings || []).forEach(function (row) {
          state.ratings[row.lang + "|" + row.voice_model] = row.verdict;
        });
      } catch (e) { /* verdicts are a convenience; the tool works without them */ }
      renderVoices();
    }

    document.getElementById("book-picker").addEventListener("change", function (ev) {
      state.bookId = ev.target.value;
      state.snippetId = book().snippets[0].id;
      stopAll();
      renderSnippets();
    });
    document.getElementById("featured-only").addEventListener("change", function (ev) {
      state.featuredOnly = ev.target.checked;
      renderVoices();
    });
    document.getElementById("voice-search").addEventListener("input", function (ev) {
      state.search = ev.target.value;
      renderVoices();
    });
    document.getElementById("play-all").addEventListener("click", function () {
      var featured = voices().filter(function (v) { return v.featured; });
      if (!featured.length) { setStatus("No featured voices in this language."); return; }
      queue = { list: featured, idx: 0 };
      syncPlayAllButtons();
      playQueueStep();
    });
    document.getElementById("stop-all").addEventListener("click", stopAll);

    renderBooks();
    renderLangs();
    renderSnippets();
    renderVoices();
    loadRatings();
  </script>
  <script is:inline>
    document.querySelectorAll(".js-signout").forEach(function (el) {
      el.addEventListener("click", async function (e) {
        e.preventDefault();
        await fetch("/api/admin-auth/logout", { method: "POST" });
        await fetch("/api/auth/sign-out", { method: "POST", headers: { "Content-Type": "application/json" }, body: "{}" }).catch(function () {});
        window.location.href = "/login";
      });
    });
  </script>
</body>
</html>
