---
import "../../styles/global.css";
import AdminShell from "../../components/AdminShell.astro";
import { listQcVideos, mediaUrl, fmtTime } from "../../lib/video-qc";
if (!Astro.locals.user) {
  return Astro.redirect("/admin/login");
}
const videos = listQcVideos();
---

<html lang="en">
<head>
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#1a3454" />
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width" />
  <title>Promo QC · Big Brain Shelf admin</title>
  <style is:global>
    body{font-family:ui-sans-serif,system-ui,sans-serif;background:#fafaf9;color:#1c1917;margin:0}
    .wrap{max-width:72rem;margin:0 auto;padding:1.75rem 1rem 4rem}
    h1{font-size:1.7rem;font-weight:800;letter-spacing:-.02em;margin:.25rem 0 .5rem}
    .sub{color:#78716c;margin:0 0 1.25rem;max-width:46rem}
    .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:16px}
    .card{background:#fff;border:1px solid #e7e5e4;border-radius:12px;overflow:hidden;box-shadow:0 1px 2px rgba(28,25,23,.05);text-decoration:none;color:inherit;display:block}
    .card:hover{border-color:#fdba74}
    .poster{width:100%;aspect-ratio:1080/760;object-fit:cover;object-position:top;display:block;background:#1a3454}
    .cardbody{padding:14px 16px 16px}
    .cardbody h2{margin:0 0 2px;font-size:1.12rem}
    .style{color:#c2410c;font-weight:600;font-size:.86rem;margin:0 0 8px}
    .nums{display:flex;flex-wrap:wrap;gap:6px 14px;font-size:.85rem;color:#44403c;margin:0}
    .nums b{color:#1c1917}
    .chip{display:inline-block;padding:2px 9px;border-radius:999px;font-size:.75rem;font-weight:700;background:#f5f5f4;color:#44403c}
    .chip.pending{background:#fef3c7;color:#92400e}
    .chip.changes_requested{background:#fee2e2;color:#991b1b}
    .chip.approved,.chip.pass{background:#dcfce7;color:#166534}
    .sz-bad{color:#b91c1c;font-weight:700}
    .sz-ok{color:#166534;font-weight:700}
  </style>
</head>
<body>
  <AdminShell current="/admin/videos" />
  <main class="wrap">
    <h1>Promo QC</h1>
    <p class="sub">Every promo cut under review, laid out the way the bookstore QC lays out a book. Open a video to walk its scenes from intro to cost, zoom into a scene to see its mechanics, and tag elements fix, steal, keep, or question. Tags land in the feedback queue a fix pass works from.</p>
    {videos.length === 0 ? (
      <p>No videos in the QC set yet. Run build_video_qc_data.py to seed it.</p>
    ) : (
      <div class="grid">
        {videos.map((v) => (
          <a class="card" href={`/admin/videos/${v.slug}`}>
            {v.poster_key && <img class="poster" src={mediaUrl(v.poster_key)} alt="" loading="lazy" />}
            <div class="cardbody">
              <h2>{v.title}</h2>
              <p class="style">{v.style}</p>
              <p class="nums">
                <span><b>{fmtTime(v.duration_s)}</b></span>
                <span>{v.lufs != null ? <b>{v.lufs.toFixed(1)} LUFS</b> : "LUFS n/a"}</span>
                <span>transcript {v.transcript ? (v.transcript.ratio != null ? <b>{v.transcript.ratio.toFixed(2)}</b> : <b>pass</b>) : "n/a"}</span>
                <span>safe zone {v.safezone_fg_violations == null ? "unmeasured" : v.safezone_fg_violations === 0 ? <span class="sz-ok">0 violations</span> : <span class="sz-bad">{v.safezone_fg_violations} violations</span>}</span>
              </p>
              <p style="margin:10px 0 0">
                <span class={`chip ${v.verdict || ""}`}>{v.verdict ? `ledger: ${v.verdict}` : "no ledger verdict"}</span>
                {" "}<span class="chip">{v.scenes.length} scenes</span>
                {" "}<span class="chip">{v.attempt_id}</span>
              </p>
            </div>
          </a>
        ))}
      </div>
    )}
  </main>
</body>
</html>
