---
import "../../styles/global.css";
import { ClientRouter } from "astro:transitions";
import { env } from "cloudflare:workers";
import AdminShell from "../../components/AdminShell.astro";
import { inspectAudiobook, formatClock } from "../../lib/audiobooks";

export const prerender = false;
if (!Astro.locals.user) {
  return Astro.redirect("/admin/login");
}

// Audiobooks admin: every book whose audiobook is generated gets a
// player here. Storage facts come from R2 heads (inspectAudiobook), so
// a book only shows chapters and files that actually exist.
const e = env as any;
const { results } = await e.DB.prepare(
  "SELECT slug, title, status, cover_key, audiobook_key FROM books ORDER BY title"
).all();
const rows = (results || []) as any[];
const R2 = "https://media.bigbrainshelf.com/";

const playable = [];
const pending = [];
for (const b of rows) {
  if (b.audiobook_key) {
    playable.push({ book: b, info: await inspectAudiobook(e, b) });
  } else {
    pending.push(b);
  }
}
const mb = (n: number) => (n / 1048576).toFixed(1) + " MB";
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Audiobooks · Big Brain Shelf Admin</title>
  <ClientRouter />
</head>
<body class="bg-stone-50 text-stone-900 antialiased">
  <AdminShell current="/admin/audiobooks" />

  <main class="mx-auto max-w-6xl px-4 py-8">
    <h1 class="text-2xl font-bold tracking-tight">Audiobooks</h1>
    <p class="text-sm text-stone-500 mt-1">Listen to a finished audiobook right here: chapter by chapter, or the whole book in one file. Playback streams the MP3s, which play in every browser.</p>

    {playable.length === 0 && (
      <p class="mt-6 text-sm text-stone-500">No audiobooks yet. When a book's audiobook is generated and its key is set, it shows up here ready to play.</p>
    )}

    <div class="mt-6 grid gap-5 sm:grid-cols-2">
      {playable.map(({ book, info }) => {
        const total = info.tracks.reduce((s, c) => s + (c.duration || 0), 0);
        return (
          <div class="rounded-lg bg-white border border-stone-200 p-4 flex gap-4">
            {book.cover_key
              ? <img src={R2 + book.cover_key} alt="" class="w-[74px] h-[98px] object-cover rounded-md border border-stone-200 shrink-0" />
              : <div class="w-[74px] h-[98px] rounded-md bg-stone-100 border border-stone-200 shrink-0"></div>}
            <div class="min-w-0 flex-1">
              <h2 class="font-bold leading-snug">{book.title}</h2>
              <p class="mt-1 text-sm text-stone-500">
                {info.chapters.length} chapter{info.chapters.length === 1 ? "" : "s"}
                {total > 0 && <> · about {formatClock(total)}</>}
                {info.m4b && <> · audiobook file {mb(info.m4b.size)}</>}
              </p>
              <p class="mt-1 text-sm text-stone-500">
                {info.full ? "Full book MP3 ready. " : ""}{info.chapters.length ? "Chapter MP3s ready." : "No chapter MP3s found."}
              </p>
              <p class="mt-3">
                <a href={`/admin/audiobooks/${book.slug}`} class="inline-block rounded-full bg-orange-600 text-white text-sm font-semibold px-5 py-2 hover:bg-orange-700">Open player</a>
              </p>
            </div>
          </div>
        );
      })}
    </div>

    {pending.length > 0 && (
      <section class="mt-10">
        <h2 class="text-sm font-bold uppercase tracking-wide text-stone-400">No audiobook yet</h2>
        <ul class="mt-3 divide-y divide-stone-200 rounded-lg bg-white border border-stone-200 opacity-70">
          {pending.map((b) => (
            <li class="px-4 py-3 flex items-center gap-3 text-sm">
              <span class="font-medium text-stone-600">{b.title}</span>
              <span class="ml-auto text-stone-400">no audiobook yet</span>
            </li>
          ))}
        </ul>
      </section>
    )}
  </main>

  <script is:inline>
    document.querySelectorAll(".js-signout").forEach(function (el) {
      el.addEventListener("click", async function (e) {
        e.preventDefault();
        await fetch("/api/admin-auth/logout", { method: "POST" });
        await fetch("/api/auth/sign-out", { method: "POST", headers: { "Content-Type": "application/json" }, body: "{}" }).catch(function () {});
        window.location.href = "/login";
      });
    });
  </script>
</body>
</html>
