---
import "../../../../styles/global.css";
import { env } from "cloudflare:workers";
import AdminShell from "../../../../components/AdminShell.astro";
import { adminMediaUrl } from "../../../../lib/media";
import { resolveBookForPublicRoute, publicSlugFor } from "../../../../lib/public-slugs";

export const prerender = false;
if (!Astro.locals.user) {
  return Astro.redirect("/admin/login");
}

// Generation Attempts: every paid image roll the factory made for
// this book, accepted and rejected, with the gates' scores and the
// deciding reason (D1 gen_attempts + books/{slug}/attempts/ in R2,
// written by the factory since 2026-11-01). This is the tuning
// surface: which gate burns the money, and whether its rejects were
// real. Rolls from before the archive existed are not shown (their
// counts live in gen_events only).
const e = env as any;
const param = String(Astro.params.slug || "");
const resolvedBook = await resolveBookForPublicRoute(e.DB, param).catch(() => null);
const book = (resolvedBook?.book ?? null) as any;
const slug = book ? String(book.slug) : param;
const adminSlug = book ? publicSlugFor(book) : param;
const title = book?.title || slug;

interface AttemptRow {
  id: number;
  kind: string;
  chapter: string | null;
  page: number | null;
  attempt: number;
  outcome: string;
  reason: string | null;
  scores: Record<string, number | null> | null;
  cost: number | null;
  image_key: string | null;
  created_at: number;
}

let rows: AttemptRow[] = [];
let loadError = "";
try {
  const res: any = await e.DB.prepare(
    "SELECT id, kind, chapter, page, attempt, outcome, reason, scores, cost, image_key, created_at FROM gen_attempts WHERE slug = ? ORDER BY created_at ASC, id ASC"
  )
    .bind(slug)
    .all();
  rows = (res?.results ?? []).map((r: any) => ({
    ...r,
    scores: r.scores ? JSON.parse(r.scores) : null,
  }));
} catch {
  loadError = "No attempt archive yet. It starts filling with the next factory run for this book.";
}

const totalCost = rows.reduce((s, r) => s + (r.cost || 0), 0);
const accepted = rows.filter((r) => r.outcome === "accepted" || r.outcome === "autofixed").length;
const held = rows.filter((r) => r.outcome === "held_for_review").length;

// Reject reasons grouped by the gate that decided (text before the
// first colon or parenthesis), so the expensive gates sort first.
const gateCounts = new Map<string, { n: number; cost: number }>();
for (const r of rows) {
  if (r.outcome === "accepted" || r.outcome === "autofixed" || !r.reason) continue;
  const gate = r.reason.split(/[:=]/)[0].trim().slice(0, 42);
  const g = gateCounts.get(gate) ?? { n: 0, cost: 0 };
  g.n += 1;
  g.cost += r.cost || 0;
  gateCounts.set(gate, g);
}
const gates = [...gateCounts.entries()].sort((a, b) => b[1].cost - a[1].cost);

// Group by page, in reading order: chapter, then page (finale last
// within its chapter, stored as page -1), probe rolls (attempt 0)
// alongside the factory rolls for the same page.
const pageLabel = (r: AttemptRow) => {
  const ch = r.chapter ?? "?";
  if (r.page === -1) return `${ch} finale`;
  if (r.page === null || r.page === undefined) return `${ch} (cover/art)`;
  return `${ch}p${r.page}`;
};
const groups = new Map<string, AttemptRow[]>();
for (const r of rows) {
  const k = `${r.kind}|${pageLabel(r)}`;
  if (!groups.has(k)) groups.set(k, []);
  groups.get(k)!.push(r);
}
const groupList = [...groups.entries()];

const SCORE_ORDER = [
  "has_text", "has_color", "is_lineart", "is_color", "anatomy",
  "cast_match", "character_match", "dupe_0", "dupe_1", "dupe_2",
  "single_scene", "no_humans",
];
const scoreLine = (s: Record<string, number | null> | null) => {
  if (!s) return "";
  return SCORE_ORDER.filter((k) => s[k] !== null && s[k] !== undefined)
    .map((k) => `${k.replace("has_", "").replace("is_", "")} ${Number(s[k]).toFixed(2)}`)
    .join(" · ");
};
const chipColor = (o: string) =>
  o === "accepted" || o === "autofixed"
    ? "background:#dcfce7;color:#166534"
    : o === "qc_reject"
      ? "background:#fee2e2;color:#991b1b"
      : o === "purity_reject"
        ? "background:#ffedd5;color:#9a3412"
        : o === "cast_reject"
          ? "background:#ede9fe;color:#5b21b6"
          : "background:#e7e5e4;color:#44403c";
const when = (ts: number) =>
  new Date(ts * 1000).toLocaleString("en-US", { timeZone: "America/Chicago", month: "short", day: "numeric", hour: "numeric", minute: "2-digit" });
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Generation attempts · {title} · Big Brain Shelf Admin</title>
    <style>
      .wrap { max-width: 1100px; margin: 0 auto; padding: 20px 16px 64px; }
      .stat { background: #fff; border: 1px solid #e7e5e4; border-radius: 12px; padding: 12px 16px; min-width: 130px; }
      .stat b { font-size: 20px; display: block; }
      .stat span { font-size: 12px; color: #78716c; }
      .card { width: 168px; background: #fff; border: 1px solid #e7e5e4; border-radius: 12px; overflow: hidden; }
      .card img { width: 100%; height: 190px; object-fit: cover; display: block; background: #f5f5f4; }
      .chip { font-size: 11px; font-weight: 600; padding: 2px 8px; border-radius: 999px; }
      .scores { font-size: 11px; color: #57534e; line-height: 1.5; }
      .reason { font-size: 11px; color: #991b1b; line-height: 1.45; }
      .promote { margin-top: 8px; width: 100%; font-size: 12px; font-weight: 600; padding: 6px 8px; border-radius: 8px; border: 1px solid #166534; background: #f0fdf4; color: #166534; cursor: pointer; }
      .promote:disabled { opacity: 0.6; cursor: default; }
    </style>
  </head>
  <body style="background:#fafaf9">
    <AdminShell current="/admin/books" />
    <div class="wrap">
      <p style="font-size:14px"><a href={"/admin/books/" + adminSlug}>&larr; {title}</a></p>
      <h1 style="font-size:24px;font-weight:700;margin:6px 0 2px">Generation attempts</h1>
      <p style="color:#57534e;font-size:14px;margin:0 0 16px">
        Every paid roll for this book, kept. Accepted and rejected, with the scores and the reason each gate decided.
      </p>

      <div style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:18px">
        <div class="stat"><b>{rows.length}</b><span>rolls archived</span></div>
        <div class="stat"><b>${totalCost.toFixed(2)}</b><span>spend archived</span></div>
        <div class="stat"><b>{rows.length ? Math.round((accepted / rows.length) * 100) : 0}%</b><span>first archive accept rate</span></div>
        <div class="stat"><b>{held}</b><span>pages held for review</span></div>
      </div>

      {gates.length > 0 && (
        <div style="background:#fff;border:1px solid #e7e5e4;border-radius:12px;padding:14px 16px;margin-bottom:22px">
          <h2 style="font-size:15px;font-weight:700;margin:0 0 8px">Where the rejects come from</h2>
          {gates.map(([gate, g]) => (
            <p style="font-size:13px;margin:4px 0;color:#44403c">
              <b>{gate}</b>: {g.n} reject{g.n === 1 ? "" : "s"}, ${g.cost.toFixed(2)} of rolls
            </p>
          ))}
        </div>
      )}

      {loadError && <p style="color:#78716c">{loadError}</p>}
      {!loadError && rows.length === 0 && (
        <p style="color:#78716c">No rolls archived for this book yet. They appear here as the factory generates.</p>
      )}

      {groupList.map(([key, list]) => (
        <section style="margin-bottom:26px">
          <h2 style="font-size:16px;font-weight:700;margin:0 0 10px">
            {key.split("|")[1]} <span style="font-weight:400;color:#78716c;font-size:13px">{key.split("|")[0]} · {list.length} roll{list.length === 1 ? "" : "s"} · ${list.reduce((s, r) => s + (r.cost || 0), 0).toFixed(2)}</span>
          </h2>
          <div style="display:flex;gap:12px;flex-wrap:wrap">
            {list.map((r) => (
              <div class="card">
                {r.image_key
                  ? <a href={adminMediaUrl(r.image_key)} target="_blank" rel="noopener"><img src={adminMediaUrl(r.image_key)} alt="" loading="lazy" /></a>
                  : <div style="height:190px;display:flex;align-items:center;justify-content:center;color:#a8a29e;font-size:12px">no image saved</div>}
                <div style="padding:8px 10px 10px">
                  <div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap">
                    <span class="chip" style={chipColor(r.outcome)}>{r.outcome}</span>
                    <span style="font-size:11px;color:#78716c">{r.attempt === 0 ? "probe" : `try ${r.attempt}`} · {r.cost != null ? `$${r.cost.toFixed(3)}` : "no cost"}</span>
                  </div>
                  {r.reason && <p class="reason" style="margin:6px 0 0">{r.reason}</p>}
                  {scoreLine(r.scores) && <p class="scores" style="margin:6px 0 0">{scoreLine(r.scores)}</p>}
                  <p style="font-size:11px;color:#a8a29e;margin:6px 0 0">{when(r.created_at)}</p>
                  {(r.kind === "line" || r.kind === "colorize") && r.image_key && r.outcome !== "accepted" && r.outcome !== "autofixed" && r.outcome !== "promoted" && (
                    <button class="promote" data-attempt={r.id} type="button">Use this page</button>
                  )}
                </div>
              </div>
            ))}
          </div>
        </section>
      ))}
    </div>
    <script is:inline define:vars={{ adminSlug }}>
      document.querySelectorAll("button.promote").forEach((btn) => {
        btn.addEventListener("click", async () => {
          if (!confirm("Make this archived roll the official page image? This replaces the current page and clears its held flag.")) return;
          btn.disabled = true;
          btn.textContent = "Promoting...";
          try {
            const res = await fetch("/api/admin/books/" + adminSlug + "/attempts-promote", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ attemptId: Number(btn.dataset.attempt) }),
            });
            const data = await res.json().catch(() => ({}));
            if (!res.ok) throw new Error(data.error || ("HTTP " + res.status));
            btn.textContent = "Promoted. Reload to see it live.";
          } catch (err) {
            btn.disabled = false;
            btn.textContent = "Use this page";
            alert("Promote failed: " + (err && err.message ? err.message : err));
          }
        });
      });
    </script>
  </body>
</html>
