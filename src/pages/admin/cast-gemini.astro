---
import "../../styles/global.css";
import AdminShell from "../../components/AdminShell.astro";
export const prerender = false;
// Casting shelf (redesign S3, 2026-11-03): the index is a shelf in the
// customer pattern, cover + ONE status chip per book, with filter pills
// and search so the shelf survives a 190-book catalog. Tapping a cover
// opens the book's own casting page (/admin/cast-gemini/[slug]), where
// the cast sheet, voice pickers, and scene auditions live. The voice
// registry view stays here as the second tab.
//
// Casting model (unchanged): voices are cast per CHARACTER in the D1
// registry (character_voices) through /api/admin/cast-registry, export
// to R2 cast-registry.json, and a character keeps their voice in every
// book and every version.
import geminiVoicesData from "../../data/cast/gemini-voices.json";
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Casting · Big Brain Shelf Admin</title>
  <style>
    /* Book shelf: the customer /account library pattern, same boards
       and planks as /admin/books (redesign S1). */
    .shelf-board{margin-top:26px}
    .shelf-board:first-of-type{margin-top:10px}
    .shelf-row{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;padding:0 4px}
    @media (max-width:640px){.shelf-row{grid-template-columns:repeat(2,1fr)}}
    .shelf-plank{height:.65rem;margin-top:.55rem;border-radius:.3rem;background:linear-gradient(180deg,#b08954 0%,#8a6844 55%,#6f5133 100%);box-shadow:0 10px 14px -8px rgba(90,62,27,.55),inset 0 1px 0 rgba(255,235,200,.5)}
    .shelf-item{display:block;text-decoration:none;color:inherit}
    .shelf-cover{aspect-ratio:3/4;border-radius:10px;overflow:hidden;border:1px solid #e7e5e4;background:#f5f5f4;box-shadow:0 1px 2px rgba(28,25,23,.06)}
    .shelf-cover img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .2s ease}
    .shelf-item:hover .shelf-cover img{transform:scale(1.02)}
    .shelf-cover-fallback{display:flex;align-items:center;justify-content:center;height:100%;padding:12px;text-align:center;font-weight:700;color:#78716c}
    .shelf-title{display:block;font-weight:700;font-size:.95rem;line-height:1.3;margin-top:10px}
    .shelf-chip{display:block;margin-top:6px;min-height:24px}
    .cast-chip{display:inline-block;border-radius:9999px;font-size:11px;font-weight:600;padding:2px 8px}
    .cast-chip.ok{background:#dcfce7;color:#166534}
    .cast-chip.needs{background:#fef3c7;color:#92400e}
    .cast-chip.none{background:#f5f5f4;color:#78716c}
    .pill{border-radius:9999px;padding:6px 14px;font-size:.875rem;font-weight:600;border:1px solid #d6d3d1;background:#fff;color:#44403c;cursor:pointer}
    .pill:hover{border-color:#78716c}
    .pill.on{background:#1a3454;color:#fff;border-color:#1a3454}
  </style>
  </head>
<body class="bg-stone-50 text-stone-900 antialiased">
  <AdminShell current="/admin/cast-gemini" />

  <main class="mx-auto max-w-6xl px-4 py-8">
    <h1 class="text-2xl font-bold tracking-tight">Casting</h1>
    <p class="text-sm text-stone-500 mt-1">Gemini 3.8 Flash TTS voices, cast per character. A character keeps their voice in every book and every version. Casting a book's protagonist locks that voice as narrator and main character at once. A cast voice belongs to its character: once a voice is cast, it does not appear in other books' pickers at all. The override inside a picker reveals cast voices, and reusing one always asks first.</p>

    <div class="mt-4 flex flex-wrap gap-2" role="group" aria-label="Casting views">
      <button id="tab-cast" class="rounded-full bg-[#1a3454] text-white px-4 py-2 text-sm font-semibold">Cast a book</button>
      <button id="tab-registry" class="rounded-full bg-white text-stone-700 border border-stone-300 hover:border-stone-500 px-4 py-2 text-sm font-semibold">Voice registry</button>
    </div>

    <section id="view-cast">
      <div class="mt-4 flex flex-wrap items-center gap-2" role="group" aria-label="Sort the casting shelf">
        <button class="pill on" data-castfilter="all">All books</button>
        <button class="pill" data-castfilter="needs">Needs voices</button>
        <button class="pill" data-castfilter="cast">All cast</button>
        <input id="cast-search" type="search" placeholder="Search the shelf" class="rounded-lg border border-stone-300 px-3 py-1.5 text-sm w-56" />
        <span class="text-sm text-stone-400" id="shelf-count"></span>
        <span class="text-sm text-red-600" id="cast-status"></span>
      </div>
      <div id="cast-shelf" class="mt-2"></div>
    </section>

    <section id="view-registry" class="hidden">
      <div class="mt-4 rounded-lg bg-white border border-stone-200 px-4 py-4">
        <div class="text-sm font-semibold">Every character on the shelf</div>
        <p class="mt-1 text-xs text-stone-400" id="registry-summary"></p>
        <div class="mt-3 overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="text-left text-xs uppercase tracking-wide text-stone-400">
                <th class="py-2 pr-3">Character</th>
                <th class="py-2 pr-3">Book(s)</th>
                <th class="py-2 pr-3">Voice</th>
                <th class="py-2">Status</th>
              </tr>
            </thead>
            <tbody id="registry-body"></tbody>
          </table>
        </div>
      </div>
      <div class="mt-4 rounded-lg bg-white border border-stone-200 px-4 py-4">
        <div class="text-sm font-semibold">Recent assignments</div>
        <ul class="mt-2 space-y-1 text-sm text-stone-600" id="log-list"></ul>
      </div>
    </section>
  </main>

  <script is:inline define:vars={{ geminiVoicesData }}>
    var state = {
      view: "cast",
      books: [],
      registry: {}, // character_name -> row
      log: [],
      filter: "all",
      search: "",
    };
    var R2 = "https://media.bigbrainshelf.com/";
    var statusEl = document.getElementById("cast-status");

    function setStatus(msg) { statusEl.textContent = msg || ""; }
    function esc(s) {
      return String(s == null ? "" : s).replace(/[&<>"']/g, function (c) {
        return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
      });
    }
    function voiceNameFor(characterName) {
      var row = state.registry[characterName];
      return row && row.voice_id ? (row.voice_name || row.voice_id) : null;
    }
    function voiceById(id) {
      return ((geminiVoicesData.voices || []).find(function (v) { return v.id === id; })) || null;
    }
    function castInfo(book) {
      var chars = book.characters || [];
      var cast = chars.filter(function (c) { return !!voiceNameFor(c.name); }).length;
      return { total: chars.length, cast: cast, needs: chars.length - cast };
    }

    // ---------- shelf ----------
    function bookMatches(book) {
      var info = castInfo(book);
      if (state.filter === "needs" && info.needs === 0) return false;
      if (state.filter === "cast" && !(info.total > 0 && info.needs === 0)) return false;
      var q = state.search.trim().toLowerCase();
      if (q) {
        var hay = (book.title + " " + (book.characters || []).map(function (c) { return c.name; }).join(" ")).toLowerCase();
        if (hay.indexOf(q) === -1) return false;
      }
      return true;
    }

    function shelfItemHtml(book) {
      var info = castInfo(book);
      var chip;
      if (info.total === 0) chip = '<span class="cast-chip none">No cast in bible yet</span>';
      else if (info.needs === 0) chip = '<span class="cast-chip ok">All cast</span>';
      else chip = '<span class="cast-chip needs">Needs voices: ' + info.needs + "</span>";
      var cover = book.coverKey
        ? '<img src="' + R2 + esc(book.coverKey) + '" alt="' + esc(book.title) + '" loading="lazy" />'
        : '<span class="shelf-cover-fallback">' + esc(book.title) + "</span>";
      var href = "/admin/cast-gemini/" + encodeURIComponent(book.publicSlug || book.slug);
      return '<a class="shelf-item" href="' + href + '">' +
        '<span class="shelf-cover">' + cover + "</span>" +
        '<span class="shelf-title">' + esc(book.title) + "</span>" +
        '<span class="shelf-chip">' + chip + "</span></a>";
    }

    function renderShelf() {
      var wrap = document.getElementById("cast-shelf");
      var countEl = document.getElementById("shelf-count");
      if (!state.books.length) {
        wrap.innerHTML = '<div class="rounded-lg bg-white border border-stone-200 p-4 mt-4">' +
          '<h2 class="font-bold" style="margin-top:0">No books yet</h2>' +
          '<p class="text-sm text-stone-500">The casting shelf is empty. Books appear here once they are on the Books shelf.</p>' +
          '<p style="margin-bottom:0"><a class="rounded-md bg-[#1a3454] text-white text-sm font-semibold px-3 py-1.5 inline-block" href="/admin/books">Go to Books</a></p></div>';
        countEl.textContent = "";
        return;
      }
      var list = state.books.filter(bookMatches);
      countEl.textContent = list.length + (list.length === 1 ? " book" : " books");
      if (!list.length) {
        wrap.innerHTML = '<div class="rounded-lg bg-white border border-stone-200 p-4 mt-4">' +
          '<p class="text-sm text-stone-500" style="margin-top:0">No books match that view.</p>' +
          '<p style="margin-bottom:0"><button id="shelf-show-all" class="rounded-md bg-[#1a3454] text-white text-sm font-semibold px-3 py-1.5">Show all books</button></p></div>';
        var btn = document.getElementById("shelf-show-all");
        if (btn) btn.addEventListener("click", function () {
          state.filter = "all";
          state.search = "";
          document.getElementById("cast-search").value = "";
          syncPills();
          renderShelf();
        });
        return;
      }
      var html = "";
      for (var i = 0; i < list.length; i += 4) {
        html += '<div class="shelf-board"><div class="shelf-row">' +
          list.slice(i, i + 4).map(shelfItemHtml).join("") +
          '</div><div class="shelf-plank" aria-hidden="true"></div></div>';
      }
      wrap.innerHTML = html;
    }

    function syncPills() {
      document.querySelectorAll("[data-castfilter]").forEach(function (b) {
        b.classList.toggle("on", b.getAttribute("data-castfilter") === state.filter);
      });
    }
    document.querySelectorAll("[data-castfilter]").forEach(function (b) {
      b.addEventListener("click", function () {
        state.filter = b.getAttribute("data-castfilter");
        syncPills();
        renderShelf();
      });
    });
    document.getElementById("cast-search").addEventListener("input", function (ev) {
      state.search = ev.target.value;
      renderShelf();
    });

    // ---------- registry view ----------
    function renderRegistry() {
      var byCharacter = {}; // name -> { books: [], species }
      state.books.forEach(function (b) {
        (b.characters || []).forEach(function (c) {
          if (!byCharacter[c.name]) byCharacter[c.name] = { books: [], species: c.species };
          byCharacter[c.name].books.push(b.title);
        });
      });
      Object.keys(state.registry).forEach(function (name) {
        if (!byCharacter[name]) byCharacter[name] = { books: [], species: "" };
      });
      var names = Object.keys(byCharacter).sort();
      var castCount = names.filter(function (n) { return state.registry[n] && state.registry[n].voice_id; }).length;
      document.getElementById("registry-summary").textContent =
        castCount + " of " + names.length + " characters cast. Voices persist across books and new versions.";
      var body = document.getElementById("registry-body");
      body.innerHTML = "";
      names.forEach(function (name) {
        var info = byCharacter[name];
        var row = state.registry[name];
        var tr = document.createElement("tr");
        tr.className = "border-t border-stone-100";
        var tdName = document.createElement("td");
        tdName.className = "py-2 pr-3 font-semibold";
        tdName.textContent = name + (info.species ? " (" + info.species + ")" : "");
        var tdBooks = document.createElement("td");
        tdBooks.className = "py-2 pr-3 text-stone-600";
        tdBooks.textContent = info.books.join("; ") || "(registry only)";
        var tdVoice = document.createElement("td");
        tdVoice.className = "py-2 pr-3";
        var voice = row && row.voice_id ? voiceById(row.voice_id) : null;
        tdVoice.textContent = voice ? voice.name : (row && row.voice_name) || "Unknown";
        var tdStatus = document.createElement("td");
        tdStatus.className = "py-2";
        var pill = document.createElement("span");
        if (row && row.voice_id && row.source === "recorded") {
          pill.className = "rounded-full bg-green-100 text-green-800 text-[11px] font-semibold px-2 py-0.5";
          pill.textContent = "Recorded cast";
        } else if (row && row.voice_id) {
          pill.className = "rounded-full bg-[#1a3454] text-white text-[11px] font-semibold px-2 py-0.5";
          pill.textContent = "Cast";
        } else {
          pill.className = "rounded-full bg-amber-100 text-amber-800 text-[11px] font-semibold px-2 py-0.5";
          pill.textContent = "Open role";
        }
        tdStatus.appendChild(pill);
        tr.appendChild(tdName);
        tr.appendChild(tdBooks);
        tr.appendChild(tdVoice);
        tr.appendChild(tdStatus);
        body.appendChild(tr);
      });

      var logList = document.getElementById("log-list");
      logList.innerHTML = "";
      if (!state.log.length) {
        var li0 = document.createElement("li");
        li0.className = "text-stone-400";
        li0.textContent = "No assignments logged yet.";
        logList.appendChild(li0);
      }
      state.log.slice(0, 15).forEach(function (entry) {
        var v = voiceById(entry.voice_id);
        var li = document.createElement("li");
        var when = entry.created_at ? new Date(entry.created_at * 1000).toLocaleDateString() : "";
        li.textContent = entry.character_name + " → " + (v ? v.name : entry.voice_id) +
          " (" + entry.action + (when ? ", " + when : "") + ")";
        logList.appendChild(li);
      });
    }

    // ---------- loading ----------
    function applyRegistry(rows) {
      state.registry = {};
      (rows || []).forEach(function (r) { state.registry[r.character_name] = r; });
    }

    function loadOverview() {
      return fetch("/api/admin/cast-registry").then(function (r) { return r.json(); }).then(function (j) {
        state.books = j.books || [];
        applyRegistry(j.registry);
        state.log = j.log || [];
        renderShelf();
        renderRegistry();
      }).catch(function () { setStatus("Could not load the casting registry."); });
    }

    // ---------- tabs ----------
    function setView(view) {
      state.view = view;
      document.getElementById("view-cast").classList.toggle("hidden", view !== "cast");
      document.getElementById("view-registry").classList.toggle("hidden", view !== "registry");
      var on = "rounded-full bg-[#1a3454] text-white px-4 py-2 text-sm font-semibold";
      var off = "rounded-full bg-white text-stone-700 border border-stone-300 hover:border-stone-500 px-4 py-2 text-sm font-semibold";
      document.getElementById("tab-cast").className = view === "cast" ? on : off;
      document.getElementById("tab-registry").className = view === "registry" ? on : off;
    }
    document.getElementById("tab-cast").addEventListener("click", function () { setView("cast"); });
    document.getElementById("tab-registry").addEventListener("click", function () { setView("registry"); });

    loadOverview();
  </script>
  <script is:inline>
    document.querySelectorAll(".js-signout").forEach(function (el) {
      el.addEventListener("click", async function (e) {
        e.preventDefault();
        await fetch("/api/admin-auth/logout", { method: "POST" });
        await fetch("/api/auth/sign-out", { method: "POST", headers: { "Content-Type": "application/json" }, body: "{}" }).catch(function () {});
        window.location.href = "/login";
      });
    });
  </script>
</body>
</html>
