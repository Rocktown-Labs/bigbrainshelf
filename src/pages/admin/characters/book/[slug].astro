---
import "../../../../styles/global.css";
import { env } from "cloudflare:workers";
import AdminShell from "../../../../components/AdminShell.astro";
import { adminMediaUrl } from "../../../../lib/media";
import { publicSlugFor, resolveInternalSlug } from "../../../../lib/public-slugs";

export const prerender = false;
if (!Astro.locals.user) {
  return Astro.redirect("/admin/login");
}
// One book's character view (redesign fix C, 2026-11-03): the book's
// characters with their sheets, plus every action the shelf index's
// Options menu used to hold for the book (QC viewer, automatic pose
// crops, by-hand pose uploads, public page). The URL wears the public
// slug; resolution follows the public-slugs rules (public first, then
// internal, then retired aliases).
const e = env as any;
const internal = await resolveInternalSlug(e.DB, String(Astro.params.slug || ""));
if (!internal) return Astro.redirect("/admin/characters", 404);
const book = await e.DB.prepare(
  "SELECT slug, public_slug, title, cover_key, status FROM books WHERE slug = ?"
).bind(internal).first() as any;
if (!book) return Astro.redirect("/admin/characters", 404);
const pub = publicSlugFor(book);
const title = String(book.title || "Untitled book");
const status = String(book.status || "");
const coverUrl = book.cover_key ? adminMediaUrl(String(book.cover_key)) : null;
const charRows = await e.DB.prepare(
  "SELECT id, name, species, visual, real_maps_to, jpg_key FROM characters WHERE book_slug = ? ORDER BY name"
).bind(internal).all().catch(() => ({ results: [] }));
const chars = ((charRows.results || []) as any[]).map((c) => ({
  id: String(c.id),
  name: String(c.name || ""),
  species: String(c.species || ""),
  visual: String(c.visual || ""),
  mapsTo: c.real_maps_to ? String(c.real_maps_to) : "",
  sheetUrl: c.jpg_key
    ? `/api/admin/character-sheet?id=${encodeURIComponent(String(c.id))}&kind=color`
    : null,
  href: `/admin/characters/${encodeURIComponent(String(c.id))}`,
}));
---

<html lang="en">
<head>
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#1a3454" />
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width" />
  <title>{title} characters · Big Brain Shelf admin</title>
  <style is:global>
    body{font-family:ui-sans-serif,system-ui,sans-serif;background:#fafaf9;color:#1c1917;margin:0}
    .wrap{max-width:64rem;margin:0 auto;padding:1.75rem 1rem 4rem}
    h1{font-size:1.7rem;font-weight:800;letter-spacing:-.02em;margin:.25rem 0 .5rem}
    .card{background:#fff;border:1px solid #e7e5e4;border-radius:12px;padding:20px;margin:16px 0;box-shadow:0 1px 2px rgba(28,25,23,.05)}
    .card h2,.card h3{margin-top:0}
    .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:20px;margin-top:24px}
    .status{display:inline-block;padding:4px 12px;border-radius:999px;font-size:.85em;font-weight:600}
    .draft{background:#f5f5f4;color:#44403c}.queued{background:#dbeafe;color:#1e40af}.building{background:#fef3c7;color:#92400e}.ready_for_qa{background:#cffafe;color:#155e75}.in_progress{background:#fef3c7;color:#92400e}.complete{background:#dcfce7;color:#166534}.failed{background:#fee2e2;color:#991b1b}
    .meta{color:#78716c;font-size:.88em}
    a{color:#c2410c}
    .btn{display:inline-block;background:#ea580c;color:#fff;padding:10px 22px;border-radius:999px;font-weight:600;text-decoration:none;border:0;cursor:pointer;font-size:14px}
    .btn:hover{background:#c2410c}
    .ghostbtn{display:inline-block;background:#fff;color:#1c1917;border:1px solid #d6d3d1;padding:9px 18px;border-radius:999px;font-weight:600;cursor:pointer;font-size:14px;text-decoration:none}
    .card img.charthumb{width:100%;height:230px;object-fit:cover;border-radius:8px;background:#f5f5f4}
    .bookhead{display:flex;gap:18px;align-items:flex-start}
    .bookhead .coverthumb{width:92px;flex:0 0 auto;aspect-ratio:3/4;border-radius:8px;overflow:hidden;border:1px solid #e7e5e4;background:#f5f5f4}
    .bookhead .coverthumb img{width:100%;height:100%;object-fit:cover;display:block}
    .toolrow{display:flex;flex-wrap:wrap;gap:10px;margin-top:14px}
  </style>
  </head>
<body>
  <AdminShell current="/admin/characters" />
  <main class="wrap">
    <p><a href="/admin/characters">&larr; Back to the character shelf</a></p>
    <div class="bookhead">
      {coverUrl ? <span class="coverthumb"><img src={coverUrl} alt="" /></span> : null}
      <div>
        <h1>{title}</h1>
        <p style="margin:0 0 8px"><span class={`status ${status}`}>{status.replace(/_/g, " ")}</span></p>
        <p class="meta" style="margin:0">{chars.length === 1 ? "1 character" : `${chars.length} characters`} in the library for this book.</p>
      </div>
    </div>

    <div class="card">
      <h2 style="margin-top:0">Book tools</h2>
      <p class="meta" style="margin:0">Check the pages in the QC viewer, fix pose crops with the automatic boxes, or upload poses you cut yourself from the sheet.</p>
      <div class="toolrow">
        <a class="btn" href={`/admin/books/${pub}`}>QC viewer</a>
        <a class="ghostbtn" href={`/admin/books/${pub}/crops`}>Pose crops (automatic)</a>
        <a class="ghostbtn" href={`/admin/books/${pub}/poses`}>Upload poses by hand</a>
        <a class="ghostbtn" href={`/books/${pub}`}>Public book page</a>
      </div>
    </div>

    <h2 style="margin:32px 0 0;font-size:1.3rem;font-weight:800;letter-spacing:-.01em">Characters</h2>
    {chars.length ? (
      <div class="grid">
        {chars.map((c) => (
          <a href={c.href} style="display:block;text-decoration:none;color:inherit">
            <div class="card" style="margin:0;height:100%;box-sizing:border-box">
              {c.sheetUrl ? <img class="charthumb" src={c.sheetUrl} alt={c.name} loading="lazy" /> : null}
              <h3>{c.name}</h3>
              <p class="meta">{c.species}</p>
              <p>{c.visual}</p>
              {c.mapsTo ? <p class="meta">Maps to: {c.mapsTo}</p> : null}
              <p style="margin:12px 0 0;color:#c2410c;font-weight:600">View full sheet &rarr;</p>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <div class="card">
        <h2 style="margin-top:0">No characters yet</h2>
        <p class="meta">This book has no characters in the library yet. Generate their sheets in the character studio and they will appear here.</p>
        <p style="margin-bottom:0"><a class="btn" href="/admin/characters#studio">Open the character studio</a></p>
      </div>
    )}
  </main>
  <script is:inline>
    document.querySelectorAll(".js-signout").forEach(function (el) {
      el.addEventListener("click", async function (e) {
        e.preventDefault();
        await fetch("/api/admin-auth/logout", { method: "POST" });
        await fetch("/api/auth/sign-out", { method: "POST", headers: { "Content-Type": "application/json" }, body: "{}" }).catch(function () {});
        window.location.href = "/login";
      });
    });
  </script>
</body>
</html>
