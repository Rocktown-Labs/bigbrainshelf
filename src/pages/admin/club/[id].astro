---
import "../../../styles/global.css";
import AdminShell from "../../../components/AdminShell.astro";
import { env } from "cloudflare:workers";
import { markSeen } from "../../../lib/seen";
export const prerender = false;
// Club member detail (CG, 2026-10-31: members had no page of
// their own; the first client-rendered version came up blank
// in his browser, so this page renders on the SERVER: the data
// is in the HTML, no fetch to fail). Opening the member stamps
// them seen, clearing the sidebar badge unless a payment
// failed (the state rule keeps those counted).
const memberId = String(Astro.params.id || "");
const db = (env as any).DB;
let member: any = null;
let boxes: any[] = [];
let orders: any[] = [];
try {
  member = await db.prepare("SELECT * FROM club_signups WHERE id = ?").bind(memberId).first();
  if (member) {
    await markSeen(db, "club_signups", memberId);
    try {
      const b = await db.prepare(
        "SELECT * FROM club_cycle_boxes WHERE signup_id = ? ORDER BY ship_date ASC LIMIT 100"
      ).bind(memberId).all();
      boxes = (b.results || []) as any[];
    } catch { /* cycle tables may not exist yet */ }
    try {
      const o = await db.prepare(
        "SELECT id, amount, status, physical_status, created_at FROM orders WHERE email = ? ORDER BY created_at DESC LIMIT 20"
      ).bind(String(member.email || "")).all();
      orders = (o.results || []) as any[];
    } catch { /* orders are a bonus, never a blocker */ }
  }
} catch { /* renders the not-found state below */ }

const fmtDate = (ts: any) =>
  ts ? new Date(Number(ts) * 1000).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" }) : "–";
const money = (c: any) => "$" + ((Number(c) || 0) / 100).toFixed(2);
const human = (s: any) => String(s || "").replace(/_/g, " ");
const audio = member?.club_plan === "audio";
const clubName = audio ? "The Audio Club" : "The Book Club";
const period = member?.plan === "annual" ? "Annual" : member?.plan === "monthly" ? "Monthly" : "Quarterly";
const shortId = (id: any) => "#" + String(id || "").replace(/-/g, "").slice(0, 8).toUpperCase();
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>Club member · Big Brain Shelf Admin</title>
  <style is:global>
    .mcard{background:#fff;border:1px solid #e7e5e4;border-radius:12px;padding:16px 18px;box-shadow:0 1px 2px rgba(28,25,23,.05)}
    .mcard h2{font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.12em;color:#a8a29e;margin:0 0 10px}
    .mrow{display:flex;justify-content:space-between;gap:16px;padding:6px 0;border-bottom:1px solid #f5f5f4;font-size:.9rem}
    .mrow:last-child{border-bottom:0}
    .mrow .k{color:#78716c}
    .mrow .v{font-weight:600;text-align:right}
    .mono{font-family:ui-monospace,monospace;font-size:.75rem;color:#78716c;word-break:break-all}
    .bchip{display:inline-flex;align-items:center;font-size:.7rem;font-weight:700;padding:2px 8px;border-radius:999px;background:#f5f5f4;color:#57534e;white-space:nowrap}
    .bchip-bad{background:#fef2f2;color:#b91c1c}
    .bchip-warn{background:#fffbeb;color:#b45309}
    .bchip-good{background:#ecfdf5;color:#047857}
  </style>
</head>
<body class="bg-stone-50 text-stone-900 antialiased">
  <AdminShell current="/admin/club" title="Club member">
    <p class="text-sm"><a class="text-orange-700 font-semibold" href="/admin/club">← Back to Club</a></p>
    {!member ? (
      <p class="mt-4 text-red-600 text-sm">Member not found.</p>
    ) : (
      <div class="mt-3 flex flex-col gap-4">
        <div class="mcard">
          <h2>Member</h2>
          <p class="text-xl font-extrabold">{member.name || member.email}</p>
          <p class="text-sm text-stone-500">{member.email}</p>
          <div class="mt-3">
            <div class="mrow"><span class="k">Club</span><span class="v">{clubName} · {period}</span></div>
            <div class="mrow"><span class="k">Status</span><span class="v">
              {member.status === "paid"
                ? <span class="bchip bchip-good">Paid member</span>
                : <span class="bchip">{human(member.status)}</span>}
              {member.subscription_status && member.subscription_status !== "active" && (
                <span class="bchip bchip-warn">{human(member.subscription_status)}</span>
              )}
            </span></div>
            <div class="mrow"><span class="k">Joined</span><span class="v">{fmtDate(member.created_at)}</span></div>
            {member.paid_at && (
              <div class="mrow"><span class="k">Paid since</span><span class="v">{fmtDate(member.paid_at)}</span></div>
            )}
            {!audio && member.first_ship_date && (
              <div class="mrow"><span class="k">First box</span><span class="v">{member.first_ship_date}</span></div>
            )}
            {member.payment_failed_at && (
              <div class="mrow"><span class="k">Payment failed</span><span class="v"><span class="bchip bchip-bad">{fmtDate(member.payment_failed_at)}</span></span></div>
            )}
            {member.canceled_at && (
              <div class="mrow"><span class="k">Canceled</span><span class="v">{fmtDate(member.canceled_at)}</span></div>
            )}
          </div>
        </div>
        <div class="mcard">
          <h2>Account</h2>
          <div>
            <div class="mrow"><span class="k">Store account</span><span class="v">{member.user_id ? "Linked" : "No account linked yet"}</span></div>
            <div class="mrow"><span class="k">Stripe customer</span><span class="v mono">{member.stripe_customer_id || "–"}</span></div>
            <div class="mrow"><span class="k">Subscription</span><span class="v mono">{member.stripe_subscription_id || "–"}</span></div>
          </div>
        </div>
        {!audio && boxes.length > 0 && (
          <div class="mcard">
            <h2>Boxes</h2>
            <div>
              {boxes.map((b) => (
                <div class="mrow">
                  <span class="k">{b.ship_date}</span>
                  <span class="v">{human(b.status)}{b.tracking_number ? <span class="mono"> · {b.tracking_number}</span> : null}</span>
                </div>
              ))}
            </div>
          </div>
        )}
        <div class="mcard">
          <h2>Store orders</h2>
          <div>
            {orders.length === 0 && <p class="text-sm text-stone-400">No store orders under this email.</p>}
            {orders.map((o) => (
              <div class="mrow">
                <span class="k"><a class="text-orange-700 font-semibold" href={`/admin/orders/${o.id}`}>{shortId(o.id)}</a> · {fmtDate(o.created_at)}</span>
                <span class="v">{money(o.amount)}{o.physical_status ? <span class="bchip"> {human(o.physical_status)}</span> : null}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    )}
  </AdminShell>
</body>
</html>
