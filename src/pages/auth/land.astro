---
export const prerender = false;
import { env } from "cloudflare:workers";
import { getAuth } from "../../lib/auth";
import { createSession } from "../../middleware";

// Post-sign-in landing: check the signed-in user's role and send them
// to the right spot. Admins land in /admin (with the admin session
// cookie the middleware requires); customers land in their library,
// or at a safe `next` they were heading for.
import { isAdminEmail } from "../../lib/admins";
const e = env as any;

const session = await getAuth()
  .api.getSession({ headers: Astro.request.headers })
  .catch(() => null);

if (!session?.user) {
  return Astro.redirect("/login", 302);
}

const next = Astro.url.searchParams.get("next") || "";
const email = (session.user.email || "").toLowerCase();
let role = (session.user as any).role as string | undefined;

// Self-heal: the owner address always carries the admin role, even if
// the account predates the role hook.
if (isAdminEmail(email) && role !== "admin") {
  try {
    await e.DB.prepare('UPDATE "user" SET role=? WHERE lower(email)=?')
      .bind("admin", email)
      .run();
    role = "admin";
  } catch {}
}

const isAdmin = role === "admin" || isAdminEmail(email);
const safePath = (p: string) =>
  p.startsWith("/") && !p.startsWith("//") && !p.startsWith("/login");

if (isAdmin) {
  const dest = next && safePath(next) ? next : "/admin";
  const cookie = await createSession(email, e.BETTER_AUTH_SECRET);
  return new Response(null, {
    status: 302,
    headers: {
      Location: dest,
      "Set-Cookie": `admin_session=${cookie}; Path=/; HttpOnly; Secure; SameSite=Lax; Max-Age=${7 * 24 * 3600}`,
    },
  });
}

// isOnboarded gate (CG's hub brief, 2026-11-01): a customer with no
// explicit destination who has not finished family setup lands on
// /onboarding first. Skipping there stamps completion, so the gate
// fires once, never as a nag. A failure here must never break
// sign-in, so every error falls through to the account.
let dest =
  next && safePath(next) && !next.startsWith("/admin") ? next : "/account";
if (dest === "/account") {
  try {
    const { getParentOnboarding } = await import("../../lib/family");
    const ob = await getParentOnboarding(e.DB, session.user.id).catch(() => null);
    if (!ob?.completed_at) dest = "/onboarding";
  } catch {}
}
return Astro.redirect(dest, 302);
---
