---
import "../../styles/global.css";
import { env } from "cloudflare:workers";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import CartSheet from "../../components/CartSheet.astro";
import Tracking from "../../components/Tracking.astro";
import { ClientRouter } from "astro:transitions";
import TransitionHooks from "../../components/TransitionHooks.astro";
import SeoHead from "../../components/SeoHead.astro";
import LanguageBadge from "../../components/LanguageBadge.astro";
import { getSamplePages } from "../../lib/sample";
import { coverDerivative } from "../../lib/derivatives";
import { GIFT_SET_PRICE_CENTS, giftSetEligible, isChristmasSeason, CHRISTMAS_ORDER_BY_LABEL, formatPublishedDate, AUDIO_PRICE_CENTS, audioEligible } from "../../lib/offers";
import { getDigitalEntitlements } from "../../lib/library";
import { getAuth } from "../../lib/auth";
import { ensureReviewsTable, reviewMediaKeys } from "../../lib/reviews";
import { resolveBookForPublicRoute, publicSlugFor, isBookPubliclyListed } from "../../lib/public-slugs";
import {
  loadLocalizedBook,
  bookTextFor,
  bookPathForLocale,
  absoluteUrl,
  formatMoneyCents,
  formatDateInLang,
  languageDef,
  type LangCode,
  type LocalizedBookPackage,
} from "../../lib/i18n";
import { bookPageStrings } from "../../lib/strings/index";
export const prerender = false;

// Public URL layer (src/lib/public-slugs.ts): this route's param is
// the book's PUBLIC, title-based slug. The internal slug stays the
// key for everything below (reviews, sample selection, cart items,
// entitlements); only the address bar, canonical/OG URLs, and links
// wear the public one. A request that arrives under the old internal
// slug 301s to the canonical public URL, query string included.
const param = String(Astro.params.slug || "");
const db = env.DB;
const resolved = await resolveBookForPublicRoute(db, param);
if (!resolved) return Astro.redirect("/", 404);
const book: any = resolved.book;
// F8: only listed books (published, or audio-published) have a public
// page. Draft/QA/repair titles that are neither stay invisible even
// when their slug or public slug is guessed.
if (!isBookPubliclyListed(book)) return Astro.redirect("/", 404);
const publicSlug = publicSlugFor(book);
if (resolved.via === "internal") {
  return Astro.redirect(`/books/${publicSlug}${Astro.url.search}`, 301);
}
const slug = String(book.slug);

// Locale (i18n Phase 0): this ONE page body serves every locale.
// English is the canonical route (unprefixed, Astro.currentLocale
// "en"); a locale route (src/pages/{lang}/books/[slug].astro) is a
// thin wrapper that pre-checks and renders this same page, where
// currentLocale carries the locale. In a localized render the book's
// display text comes from its stored edition package in R2
// (src/lib/i18n.ts), chrome strings come from the string catalog
// (src/lib/strings), prices render through the Intl formatter, and
// the page STRUCTURE is identical across locales (CG's parity rule,
// 2026-10-30): same sections, same order, same session/review logic.
// Commerce is the one sanctioned difference: on a localized render
// the picker and CTA render in the same slot with the same styling
// but disabled (the edition is not sellable yet), and the cart and
// sample machinery is not emitted. A locale with no stored package
// for this book 404s here (the wrapper pre-checks the same
// condition). English rendering is the original page, byte for byte:
// every localized branch is inert when isLocalized is false.
const lang = (Astro.currentLocale ?? "en") as LangCode;
const isLocalized = lang !== "en";
const langDef = languageDef(lang);
const bs = bookPageStrings(lang);
let pkg: LocalizedBookPackage | null = null;
if (isLocalized) {
  pkg = await loadLocalizedBook(env as any, slug, lang);
  if (!pkg) return new Response("Not found", { status: 404 });
}
const text = bookTextFor(book, pkg);
const displayTitle = text.title;
const displayDescription = text.description;

// Free sample: the book's first 5 defect-free pages (see
// src/lib/sample.ts). The sample button only renders when a full
// 5-page sample exists; pages are served one at a time through the
// capped /api/sample route. Catalog books only: a book with no
// finished picture book (Tilda's partial build) gets no sample, since
// its pages were never verified.
const samplePages = !isLocalized && book.picture_book_key ? await getSamplePages(env as any, String(slug)) : [];
const sampleLabels = samplePages.map((p) => p.label);
const hasSample = samplePages.length >= 5;

const R2 = "https://media.bigbrainshelf.com/";
const cover = book.cover_key ? R2 + book.cover_key : "";
const coverHero = coverDerivative(book.slug, "hero", book.cover_key) || cover;
const price = "$" + (Number(book.price || 0) / 100).toFixed(2);
const pricePrint = "$" + (Number(book.price_print || 0) / 100).toFixed(2);
const topic = book.topic || "tech";
// Publication date, stamped once by the publish action. Books that
// went live before the stamp existed carry no date and show no line.
const publishedLabel = book.published_at ? formatPublishedDate(Number(book.published_at)) : null;
// The rendered "Published ..." line: identical construction in
// English; localized pages get the catalog prefix and an Intl date.
const publishedText = book.published_at
  ? isLocalized
    ? `${bs.publishedPrefix} ${formatDateInLang(Number(book.published_at), lang)}`
    : `Published ${publishedLabel}`
  : null;
const buyable = book.status === "complete" && Number(book.price || 0) > 0;
// Gift Set: full color printed storybook + printed coloring book +
// digital bundle at the flat gift set price. Appears automatically on
// any live book that has both a story book and a coloring book.
const giftEligible = buyable && giftSetEligible(book as any);
const giftPrice = "$" + (GIFT_SET_PRICE_CENTS / 100).toFixed(2);
const christmasSeason = isChristmasSeason();
const adminUser = Astro.locals.user;
const viewEvent = {
  name: "ViewContent",
  data: {
    content_ids: [slug],
    content_name: book.title,
    content_type: "product",
    value: Number(book.price || 0) / 100,
    currency: "USD",
  },
};

// Reviews (Phase 3): only APPROVED reviews are ever read here; pending
// and rejected ones stay invisible. The summary shows only when at
// least one approved review exists (no fake ratings).
await ensureReviewsTable(db as any);
const approvedReviews = (await db.prepare(
  "SELECT * FROM reviews WHERE book_slug = ? AND status = 'approved' ORDER BY created_at DESC LIMIT 50"
).bind(slug).all()).results as any[];
const reviewCount = approvedReviews.length;
const reviewAvg = reviewCount
  ? approvedReviews.reduce((s: number, r: any) => s + Number(r.rating || 0), 0) / reviewCount
  : 0;
// Rendered review labels, pre-composed so the template's English
// output is character-identical to the original inline expressions.
const reviewAvgLabel = isLocalized
  ? new Intl.NumberFormat(langDef.bcp47, { minimumFractionDigits: 1, maximumFractionDigits: 1 }).format(reviewAvg)
  : reviewAvg.toFixed(1);
const reviewsParen = `(${reviewCount} ${reviewCount === 1 ? bs.reviewOne : bs.reviewMany})`;
const basedOnLine = `${bs.basedOnPrefix} ${reviewCount} ${reviewCount === 1 ? bs.reviewOne : bs.reviewMany}`;
const reviewSignInHref = `/login?next=${bookPathForLocale(lang, publicSlug)}`;
// This page's own path in its locale, for the review script's
// re-init guard (English value is the long-standing "/books/{slug}").
const reviewPath = bookPathForLocale(lang, publicSlug);

// Customer session (better-auth), separate from the admin locals.user.
// The lookup runs in EVERY locale (parity, 2026-10-30): a signed-in
// visitor on a localized page gets the same review form and owner
// treatment as on the English page, rendered in the page's strings.
let customer: any = null;
try {
  const sess = await getAuth().api.getSession({ headers: Astro.request.headers });
  customer = sess?.user || null;
} catch { customer = null; }
let myReview: any = null;
let ownsBook = false;
if (customer) {
  myReview = await db.prepare(
    "SELECT * FROM reviews WHERE user_id = ? AND book_slug = ?"
  ).bind(customer.id, slug).first();
  // Entitlement = bought it (orders by id or email) or can read /
  // listen through a club: the same map the library uses, and the
  // same gate the review API enforces (CG, 2026-10-31).
  const { getDigitalEntitlements } = await import("../../lib/library");
  // SECURITY (F1): email fallback only for verified sessions.
  ownsBook = (await getDigitalEntitlements(db as any, {
    id: customer.id,
    email: customer.email,
    emailVerified: customer.emailVerified === true,
  } as any)).has(String(slug));
}
const starRow = (n: number) => [1, 2, 3, 4, 5].map((i) => (i <= Math.round(n) ? "★" : "☆")).join("");
// Audiobook only: offered beside the bundle whenever the book has an
// audiobook, at the flat store audio price. A signed-in owner of the
// audiobook only sees the digital format at the upgrade price
// (digital price minus the audio price they already paid); checkout
// recomputes and enforces the same credit server-side, so this is
// display only. Owner means owned (the lock model): a club member
// whose listening comes from the membership layer gets no credit and
// sees list prices, exactly like anonymous visitors and everyone else.
const hasAudio = audioEligible(book as any);
const audioPrice = "$" + (AUDIO_PRICE_CENTS / 100).toFixed(2);
let audioOnlyOwner = false;
if (customer) {
  try {
    const ents = await getDigitalEntitlements(db as any, {
      id: customer.id,
      email: String(customer.email || ""),
      emailVerified: customer.emailVerified === true,
    });
    const ent = ents.get(String(slug));
    audioOnlyOwner = !!ent && ent.owned && !ent.digital && ent.audio;
  } catch { audioOnlyOwner = false; }
}
const upgradeDigitalCents = Math.max(0, Number(book.price || 0) - AUDIO_PRICE_CENTS);
const digitalCentsEffective = audioOnlyOwner ? upgradeDigitalCents : Number(book.price || 0);
const digitalPrice = "$" + (digitalCentsEffective / 100).toFixed(2);
const preselectAudio = Astro.url.searchParams.get("format") === "audio" && hasAudio;
const initialPrice = preselectAudio ? audioPrice : digitalPrice;
// The price the page displays at first render: English keeps its
// preformatted string; localized pages format the digital price
// through Intl in the locale's conventions.
const displayInitialPrice = isLocalized ? formatMoneyCents(Number(book.price || 0), lang) : initialPrice;
// Localized format-picker prices (the disabled picker on localized
// pages). Unused in English renders.
const locDigital = formatMoneyCents(Number(book.price || 0), lang);
const locPrint = formatMoneyCents(Number(book.price_print || 0), lang);
const locGift = formatMoneyCents(GIFT_SET_PRICE_CENTS, lang);
const locAudio = formatMoneyCents(AUDIO_PRICE_CENTS, lang);
// Social metadata + structured data for this book, built only from
// values already rendered on the page (title, description, cover,
// prices). No rating data: only approved reviews count and none are
// claimed here.
const bookCanonical = isLocalized
  ? absoluteUrl(bookPathForLocale(lang, publicSlug))
  : `https://bigbrainshelf.com/books/${publicSlug}`;
// Localized pages describe the Book only, from the package, with no
// Product/offers graph: a not-yet-sellable edition must not claim
// offers. The English construction below is untouched.
const bookJsonLd: Record<string, unknown> = isLocalized
  ? {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Book",
          name: displayTitle,
          ...(displayDescription ? { description: displayDescription } : {}),
          ...(cover ? { image: cover } : {}),
          url: bookCanonical,
          inLanguage: langDef.bcp47,
          publisher: { "@type": "Organization", name: "Big Brain Shelf" },
        },
      ],
    }
  : {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Book",
      name: book.title,
      ...(book.description ? { description: book.description } : {}),
      ...(cover ? { image: cover } : {}),
      url: bookCanonical,
      publisher: { "@type": "Organization", name: "Big Brain Shelf" },
    },
    ...(buyable
      ? [
          {
            "@type": "Product",
            name: book.title,
            ...(book.description ? { description: book.description } : {}),
            ...(cover ? { image: cover } : {}),
            url: bookCanonical,
            offers: [
              {
                "@type": "Offer",
                name: "Digital bundle",
                priceCurrency: "USD",
                price: (Number(book.price || 0) / 100).toFixed(2),
                availability: "https://schema.org/InStock",
                url: bookCanonical,
              },
              ...(Number(book.price_print || 0) > 0
                ? [
                    {
                      "@type": "Offer",
                      name: "Full color printed book",
                      priceCurrency: "USD",
                      price: (Number(book.price_print || 0) / 100).toFixed(2),
                      availability: "https://schema.org/InStock",
                      url: bookCanonical,
                    },
                  ]
                : []),
              ...(hasAudio
                ? [
                    {
                      "@type": "Offer",
                      name: "Audiobook only",
                      priceCurrency: "USD",
                      price: (AUDIO_PRICE_CENTS / 100).toFixed(2),
                      availability: "https://schema.org/InStock",
                      url: bookCanonical,
                    },
                  ]
                : []),
            ],
          },
        ]
      : []),
  ],
    };

---

<html lang={langDef.bcp47}>
<head>
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#1a3454" />
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{displayTitle} — Big Brain Shelf</title>
  <meta name="description" content={displayDescription || displayTitle} />
  <SeoHead
    title={`${displayTitle} — Big Brain Shelf`}
    socialDescription={displayDescription || undefined}
    image={cover || undefined}
    imageAlt={`${displayTitle} ${bs.coverAltWord}`}
    jsonLd={bookJsonLd}
  />{isLocalized && (<><meta name="robots" content="noindex" /><meta property="og:locale" content={langDef.ogLocale} /><link rel="alternate" hreflang="en" href={absoluteUrl(bookPathForLocale("en", publicSlug))} /><link rel="alternate" hreflang={langDef.bcp47} href={absoluteUrl(bookPathForLocale(lang, publicSlug))} /><link rel="alternate" hreflang="x-default" href={absoluteUrl(bookPathForLocale("en", publicSlug))} /></>)}
    <ClientRouter />
  <TransitionHooks />
  {!isLocalized && <Tracking pageEvent={viewEvent} traksEvent={{ name: "book_view", props: { topic } }} />}
</head>
<body class="bg-white text-stone-900 antialiased">
  {isLocalized ? <SiteHeader search /> : <SiteHeader search cartMode="sheet" />}

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <a href="/" class="inline-block mt-5 sm:mt-6 py-1 text-sm text-stone-500 hover:text-stone-900">&larr; {bs.backToShelf}</a>
    <div class="grid md:grid-cols-2 gap-6 sm:gap-10 py-4 sm:py-6 pb-12 sm:pb-20 max-w-5xl">
      <div>
        {cover
          ? <div class="relative w-full aspect-[3/4] bg-stone-100" style={`view-transition-name: book-cover-${book.slug}`} role="img" aria-label={`${displayTitle} ${bs.coverAltWord}`}>
              <span aria-hidden="true" class="absolute inset-0 z-10 pointer-events-none" style="box-shadow: inset 18px 0 26px -16px rgba(0,0,0,.5), inset -1px 0 2px rgba(0,0,0,.12), inset 0 0 0 1px rgba(0,0,0,.07)"></span>
              <img src={coverHero} alt="" aria-hidden="true" class="absolute inset-0 w-full h-full object-cover" />
              <img src="/just-buy-it.webp" alt="" aria-hidden="true" class="absolute inset-0 z-20 w-full h-full opacity-0" />{isLocalized && <LanguageBadge locale={lang} />}
            </div>
          : <div class="w-full aspect-[3/4] bg-stone-100"></div>}
      </div>
      <div>
        <span class="inline-block text-xs font-semibold uppercase tracking-wider text-orange-600 capitalize mb-2">{topic}</span>
        <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight leading-tight mb-3 break-words">{displayTitle}</h1>
        {publishedText && <p class="text-sm text-stone-500 -mt-1 mb-3">{publishedText}</p>}
        {reviewCount > 0 && (
          <p class="mb-3 text-sm">
            <a href="#reviews" class="inline-flex items-center gap-2 hover:underline">
              <span class="text-orange-500 text-base tracking-tight">{starRow(reviewAvg)}</span>
              <span class="font-semibold">{reviewAvgLabel}</span>
              <span class="text-stone-500">{reviewsParen}</span>
            </a>
          </p>
        )}
        {/* The purchase cluster sits ABOVE the description (site
            review, 2026-10-30): ad traffic lands here on phones, and
            the price ladder and Add to cart were buried under the
            description, the includes list and the chips. The formats
            are radio cards in the ads' order (digital bundle,
            printed, audio, gift set last) so the whole ladder,
            including "digital included" on the printed book, is
            visible without opening anything; a native select hid it
            behind a system picker on phones. Labels use colons, never
            em dashes, and the bundle names its contents with the
            same words the ads use: Storybook, Coloring book, Ebook,
            Audio book. */}
        <div class="mb-6">
          <span id="price-display" class="block text-2xl font-bold tracking-tight mb-3">{displayInitialPrice}</span>
          {isLocalized && buyable ? (
            <span class="flex items-center gap-3 flex-wrap max-sm:flex-col max-sm:items-stretch max-sm:flex-nowrap">
              <select disabled aria-disabled="true" class="max-sm:w-full min-w-0 border border-stone-300 rounded-full px-4 py-3 text-sm bg-stone-50 text-stone-500 cursor-not-allowed" aria-label={bs.formatPickerLabel}>
                <option>{bs.digitalLabel}: {locDigital}</option>
                {Number(book.price_print || 0) > 0 && <option>{bs.printLabel}: {locPrint}</option>}
                {giftEligible && <option>{bs.giftSetLabel}: {locGift}</option>}
                {hasAudio && <option>{bs.audioLabel}: {locAudio}</option>}
              </select>
              <button type="button" disabled aria-disabled="true" class="max-sm:w-full bg-stone-200 text-stone-500 rounded-full px-8 py-3 text-sm font-semibold cursor-not-allowed">{bs.notAvailableButton}</button>
            </span>
          ) : buyable ? (
            <span class="block">
              <div id="format" role="radiogroup" aria-label="Choose format" class="flex flex-col gap-2 max-w-xl">
                <label class="block cursor-pointer select-none touch-manipulation">
                  <input type="radio" name="bbs-format" value="digital" class="peer sr-only" checked={!preselectAudio} />
                  <span class="flex items-start justify-between gap-3 rounded-xl border border-stone-300 bg-white px-4 py-3 transition duration-100 peer-checked:border-orange-600 peer-checked:bg-orange-50 peer-focus-visible:outline-2 peer-focus-visible:outline-orange-600 active:scale-[0.99]">
                    <span>
                      <span class="block text-sm font-bold">Digital bundle</span>
                      <span class="block text-[13px] text-stone-500 leading-snug mt-0.5">Storybook, coloring book, ebook{book.audiobook_key ? " and audiobook" : ""}. Delivered instantly.</span>
                    </span>
                    <span class="text-sm font-bold whitespace-nowrap">{digitalPrice}</span>
                  </span>
                </label>
                {Number(book.price_print || 0) > 0 && (
                  <label class="block cursor-pointer select-none touch-manipulation">
                    <input type="radio" name="bbs-format" value="printed" class="peer sr-only" />
                    <span class="flex items-start justify-between gap-3 rounded-xl border border-stone-300 bg-white px-4 py-3 transition duration-100 peer-checked:border-orange-600 peer-checked:bg-orange-50 peer-focus-visible:outline-2 peer-focus-visible:outline-orange-600 active:scale-[0.99]">
                      <span>
                        <span class="block text-sm font-bold">Printed book</span>
                        <span class="block text-[13px] text-stone-500 leading-snug mt-0.5">Full color printed storybook. Digital bundle included.</span>
                      </span>
                      <span class="text-sm font-bold whitespace-nowrap">{pricePrint}</span>
                    </span>
                  </label>
                )}
                {hasAudio && (
                  <label class="block cursor-pointer select-none touch-manipulation">
                    <input type="radio" name="bbs-format" value="audio" class="peer sr-only" checked={preselectAudio} />
                    <span class="flex items-start justify-between gap-3 rounded-xl border border-stone-300 bg-white px-4 py-3 transition duration-100 peer-checked:border-orange-600 peer-checked:bg-orange-50 peer-focus-visible:outline-2 peer-focus-visible:outline-orange-600 active:scale-[0.99]">
                      <span>
                        <span class="block text-sm font-bold">Audiobook only</span>
                        <span class="block text-[13px] text-stone-500 leading-snug mt-0.5">The full story, read aloud.</span>
                      </span>
                      <span class="text-sm font-bold whitespace-nowrap">{audioPrice}</span>
                    </span>
                  </label>
                )}
                {giftEligible && (
                  <label class="block cursor-pointer select-none touch-manipulation">
                    <input type="radio" name="bbs-format" value="giftset" class="peer sr-only" />
                    <span class="flex items-start justify-between gap-3 rounded-xl border border-stone-300 bg-white px-4 py-3 transition duration-100 peer-checked:border-orange-600 peer-checked:bg-orange-50 peer-focus-visible:outline-2 peer-focus-visible:outline-orange-600 active:scale-[0.99]">
                      <span>
                        <span class="block text-sm font-bold">Gift Set</span>
                        <span class="block text-[13px] text-stone-500 leading-snug mt-0.5">Printed storybook and printed coloring book. Digital bundle included.</span>
                      </span>
                      <span class="text-sm font-bold whitespace-nowrap">{giftPrice}</span>
                    </span>
                  </label>
                )}
              </div>
              <button id="buy" class="mt-3 w-full sm:w-auto bg-stone-900 text-white rounded-full px-8 py-3 text-sm font-semibold hover:bg-black transition duration-100 active:scale-[0.97]">Add to cart</button>
            </span>
          ) : (
            <span class="text-sm text-stone-500">{bs.availableSoon}</span>
          )}
        </div>
        {!isLocalized && <p id="buy-note" hidden class="text-sm mt-4"><a href="/cart" class="js-cart-open text-orange-700 font-medium">Added to your cart. Review it here.</a></p>}
        {!isLocalized && hasAudio && (
          <p id="format-note" class="text-sm text-stone-500 mt-4 max-w-xl" hidden={!preselectAudio}>
            Audiobook only means listening: stream it in your library or download the audiobook file. It does not include the storybook, coloring book, or ebook files.
          </p>
        )}
        {!isLocalized && audioOnlyOwner && (
          <p class="text-sm text-orange-700 mt-4 max-w-xl">
            You own the audiobook, so the digital book is {digitalPrice} for you. Your audiobook credit comes off at checkout.
          </p>
        )}
        {!isLocalized && giftEligible && (
          <p class="text-sm text-stone-500 mt-4 max-w-xl">
            {christmasSeason
              ? `Giving it as a gift? The Gift Set pairs the printed storybook with the printed coloring book, ready to wrap. Ordering for Christmas: please order by ${CHRISTMAS_ORDER_BY_LABEL} so there is time to print, bind, and mail it.`
              : "Giving it as a gift? The Gift Set pairs the printed storybook with the printed coloring book, a ready-made present."}
          </p>
        )}
        {!isLocalized && hasSample && (
          <div class="mt-6 mb-6">
            <button id="sample-open" type="button" class="w-full sm:w-auto rounded-full border-2 border-[#1a3454] text-[#1a3454] px-6 py-2.5 text-sm font-semibold hover:bg-[#1a3454] hover:text-white transition duration-100 active:scale-[0.97]">Read a free sample</button>
            <p class="text-xs text-stone-400 mt-2">The first 5 pages, free. No account needed.</p>
          </div>
        )}
        {displayDescription && <p class="text-stone-600 leading-relaxed mb-6 max-w-xl">{displayDescription}</p>}
        {book.topics && (
          <div class="flex gap-2 flex-wrap mb-6">
            {book.topics.split(",").map((t: string) => t.trim()).filter(Boolean).map((t: string) => (
              <span class="text-xs font-medium bg-stone-100 text-stone-700 px-2.5 py-1 rounded-full capitalize">{t}</span>
            ))}
          </div>
        )}
        <ul class="mb-6 max-w-xl">
          {book.picture_book_key && <li class="flex items-center gap-3 py-2.5 border-t border-stone-200 text-sm"><span class="w-1.5 h-1.5 rounded-full bg-orange-600 shrink-0"></span>{bs.includesPicture}</li>}
          {book.coloring_book_key && <li class="flex items-center gap-3 py-2.5 border-t border-stone-200 text-sm"><span class="w-1.5 h-1.5 rounded-full bg-orange-600 shrink-0"></span>{bs.includesColoring}</li>}
