  {!isLocalized && <script is:inline define:vars={{ slug, publicSlug, priceCents: digitalCentsEffective, printCents: Number(book.price_print || 0), giftCents: GIFT_SET_PRICE_CENTS, audioCents: AUDIO_PRICE_CENTS }}>
    function money(cents) { return "$" + (cents / 100).toFixed(2); }
    function centsFor(format) {
      return format === "printed" ? printCents : format === "giftset" ? giftCents : format === "audio" ? audioCents : priceCents;
    }
    // Bind the format picker and Add to cart for THIS book. Runs on
    // first render and again on astro:page-load; the path check keeps
    // a listener registered by another book's page from ever acting
    // here, and the display flag keeps one page from binding twice.
    // Two slug forms ride along deliberately: the address bar is the
    // PUBLIC slug (path check), cart entries key on the INTERNAL
    // slug (slug), which is what checkout and entitlements resolve.
    function initBuy() {
      if (window.location.pathname !== "/books/" + publicSlug) return;
      var display = document.getElementById("price-display");
      if (!display || display.__buyBound) return;
      display.__buyBound = true;
      var sel = document.getElementById("format");
      var note = document.getElementById("format-note");
      // The picker is a radio-card group now (2026-10-30), not a
      // <select>: the checked radio's value is the format, read the
      // same way everywhere the select's value used to be read.
      function currentFormat() {
        var checked = sel ? sel.querySelector("input[name='bbs-format']:checked") : null;
        return checked ? checked.value : "digital";
      }
      function syncNote() {
        if (note) note.hidden = currentFormat() !== "audio";
      }
      var btn = document.getElementById("buy");
      // The sticky mobile buy bar mirrors the price display and the
      // button state, and its button simply clicks the real one, so
      // every behavior (cart mirror, tracking, sheet) stays single-
      // sourced in the handlers below.
      var stickyPrice = document.getElementById("sticky-price");
      var stickyBuy = document.getElementById("sticky-buy");
      function syncSticky() {
        if (stickyPrice) stickyPrice.textContent = display.textContent;
        if (stickyBuy && btn) {
          stickyBuy.disabled = btn.disabled;
          stickyBuy.textContent = btn.textContent;
        }
      }
      if (stickyBuy && btn) stickyBuy.addEventListener("click", function () { btn.click(); });
      // The button mirrors the cart for the format on the picker:
      // a format already in the cart shows "In your cart" and is
      // disabled; switching the picker re-arms it for a format that
      // is not in the cart yet. (It once latched disabled after the
      // first add, so a second format could not be added at all.)
      function cartHas(format) {
        return window.bbsCart ? window.bbsCart.has(slug, format) : false;
      }
      function syncBtn() {
        if (!btn) return;
        var has = cartHas(currentFormat());
        btn.disabled = has;
        btn.textContent = has ? "In your cart" : "Add to cart";
        syncSticky();
      }
      if (sel) sel.addEventListener("change", function () {
        display.textContent = money(centsFor(currentFormat()));
        syncNote();
        syncBtn();
      });
      syncNote();
      syncBtn();
      syncSticky();
      // The mirror also follows cart changes made anywhere else:
      // remove this format in the slide-over sheet and the button
      // re-arms at once, no reload. (It used to latch "In your cart"
      // until the next page load.)
      document.addEventListener("bbs:cart-changed", function () {
        if (window.location.pathname === "/books/" + publicSlug) syncBtn();
      });
      if (btn) btn.addEventListener("click", function () {
        var format = currentFormat();
        // The store writes, repaints the badge, and announces the
        // change; add() reports whether the entry was new, which is
        // what the tracking event has always keyed on.
        var added = window.bbsCart && window.bbsCart.add(slug, format);
        if (added && window.bbsTrack) window.bbsTrack("AddToCart", {
          content_ids: [slug],
          content_type: "product",
          format: format,
          value: centsFor(format) / 100,
          currency: "USD",
        });
        if (window.openCartSheet) window.openCartSheet();
        syncBtn();
      });
    }
    initBuy();
    document.addEventListener("astro:page-load", initBuy);
  </script>}

  {!isLocalized && <script is:inline define:vars={{ publicSlug }}>
    // Review form submission. Same re-init pattern as the buy controls
    // (astro:page-load, path checked, per-form bound flag). The path
    // check uses the PUBLIC slug (the address bar); the form itself
    // posts the internal slug in its hidden field.
    function initReviewForm() {
      if (window.location.pathname !== "/books/" + publicSlug) return;
      var form = document.getElementById("review-form");
      if (!form || form.__reviewBound) return;
      form.__reviewBound = true;
      form.addEventListener("submit", function (e) {
        e.preventDefault();
        var msg = document.getElementById("review-msg");
        var btn = document.getElementById("review-submit");
        function show(text, ok) {
          msg.textContent = text;
          msg.classList.remove("hidden", "text-red-600", "text-green-700");
          msg.classList.add(ok ? "text-green-700" : "text-red-600");
        }
        btn.disabled = true;
        fetch("/api/reviews", { method: "POST", body: new FormData(form) })
          .then(function (r) {
            return r.json().catch(function () { return {}; }).then(function (d) { return { ok: r.ok, d: d }; });
          })
          .then(function (res) {
            if (res.ok && res.d && res.d.ok) {
              var ratingEl = document.getElementById("review-rating");
              if (window.bbsTraks) window.bbsTraks("review_submitted", { rating: String((ratingEl && ratingEl.value) || "") });
              form.reset();
              show("Thank you. Your review is in the queue and will appear here once it is approved.", true);
            } else {
              show((res.d && res.d.error) || "Something went wrong. Please try again.", false);
              btn.disabled = false;
            }
          })
          .catch(function () {
            show("Something went wrong. Please try again.", false);
            btn.disabled = false;
          });
      });
    }
    initReviewForm();
    document.addEventListener("astro:page-load", initReviewForm);
  </script>}

  {isLocalized && <script is:inline define:vars={{ publicSlug: reviewPath, thanksMsg: bs.reviewThanksMsg, errorMsg: bs.reviewErrorMsg }}>
