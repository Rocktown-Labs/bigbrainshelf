  {!isLocalized && hasSample && (
    <script is:inline define:vars={{ publicSlug, sampleLabels }}>
      // Free-sample viewer: 5 pages served by the capped /api/sample
      // route, then a buy panel as the final slide. Same re-init
      // pattern as the buy controls (astro:page-load, path checked,
      // per-element bound flag). The sample route is addressed by the
      // PUBLIC slug and resolves it server-side.
      function initSample() {
        if (window.location.pathname !== "/books/" + publicSlug) return;
        var root = document.getElementById("sample-root");
        if (!root || root.__sampleBound) return;
        root.__sampleBound = true;
        var img = document.getElementById("sample-img");
        var end = document.getElementById("sample-end");
        var count = document.getElementById("sample-count");
        var prev = document.getElementById("sample-prev");
        var next = document.getElementById("sample-next");
        var total = sampleLabels.length;
        var idx = 0; // 0..total-1 are pages; total is the buy panel

        function show(i) {
          idx = Math.max(0, Math.min(total, i));
          if (idx < total) {
            end.classList.add("hidden");
            end.classList.remove("flex");
            img.classList.remove("hidden");
            img.src = "/api/sample/" + publicSlug + "/" + (idx + 1);
            img.alt = "Sample page " + (idx + 1) + " (" + sampleLabels[idx] + ")";
            count.textContent = "Page " + (idx + 1) + " of " + total;
          } else {
            img.classList.add("hidden");
            end.classList.remove("hidden");
            end.classList.add("flex");
            count.textContent = "End of sample";
          }
          prev.disabled = idx === 0;
          next.disabled = idx === total;
        }
        function openSample() {
          show(0);
          root.classList.remove("hidden");
          document.body.style.overflow = "hidden";
        }
        function closeSample() {
          root.classList.add("hidden");
          document.body.style.overflow = "";
        }
        document.getElementById("sample-open").addEventListener("click", openSample);
        document.getElementById("sample-close").addEventListener("click", closeSample);
        prev.addEventListener("click", function () { show(idx - 1); });
        next.addEventListener("click", function () { show(idx + 1); });
        var buyBtn = document.getElementById("sample-buy");
        if (buyBtn) buyBtn.addEventListener("click", function () {
          closeSample();
          var b = document.getElementById("buy");
          if (b && !b.disabled) b.click();
        });
        document.addEventListener("keydown", function (e) {
          if (e.key === "Escape" && document.contains(root) && !root.classList.contains("hidden")) closeSample();
          if (e.key === "ArrowRight" && document.contains(root) && !root.classList.contains("hidden")) show(idx + 1);
          if (e.key === "ArrowLeft" && document.contains(root) && !root.classList.contains("hidden")) show(idx - 1);
        });
      }
      initSample();
      document.addEventListener("astro:page-load", initSample);
    </script>
  )}

  <script is:inline>
    // Keep the header account link in sync with the session. Runs now
    // and again on astro:page-load so it also applies to the header
    // swapped in by view transitions. The update is idempotent.
    function bbsAccountLink() {
      fetch("/api/auth/get-session").then(function (r) { return r.json(); }).then(function (s) {
        var link = document.getElementById("account-link");
        if (s && s.user && link) { link.textContent = "My library"; link.href = "/account"; }
      }).catch(function () {});
    }
    bbsAccountLink();
    document.addEventListener("astro:page-load", bbsAccountLink);
  </script>
{!isLocalized && <script is:inline define:vars={{ upgradeSlug: audioOnlyOwner ? String(slug) : "", upgradeDigitalCents }}>
  // This page's cart sheet prices this book's digital format at the
  // signed-in audiobook owner's upgrade price, matching the picker
  // and the server-side checkout credit. Other pages' sheets show
  // list prices; checkout always settles at the credited amount.
  window.__bbsUpgrade = upgradeSlug ? { slug: upgradeSlug, digitalCents: upgradeDigitalCents } : null;
</script>}
<!-- cart-sheet: slide-over cart, replaces the trip to /cart for shoppers -->
{!isLocalized && <CartSheet />}

</body>
</html>
