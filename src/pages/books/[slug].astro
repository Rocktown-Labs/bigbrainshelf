  <script is:inline define:vars={{ reviewPath }}>
    // Review form fold: with no approved reviews the card starts
    // hidden behind the Write a review toggle (see the reviews
    // section). One binding for every locale, guarded by this page's
    // own locale path like the form scripts above.
    function initReviewToggle() {
      if (window.location.pathname !== reviewPath) return;
      var toggle = document.getElementById("review-toggle");
      var card = document.getElementById("review-card");
      if (!toggle || !card || toggle.__toggleBound) return;
      toggle.__toggleBound = true;
      toggle.addEventListener("click", function () {
        card.classList.remove("hidden");
