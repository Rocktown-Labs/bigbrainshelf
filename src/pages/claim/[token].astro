---
import { env } from "cloudflare:workers";
import "../../styles/global.css";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import Tracking from "../../components/Tracking.astro";
import { getEffectiveSession } from "../../lib/auth";
import { getPhygitalClaim } from "../../lib/fulfillment-router";

export const prerender = false;

const token = String(Astro.params.token || "").trim().toLowerCase();
const db = (env as any).DB;
const session = await getEffectiveSession(Astro.request, Astro.locals, db);
const claim = token ? await getPhygitalClaim(db, token) : null;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Claim Your Shelf Unlock — Big Brain Shelf</title>
  <link rel="icon" href="/favicon.ico" />
  <Tracking />
</head>
<body class="min-h-screen flex flex-col bg-[#faf6ee] text-stone-900">
  <SiteHeader />

  <main class="flex-1 max-w-2xl mx-auto w-full px-4 py-12 sm:py-16">
    <div class="rounded-3xl border border-stone-200 bg-white p-6 sm:p-10 shadow-xs">
      <div class="inline-flex items-center gap-2 rounded-full bg-orange-50 border border-orange-200 px-3.5 py-1 text-xs font-extrabold uppercase tracking-wider text-orange-800">
        <span>✨ Phygital Book &amp; Plush Unlock</span>
      </div>

      {!claim ? (
        <div class="mt-5">
          <h1 class="text-2xl sm:text-3xl font-extrabold text-[#1a3454]">
            Unlock Code Not Found
          </h1>
          <p class="mt-2 text-sm text-stone-600 leading-relaxed">
            We couldn't find code <code class="font-mono bg-stone-100 px-2 py-0.5 rounded">{token || "none"}</code>. Check the QR/NFC tag inside your Printed Book, $25 Gift Set, or Character Plush hangtag and try again.
          </p>
          <a
            href="/account"
            class="mt-6 inline-flex items-center justify-center min-h-[44px] rounded-full bg-[#1a3454] text-white px-6 text-sm font-extrabold hover:bg-[#132741]"
          >
            Go to Family Hub →
          </a>
        </div>
      ) : (
        <div class="mt-5">
          <h1 class="text-2xl sm:text-3xl font-extrabold text-[#1a3454]">
            {claim.bonus_title}
          </h1>
          <p class="mt-2 text-sm text-stone-600 leading-relaxed">
            This QR/NFC tag unlocks the full digital edition, Read-Along Auto-Flip player, and audiobook for <strong class="text-stone-900">{claim.book_slug}</strong> in your family shelf.
          </p>

          <div class="mt-5 rounded-2xl bg-stone-50 border border-stone-200 p-4 text-xs text-stone-600 flex flex-wrap items-center justify-between gap-2">
            <span>Tag Code: <strong class="font-mono text-stone-900">{claim.token}</strong></span>
            <span class="uppercase font-extrabold text-orange-700">Edition: {claim.sku_type}</span>
          </div>

          {!session?.user ? (
            <div class="mt-6">
              <p class="text-sm text-stone-700 font-semibold">
                Sign in or create your free family account to add this unlock to your shelf:
              </p>
              <div class="mt-4 flex flex-wrap gap-3">
                <a
                  href={`/login?next=${encodeURIComponent(`/claim/${claim.token}`)}`}
                  class="inline-flex items-center justify-center min-h-[44px] rounded-full bg-orange-600 text-white px-6 text-sm font-extrabold hover:bg-orange-700"
                >
                  Sign In to Claim
                </a>
                <a
                  href={`/signup?next=${encodeURIComponent(`/claim/${claim.token}`)}`}
                  class="inline-flex items-center justify-center min-h-[44px] rounded-full border border-stone-300 bg-white text-stone-800 px-6 text-sm font-extrabold hover:border-stone-500"
                >
                  Create Family Account
                </a>
              </div>
            </div>
          ) : (
            <div class="mt-6">
              <button
                type="button"
                id="redeem-claim-btn"
                data-claim-token={claim.token}
                class="inline-flex items-center justify-center min-h-[48px] rounded-full bg-orange-600 text-white px-7 text-sm font-extrabold hover:bg-orange-700 active:scale-[0.98] transition"
              >
                🎁 Unlock in My Family Shelf ({session.user.email})
              </button>
              <p id="redeem-claim-msg" class="mt-3 text-sm font-bold text-stone-600"></p>
            </div>
          )}
        </div>
      )}
    </div>
  </main>

  <SiteFooter />

  <script is:inline>
    (function () {
      var btn = document.getElementById("redeem-claim-btn");
      var msg = document.getElementById("redeem-claim-msg");
      if (!btn) return;
      btn.addEventListener("click", async function () {
        var token = btn.getAttribute("data-claim-token");
        btn.disabled = true;
        if (msg) msg.textContent = "Unlocking your digital bundle & Read-Along story...";
        try {
          var r = await fetch("/api/claim", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ action: "redeem", token: token }),
          });
          var d = await r.json().catch(function () { return {}; });
          if (r.ok && d.ok) {
            if (msg) {
              msg.textContent = "🎉 Unlocked! Taking you to your Family Hub...";
              msg.className = "mt-3 text-sm font-bold text-green-700";
            }
            setTimeout(function () {
              window.location.href = "/account#qc-viewer";
            }, 900);
          } else {
            btn.disabled = false;
            if (msg) {
              msg.textContent = d.error || "Could not redeem this code.";
              msg.className = "mt-3 text-sm font-bold text-red-600";
            }
          }
        } catch {
          btn.disabled = false;
          if (msg) msg.textContent = "Network error redeeming code.";
        }
      });
    })();
  </script>
</body>
</html>
