---
import { env } from "cloudflare:workers";
import "../../styles/global.css";
import SiteHeader from "../../components/SiteHeader.astro";
import SectionNav from "../../components/SectionNav.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import CartSheet from "../../components/CartSheet.astro";
import Tracking from "../../components/Tracking.astro";
import { getEffectiveSession } from "../../lib/auth";
import { getPhygitalClaim } from "../../lib/fulfillment-router";

export const prerender = false;

const { token = "" } = Astro.params;
const e = env as any;
const session = await getEffectiveSession(Astro.request, Astro.locals, e.DB);
const claim = await getPhygitalClaim(e.DB, token);
const bookTitle =
  claim?.bookSlug === "fern-counts-the-forest"
    ? "Fern Counts the Forest"
    : claim?.bookSlug || "Fern Counts the Forest";
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>Unlock Your Gift Set Companion · Big Brain Shelf</title>
  <Tracking />
</head>
<body class="bg-white text-stone-900 antialiased">
  <SiteHeader search cartMode="sheet" />
  <SectionNav />
  <main class="max-w-2xl mx-auto px-4 py-14">
    <div class="rounded-3xl border border-amber-200 bg-amber-50/70 p-6 sm:p-10 shadow-sm">
      <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-900 text-amber-100 px-3 py-1 text-xs font-extrabold uppercase tracking-wider">
        Phygital Story Unlock
      </span>
      <h1 class="mt-3 text-2xl sm:text-3xl font-extrabold text-stone-900 font-serif">
        {claim ? claim.bonusTitle : "Whispering Woods Digital & Audio Companion"}
      </h1>
      <p class="mt-2 text-sm text-stone-700 leading-relaxed">
        Every physical Printed Book ($20), Complete Gift Set ($25), Quarterly Book Club Box ($60/qtr), and Fern Plushie includes instant access to the narrated audiobook, Read-Along auto-flip story mode, and printable coloring pages inside your Family Hub.
      </p>

      <div class="mt-6 rounded-2xl border border-stone-200 bg-white p-5">
        <div class="flex items-center justify-between text-xs text-stone-500">
          <span>Claim Token</span>
          <code class="font-mono font-bold text-stone-900 bg-stone-100 px-2 py-0.5 rounded">{token.toUpperCase()}</code>
        </div>
        <div class="mt-2 flex items-center justify-between text-xs text-stone-500">
          <span>Book Volume</span>
          <span class="font-bold text-stone-800">{bookTitle}</span>
        </div>

        <form id="phygital-claim-form" class="mt-5 space-y-3">
          <input type="hidden" name="token" value={token} />
          <div>
            <label for="claim-email" class="block text-xs font-extrabold uppercase tracking-wider text-stone-700">
              Parent Account Email
            </label>
            <input
              id="claim-email"
              name="email"
              type="email"
              required
              value={session?.user?.email || ""}
              placeholder="parent@example.com"
              class="mt-1 w-full rounded-xl border border-stone-300 px-3.5 py-2.5 text-sm text-stone-900"
            />
          </div>
          <button
            type="submit"
            class="w-full rounded-xl bg-emerald-900 hover:bg-emerald-800 text-white font-extrabold py-3 px-4 text-sm transition cursor-pointer"
          >
            Unlock Digital Bundle &amp; Bonus Audio in My Library →
          </button>
          <p id="phygital-claim-status" class="text-xs font-semibold text-center text-stone-600 hidden"></p>
        </form>
      </div>
    </div>
  </main>
  <CartSheet />
  <SiteFooter />

  <script is:inline>
    (function () {
      var form = document.getElementById("phygital-claim-form");
      var statusEl = document.getElementById("phygital-claim-status");
      if (!form) return;
      form.addEventListener("submit", function (ev) {
        ev.preventDefault();
        var fd = new FormData(form);
        var token = String(fd.get("token") || "");
        var email = String(fd.get("email") || "");
        if (statusEl) {
          statusEl.classList.remove("hidden");
          statusEl.textContent = "Unlocking your Whispering Woods companion...";
        }
        fetch("/api/claim", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ token: token, email: email }),
        })
          .then(function (r) { return r.json(); })
          .then(function (data) {
            if (data && data.ok) {
              try {
                if (typeof window.bbsTraks === "function") {
                  window.bbsTraks("phygital_claim_redeemed", { sku: (data.claim && data.claim.skuType) || "gift_set" });
                }
              } catch (e) {}
              if (statusEl) {
                statusEl.textContent = "Unlocked! Redirecting to your Family Hub...";
              }
              window.location.href = "/account#shelf";
            } else if (statusEl) {
              statusEl.textContent = (data && data.error) || "Could not verify that claim code.";
            }
          })
          .catch(function () {
            if (statusEl) statusEl.textContent = "Network error while unlocking claim.";
          });
      });
    })();
  </script>
</body>
</html>
