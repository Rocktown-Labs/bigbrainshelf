---
import "../styles/global.css";
import { env } from "cloudflare:workers";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SectionNav from "../components/SectionNav.astro";
import BackLink from "../components/BackLink.astro";
import CartSheet from "../components/CartSheet.astro";
import Tracking from "../components/Tracking.astro";
import { ClientRouter } from "astro:transitions";
import TransitionHooks from "../components/TransitionHooks.astro";
import SeoHead from "../components/SeoHead.astro";
export const prerender = false;
const turnstileSiteKey = String((env as any)?.TURNSTILE_SITE_KEY || "").trim();
---

<html lang="en">
<head>
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#1a3454" />
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>Contact - Big Brain Shelf</title>
  <SeoHead title="Contact - Big Brain Shelf" socialDescription="Questions about a book or an order? Write to Big Brain Shelf." />
  <meta name="description" content="Questions about a book or an order? Write to Big Brain Shelf." />
  <ClientRouter />
  <TransitionHooks />
  <Tracking />
</head>
<body class="bg-white text-stone-900 antialiased">
  <SiteHeader search cartMode="sheet" />
  <SectionNav />
  <CartSheet />
  <main class="max-w-2xl mx-auto px-5 py-12 pb-20">
    <BackLink />
    <h1 class="text-3xl font-extrabold tracking-tight mb-2">Contact us</h1>
    <p class="text-stone-600 leading-relaxed mb-8">Questions about a book, an order, or a club box? Send us a note here, or email <a href="mailto:support@bigbrainshelf.com" class="text-orange-700 hover:text-orange-800">support@bigbrainshelf.com</a>. We read everything and reply from that address.</p>

    <form id="contact-form" class="space-y-4" novalidate>
      <div>
        <label for="cf-name" class="block text-sm font-semibold mb-1">Your name</label>
        <input id="cf-name" name="name" type="text" autocomplete="name" class="w-full rounded-lg border border-stone-300 px-3 py-2.5 text-[15px]" placeholder="Jane Reader" />
      </div>
      <div>
        <label for="cf-email" class="block text-sm font-semibold mb-1">Your email</label>
        <input id="cf-email" name="email" type="email" autocomplete="email" required class="w-full rounded-lg border border-stone-300 px-3 py-2.5 text-[15px]" placeholder="you@example.com" />
      </div>
      <div>
        <label for="cf-message" class="block text-sm font-semibold mb-1">Message</label>
        <textarea id="cf-message" name="message" rows="6" required class="w-full rounded-lg border border-stone-300 px-3 py-2.5 text-[15px]" placeholder="How can we help?"></textarea>
      </div>
      {turnstileSiteKey && <div class="cf-turnstile" data-sitekey={turnstileSiteKey}></div>}
      <button id="cf-submit" type="submit" class="rounded-lg bg-orange-600 text-white font-semibold px-6 py-3 min-h-[48px]">Send message</button>
      <p id="cf-status" class="text-sm font-medium" role="status"></p>
    </form>
  </main>
  <SiteFooter />
  {turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
  <script is:inline>
    (function () {
      var form = document.getElementById("contact-form");
      var status = document.getElementById("cf-status");
      var btn = document.getElementById("cf-submit");
      form.addEventListener("submit", function (ev) {
        ev.preventDefault();
        status.textContent = "";
        btn.disabled = true;
        btn.textContent = "Sending...";
        var tokenEl = form.querySelector('[name="cf-turnstile-response"]');
        fetch("/api/contact", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            name: document.getElementById("cf-name").value,
            email: document.getElementById("cf-email").value,
            message: document.getElementById("cf-message").value,
            turnstile_token: tokenEl ? tokenEl.value : undefined
          })
        }).then(function (r) {
          return r.json().catch(function () { return {}; }).then(function (j) {
            if (!r.ok) throw new Error(j.error || "Something went wrong. Please try again.");
            return j;
          });
        }).then(function () {
          form.reset();
          status.style.color = "#15803d";
          status.textContent = "Thank you. Your message is on its way, and we will reply to your email.";
          btn.textContent = "Send message";
          btn.disabled = false;
        }).catch(function (e) {
          status.style.color = "#b91c1c";
          status.textContent = e.message || "Something went wrong. Please try again.";
          btn.textContent = "Send message";
          btn.disabled = false;
        });
      });
    })();
  </script>
</body>
</html>
