---
import "../../styles/global.css";
import { ClientRouter } from "astro:transitions";
import { env } from "cloudflare:workers";
import { getAuth } from "../../lib/auth";
import Tracking from "../../components/Tracking.astro";
import { inspectAudiobook, formatClock } from "../../lib/audiobooks";
import { getDigitalEntitlements, loadReaderBook } from "../../lib/library";
import CustomerShell from "../../components/CustomerShell.astro";
import { getParentOnboarding, listKidProfiles, computeOnboardingChecklist } from "../../lib/family";
import { resolveBookForPublicRoute, publicSlugFor } from "../../lib/public-slugs";

export const prerender = false;

// The customer reader: read (scroll or flip) and listen (streaming
// audiobook) in the browser, for books the signed-in account owns
// digitally. Entitlements come from lib/library.ts (completed orders
// plus shipped Book Club boxes). The layout and player behavior are
// the admin Story Review's, minus the QC furniture: no notes, no
// factory labels, viewer page numbers only.
//
// The address bar carries the book's PUBLIC slug (lib/public-slugs);
// an old internal-slug link 301s to the public URL before anything
// else. Everything past resolution keys on the internal slug:
// entitlements, page data, and the library audio/page routes.
const e = env as any;
const param = String(Astro.params.slug || "");
const resolved = await resolveBookForPublicRoute(e.DB, param).catch(() => null);
if (resolved && resolved.via === "internal") {
  return Astro.redirect(`/read/${publicSlugFor(resolved.book)}${Astro.url.search}`, 301);
}
const slug = resolved ? String(resolved.book.slug) : param;
const publicSlug = resolved ? publicSlugFor(resolved.book) : param;
const auth = getAuth();
const session = await auth.api.getSession({ headers: Astro.request.headers });
if (!session) {
  return Astro.redirect("/login?next=" + encodeURIComponent(`/read/${publicSlug}`));
}

const book = resolved ? (resolved.book as any) : ((await e.DB.prepare(
  "SELECT slug, title, topic, cover_key, picture_book_key, coloring_book_key, epub_key, color_book_key, audiobook_key FROM books WHERE slug = ?"
).bind(slug).first()) as any);
if (!book) {
  return Astro.redirect("/");
}
const user = { id: session.user.id, email: String(session.user.email || "") };
// Sidebar frame (same mechanics as /admin, CG 2026-11-01): the reader
// sits inside the account shell. Light context only: switcher + nav.
const shellParent = await getParentOnboarding(e.DB, user.id).catch(() => null);
const shellKids = await listKidProfiles(e.DB, user.id).catch(() => []);
const shellChecklist = computeOnboardingChecklist(shellParent as any, shellKids as any, []);
const entitlements = await getDigitalEntitlements(e.DB, user);
const entitlement = entitlements.get(slug);
if (!entitlement) {
  return Astro.redirect(`/books/${publicSlug}`);
}
// An audiobook-only owner gets this page as a listening room: the
// player and the audiobook download, with no page images, no reading
// views, and no book files anywhere on it. A member who reaches the
// book through a club membership layer gets the same room minus the
// download: membership is read and listen only (the lock model), and
// the download controls below render only for owned books.
const audioOnly = !entitlement.digital && entitlement.audio;

const R2 = "https://media.bigbrainshelf.com/";
let info = null;
if (book.audiobook_key) {
  info = await inspectAudiobook(e, book, `/api/library/audio/${slug}`);
}
const playerData = info
  ? { slug: book.slug, title: book.title, cover: book.cover_key ? R2 + book.cover_key : "", full: info.full, chapters: info.chapters, tracks: info.tracks }
  : null;
const audioChapterCount = info ? info.chapters.length : 0;
const totalSecs = info ? info.tracks.reduce((s: number, c: any) => s + (c.duration || 0), 0) : 0;

const reader = audioOnly
  ? { chapters: [], totalPages: 0, colorCount: 0, hasColor: false, error: null }
  : await loadReaderBook(e.BOOKS, slug);
const chapters = reader.chapters;
const listenMode = audioOnly || Astro.url.searchParams.get("listen") === "1";
// The player card's chapter chips jump the AUDIO, so in listen mode
// they come from the audiobook's own chapter list. They used to map
// the reader's chapters, which are empty for an audio-only owner,
// leaving only the Introduction and The End chips on a book with
// real chapters (CG, 2026-11-05).
const chipChapters = listenMode && info
  ? info.chapters.map((t: any) => ({ num: t.chapter as number, title: t.label as string }))
  : chapters.map((ch: any) => ({ num: ch.num, title: ch.title }));
// Analytics: opening a book that actually has pages is a read start
// (the activation signal). A listen-only entry never fires it; its
// first play fires listen_start in the player script instead.
const readTraksEvent = !audioOnly && reader.totalPages > 0 ? { name: "read_start", props: {} } : null;

const downloads: { label: string; format: string; primary?: boolean }[] = [];
if (entitlement.owned) {
  if (!audioOnly && book.picture_book_key) downloads.push({ label: "Picture book", format: "picture", primary: true });
  if (!audioOnly && book.coloring_book_key) downloads.push({ label: "Coloring book", format: "coloring" });
  if (!audioOnly && book.epub_key) downloads.push({ label: "EPUB", format: "epub" });
  if (!audioOnly && book.color_book_key) downloads.push({ label: "Color edition", format: "color" });
  if (book.audiobook_key) downloads.push({ label: "Audiobook file", format: "audiobook", primary: audioOnly });
}
---
<!doctype html>
<html lang="en">
<head>
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#ffffff" />
  <ClientRouter />
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content" />
  <title>{book.title} · Read · Big Brain Shelf</title>
  <Tracking traksEvent={readTraksEvent} />
  <style>
    .reader { max-width: 1080px; padding-inline: max(16px, env(safe-area-inset-left, 0px)) max(16px, env(safe-area-inset-right, 0px)); }
    .rd-back { display: inline-flex; align-items: center; min-height: 40px; font-size: 12px; font-weight: 650; color: #9a3412; }
    .rd-chrome { position: sticky; top: var(--reader-shell-top, 64px); z-index: 32; background: #faf8f4; border: 1px solid #e7e0d7; border-radius: 14px; box-shadow: 0 3px 14px #1c191706; }
    .rd-player { display: flex; align-items: center; gap: 12px; padding: 10px 12px 6px; }
    .rd-identity { display: flex; align-items: center; gap: 10px; min-width: 0; flex: 1; }
    .rd-cover { width: 32px; height: 44px; object-fit: contain; border-radius: 3px; flex: none; }
    .rd-book { flex: 1; }
    .rd-book h1 { margin: 0; font-size: 14px; font-weight: 750; line-height: 1.35; white-space: nowrap; text-overflow: ellipsis; overflow: hidden; }
    .rd-track-line { display: flex; gap: 8px; align-items: center; font-size: 11px; color: #78716c; line-height: 1.4; }
    #now-playing { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; min-width: 0; }
    .rd-time { margin-left: auto; flex: none; font-variant-numeric: tabular-nums; }
    #seek { display: block; width: 100%; height: 16px; accent-color: #ea580c; cursor: pointer; }
    .rd-transport, .rd-tools { display: flex; gap: 2px; align-items: center; flex: none; }
    .rd-icon, .rd-control { display: inline-flex; align-items: center; justify-content: center; gap: 6px; min-width: 40px; min-height: 40px; border-radius: 9px; background: transparent; color: #344358; font-size: 13px; font-weight: 650; cursor: pointer; flex: none; touch-action: manipulation; user-select: none; -webkit-user-select: none; -webkit-touch-callout: none; }
    .rd-control { padding-inline: 10px; }
    .rd-play { background: #ea580c; color: white; border-radius: 50%; }
    .rd-icon:disabled { opacity: .3; cursor: default; }
    .reader button:active:not(:disabled), .reader summary:active { background-color: #eee8de; }
    .reader .rd-play:active { background-color: #c2410c; }
    .reader :is(button, summary, select, input):focus-visible { outline: 2px solid #c2410c; outline-offset: 3px; }
    .rd-toolbar { display: flex; align-items: center; gap: 6px; padding: 0 8px 5px; }
    .rd-pagination { display: flex; flex: 1; align-items: center; justify-content: center; gap: 8px; min-width: 0; }
    .rd-position { font-size: 12px; font-weight: 600; color: #78716c; white-space: nowrap; font-variant-numeric: tabular-nums; text-align: center; }
    .rd-tools { margin-left: auto; }
    .rd-status { padding-inline: 12px; color: #b91c1c; font-size: 12px; }
    .rd-status:empty { display: none; }
    .rd-menu { position: static; }
    .rd-menu summary, .rd-downloads summary { list-style: none; }
    .rd-menu summary::-webkit-details-marker, .rd-downloads summary::-webkit-details-marker { display: none; }
    .rd-menu[open] > summary { background: #eee8de; }
    .rd-panel { position: absolute; top: calc(100% + 8px); z-index: 40; width: min(330px, calc(100vw - 48px)); max-height: min(65dvh, 460px); overflow-y: auto; overscroll-behavior: contain; padding: 10px; border: 1px solid #e7e0d7; border-radius: 12px; background: white; box-shadow: 0 12px 36px #1c19171a; }
    .rd-chapters { left: 8px; }
    .rd-chapters .rd-chapter-chip { display: block; width: 100%; min-height: 44px; text-align: left; border: 0; border-radius: 7px; padding: 8px 10px; font-size: 12px; font-weight: 650; cursor: pointer; }
    .rd-chapter-chip span { display: block; font-size: 13px; font-weight: 450; opacity: .8; margin-top: 1px; }
    .rd-options { right: 8px; }
    .rd-option { display: flex; align-items: center; justify-content: space-between; gap: 10px; min-height: 52px; font-size: 13px; }
    .rd-segment { display: inline-flex; gap: 2px; border-radius: 8px; background: #f5f5f4; padding: 3px; }
    .rd-segment button { min-height: 38px; border-radius: 6px; padding: 6px 10px; font-size: 12px; font-weight: 600; cursor: pointer; }
    .rd-option select { border: 1px solid #d6d3d1; border-radius: 7px; padding: 6px; min-height: 40px; }
    .rd-sleep { display: block; text-align: right; font-size: 11px; color: #9a3412; }
    .rd-book-info { margin: 10px 0 0; padding-top: 10px; border-top: 1px solid #e7e5e4; color: #78716c; font-size: 11px; line-height: 1.5; }
    .rd-anchor, #page-column { scroll-margin-top: calc(var(--reader-shell-top, 64px) + var(--reader-chrome-height, 120px) + 16px); }
    #page-column.flip { padding-top: 16px; }
    #page-column.flip > section { margin: 0; }
    #page-column.flip .rd-page { margin: 0 auto; max-width: 100%; background: transparent; border: 0; overflow: visible; }
    #page-column.flip .rd-page-header { display: none; }
    #page-column.flip .rd-art { padding: 0; align-self: start; }
    #page-column.flip .rd-img { display: block; width: auto; max-width: 100%; height: auto; max-height: max(160px, calc(100dvh - var(--reader-stage-top, 240px) - var(--reader-bottom, 24px))); object-fit: contain; margin: 0 auto; border-color: #e7e0d7; border-radius: 7px; }
    #page-column.flip .rd-img.hidden { display: none; }
    #page-column.flip .rd-story { max-width: 660px; margin: 0 auto; padding: 16px 4px; font-size: 15px; line-height: 1.65; }
    .rd-downloads { margin: 30px 0 0; border-top: 1px solid #e7e0d7; padding: 12px 0; }
    .rd-downloads summary { display: flex; align-items: center; gap: 8px; min-height: 44px; font-size: 12px; font-weight: 650; color: #78716c; cursor: pointer; }
    .reader.is-expanded, .reader:fullscreen { position: fixed; inset: 0; z-index: 100; max-width: none; width: 100%; height: 100dvh; overflow-y: auto; overscroll-behavior: contain; background: #faf8f4; padding: max(10px, env(safe-area-inset-top, 0px)) max(16px, env(safe-area-inset-right, 0px)) max(12px, env(safe-area-inset-bottom, 0px)) max(16px, env(safe-area-inset-left, 0px)); }
    .reader.is-expanded .rd-back, .reader:fullscreen .rd-back { display: none; }
    .reader.is-expanded .rd-chrome, .reader:fullscreen .rd-chrome { top: 0; }
    @media (min-width: 1100px), (min-width: 640px) and (max-height: 600px) {
      #page-column.flip .rd-page { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(220px, 1fr); gap: 28px; align-items: center; }
      #page-column.flip .rd-page[style*="display: none"] { display: none; }
      #page-column.flip .rd-img { max-height: max(160px, calc(100dvh - var(--reader-stage-top, 240px) - var(--reader-bottom, 24px))); }
      #page-column.flip .rd-story { padding: 20px 20px 20px 0; font-size: 17px; line-height: 1.85; }
    }
    @media (max-width: 640px) {
      .reader { padding-inline: max(12px, env(safe-area-inset-left, 0px)) max(12px, env(safe-area-inset-right, 0px)); }
      .rd-back { min-height: 32px; }
      .rd-player { gap: 4px; padding: 8px 8px 2px; }
      .rd-identity { gap: 8px; }
      .rd-cover { width: 25px; height: 36px; }
      .rd-book h1 { font-size: 12px; }
      .rd-time { font-size: 10px; }
      .rd-track-line { font-size: 10px; }
      .rd-toolbar { gap: 2px; padding: 0 4px 3px; }
      .rd-pagination { gap: 0; }
      .rd-control { padding-inline: 6px; font-size: 12px; }
      .rd-icon, .rd-control { min-width: 44px; min-height: 44px; }
      .rd-transport .rd-icon:not(.rd-play) { display: none; } /* Chapter navigation remains in Chapters. */
      .rd-segment button { min-height: 44px; }
    }
    @media (pointer: coarse) {
      .rd-option select { font-size: 16px; min-height: 44px; }
      .rd-icon, .rd-control, .rd-segment button { min-height: 44px; min-width: 44px; }
    }
    @media (hover: hover) and (pointer: fine) {
      .rd-icon:hover:not(:disabled), .rd-control:hover { background: #eee8de; }
      .rd-play:hover { background: #c2410c; }
      .rd-chapter-chip:hover { background: #fff7ed; color: #9a3412; }
    }
    @keyframes rd-pulse { 0%, 100% { box-shadow: 0 0 0 0 rgba(234, 88, 12, 0.55); } 50% { box-shadow: 0 0 0 10px rgba(234, 88, 12, 0); } }
    .rd-pulse { animation: rd-pulse 1.1s ease-in-out 3; }
  </style>
</head>
<body class="bg-stone-50 text-stone-900 antialiased">
  <CustomerShell
    currentSection="library"
    userEmail={user.email}
    username={(session.user as any).displayUsername || (session.user as any).username}
    displayName={shellParent?.parent_name || session.user.name}
    isAdmin={(session.user as any).role === "admin"}
    kidProfiles={shellKids}
    hasParentPin={Boolean(shellParent?.parent_pin)}
    bookCount={entitlements.size}
    onboardingComplete={shellChecklist.isComplete}
  />

  <main id="reader" class="reader mx-auto pb-16">
    <a href="/account/library" class="rd-back">← My Library</a>
    <div id="reader-chrome" class="rd-chrome">
      <div id="player-card" class="rd-player">
        <div class="rd-identity">
          {book.cover_key && <img src={R2 + book.cover_key} alt="" class="rd-cover" width="32" height="44" />}
          <div class="rd-book min-w-0">
            <h1 title={book.title}>{book.title}</h1>
            <div class="rd-track-line">
              <span id="now-playing">{playerData ? (listenMode ? "Ready when you are" : "Listen along") : "Read at your own pace"}</span>
              {playerData && <span class="rd-time"><span id="time-elapsed">0:00</span> / <span id="time-total">0:00</span></span>}
            </div>
            {playerData && <input id="seek" type="range" min="0" max="1000" value="0" step="1" aria-label="Seek" />}
          </div>
        </div>
        {playerData && (
          <div class="rd-transport" role="group" aria-label="Audio playback">
            <button id="prev-btn" class="rd-icon" aria-label="Previous chapter">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6 5h2.5v14H6zM19 5v14L9.5 12z"/></svg>
            </button>
            <button id="play-btn" class="rd-icon rd-play" aria-label="Play or pause">
              <svg id="icon-play" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
              <svg id="icon-pause" class="hidden" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.5 5h4v14h-4zM13.5 5h4v14h-4z"/></svg>
            </button>
            <button id="next-btn" class="rd-icon" aria-label="Next chapter">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M15.5 5H18v14h-2.5zM5 5v14l9.5-7z"/></svg>
            </button>
          </div>
        )}
      </div>
      {playerData && <p id="player-status" class="rd-status" role="status"></p>}
      <div class="rd-toolbar">
        <details class="rd-menu" id="chapter-menu">
          <summary class="rd-control"><span id="reader-chapter-label">Chapters</span> <span aria-hidden="true">⌄</span></summary>
          <div class="rd-panel rd-chapters" role="group" aria-label="Jump to chapter">
            {info?.intro && <button class="rd-chapter-chip" data-edge="intro">{info.intro.label}</button>}
            {chipChapters.map((ch) => (
              <button class="rd-chapter-chip" data-chapter={ch.num} title={ch.title}>Chapter {ch.num}<span>{ch.title}</span></button>
            ))}
            {info?.outro && <button class="rd-chapter-chip" data-edge="outro">{info.outro.label}</button>}
            {!chipChapters.length && <p>No chapters available yet.</p>}
          </div>
        </details>
        {!audioOnly && (
          <div id="flip-bar" class="rd-pagination" role="group" aria-label="Page navigation">
            <button id="flip-prev" class="rd-icon" aria-label="Previous page">←</button>
            <span id="flip-pos" class="rd-position" aria-live="polite"></span>
            <button id="flip-next" class="rd-icon" aria-label="Next page">→</button>
          </div>
        )}
        <div class="rd-tools">
          <details class="rd-menu" id="reader-options">
            <summary class="rd-icon" aria-label="Reader options" title="Reader options">
              <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 17h16"/><circle cx="8" cy="7" r="3" fill="white"/><circle cx="16" cy="17" r="3" fill="white"/></svg>
            </summary>
            <div class="rd-panel rd-options">
              {!audioOnly && <>
                <div class="rd-option"><span>Reading view</span><span class="rd-segment" role="group" aria-label="Reading view"><button id="view-scroll">Scroll</button><button id="view-flip">Flip pages</button></span></div>
                {reader.hasColor && <div class="rd-option"><span>Artwork</span><span class="rd-segment" role="group" aria-label="Artwork"><button id="art-line">Line</button><button id="art-color">Color</button></span></div>}
              </>}
              {playerData && <>
                <label class="rd-option" for="speed">Speed<select id="speed"><option value="0.75">0.75x</option><option value="1" selected>1x</option><option value="1.25">1.25x</option><option value="1.5">1.5x</option><option value="2">2x</option></select></label>
                <label class="rd-option" for="sleep-timer">Sleep timer<select id="sleep-timer"><option value="0">Off</option><option value="15">15 min</option><option value="30">30 min</option><option value="45">45 min</option><option value="60" selected>60 min</option><option value="-1">End of chapter</option></select></label>
                <span id="sleep-countdown" class="rd-sleep">⏱ 60:00</span>
                {playerData.full && <div class="rd-option"><span>Listen to</span><span class="rd-segment" role="group" aria-label="Listening mode"><button id="mode-chapters">Chapters</button><button id="mode-full">Full book</button></span></div>}
              </>}
              <p class="rd-book-info">{reader.totalPages > 0 && <>{reader.totalPages} pages · {chapters.length} chapters</>}{totalSecs > 0 && <>{reader.totalPages > 0 ? " · " : ""}{formatClock(totalSecs)} of listening</>}</p>
            </div>
          </details>
          <button id="reader-expand" class="rd-icon" aria-label="Expand reader" aria-pressed="false" title="Expand reader">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M8 3H3v5M16 3h5v5M3 16v5h5M21 16v5h-5"/></svg>
          </button>
        </div>
      </div>
    </div>

    {/* Pages (never rendered for audiobook-only owners) */}
    {reader.error && (
      <p class="mt-8 text-sm text-stone-500">{reader.error}</p>
    )}
    {!audioOnly && (
    <div id="page-column">
      {chapters.map((ch) => (
        <section class="mt-8">
          <h2 id={`ch-${ch.num}`} class="rd-anchor text-lg font-bold tracking-tight">
            Chapter {ch.num}: {ch.title}
            {ch.num <= audioChapterCount && (
              <button class="rd-play-chapter ml-2 align-middle rounded-full bg-orange-600 text-white text-xs font-semibold px-3 py-1 hover:bg-orange-700" data-chapter={ch.num}>▶ Play</button>
            )}
          </h2>
          {ch.pages.map((p) => (
            <article
              class="rd-page mt-6 rounded-lg bg-white border border-stone-200 overflow-hidden"
              data-chapter={ch.num}
              data-chapter-title={ch.title}
              data-viewer={p.viewer}
              data-line-url={p.lineUrl}
              data-color-url={p.colorUrl || ""}
            >
              <header class="rd-page-header flex items-center gap-2 px-4 pt-3">
                <span class="text-sm font-semibold">Page {p.viewer}</span>
                <span class="ml-auto text-xs text-stone-400">Chapter {ch.num}</span>
              </header>
              <div class="rd-art px-4 pt-2">
                {p.lineUrl ? (
                  <img
                    class="rd-img w-full rounded border border-stone-200 bg-white"
                    src={p.lineUrl}
                    alt={`Chapter ${ch.num}, page ${p.viewer}`}
                    loading="lazy"
                  />
                ) : (
                  <div class="rounded border border-dashed border-stone-300 bg-stone-50 px-4 py-10 text-center text-sm text-stone-400">No image for this page yet.</div>
                )}
                <div class="rd-nocolor hidden rounded border border-dashed border-stone-300 bg-stone-50 px-4 py-10 text-center text-sm text-stone-400">This page has no color version yet.</div>
              </div>
              {p.text && (
                <p class="rd-story px-4 py-4 text-[15px] leading-relaxed whitespace-pre-wrap">{p.text}</p>
              )}
            </article>
          ))}
        </section>
      ))}
    </div>
    )}

    {downloads.length > 0 && (
      <details class="rd-downloads">
        <summary>Downloads <span aria-hidden="true">⌄</span></summary>
        <p class="text-sm text-stone-500 mt-1">{audioOnly ? "The audiobook file is yours to keep, for listening anywhere." : "The files are yours to keep, for offline reading and printing."}</p>
        <div class="mt-3 flex flex-wrap gap-2">
          {downloads.map((d) => (
            <a data-astro-reload href={`/api/download?slug=${slug}&format=${d.format}`} class={d.primary
              ? "text-xs font-semibold rounded-md bg-stone-900 text-white px-3 py-1.5 hover:bg-stone-700"
              : "text-xs font-semibold rounded-md border border-stone-300 px-3 py-1.5 hover:border-stone-500"}>{d.label}</a>
          ))}
        </div>
        <p class="text-xs text-stone-400 mt-3">For your family's personal use.</p>
      </details>
    )}
  </main>

  <script is:inline define:vars={{ playerData, audioChapterCount, listenMode, hasColor: reader.hasColor, bookSlug: book.slug }}>
    // Defaults (DESIGN.md + CG 2026-11-01): the reader opens like
    // the admin QC stage, one page at a time, in the full-color
    // edition when the book has one. Scroll and Line stay one tap away.
    var artMode = hasColor ? "color" : "line"; // "line" | "color"
    var viewMode = "flip"; // "scroll" | "flip"

    var pageEls = Array.prototype.slice.call(document.querySelectorAll(".rd-page"));
    var chapterStarts = {}; // chapter num -> first flat page index
    var chapterTitles = {};
    pageEls.forEach(function (el, i) {
      var num = Number(el.getAttribute("data-chapter"));
      if (chapterStarts[num] === undefined) {
        chapterStarts[num] = i;
        chapterTitles[num] = el.getAttribute("data-chapter-title") || "";
      }
    });
    var flipIndex = 0;

    // Fit the art to the actual chrome, not a fixed percentage of vh.
    // CSS owns dynamic viewport/safe-area sizing; JS measures only our content.
    var readerRoot = document.getElementById("reader");
    var readerChrome = document.getElementById("reader-chrome");
    var expandBtn = document.getElementById("reader-expand");
    var readerFitFrame = 0;
    function fitReader() {
      if (!document.contains(readerRoot)) return;
      var expanded = readerRoot.classList.contains("is-expanded") || document.fullscreenElement === readerRoot;
      var header = document.querySelector("body > header");
      var shellTop = expanded ? 0 : (header ? header.getBoundingClientRect().height : 64);
      readerRoot.style.setProperty("--reader-shell-top", Math.ceil(shellTop) + "px");
      readerRoot.style.setProperty("--reader-chrome-height", Math.ceil(readerChrome.getBoundingClientRect().height) + "px");
      var col = document.getElementById("page-column");
      var stageTop = Math.max(readerChrome.getBoundingClientRect().bottom + 16, col ? col.getBoundingClientRect().top : 0);
      readerRoot.style.setProperty("--reader-stage-top", Math.ceil(stageTop) + "px");
      var tabs = document.querySelector(".cust-bottom-tabs");
      var bottom = !expanded && tabs ? tabs.getBoundingClientRect().height : 0;
      readerRoot.style.setProperty("--reader-bottom", Math.ceil(bottom + 16) + "px");
    }
    function scheduleReaderFit() {
      cancelAnimationFrame(readerFitFrame);
      readerFitFrame = requestAnimationFrame(fitReader);
    }
    function readerArtFits() {
      var page = pageEls[flipIndex];
      if (!page) return true;
      var art = page.querySelector(".rd-img");
      var rect = (art || page).getBoundingClientRect();
      return rect.top >= readerChrome.getBoundingClientRect().bottom && rect.bottom <= window.innerHeight;
    }
    var fitObserver = new ResizeObserver(scheduleReaderFit);
    [readerChrome, document.querySelector("body > header"), document.querySelector(".cust-bottom-tabs")].forEach(function (el) { if (el) fitObserver.observe(el); });
    window.addEventListener("resize", scheduleReaderFit);
    if (window.visualViewport) window.visualViewport.addEventListener("resize", scheduleReaderFit);
    var inertSiblings = [];
    function setExpanded(active) {
      readerRoot.classList.toggle("is-expanded", active);
      expandBtn.setAttribute("aria-pressed", String(active));
      expandBtn.setAttribute("aria-label", active ? "Exit expanded reader" : "Expand reader");
      expandBtn.title = active ? "Exit expanded reader" : "Expand reader";
      if (active) {
        readerRoot.scrollTop = 0;
        Array.from(document.body.children).forEach(function (el) {
          if (el !== readerRoot && !el.inert) { inertSiblings.push(el); el.inert = true; }
        });
      } else {
        inertSiblings.forEach(function (el) { el.inert = false; });
        inertSiblings = [];
      }
      scheduleReaderFit();
    }
    expandBtn.addEventListener("click", function () {
      var active = expandBtn.getAttribute("aria-pressed") === "true";
      if (active) {
        setExpanded(false);
        if (document.fullscreenElement === readerRoot) document.exitFullscreen().catch(function () {});
      } else {
        setExpanded(true);
        if (readerRoot.requestFullscreen) readerRoot.requestFullscreen().catch(function () { /* Expanded layout also works without the Fullscreen API. */ });
      }
    });
    function closeReaderMenus(event) {
      document.querySelectorAll(".rd-menu[open]").forEach(function (menu) {
        if (!menu.contains(event.target)) menu.open = false;
      });
    }
    function readerEscape(event) {
      if (event.key !== "Escape") return;
      readerRoot.querySelectorAll(".rd-menu[open]").forEach(function (menu) {
        if (menu.contains(document.activeElement)) menu.querySelector("summary").focus();
        menu.open = false;
      });
      if (readerRoot.classList.contains("is-expanded")) { setExpanded(false); expandBtn.focus(); }
    }
    function fullscreenChanged() { if (document.fullscreenElement !== readerRoot) setExpanded(false); }
    document.addEventListener("click", closeReaderMenus);
    document.addEventListener("keydown", readerEscape);
    document.addEventListener("fullscreenchange", fullscreenChanged);
    document.addEventListener("astro:before-swap", function cleanupReader() {
      fitObserver.disconnect(); cancelAnimationFrame(readerFitFrame);
      window.removeEventListener("resize", scheduleReaderFit);
      if (window.visualViewport) window.visualViewport.removeEventListener("resize", scheduleReaderFit);
      document.removeEventListener("click", closeReaderMenus);
      document.removeEventListener("keydown", readerEscape);
      document.removeEventListener("fullscreenchange", fullscreenChanged);
      setExpanded(false);
      document.removeEventListener("astro:before-swap", cleanupReader);
    });

    // ---------- Progress saves (2026-11-05) ----------
    // Progress belongs to whoever is reading: the shell's active
    // profile decides the row. Parent View reads under "default"
    // (the long-standing parent row); a kid's view reads under
    // their profile id. The full save (pages + audio) lives in the
    // player branch and registers itself on window; books without
    // an audiobook use the page-only save here, so every book
    // tracks. Saves ride page turns (debounced), audio pauses, and
    // pagehide.
    function activeProgressProfile() {
      try {
        var stored = window.localStorage.getItem("bbs.activeProfileId");
        return !stored || stored === "parent" ? "default" : stored;
      } catch (e) {
        return "default";
      }
    }
    function savePageProgress() {
      if (!bookSlug) return;
      var pid = activeProgressProfile();
      var payload = {
        profile_id: pid,
        book_slug: bookSlug,
        page_index: flipIndex,
        reader_total_pages: pageEls.length,
        total_pages: pageEls.length,
        view_edition: artMode === "color" ? "fullcolor" : "story",
        view_mode: viewMode,
        sync_enabled: true,
      };
      try {
        window.localStorage.setItem("bbs-progress:" + pid + ":" + bookSlug, JSON.stringify(payload));
      } catch (e) {}
      fetch("/api/account/progress", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      }).catch(function () {});
    }
    var progressSaveTimer = 0;
    function scheduleProgressSave() {
      if (progressSaveTimer) window.clearTimeout(progressSaveTimer);
      progressSaveTimer = window.setTimeout(function () {
        if (typeof window.__bbsSaveFullProgress === "function") window.__bbsSaveFullProgress();
        else savePageProgress();
      }, 800);
    }
    window.addEventListener("pagehide", function () {
      if (typeof window.__bbsSaveFullProgress === "function") window.__bbsSaveFullProgress();
      else savePageProgress();
    });

    // Without a player there is no player branch to restore
    // progress: land a returning reader on their saved page.
    if (!playerData) {
      try {
        var rawSaved = window.localStorage.getItem("bbs-progress:" + activeProgressProfile() + ":" + bookSlug);
        var savedPage = rawSaved ? JSON.parse(rawSaved) : null;
        if (savedPage && typeof savedPage.page_index === "number" && savedPage.page_index > 0) {
          flipIndex = Math.min(savedPage.page_index, pageEls.length - 1);
        }
      } catch (e) {}
    }

    // ---------- Artwork (line/color) ----------
    var artLine = document.getElementById("art-line");
    var artColor = document.getElementById("art-color");
    var TOGGLE_ON = "bg-[#1a3454] text-white";
    var TOGGLE_OFF = "bg-white text-stone-700";

    function applyArt() {
      if (artLine) artLine.className = artMode === "line" ? TOGGLE_ON : TOGGLE_OFF;
      if (artColor) artColor.className = artMode === "color" ? TOGGLE_ON : TOGGLE_OFF;
      if (artLine) artLine.setAttribute("aria-pressed", String(artMode === "line"));
      if (artColor) artColor.setAttribute("aria-pressed", String(artMode === "color"));
      pageEls.forEach(function (page) {
        var img = page.querySelector(".rd-img");
        var nocolor = page.querySelector(".rd-nocolor");
        var colorUrl = page.getAttribute("data-color-url") || "";
        var lineUrl = page.getAttribute("data-line-url") || "";
        if (!img) { if (nocolor) nocolor.classList.add("hidden"); return; }
        if (artMode === "color") {
          if (colorUrl) {
            if (img.getAttribute("src") !== colorUrl) img.setAttribute("src", colorUrl);
            img.classList.remove("hidden");
            if (nocolor) nocolor.classList.add("hidden");
          } else if (lineUrl) {
            // No color twin for this page yet: show the page itself
            // (line art), never a placeholder box, for customers.
            if (img.getAttribute("src") !== lineUrl) img.setAttribute("src", lineUrl);
            img.classList.remove("hidden");
            if (nocolor) nocolor.classList.add("hidden");
          } else {
            img.classList.add("hidden");
            if (nocolor) nocolor.classList.remove("hidden");
          }
        } else {
          if (lineUrl && img.getAttribute("src") !== lineUrl) img.setAttribute("src", lineUrl);
          img.classList.remove("hidden");
          if (nocolor) nocolor.classList.add("hidden");
        }
      });
    }
    if (artLine) artLine.addEventListener("click", function () { artMode = "line"; applyArt(); });
    if (artColor) artColor.addEventListener("click", function () { artMode = "color"; applyArt(); });

    // ---------- View (scroll/flip) ----------
    var viewScrollBtn = document.getElementById("view-scroll");
    var viewFlipBtn = document.getElementById("view-flip");
    var flipBar = document.getElementById("flip-bar");
    var flipPos = document.getElementById("flip-pos");
    var flipPrev = document.getElementById("flip-prev");
    var flipNext = document.getElementById("flip-next");
    var headings = Array.prototype.slice.call(document.querySelectorAll("#page-column section > h2"));

    function renderFlip() {
      pageEls.forEach(function (el, i) { el.style.display = i === flipIndex ? "" : "none"; });
      headings.forEach(function (h) { h.style.display = "none"; });
      var el = pageEls[flipIndex];
      if (el && flipPos) {
        var num = el.getAttribute("data-chapter");
        flipPos.textContent = (flipIndex + 1) + " / " + pageEls.length;
        flipPos.setAttribute("aria-label", "Chapter " + num + ": " + (chapterTitles[num] || "") + ". Page " + (flipIndex + 1) + " of " + pageEls.length);
        flipPos.title = "Chapter " + num + ": " + (chapterTitles[num] || "");
        document.getElementById("reader-chapter-label").textContent = "Chapter " + num;
      }
      if (flipPrev) flipPrev.disabled = flipIndex <= 0;
      if (flipNext) flipNext.disabled = flipIndex >= pageEls.length - 1;
      scheduleReaderFit();
    }
    function applyView() {
      if (viewScrollBtn) viewScrollBtn.className = viewMode === "scroll" ? TOGGLE_ON : TOGGLE_OFF;
      if (viewFlipBtn) viewFlipBtn.className = viewMode === "flip" ? TOGGLE_ON : TOGGLE_OFF;
      if (viewScrollBtn) viewScrollBtn.setAttribute("aria-pressed", String(viewMode === "scroll"));
      if (viewFlipBtn) viewFlipBtn.setAttribute("aria-pressed", String(viewMode === "flip"));
      var col0 = document.getElementById("page-column");
      if (col0) col0.classList.toggle("flip", viewMode === "flip");
      if (flipBar) {
        flipBar.classList.toggle("hidden", viewMode !== "flip");
        flipBar.style.display = viewMode === "flip" ? "" : "none";
      }
      if (viewMode === "flip") {
        renderFlip();
      } else {
        pageEls.forEach(function (el) { el.style.display = ""; });
        headings.forEach(function (h) { h.style.display = ""; });
        flipPos.textContent = "";
      }
      scheduleReaderFit();
    }
    function setFlip(i, scroll) {
      if (i < 0 || i >= pageEls.length) return;
      var changed = i !== flipIndex;
      flipIndex = i;
      if (viewMode === "flip") {
        renderFlip();
        if (scroll !== false && !readerArtFits()) {
          var col = document.getElementById("page-column");
          if (col) col.scrollIntoView({ block: "start", behavior: "smooth" });
        }
      }
      // Reading is progress too (2026-11-05): a silent reader used
      // to save nothing, because saves only rode audio events.
      if (changed) scheduleProgressSave();
    }
    function flipBy(delta) { setFlip(flipIndex + delta); }
    if (viewScrollBtn) viewScrollBtn.addEventListener("click", function () { viewMode = "scroll"; applyView(); });
    if (viewFlipBtn) viewFlipBtn.addEventListener("click", function () { viewMode = "flip"; applyView(); });
    if (flipPrev) flipPrev.addEventListener("click", function () { flipBy(-1); });
    if (flipNext) flipNext.addEventListener("click", function () { flipBy(1); });
    document.addEventListener("keydown", function (ev) {
      if (viewMode !== "flip" || ev.target.closest("input, select, textarea, summary, button")) return;
      if (ev.key === "ArrowRight") { ev.preventDefault(); flipBy(1); }
      if (ev.key === "ArrowLeft") { ev.preventDefault(); flipBy(-1); }
    });
    // Tap zones in flip view: left third of the image goes back, right
    // third goes forward.
    pageEls.forEach(function (page) {
      var img = page.querySelector(".rd-img");
      if (!img) return;
      img.addEventListener("click", function (ev) {
        if (viewMode !== "flip") return;
        var r = img.getBoundingClientRect();
        var x = (ev.clientX - r.left) / Math.max(1, r.width);
        if (x < 0.35) flipBy(-1);
        else if (x > 0.65) flipBy(1);
      });
    });

    function gotoChapter(num) {
      document.getElementById("chapter-menu").open = false;
      if (viewMode === "flip") {
        var start = chapterStarts[num];
        if (start !== undefined) setFlip(start);
      } else {
        var el = document.getElementById("ch-" + num);
        if (el) el.scrollIntoView({ block: "start", behavior: "smooth" });
      }
    }

    // ---------- Player (same behavior as the admin Story Review) ----
    if (playerData) {
      var audio = window.BBSPlayer.audio;
      var playBtn = document.getElementById("play-btn");
      var iconPlay = document.getElementById("icon-play");
      var iconPause = document.getElementById("icon-pause");
      var prevBtn = document.getElementById("prev-btn");
      var nextBtn = document.getElementById("next-btn");
      var seek = document.getElementById("seek");
      var elapsedEl = document.getElementById("time-elapsed");
      var totalEl = document.getElementById("time-total");
      var nowPlaying = document.getElementById("now-playing");
      var statusEl = document.getElementById("player-status");
      var speedSel = document.getElementById("speed");
      var modeChBtn = document.getElementById("mode-chapters");
      var modeFullBtn = document.getElementById("mode-full");

      var pmode = "chapters";
      if (window.BBSPlayer) window.BBSPlayer.host({ slug: playerData.slug, title: playerData.title || document.title, cover: playerData.cover || "", bookUrl: window.location.pathname });
      var index = -1;
      var seeking = false;

      function playlist() {
        return pmode === "full" && playerData.full ? [playerData.full] : playerData.tracks;
      }
      function trackIndexForChapter(num) {
        var tracks = playlist();
        for (var i = 0; i < tracks.length; i++) if (tracks[i].chapter === num) return i;
        return -1;
      }
      function scrollForTrack(t) {
        if (!t || pmode === "full") return;
        if (t.chapter != null) { gotoChapter(t.chapter); return; }
        if (t.id === "intro") { gotoChapter(1); return; }
        if (t.id === "outro" && audioChapterCount > 0) { gotoChapter(audioChapterCount); }
      }
      function fmt(s) {
        if (s == null || !isFinite(s) || s < 0) return "0:00";
        s = Math.round(s);
        var h = Math.floor(s / 3600), m = Math.floor((s % 3600) / 60), r = s % 60;
        var mm = h > 0 ? String(m).padStart(2, "0") : String(m);
        return (h > 0 ? h + ":" : "") + mm + ":" + String(r).padStart(2, "0");
      }
      function setPlayingUi(playing) {
        iconPlay.classList.toggle("hidden", playing);
        iconPause.classList.toggle("hidden", !playing);
        playBtn.setAttribute("aria-label", playing ? "Pause" : "Play");
      }
      function loadTrack(i, autoplay) {
        // Stale-page guard: our listeners ride the persisted audio
        // element across navigations; with our DOM gone, stay inert
        // and let the global player advance the playlist itself.
        if (!document.contains(statusEl)) return;
        var tracks = playlist();
        if (i < 0 || i >= tracks.length) return;
        index = i;
        if (window.BBSPlayer) window.BBSPlayer.notePlaylist(playlist(), index, { slug: playerData.slug, title: playerData.title || document.title, cover: playerData.cover || "", bookUrl: window.location.pathname });
        var t = tracks[i];
        statusEl.textContent = "";
        audio.src = t.url;
        audio.playbackRate = Number(speedSel.value) || 1;
        nowPlaying.textContent = t.label;
        totalEl.textContent = t.duration ? fmt(t.duration) : "0:00";
        elapsedEl.textContent = "0:00";
        seek.value = 0;
        prevBtn.disabled = pmode === "full" || index <= 0;
        nextBtn.disabled = pmode === "full" || index >= tracks.length - 1;
        document.querySelectorAll(".rd-chapter-chip").forEach(function (chip) {
          var edge = chip.getAttribute("data-edge");
          var active = pmode === "chapters" && (edge
            ? t.id === edge
            : t.chapter === Number(chip.getAttribute("data-chapter")));
          chip.className = "rd-chapter-chip shrink-0 rounded-full px-3 py-1.5 text-xs font-semibold " +
            (active ? "bg-orange-600 text-white border border-orange-600"
                    : "border border-stone-300 bg-white hover:border-stone-500 text-stone-700");
        });
        document.getElementById("chapter-menu").open = false;
        if (autoplay) audio.play().catch(function () {});
      }
      function playChapter(num) {
        if (num < 1 || num > audioChapterCount) return;
        if (pmode !== "chapters") setPmode("chapters");
        var i = trackIndexForChapter(num);
        if (i < 0) return;
        loadTrack(i, true);
        gotoChapter(num);
      }
      function playEdge(edge) {
        if (pmode !== "chapters") setPmode("chapters");
        var tracks = playlist();
        for (var i = 0; i < tracks.length; i++) {
          if (tracks[i].id === edge) { loadTrack(i, true); scrollForTrack(tracks[i]); return; }
        }
      }
      function setPmode(next) {
        if (next === pmode) return;
        pmode = next;
        var on = "bg-[#1a3454] text-white px-3 py-1.5 text-xs font-semibold";
        var off = "bg-white text-stone-700 px-3 py-1.5 text-xs font-semibold";
        if (modeChBtn) modeChBtn.className = pmode === "chapters" ? on : off;
        if (modeFullBtn) modeFullBtn.className = pmode === "full" ? on : off;
        loadTrack(0, false);
      }

      playBtn.addEventListener("click", function () {
        if (index < 0) { loadTrack(0, true); scrollForTrack(playlist()[0]); return; }
        if (audio.paused) audio.play().catch(function () {});
        else audio.pause();
      });
      prevBtn.addEventListener("click", function () { if (index > 0) { loadTrack(index - 1, true); scrollForTrack(playlist()[index]); } });
      nextBtn.addEventListener("click", function () { if (index < playlist().length - 1) { loadTrack(index + 1, true); scrollForTrack(playlist()[index]); } });
      if (modeChBtn) modeChBtn.addEventListener("click", function () { setPmode("chapters"); });
      if (modeFullBtn) modeFullBtn.addEventListener("click", function () { setPmode("full"); });
      speedSel.addEventListener("change", function () { audio.playbackRate = Number(speedSel.value) || 1; });

      document.querySelectorAll(".rd-chapter-chip").forEach(function (chip) {
        chip.addEventListener("click", function () {
          var edge = chip.getAttribute("data-edge");
          if (edge) { playEdge(edge); return; }
          var num = Number(chip.getAttribute("data-chapter"));
          if (num <= audioChapterCount) playChapter(num);
          else gotoChapter(num);
        });
      });
      document.querySelectorAll(".rd-play-chapter").forEach(function (btn) {
        btn.addEventListener("click", function () {
          playChapter(Number(btn.getAttribute("data-chapter")));
        });
      });

      var listenStartFired = false;
      audio.addEventListener("play", function () {
        if (listenStartFired) return;
        listenStartFired = true;
        if (window.bbsTraks) window.bbsTraks("listen_start", {});
      });
      audio.addEventListener("play", function () { setPlayingUi(true); });
      audio.addEventListener("pause", function () { setPlayingUi(false); });
      audio.addEventListener("loadedmetadata", function () {
        if (isFinite(audio.duration)) totalEl.textContent = fmt(audio.duration);
      });
      audio.addEventListener("timeupdate", function () {
        if (!isFinite(audio.duration) || audio.duration <= 0) return;
        elapsedEl.textContent = fmt(audio.currentTime);
        if (!seeking) seek.value = Math.round((audio.currentTime / audio.duration) * 1000);
      });
      audio.addEventListener("ended", function () {
        setPlayingUi(false);
        if (sleepMode === -1) {
          statusEl.textContent = "Paused at end of chapter by Sleep Timer.";
          saveReaderProgress();
          return;
        }
        if (pmode === "chapters" && index < playlist().length - 1) {
          loadTrack(index + 1, true);
          scrollForTrack(playlist()[index]);
        }
      });
      audio.addEventListener("error", function () {
        if (index >= 0) statusEl.textContent = "That track could not be loaded.";
      });
      seek.addEventListener("input", function () { seeking = true; });
      seek.addEventListener("change", function () {
        seeking = false;
        if (isFinite(audio.duration) && audio.duration > 0) {
          audio.currentTime = (Number(seek.value) / 1000) * audio.duration;
          saveReaderProgress();
        }
      });

      // Sleep timer ("timed turn off" — defaults to 60 mins) + synced progress save/resume
      var sleepSel = document.getElementById("sleep-timer");
      var sleepCountdown = document.getElementById("sleep-countdown");
      var sleepMode = 60;
      var sleepRemainingSec = 60 * 60;

      function updateSleepUi() {
        if (!sleepCountdown) return;
        if (sleepMode === 0) sleepCountdown.textContent = "Off";
        else if (sleepMode === -1) sleepCountdown.textContent = "End of ch";
        else sleepCountdown.textContent = "⏱ " + fmt(sleepRemainingSec);
      }

      if (sleepSel) {
        sleepSel.addEventListener("change", function () {
          sleepMode = Number(sleepSel.value);
          sleepRemainingSec = sleepMode > 0 ? sleepMode * 60 : 0;
          audio.volume = 1;
          updateSleepUi();
        });
      }

      window.setInterval(function () {
        if (audio.paused) return;
        if (sleepMode > 0) {
          sleepRemainingSec = Math.max(0, sleepRemainingSec - 1);
          if (sleepRemainingSec > 0 && sleepRemainingSec <= 10) {
            audio.volume = Math.max(0.1, sleepRemainingSec / 10);
          }
          updateSleepUi();
          if (sleepRemainingSec <= 0) {
            audio.pause();
            audio.volume = 1;
            statusEl.textContent = "Paused by Sleep Timer.";
            saveReaderProgress();
          }
        }
      }, 1000);

      function saveReaderProgress() {
        if (!playerData || !playerData.slug) return;
        var pid = activeProgressProfile();
        var tracks = playlist();
        var currentTrack = tracks[index] || null;
        // Book-level listening position: whole tracks before this
        // one plus the position inside it, over the playlist's
        // total. Only sent when the playlist's durations are known,
        // so a partial save never zeroes a good total.
        var audioElapsed = 0;
        var audioTotal = 0;
        tracks.forEach(function (t, i) {
          var d = Number(t.duration || 0);
          if (d > 0) {
            audioTotal += d;
            if (i < index) audioElapsed += d;
          }
        });
        if (index >= 0 && isFinite(audio.currentTime)) audioElapsed += audio.currentTime;
        var payload = {
          profile_id: pid,
          book_slug: playerData.slug,
          chapter_num: currentTrack && currentTrack.chapter ? currentTrack.chapter : 1,
          page_index: flipIndex,
          reader_total_pages: pageEls.length,
          total_pages: pageEls.length,
          view_edition: artMode === "color" ? "fullcolor" : "story",
          view_mode: viewMode,
          audio_track_id: currentTrack ? currentTrack.id : null,
          audio_position_sec: isFinite(audio.currentTime) ? Math.round(audio.currentTime * 10) / 10 : 0,
          audio_duration_sec: isFinite(audio.duration) ? Math.round(audio.duration * 10) / 10 : 0,
          sync_enabled: true,
        };
        if (audioTotal > 0) {
          payload.audio_elapsed_sec = Math.round(audioElapsed * 10) / 10;
          payload.audio_total_sec = Math.round(audioTotal * 10) / 10;
        }
        try {
          window.localStorage.setItem("bbs-progress:" + pid + ":" + playerData.slug, JSON.stringify(payload));
        } catch (e) {}
        fetch("/api/account/progress", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        }).catch(function () {});
      }

      audio.addEventListener("pause", saveReaderProgress);
      // The top-level scheduler and pagehide hook call the full
      // save (pages + audio) through here when the player exists.
      window.__bbsSaveFullProgress = saveReaderProgress;

      // Adopt the live session when we land back on a book the
      // global player kept playing (CG, 2026-11-05): paint this
      // card from the shared player's state instead of sitting
      // idle over a playing story, and keep the saved-progress
      // restore below from touching the live element.
      var adoptedLive = false;
      (function adoptLiveSession() {
        var bp = window.BBSPlayer;
        if (!bp || !bp.state || bp.state.slug !== playerData.slug) return;
        var st = bp.state;
        if (!st.tracks || !st.tracks.length || st.index < 0 || st.index >= st.tracks.length) return;
        var cur = st.tracks[st.index];
        if (playerData.full && st.tracks.length === 1 && cur.id === "full") {
          pmode = "full";
          if (modeChBtn) modeChBtn.className = "bg-white text-stone-700 px-3 py-1.5 text-xs font-semibold";
          if (modeFullBtn) modeFullBtn.className = "bg-[#1a3454] text-white px-3 py-1.5 text-xs font-semibold";
        }
        var tracks = playlist();
        var found = -1;
        for (var i = 0; i < tracks.length; i++) {
          if (tracks[i].id === cur.id || tracks[i].url === cur.url) { found = i; break; }
        }
        if (found < 0) return;
        index = found;
        var t = tracks[found];
        nowPlaying.textContent = t.label;
        totalEl.textContent = t.duration ? fmt(t.duration) : (isFinite(audio.duration) && audio.duration > 0 ? fmt(audio.duration) : "0:00");
        elapsedEl.textContent = fmt(audio.currentTime || 0);
        if (isFinite(audio.duration) && audio.duration > 0) {
          seek.value = Math.round((audio.currentTime / audio.duration) * 1000);
        }
        prevBtn.disabled = pmode === "full" || index <= 0;
        nextBtn.disabled = pmode === "full" || index >= tracks.length - 1;
        setPlayingUi(!audio.paused);
        document.querySelectorAll(".rd-chapter-chip").forEach(function (chip) {
          var edge = chip.getAttribute("data-edge");
          var active = pmode === "chapters" && (edge
            ? t.id === edge
            : t.chapter === Number(chip.getAttribute("data-chapter")));
          chip.className = "rd-chapter-chip shrink-0 rounded-full px-3 py-1.5 text-xs font-semibold " +
            (active ? "bg-orange-600 text-white border border-orange-600"
                    : "border border-stone-300 bg-white hover:border-stone-500 text-stone-700");
        });
        adoptedLive = true;
      })();

      // Restore saved progress on load
      (function restoreReaderProgress() {
        if (adoptedLive) return;
        if (!playerData || !playerData.slug) return;
        try {
          var raw = window.localStorage.getItem("bbs-progress:" + activeProgressProfile() + ":" + playerData.slug);
          if (!raw) return;
          var saved = JSON.parse(raw);
          // The page position restores too, not just the audio: a
          // silent reader used to land back on page one every time.
          if (saved && typeof saved.page_index === "number" && saved.page_index > 0) {
            setFlip(Math.min(saved.page_index, pageEls.length - 1), false);
          }
          if (saved && saved.audio_track_id) {
            var tracks = playlist();
            for (var i = 0; i < tracks.length; i++) {
              if (tracks[i].id === saved.audio_track_id) {
                loadTrack(i, false);
                if (saved.audio_position_sec > 2) {
                  audio.addEventListener("loadedmetadata", function onMeta() {
                    audio.removeEventListener("loadedmetadata", onMeta);
                    if (isFinite(audio.duration) && saved.audio_position_sec < audio.duration) {
                      audio.currentTime = saved.audio_position_sec;
                      elapsedEl.textContent = fmt(saved.audio_position_sec);
                    }
                  });
                }
                break;
              }
            }
          }
        } catch (e) {}
      })();

      if (listenMode) {
        if (playBtn) playBtn.classList.add("rd-pulse");
      }
    } else {
      document.querySelectorAll(".rd-chapter-chip").forEach(function (chip) {
        chip.addEventListener("click", function () {
          gotoChapter(Number(chip.getAttribute("data-chapter")));
        });
      });
    }

    applyArt();
    applyView();
  </script>

  <script is:inline>
    function initSignout() {
      var btn = document.getElementById("signout");
      if (!btn || btn.__signoutBound) return;
      btn.__signoutBound = true;
      btn.addEventListener("click", async function () {
        await fetch("/api/auth/sign-out", { method: "POST", headers: { "Content-Type": "application/json" }, body: "{}" });
        await fetch("/api/admin-auth/logout", { method: "POST" }).catch(function () {});
        window.location.href = "/";
      });
    }
    initSignout();
    document.addEventListener("astro:page-load", initSignout);
  </script>
</body>
</html>
