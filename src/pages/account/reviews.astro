---
import "../../styles/global.css";
import { env } from "cloudflare:workers";
import Tracking from "../../components/Tracking.astro";
import { ClientRouter } from "astro:transitions";
import TransitionHooks from "../../components/TransitionHooks.astro";
import CustomerShell from "../../components/CustomerShell.astro";
import { loadCustomerHubContext } from "../../lib/account-data";
import { ensureReviewsTable, REVIEW_STATUS_LABELS } from "../../lib/reviews";
import { ensurePublicSlugColumn, publicSlugFor } from "../../lib/public-slugs";

const e = env as any;
const hub = await loadCustomerHubContext(Astro.request, Astro.locals, e.DB, Astro.url.origin);
if (!hub) {
  return Astro.redirect("/login?next=/account/reviews");
}

const {
  session,
  books,
  audioBooksCount,
  parentOnboarding,
  kidProfiles,
  onboardingChecklist,
} = hub;

await ensureReviewsTable(e.DB);
await ensurePublicSlugColumn(e.DB).catch(() => {});
const myReviews = ((
  await e.DB.prepare(
    "SELECT r.*, b.title AS book_title, b.public_slug AS book_public_slug FROM reviews r LEFT JOIN books b ON b.slug = r.book_slug WHERE r.user_id = ? ORDER BY r.created_at DESC"
  )
    .bind(session.user.id)
    .all()
).results || []) as any[];

const reviewStats = {
  total: myReviews.length,
  approved: myReviews.filter((r) => r.status === "approved").length,
  pending: myReviews.filter((r) => r.status === "pending").length,
  avg: myReviews.length
    ? Math.round((myReviews.reduce((s, r) => s + (Number(r.rating) || 0), 0) / myReviews.length) * 10) / 10
    : 0,
};
---
<!doctype html>
<html lang="en">
<head>
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="theme-color" content="#1a3454" />
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>My Reviews · Big Brain Shelf</title>
  <ClientRouter />
  <TransitionHooks />
  <Tracking />
</head>
<body class="bg-white text-stone-900 antialiased pb-28">
  <CustomerShell
    currentSection="reviews"
    userEmail={String(session.user.email || "")}
    username={session.user.displayUsername || session.user.username}
    displayName={parentOnboarding?.parent_name || session.user.name}
    isAdmin={session.user.isAdmin}
    kidProfiles={kidProfiles}
    hasParentPin={Boolean(parentOnboarding?.parent_pin)}
    bookCount={books.length}
    audioCount={audioBooksCount}
    onboardingComplete={onboardingChecklist.isComplete}
  />

  <main class="max-w-4xl mx-auto px-4 py-7 sm:py-10">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div>
        <span class="rounded-full bg-orange-100 text-orange-800 px-3 py-0.5 text-[11px] font-extrabold uppercase tracking-wider">
          Reader Notes
        </span>
        <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-stone-900 mt-1.5">
          My Reviews
        </h1>
        <p class="text-sm text-stone-600 mt-1">
          Reviews help other parents pick the right story for their children. Every review is checked by a person before going live.
        </p>
      </div>
      <a
        href="/account"
        class="cust-pressable rounded-full border border-stone-300 bg-white px-4 py-2 text-xs font-extrabold text-stone-700 hover:border-stone-500"
      >
        ← Back to Dashboard
      </a>
    </div>

    {myReviews.length > 0 && (
      <section class="mt-6 grid grid-cols-2 lg:grid-cols-4 gap-3" aria-label="Your reviews at a glance">
        <div class="rounded-3xl border border-stone-200 bg-white p-4">
          <p class="text-[11px] font-extrabold uppercase tracking-wider text-stone-400">Reviews written</p>
          <p class="text-2xl font-extrabold text-stone-900 mt-1">{reviewStats.total}</p>
          <p class="text-xs text-stone-500 mt-0.5">One per book, ever</p>
        </div>
        <div class="rounded-3xl border border-stone-200 bg-white p-4">
          <p class="text-[11px] font-extrabold uppercase tracking-wider text-stone-400">Live on the store</p>
          <p class="text-2xl font-extrabold text-stone-900 mt-1">{reviewStats.approved}</p>
          <p class="text-xs text-stone-500 mt-0.5">Helping other parents choose</p>
        </div>
        <div class="rounded-3xl border border-stone-200 bg-white p-4">
          <p class="text-[11px] font-extrabold uppercase tracking-wider text-stone-400">Waiting for review</p>
          <p class="text-2xl font-extrabold text-stone-900 mt-1">{reviewStats.pending}</p>
          <p class="text-xs text-stone-500 mt-0.5">Editable until approved</p>
        </div>
        <div class="rounded-3xl border border-stone-200 bg-white p-4">
          <p class="text-[11px] font-extrabold uppercase tracking-wider text-stone-400">Average stars</p>
          <p class="text-2xl font-extrabold text-stone-900 mt-1">{reviewStats.avg ? reviewStats.avg.toFixed(1) : "—"}</p>
          <p class="text-xs text-stone-500 mt-0.5">Across your reviews</p>
        </div>
      </section>
    )}

    {myReviews.length === 0 ? (
      <div class="mt-6 rounded-3xl border border-dashed border-stone-300 bg-[#fcfaf6] p-8 text-center">
        <p class="text-base font-extrabold text-stone-900">You have not reviewed any books yet</p>
        <p class="mt-1 text-xs text-stone-600 max-w-md mx-auto">
          After you finish a book with your child, its review button waits on the book's page in your library.
        </p>
        <a
          href="/account/library"
          class="cust-pressable mt-4 inline-block rounded-full bg-orange-600 px-5 py-2.5 text-xs font-extrabold text-white hover:bg-orange-700"
        >
          Open Your Library →
        </a>
      </div>
    ) : (
      <div class="mt-6 space-y-3">
        {myReviews.map((r) => (
          <div class="rounded-2xl border border-stone-200 bg-[#fcfaf6] p-5 text-sm">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <div class="flex items-center gap-2">
                <a
                  href={"/account/book/" + publicSlugFor({ slug: r.book_slug, public_slug: r.book_public_slug, title: r.book_title })}
                  class="font-extrabold text-stone-900 hover:text-orange-600"
                >
                  {r.book_title || "Big Brain Shelf book"}
                </a>
                <span class="text-orange-500">
                  {"★".repeat(Number(r.rating) || 0)}
                  {"☆".repeat(5 - (Number(r.rating) || 0))}
                </span>
              </div>
              <div class="flex items-center gap-3 text-xs">
                <span
                  class:list={[
                    "rounded-full px-2.5 py-0.5 font-semibold",
                    r.status === "approved"
                      ? "bg-green-50 text-green-800 border border-green-200"
                      : r.status === "rejected"
                        ? "bg-stone-100 text-stone-600 border border-stone-200"
                        : "bg-orange-50 text-orange-800 border border-orange-200",
                  ]}
                >
                  {REVIEW_STATUS_LABELS[String(r.status)] || r.status}
                </span>
                <span class="text-stone-400">
                  {new Date(Number(r.created_at) * 1000).toLocaleDateString()}
                </span>
              </div>
            </div>
            {r.title && <p class="mt-2 font-bold text-stone-900">{r.title}</p>}
            <p class="mt-1 text-stone-700 whitespace-pre-line">{r.body}</p>
            {r.status === "pending" && (
              <div class="mt-3">
                <button
                  type="button"
                  class="cust-pressable rounded-full border border-stone-300 bg-white px-4 py-1.5 text-xs font-extrabold text-stone-700 hover:border-stone-500"
                  data-edit-toggle={r.id}
                >
                  Edit review
                </button>
                <form class="review-edit-form mt-3 hidden rounded-2xl border border-stone-200 bg-white p-4" data-edit-form={r.id}>
                  <label class="block text-xs font-bold text-stone-700">Stars</label>
                  <select name="rating" class="mt-1 rounded-xl border border-stone-300 bg-white px-3 py-2 text-sm font-semibold">
                    {[5, 4, 3, 2, 1].map((n) => (
                      <option value={n} selected={Number(r.rating) === n}>{n} star{n > 1 ? "s" : ""}</option>
                    ))}
                  </select>
                  <label class="block text-xs font-bold text-stone-700 mt-3">Headline</label>
                  <input type="text" name="title" value={r.title || ""} maxlength="120" class="mt-1 w-full rounded-xl border border-stone-300 bg-white px-3 py-2 text-sm font-semibold" />
                  <label class="block text-xs font-bold text-stone-700 mt-3">Your review</label>
                  <textarea name="body" rows="4" maxlength="4000" class="mt-1 w-full rounded-xl border border-stone-300 bg-white px-3 py-2 text-sm">{r.body}</textarea>
                  <div class="mt-3 flex items-center gap-3">
                    <button type="submit" class="cust-pressable rounded-full bg-[#1a3454] px-4 py-2 text-xs font-extrabold text-white hover:bg-[#132741]">Save changes</button>
                    <p class="review-edit-msg text-xs text-stone-500" role="status"></p>
                  </div>
                  <p class="mt-2 text-[11px] text-stone-400">You can edit until your review is approved. Photos and video stay as submitted.</p>
                </form>
              </div>
            )}
          </div>
        ))}
      </div>
    )}
  </main>

  <script is:inline>
    (function () {
      function initReviewEdits() {
        document.querySelectorAll("[data-edit-toggle]").forEach(function (btn) {
          if (btn.__bound) return;
          btn.__bound = true;
          btn.addEventListener("click", function () {
            var form = document.querySelector('[data-edit-form="' + btn.getAttribute("data-edit-toggle") + '"]');
            if (form) form.classList.toggle("hidden");
          });
        });
        document.querySelectorAll(".review-edit-form").forEach(function (form) {
          if (form.__bound) return;
          form.__bound = true;
          form.addEventListener("submit", async function (ev) {
            ev.preventDefault();
            var msg = form.querySelector(".review-edit-msg");
            var fd = new FormData(form);
            if (msg) msg.textContent = "Saving...";
            try {
              var r = await fetch("/api/reviews", {
                method: "PATCH",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                  id: form.getAttribute("data-edit-form"),
                  rating: Number(fd.get("rating")),
                  title: String(fd.get("title") || ""),
                  body: String(fd.get("body") || ""),
                }),
              });
              var data = await r.json().catch(function () { return {}; });
              if (!r.ok) {
                if (msg) msg.textContent = data.error || "Could not save.";
                return;
              }
              window.location.reload();
            } catch {
              if (msg) msg.textContent = "Could not save. Please try again.";
            }
          });
        });
      }
      initReviewEdits();
      document.addEventListener("astro:page-load", initReviewEdits);
    })();
  </script>
</body>
</html>
