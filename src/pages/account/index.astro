---
import "../../styles/global.css";
import { env } from "cloudflare:workers";
import Tracking from "../../components/Tracking.astro";
import { ClientRouter } from "astro:transitions";
import TransitionHooks from "../../components/TransitionHooks.astro";
import { parseItems } from "../../lib/orders";
import { publicSlugFor } from "../../lib/public-slugs";
import { coverDerivative } from "../../lib/derivatives";
import { AUDIO_PRICE_CENTS } from "../../lib/offers";
import CustomerShell from "../../components/CustomerShell.astro";
import CustomerBookViewer from "../../components/CustomerBookViewer.astro";
import CustomerAudioDock from "../../components/CustomerAudioDock.astro";
import { loadCustomerHubContext } from "../../lib/account-data";

const e = env as any;
const hub = await loadCustomerHubContext(Astro.request, Astro.locals, e.DB, Astro.url.origin);
if (!hub) {
  return Astro.redirect("/login?next=/account");
}

const {
  session,
  books,
  audioBooksCount,
  parentOnboarding,
  kidProfiles,
  readingProgressList,
  onboardingChecklist,
  defaultSleepMinutes,
} = hub;

const R2 = "https://media.bigbrainshelf.com/";
const unlockPriceFor = (b: any): number =>
  Math.max(0, Math.round(Number(b?.price || 0)) - AUDIO_PRICE_CENTS);
const money = (cents: number) => "$" + (Number(cents || 0) / 100).toFixed(2);

const showSuccess = Astro.url.searchParams.get("checkout") === "success";

// Purchase event for the tracking component: Stripe sends buyers back
// to /account?checkout=success after a completed payment.
let purchaseEvent: { name: string; data: Record<string, unknown> } | null = null;
let purchaseTraksEvent: { name: string; props: Record<string, string>; value: number; onceKey: string } | null = null;
if (showSuccess) {
  const orders = await e.DB.prepare(
    "SELECT * FROM orders WHERE user_id = ? AND status = 'complete' ORDER BY created_at DESC LIMIT 1"
  )
    .bind(session.user.id)
    .all();
  const rows = (orders.rows || orders.results || []) as any[];
  const latest = rows[0];
  if (latest) {
    let ids: string[] = [];
    try {
      ids = JSON.parse(latest.book_slugs || "[]").map(String);
    } catch {}
    purchaseEvent = {
      name: "Purchase",
      data: {
        content_ids: ids,
        content_type: "product",
        num_items: ids.length,
        value: Math.round(Number(latest.amount || 0)) / 100,
        currency: "USD",
      },
    };
    const formats = [...new Set(parseItems(latest).map((i: any) => String(i.format || "digital")))].sort();
    purchaseTraksEvent = {
      name: "purchase",
      props: {
        format_mix: formats.join("+") || "digital",
        has_printed: formats.some((f) => f === "printed" || f === "giftset") ? "yes" : "no",
      },
      value: Math.round(Number(latest.amount || 0)) / 100,
      onceKey: String(latest.id || ""),
    };
  }
}
---
<!doctype html>
<html lang="en">
<head>
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#1a3454" />
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>My Shelf · Big Brain Shelf</title>
  <ClientRouter />
  <TransitionHooks />
  <Tracking pageEvent={purchaseEvent} traksEvent={purchaseTraksEvent} />
</head>
<body class="bg-white text-stone-900 antialiased pb-28">
  <CustomerShell
    currentSection="shelf"
    userEmail={String(session.user.email || "")}
    username={session.user.displayUsername || session.user.username}
    displayName={parentOnboarding?.parent_name || session.user.name}
    isAdmin={session.user.isAdmin}
    kidProfiles={kidProfiles}
    hasParentPin={Boolean(parentOnboarding?.parent_pin)}
    bookCount={books.length}
    audioCount={audioBooksCount}
    onboardingComplete={onboardingChecklist.isComplete}
  />

  <main class="max-w-6xl mx-auto px-4 py-7 sm:py-9">
    {showSuccess && (
      <div class="mb-6 rounded-2xl bg-green-50 border border-green-200 px-4 py-3 text-sm font-semibold text-green-800">
        Payment complete. Your books are on your shelf below. Tap any book to read along, listen, or print coloring pages.
      </div>
    )}

    <!-- Clean Family Header (No Admin Preview or QC Jargon) -->
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div>
        <div class="flex flex-wrap items-center gap-2.5">
          <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-stone-900">
            My Shelf
          </h1>
          {(session.user.displayUsername || session.user.username) && (
            <span class="rounded-full bg-orange-100 text-orange-800 px-2.5 py-0.5 text-xs font-extrabold">
              @{session.user.displayUsername || session.user.username}
            </span>
          )}
        </div>
        <p class="text-sm text-stone-600 mt-1">
          Pick a book below to read along with the narrator, listen at bedtime, or print coloring pages.
          The books you own are yours to download and keep.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-2" data-parent-only="true">
        <a
          href="/account/kids"
          class="cust-pressable rounded-full border border-stone-300 bg-white px-3.5 py-1.5 text-xs font-extrabold text-stone-700 hover:border-stone-500"
        >
          👧 Kids &amp; Timers ({kidProfiles.length})
        </a>
        <a
          href="/books"
          class="cust-pressable rounded-full bg-[#1a3454] px-3.5 py-1.5 text-xs font-extrabold text-white hover:bg-[#132741]"
        >
          Browse New Books →
        </a>
      </div>
    </div>

    <!-- Compact, Dismissible Family Onboarding Prompt (Never blocks the shelf) -->
    {!onboardingChecklist.isComplete && (
      <div
        id="shelf-onboarding-nudge"
        data-parent-only="true"
        class="mt-5 rounded-2xl border border-orange-200 bg-orange-50/70 px-4 py-3.5 flex flex-wrap items-center justify-between gap-3"
      >
        <div class="flex items-center gap-3 min-w-0">
          <span class="w-9 h-9 rounded-xl bg-orange-600 text-white font-extrabold text-sm flex items-center justify-center shrink-0">
            🦊
          </span>
          <div class="min-w-0">
            <p class="text-xs sm:text-sm font-extrabold text-stone-900">
              Personalize your family shelf ({onboardingChecklist.percent}% ready)
            </p>
            <p class="text-xs text-stone-600 truncate">
              Add your child's reader profile, bedtime sleep timer, and birthday for their annual $10 gift email.
            </p>
          </div>
        </div>
        <div class="flex items-center gap-2 shrink-0">
          <a
            href="/account/onboarding"
            class="cust-pressable rounded-full bg-orange-600 px-3.5 py-1.5 text-xs font-extrabold text-white hover:bg-orange-700"
          >
            Set Up Family Profile →
          </a>
          <button
            type="button"
            id="dismiss-onboarding-nudge"
            class="cust-pressable rounded-full border border-stone-300 bg-white px-2.5 py-1 text-xs font-bold text-stone-500 hover:text-stone-800 cursor-pointer"
            aria-label="Dismiss setup reminder for now"
          >
            Later ✕
          </button>
        </div>
      </div>
    )}

    <!-- SHELF GRID OR ZERO-ORDER FIRST-RUN EXPERIENCE -->
    <section id="shelf" class="mt-6" aria-label="Books on your shelf">
      {books.length === 0 ? (
        <div class="rounded-3xl border border-stone-200 bg-[#fcfaf6] p-6 sm:p-8">
          <div class="max-w-2xl">
            <span class="rounded-full bg-orange-100 text-orange-800 px-3 py-0.5 text-[11px] font-extrabold uppercase tracking-wider">
              Welcome to Big Brain Shelf
            </span>
            <h2 class="text-xl sm:text-2xl font-extrabold tracking-tight text-stone-900 mt-2">
              Your family shelf is ready for its first story
            </h2>
            <p class="text-sm text-stone-600 mt-1.5 leading-relaxed">
              Every Big Brain Shelf title turns big ideas (courage, money, technology, science) into warm illustrated stories for ages 4–8. When you add a book, it appears right here with both <strong>playable</strong> and <strong>printable</strong> editions:
            </p>
          </div>

          <div class="mt-6 grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div class="rounded-2xl border border-stone-200 bg-white p-4">
              <span class="text-xl" aria-hidden="true">✨</span>
              <h3 class="text-sm font-extrabold text-stone-900 mt-1.5">Playable Read-Along</h3>
              <p class="text-xs text-stone-600 mt-1">
                Full-color story pages on top with a synced narrator below that turns the pages automatically for young readers.
              </p>
            </div>
            <div class="rounded-2xl border border-stone-200 bg-white p-4">
              <span class="text-xl" aria-hidden="true">🖍️</span>
              <h3 class="text-sm font-extrabold text-stone-900 mt-1.5">Printable Coloring Book</h3>
              <p class="text-xs text-stone-600 mt-1">
                Print black-and-white line-art scenes at home so kids can color with crayons while listening to the story.
              </p>
            </div>
            <div class="rounded-2xl border border-stone-200 bg-white p-4">
              <span class="text-xl" aria-hidden="true">🌙</span>
              <h3 class="text-sm font-extrabold text-stone-900 mt-1.5">Bedtime Audiobook &amp; Timer</h3>
              <p class="text-xs text-stone-600 mt-1">
                Multi-chapter narration with a gentle bedtime sleep timer and downloadable M4B/EPUB files you keep forever.
              </p>
            </div>
          </div>

          <div class="mt-6 flex flex-wrap items-center gap-3">
            <a
              href="/books"
              class="cust-pressable rounded-full bg-orange-600 px-5 py-2.5 text-xs font-extrabold text-white hover:bg-orange-700"
            >
              Explore Digital Bundles ($8.99) →
            </a>
            <a
              href="/clubs"
              class="cust-pressable rounded-full border border-stone-300 bg-white px-5 py-2.5 text-xs font-extrabold text-stone-800 hover:border-stone-500"
            >
              Join Audio Club ($5.99/mo) or Book Club →
            </a>
            {!onboardingChecklist.isComplete && (
              <a
                href="/account/onboarding"
                class="cust-pressable rounded-full px-4 py-2 text-xs font-bold text-[#1a3454] hover:underline"
              >
                Finish 1-Minute Family Setup →
              </a>
            )}
          </div>
        </div>
      ) : (
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
          {books.map((b: any, idx: number) => {
            const cover =
              coverDerivative(b.slug, "card", b.cover_key) || (b.cover_key ? R2 + b.cover_key : null);
            const hasAudio = Boolean(b.audiobook_key);
            const audioOnly = Boolean(b.audioOnly);
            const unlockCents = unlockPriceFor(b);
            const prog = readingProgressList.find((p) => p.book_slug === b.slug);
            const progPct =
              prog && prog.total_pages > 0
                ? Math.min(100, Math.round((prog.current_page / prog.total_pages) * 100))
                : 0;
            return (
              <article
                class:list={[
                  "shelf-book-card group rounded-2xl border p-3 transition flex flex-col justify-between bg-white",
                  idx === 0 ? "border-orange-400 ring-2 ring-orange-200/70" : "border-stone-200 hover:border-stone-300",
                ]}
                data-book-card-slug={b.slug}
              >
                <div>
                  <button
                    type="button"
                    data-shelf-open-slug={b.slug}
                    data-shelf-open-tab={audioOnly ? "listen" : "readalong"}
                    class="w-full text-left cursor-pointer focus:outline-none"
                  >
                    <div
                      class="aspect-square rounded-xl bg-stone-100 overflow-hidden mb-2.5 border border-stone-200 relative"
                      transition:name={`book-cover-${b.slug}`}
                    >
                      {cover && (
                        <img
                          src={cover}
                          alt={b.title}
                          width="300"
                          height="300"
                          loading="lazy"
                          decoding="async"
                          class="w-full h-full object-cover group-hover:scale-[1.02] transition duration-200"
                        />
                      )}
                      {progPct > 0 && (
                        <div class="absolute bottom-0 inset-x-0 bg-stone-900/75 text-white px-2 py-0.5 text-[10px] font-bold flex items-center justify-between">
                          <span>Page {prog?.current_page}</span>
                          <span>{progPct}%</span>
                        </div>
                      )}
                    </div>
                    <h3 class="font-extrabold text-xs sm:text-sm leading-snug text-stone-900 line-clamp-2">
                      {b.title}
                    </h3>
                    <p class="text-[11px] text-stone-500 mt-0.5">{b.topic}</p>
                  </button>
                </div>

                <!-- Compact 2-Button Action Row (Selects Book into Stage Below) -->
                <div class="mt-3 pt-2 border-t border-stone-100 flex flex-wrap items-center gap-1.5">
                  <button
                    type="button"
                    data-shelf-open-slug={b.slug}
                    data-shelf-open-tab={audioOnly ? "listen" : "readalong"}
                    class="cust-pressable flex-1 rounded-lg bg-orange-600 px-2.5 py-1.5 text-[11px] font-extrabold text-white hover:bg-orange-700 text-center cursor-pointer"
                  >
                    {audioOnly ? "🎧 Listen" : "✨ Read & Listen"}
                  </button>
                  {!audioOnly && (
                    <button
                      type="button"
                      data-shelf-open-slug={b.slug}
                      data-shelf-open-tab="printables"
                      data-parent-only="true"
                      class="cust-pressable rounded-lg border border-stone-200 bg-stone-50 px-2 py-1.5 text-[11px] font-bold text-stone-700 hover:border-stone-400 cursor-pointer"
                      title="Printable coloring pages & PDF downloads"
                    >
                      🖨️ PDFs
                    </button>
                  )}
                </div>

                {audioOnly && (
                  <p class="mt-2 text-[11px] text-stone-600" data-parent-only="true">
                    <a
                      href={`/books/${publicSlugFor(b)}?upgrade=digital`}
                      class="font-bold text-orange-700 hover:underline"
                    >
                      + Add Storybook &amp; Coloring PDFs ({money(unlockCents)})
                    </a>
                  </p>
                )}
              </article>
            );
          })}
        </div>
      )}
    </section>

    <!-- UNIFIED BOOK VIEWER, READ-ALONG, AUDIOBOOK PLAYER & PRINTABLES STAGE -->
    {books.length > 0 && (
      <CustomerBookViewer books={books} defaultSleepMinutes={defaultSleepMinutes} />
    )}
    {books.length > 0 && (
      <p class="text-[11px] text-stone-400 mt-3">For your family's personal use.</p>
    )}

    <!-- Hidden Audio Engine & Persistent Mini-Bar -->
    {books.length > 0 && (
      <CustomerAudioDock
        books={books.map((b: any) => ({
          slug: b.slug,
          title: b.title,
          coverUrl: coverDerivative(b.slug, "card", b.cover_key) || (b.cover_key ? R2 + b.cover_key : null),
          audiobook_key: b.audiobook_key,
        }))}
        defaultSleepMinutes={defaultSleepMinutes}
      />
    )}
  </main>

  <script is:inline>
    (function () {
      function initShelfPage() {
        // Dismissible onboarding nudge
        var nudge = document.getElementById("shelf-onboarding-nudge");
        var dismissBtn = document.getElementById("dismiss-onboarding-nudge");
        var NUDGE_KEY = "bbs.dismissOnboardingNudge";
        if (nudge && sessionStorage.getItem(NUDGE_KEY) === "1") {
          nudge.classList.add("hidden");
        }
        if (dismissBtn && nudge && !dismissBtn.dataset.bound) {
          dismissBtn.dataset.bound = "1";
          dismissBtn.addEventListener("click", function () {
            sessionStorage.setItem(NUDGE_KEY, "1");
            nudge.classList.add("hidden");
          });
        }

        // Clicking a book card or compact button selects it into the Shelf Stage
        document.querySelectorAll("[data-shelf-open-slug]").forEach(function (btn) {
          if (btn.dataset.boundShelfOpen) return;
          btn.dataset.boundShelfOpen = "1";
          btn.addEventListener("click", function () {
            var slug = btn.getAttribute("data-shelf-open-slug");
            var tab = btn.getAttribute("data-shelf-open-tab") || "readalong";
            document.querySelectorAll(".shelf-book-card").forEach(function (card) {
              var active = card.getAttribute("data-book-card-slug") === slug;
              card.classList.toggle("border-orange-400", active);
              card.classList.toggle("ring-2", active);
              card.classList.toggle("ring-orange-200/70", active);
              card.classList.toggle("border-stone-200", !active);
            });
            window.dispatchEvent(
              new CustomEvent("bbs:open-book-in-qc", {
                detail: { slug: slug, tab: tab },
              })
            );
          });
        });
      }

      initShelfPage();
      document.addEventListener("astro:page-load", initShelfPage);
    })();
  </script>
</body>
</html>
