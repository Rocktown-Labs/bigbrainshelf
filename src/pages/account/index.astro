                      <span><strong>Surprise me</strong><br /><span class="text-white/70">We choose a back catalog book you do not already have.</span></span>
                    </label>
                    {clubPickOptions2.map((o: any) => (
                      <label class={`flex items-start gap-2 rounded-lg bg-white/5 px-3 py-2 text-sm ${o.blocked && clubBox.second_selected_book_slug !== o.slug ? "opacity-60" : "cursor-pointer"}`}>
                        <input
                          type="radio"
                          name="club-pick-2"
                          value={o.slug}
                          data-blocked={o.blocked ? "1" : "0"}
                          disabled={o.blocked && clubBox.second_selected_book_slug !== o.slug && !clubBox.allow_repeat}
                          checked={clubBox.second_selected_book_slug === o.slug}
                          class="mt-1"
                        />
                        <span>{o.title}{o.blocked ? <><br /><span class="text-white/70">{o.reason}</span></> : null}</span>
                      </label>
                    ))}
                  </div>
                </fieldset>
                <label class="mt-3 flex items-start gap-2 text-sm cursor-pointer">
                  <input type="checkbox" id="club-allow-repeat" checked={clubBox.allow_repeat === 1} class="mt-1" />
                  <span>I am choosing a repeat on purpose (a second copy, or a gift).</span>
                </label>
                <div class="mt-3 flex items-center gap-3">
                  <button type="submit" class="rounded-full bg-orange-400 px-5 py-2 text-sm font-bold text-[#1a3454] hover:bg-orange-300">Save my picks</button>
                  <p id="club-pick-msg" class="text-sm text-white/80" role="status"></p>
                </div>
              </form>
