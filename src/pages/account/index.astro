                    {clubPickOptions.map((o: any) => (
                      <label class={`flex items-start gap-2 rounded-lg bg-white/5 px-3 py-2 text-sm ${o.blocked && clubBox.selected_book_slug !== o.slug ? "opacity-60" : "cursor-pointer"}`}>
