---
import "../../styles/global.css";
import { env } from "cloudflare:workers";
import { getAuth, getEffectiveSession } from "../../lib/auth";
import Tracking from "../../components/Tracking.astro";
import { ClientRouter } from "astro:transitions";
import TransitionHooks from "../../components/TransitionHooks.astro";
import { parseItems, shortOrderId } from "../../lib/orders";
import FormatChip from "../../components/FormatChip.astro";
import { getLibraryBooks } from "../../lib/library";
import { publicSlugFor, ensurePublicSlugColumn } from "../../lib/public-slugs";
import { coverDerivative } from "../../lib/derivatives";
import { GIFT_SET_PRICE_CENTS, AUDIO_PRICE_CENTS, formatLabel, clubPriceLabel, CLUB_ANNUAL_PRICE_CENTS, AUDIO_CLUB_PRICE_CENTS, AUDIO_CLUB_ANNUAL_PRICE_CENTS } from "../../lib/offers";
import { ensureReviewsTable, REVIEW_STATUS_LABELS } from "../../lib/reviews";
import { ensureClubTable, shelfLabel, clubPlanOf } from "../../lib/club";
import {
  ensureClubCycleTables,
  generateUpcomingCyclesForMember,
  getNextClubBox,
  getClubSelectionOptions,
} from "../../lib/club-cycles";
import { boxCreatedDateString, clubCycleTiming, formatClubDate } from "../../lib/club-cycle-dates";
import CustomerShell from "../../components/CustomerShell.astro";
import CustomerBookViewer from "../../components/CustomerBookViewer.astro";
import CustomerAudioDock from "../../components/CustomerAudioDock.astro";
import {
  KID_AVATARS,
  SLEEP_TIMER_PRESETS,
  DAILY_LIMIT_PRESETS,
  READING_GOAL_OPTIONS,
  CURRENT_TOPIC_OPTIONS,
  FUTURE_TOPIC_OPTIONS,
  DISCOVERY_SOURCE_OPTIONS,
  generateReferralCode,
  computeOnboardingChecklist,
  getParentOnboarding,
  listKidProfiles,
  listReadingProgress,
} from "../../lib/family";

const e = env as any;
const session = await getEffectiveSession(Astro.request, Astro.locals, e.DB);
if (!session) {
  return Astro.redirect("/login?next=/account");
}

const R2 = "https://media.bigbrainshelf.com/";
const orders = await e.DB.prepare(
  "SELECT * FROM orders WHERE user_id = ? AND status = 'complete' ORDER BY created_at DESC"
).bind(session.user.id).all();
const orderRows = (orders.rows || orders.results || []) as any[];

// My Shelf: the account's digital library. Entitlements come from the
// library layer (completed orders in any format, the $0 Book Club join
// grants those orders include, plus shipped Book Club cycle boxes),
// not from orders alone.
const libraryBooks = await getLibraryBooks(e.DB, {
  id: session.user.id,
  email: String(session.user.email || ""),
});
let books: any[] = libraryBooks as any[];
// Admin review access: when an owner/admin visits /account or /accounts,
// include published books on the shelf so they can test the QC Viewer,
// Read-Along auto-flip, and Audiobook Player without placing a test order.
if (session.user.isAdmin && books.length === 0) {
  try {
    const allComplete = await e.DB.prepare(
      `SELECT slug, public_slug, title, topic, cover_key, picture_book_key, coloring_book_key, epub_key, color_book_key, audiobook_key, price, price_print
       FROM books WHERE status = 'complete' ORDER BY title ASC`
    )
      .bind()
      .all();
    const completeRows = (allComplete?.results || allComplete?.rows || []) as any[];
    books = completeRows.map((b) => ({
      ...b,
      sources: ["order"],
      digital: true,
      audio: Boolean(b.audiobook_key),
      audioOnly: false,
      owned: true,
      clubPlan: null,
    }));
  } catch {
    // Keep empty if query fails
  }
}
const audioBooksCount = books.filter((b) => Boolean(b.audiobook_key)).length;

// Family onboarding, kid profiles, and synced reading/listening progress.
const [parentOnboarding, kidProfiles, readingProgressList] = await Promise.all([
  getParentOnboarding(e.DB, session.user.id).catch(() => null),
  listKidProfiles(e.DB, session.user.id).catch(() => []),
  listReadingProgress(e.DB, session.user.id).catch(() => []),
]);
const onboardingChecklist = computeOnboardingChecklist(
  parentOnboarding,
  kidProfiles,
  readingProgressList
);
const defaultKidProfile = kidProfiles.find((k) => k.is_default) || kidProfiles[0] || null;
const defaultSleepMinutes = defaultKidProfile ? defaultKidProfile.default_sleep_timer_minutes : 60;
const familyReferralCode =
  parentOnboarding?.referral_code ||
  generateReferralCode(parentOnboarding?.parent_name || String(session.user.email || "FAMILY"), session.user.id);
const referralShareUrl = `${Astro.url.origin}/?ref=${encodeURIComponent(familyReferralCode)}`;
const bookBySlug: Record<string, any> = {};
for (const b of books) bookBySlug[b.slug] = b;
const priceFor = (slug: string, format: string): number => {
  const b = bookBySlug[slug];
  if (!b) return 0;
  if (format === "printed") return Math.round(Number(b.price_print || 0));
  if (format === "giftset") return GIFT_SET_PRICE_CENTS;
  if (format === "audio") return AUDIO_PRICE_CENTS;
  return Math.round(Number(b.price || 0));
};
// The audio upgrade: an audiobook-only owner unlocks the digital
// edition for the digital price minus the audio price they paid.
// Displayed here, computed and enforced again at checkout.
const unlockPriceFor = (b: any): number =>
  Math.max(0, Math.round(Number(b?.price || 0)) - AUDIO_PRICE_CENTS);
const money = (cents: number) => "$" + (Number(cents || 0) / 100).toFixed(2);
const PHYSICAL_LABELS: Record<string, string> = {
  preorder_received: "Printed order received",
  in_print: "Being printed",
  packed: "Packed",
  shipped: "Shipped",
  delivered: "Delivered",
};
// Cover + public-slug dressing for the order history blocks,
// covering every ordered slug (the library map above only holds
// entitled books; an order's books are normally among them, but the
// order view must not depend on that).
const orderBookRows = new Map<string, any>();
{
  const slugs = [...new Set(orderRows.flatMap((o) => parseItems(o).map((i) => i.slug)))];
  if (slugs.length) {
    const ph = slugs.map(() => "?").join(",");
    const rows = await e.DB.prepare(
      `SELECT slug, title, cover_key, public_slug FROM books WHERE slug IN (${ph})`
    ).bind(...slugs).all();
    for (const r of (rows.results || rows.rows || []) as any[]) orderBookRows.set(String(r.slug), r);
  }
}
// Each order renders as the store's order block (the "Order
// history" pattern): a summary band plus a products table. Items
// group by book + format with counts, like the other order views.
const orderViews = orderRows.map((o) => {
  const grouped = new Map<string, any>();
  for (const it of parseItems(o)) {
    const key = it.slug + "|" + it.format;
    const existing = grouped.get(key);
    if (existing) { existing.count += 1; continue; }
    const ob = orderBookRows.get(it.slug);
    grouped.set(key, {
      slug: it.slug,
      // Links wear the public (title-based) slug; the item itself
      // keeps keying on the internal slug everywhere else.
      publicSlug: bookBySlug[it.slug] ? publicSlugFor(bookBySlug[it.slug]) : ob ? publicSlugFor(ob) : it.slug,
      // A missing book row must never fall back to the internal slug
      // as the displayed name.
      title: bookBySlug[it.slug]?.title || ob?.title || "Big Brain Shelf book",
      format: it.format,
      count: 1,
      cover: ob ? coverDerivative(it.slug, "card", ob.cover_key) || (ob.cover_key ? R2 + ob.cover_key : null) : null,
      price: it.upgrade === "audio-upgrade" ? unlockPriceFor(bookBySlug[it.slug]) : priceFor(it.slug, it.format),
      creditNote: it.upgrade === "audio-upgrade",
      hasAudio: !!bookBySlug[it.slug]?.audiobook_key,
    });
  }
  return {
    order: o,
    items: [...grouped.values()],
    dateLong: new Date(Number(o.created_at) * 1000).toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" }),
    shortId: shortOrderId(o.id),
    physicalLabel: o.physical_status ? PHYSICAL_LABELS[o.physical_status] || o.physical_status : null,
    trackingLine: o.tracking_number
      ? [o.carrier ? o.carrier + " · " : "", "Tracking ", o.tracking_number].join("")
      : null,
  };
});

// My Reviews (Phase 3): every review this account has written, with its
// moderation status.
await ensureReviewsTable(e.DB);
await ensurePublicSlugColumn(e.DB).catch(() => {});
const myReviews = ((await e.DB.prepare(
  "SELECT r.*, b.title AS book_title, b.public_slug AS book_public_slug FROM reviews r LEFT JOIN books b ON b.slug = r.book_slug WHERE r.user_id = ? ORDER BY r.created_at DESC"
).bind(session.user.id).all()).results || []) as any[];

// Book Club (Phase 2): this account's club status, if they have joined.
await ensureClubTable(e.DB);
const clubSignup = await e.DB.prepare(
  "SELECT * FROM club_signups WHERE email = ?"
).bind(String(session.user.email || "").toLowerCase()).first() as any;
// Which club plan this membership is (club.ts clubPlanOf; rows from
// before the Audio Club existed are physical).
const clubPlan = clubSignup ? clubPlanOf(clubSignup) : null;
const showSuccess = Astro.url.searchParams.get("checkout") === "success";

// Book Club V2: the member's next cycle box and book-choice state.
// Cycle rows are generated idempotently on render as a backup; the
// worker's scheduled pass is the mechanism that creates them for
// everyone, reminds, and locks.
let clubBox: any = null;
let clubTiming: any = null;
let clubPickOptions: any[] = [];
let clubPickOptions2: any[] = [];
let clubCurrentTitle: string | null = null;
let clubSecondTitle: string | null = null;
let clubBillingPaused = false;
if (clubSignup?.status === "paid") {
  clubBillingPaused = ["past_due", "paused"].includes(String(clubSignup.subscription_status || ""));
  try {
    await ensureClubCycleTables(e.DB);
    await generateUpcomingCyclesForMember(e.DB, clubSignup);
    clubBox = await getNextClubBox(e.DB, clubSignup.id);
    if (clubBox) {
      clubTiming = clubCycleTiming(String(clubBox.ship_date), boxCreatedDateString(clubBox.created_at));
      const opts = await getClubSelectionOptions(e.DB, clubSignup, clubBox);
      // Two pick lists for the box's two slots: each also blocks the
      // other slot's book, so a box never carries the same title twice.
      const slot1Slug = clubBox.resolved_book_slug || clubBox.selected_book_slug;
      const slot2Slug = clubBox.second_resolved_book_slug || clubBox.second_selected_book_slug;
      const toOptions = (otherSlug: any) =>
        opts.books.map((b: any) => ({
          slug: b.slug,
          title: b.title,
          blocked: opts.owned.has(b.slug) || opts.committed.has(b.slug) || b.slug === otherSlug,
          reason:
            b.slug === otherSlug
              ? "Already in this box"
              : opts.owned.has(b.slug)
                ? "Already in your library"
                : "Already coming in a club box",
        }));
      clubPickOptions = toOptions(slot2Slug);
      clubPickOptions2 = toOptions(slot1Slug);
      const current = clubPickOptions.find((o: any) => o.slug === slot1Slug);
      clubCurrentTitle = current?.title || null;
      clubSecondTitle = clubPickOptions2.find((o: any) => o.slug === slot2Slug)?.title || null;
    }
  } catch (err) {
    console.error("account club cycle load failed", err);
    clubBox = null;
  }
}

// Purchase event for the tracking component: Stripe sends buyers back
// to /account?checkout=success after a completed payment, so that
// landing is the success point. Value and contents come from the
// newest completed order on the account; if the Stripe webhook has
// not marked an order complete yet at that instant, no event fires
// rather than firing with the wrong order's numbers.
let purchaseEvent: { name: string; data: Record<string, unknown> } | null = null;
let purchaseTraksEvent: { name: string; props: Record<string, string>; value: number; onceKey: string } | null = null;
if (showSuccess) {
  const rows = (orders.rows || orders.results || []) as any[];
  const latest = rows[0];
  if (latest) {
    let ids: string[] = [];
    try { ids = JSON.parse(latest.book_slugs || "[]").map(String); } catch {}
    purchaseEvent = {
      name: "Purchase",
      data: {
        content_ids: ids,
        content_type: "product",
        num_items: ids.length,
        value: Math.round(Number(latest.amount || 0)) / 100,
        currency: "USD",
      },
    };
    // The Traks purchase carries the order's format mix, never its
    // contents: formats are a small closed set, joined sorted so the
    // same mix always spells the same token. onceKey guards refreshes
    // of the success landing; it never leaves the browser.
    const formats = [...new Set(parseItems(latest).map((i: any) => String(i.format || "digital")))].sort();
    purchaseTraksEvent = {
      name: "purchase",
      props: {
        format_mix: formats.join("+") || "digital",
        has_printed: formats.some((f) => f === "printed" || f === "giftset") ? "yes" : "no",
      },
      value: Math.round(Number(latest.amount || 0)) / 100,
      onceKey: String(latest.id || ""),
    };
  }
}
---
<!doctype html>
<html lang="en">
<head>
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#1a3454" />
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Your library · Big Brain Shelf</title>
    <ClientRouter />
  <TransitionHooks />
  <Tracking pageEvent={purchaseEvent} traksEvent={purchaseTraksEvent} />
</head>
<body class="bg-white text-stone-900 antialiased pb-28">
  <CustomerShell
    currentSection="shelf"
    userEmail={String(session.user.email || "")}
    username={session.user.displayUsername || session.user.username}
    displayName={parentOnboarding?.parent_name || session.user.name}
    isAdmin={session.user.isAdmin}
    kidProfiles={kidProfiles}
    hasParentPin={Boolean(parentOnboarding?.parent_pin)}
    bookCount={books.length}
    audioCount={audioBooksCount}
  />

  <main class="max-w-6xl mx-auto px-4 py-8 sm:py-10">
    {showSuccess && (
      <div class="mb-8 rounded-lg bg-green-50 border border-green-200 px-4 py-3 text-sm text-green-800">
        Payment complete. Your books are below, ready to download.
      </div>
    )}
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div>
        <div class="flex flex-wrap items-center gap-2">
          <h1 class="text-2xl font-bold tracking-tight">Your library</h1>
          {(session.user.displayUsername || session.user.username) && (
            <span class="rounded-full bg-orange-100 text-orange-800 px-2.5 py-0.5 text-xs font-extrabold">
              @{session.user.displayUsername || session.user.username}
            </span>
          )}
          {session.user.isAdmin && (
            <span class="rounded-full bg-[#1a3454] text-white px-2.5 py-0.5 text-[11px] font-extrabold uppercase tracking-wider">
              Admin Preview
            </span>
          )}
        </div>
        <p class="text-sm text-stone-500 mt-1">{session.user.email}</p>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        {session.user.isAdmin && (
          <a href="/admin" class="rounded-full border border-[#1a3454] bg-white text-[#1a3454] px-4 py-2 text-xs font-extrabold hover:bg-stone-50">
            Admin Dashboard →
          </a>
        )}
        <a href="#qc-viewer" class="rounded-full bg-[#1a3454] text-white px-4 py-2 text-xs font-bold hover:bg-[#132741]">
          Open Book Viewer (QC)
        </a>
        <a href="#audio-slot" class="rounded-full bg-orange-600 text-white px-4 py-2 text-xs font-bold hover:bg-orange-700">
          Audiobook Player · 60m Sleep Timer
        </a>
        <a href="#kids-family" data-parent-only="true" class="rounded-full border border-stone-300 bg-white px-4 py-2 text-xs font-bold text-stone-700 hover:border-stone-500">
          Kids &amp; Limits ({kidProfiles.length})
        </a>
      </div>
    </div>

    {/* Parent & Kid Onboarding Card (Endowed Progress starts at 25%) */}
    {!onboardingChecklist.isComplete && (
      <section
        id="onboarding-card"
        data-parent-only="true"
        class="mt-6 rounded-2xl border-2 border-orange-200 bg-orange-50/50 p-5 sm:p-6"
        aria-labelledby="onboarding-heading"
      >
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div>
            <span class="rounded-full bg-orange-600 text-white px-2.5 py-0.5 text-[11px] font-extrabold uppercase tracking-wider">
              Quick Family Setup · {onboardingChecklist.percent}% Complete
            </span>
            <h2 id="onboarding-heading" class="text-lg font-extrabold tracking-tight text-stone-900 mt-1">
              Set up your child's reader profile &amp; bedtime timer
            </h2>
            <p class="text-xs text-stone-600 mt-0.5">
              Built for kids ages 4–8 (and growing up to 18): create a reader profile, choose a sleep timer limit, and sync your digital books with the audiobook player.
            </p>
          </div>
          <div class="w-full sm:w-48">
            <div class="h-2.5 rounded-full bg-orange-200/70 overflow-hidden">
              <div
                id="onboarding-progress-bar"
                class="h-full bg-orange-600 rounded-full transition-all"
                style={`width: ${onboardingChecklist.percent}%`}
              ></div>
            </div>
            <p class="text-[11px] font-bold text-orange-800 mt-1 text-right">
              {onboardingChecklist.steps.filter((s) => s.done).length} of {onboardingChecklist.steps.length} steps ready
            </p>
          </div>
        </div>

        <form id="family-onboarding-form" class="mt-4 bg-white rounded-xl border border-orange-200/80 p-4 sm:p-5 space-y-5">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div>
              <label class="block text-xs font-bold text-stone-700">
                Parent / Guardian Name
                <input
                  type="text"
                  name="parent_name"
                  value={parentOnboarding?.parent_name || ""}
                  placeholder="e.g., Alex"
                  class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2 text-sm font-medium"
                />
              </label>

              {/* Username (@handle) or Email Sign-in Choice + Live Availability Checker */}
              <div class="mt-3 rounded-lg border border-stone-200 bg-stone-50/80 p-2.5">
                <div class="flex items-center justify-between gap-2">
                  <span class="text-xs font-extrabold text-stone-800">Username or Email</span>
                  <span id="onboarding-username-status" class="text-[11px] font-bold text-stone-500" role="status">
                    {session.user.displayUsername || session.user.username
                      ? `✓ @${session.user.displayUsername || session.user.username}`
                      : "Optional"}
                  </span>
                </div>
                <div class="mt-1.5 flex items-center gap-3 text-[11px] font-semibold text-stone-700">
                  <label class="inline-flex items-center gap-1 cursor-pointer">
                    <input
                      type="radio"
                      name="login_identity_mode"
                      value="username"
                      checked={Boolean(session.user.username)}
                      id="identity-mode-username"
                      class="accent-orange-600"
                    />
                    <span>Set a @username</span>
                  </label>
                  <label class="inline-flex items-center gap-1 cursor-pointer">
                    <input
                      type="radio"
                      name="login_identity_mode"
                      value="email"
                      checked={!session.user.username}
                      id="identity-mode-email"
                      class="accent-orange-600"
                    />
                    <span>Use my email</span>
                  </label>
                </div>
                <div id="onboarding-username-box" class="mt-2 flex items-center gap-1.5">
                  <div class="relative flex-1 flex items-center">
                    <span class="absolute left-2.5 text-xs font-bold text-stone-400 select-none">@</span>
                    <input
                      type="text"
                      id="onboarding-username-input"
                      name="username"
                      minlength="3"
                      maxlength="30"
                      pattern="[a-zA-Z0-9_.]*"
                      value={session.user.displayUsername || session.user.username || ""}
                      placeholder="alex_family"
                      class="w-full rounded-lg border border-stone-300 bg-white pl-6 pr-2.5 py-1.5 text-xs font-semibold"
                    />
                  </div>
                  <button
                    type="button"
                    id="onboarding-username-check-btn"
                    class="shrink-0 rounded-lg border border-stone-300 bg-white px-2.5 py-1.5 text-[11px] font-extrabold text-stone-700 hover:border-stone-500"
                  >
                    Check
                  </button>
                </div>
                <p class="text-[10px] text-stone-500 mt-1">
                  Sign in with your @username or {session.user.email}.
                </p>
              </div>
              <label class="block text-xs font-bold text-stone-700 mt-3">
                Optional 4-Digit Parent PIN
                <input
                  type="password"
                  name="parent_pin"
                  inputmode="numeric"
                  maxlength="6"
                  placeholder="e.g., 1234"
                  class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2 text-sm font-medium"
                />
              </label>
              <label class="block text-xs font-bold text-stone-700 mt-3">
                How did you find Big Brain Shelf?
                <select
                  name="discovery_source"
                  class="mt-1 w-full rounded-lg border border-stone-300 px-2.5 py-2 text-sm font-semibold bg-white"
                >
                  <option value="">Choose one (optional)</option>
                  {DISCOVERY_SOURCE_OPTIONS.map((opt) => (
                    <option value={opt.id} selected={parentOnboarding?.discovery_source === opt.id}>
                      {opt.label}
                    </option>
                  ))}
                </select>
              </label>
            </div>

            <div>
              <label class="block text-xs font-bold text-stone-700">
                First Child's Name
                <input
                  type="text"
                  name="kid_name"
                  value={defaultKidProfile?.name || ""}
                  placeholder="e.g., Maya"
                  required
                  class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2 text-sm font-medium"
                />
              </label>
              <label class="block text-xs font-bold text-stone-700 mt-3">
                Child's Birthday (for their annual Birthday Gift email 🎂)
                <input
                  type="date"
                  name="kid_birth_date"
                  value={defaultKidProfile?.birth_date || ""}
                  class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2 text-sm font-medium"
                />
              </label>
              <div class="grid grid-cols-2 gap-2 mt-3">
                <label class="block text-xs font-bold text-stone-700">
                  Age Group
                  <select
                    name="kid_age_group"
                    class="mt-1 w-full rounded-lg border border-stone-300 px-2.5 py-2 text-sm font-semibold bg-white"
                  >
                    <option value="4-8" selected={!defaultKidProfile || defaultKidProfile.age_group === "4-8"}>Ages 4–8</option>
                    <option value="9-12" selected={defaultKidProfile?.age_group === "9-12"}>Ages 9–12</option>
                    <option value="13-18" selected={defaultKidProfile?.age_group === "13-18"}>Ages 13–18</option>
                  </select>
                </label>
                <label class="block text-xs font-bold text-stone-700">
                  Character Buddy
                  <select
                    name="kid_avatar"
                    class="mt-1 w-full rounded-lg border border-stone-300 px-2.5 py-2 text-sm font-semibold bg-white"
                  >
                    {KID_AVATARS.map((av) => (
                      <option value={av.id} selected={defaultKidProfile?.avatar_key === av.id}>
                        {av.emoji} {av.name}
                      </option>
                    ))}
                  </select>
                </label>
              </div>
            </div>

            <div class="flex flex-col justify-between">
              <div class="grid grid-cols-2 gap-2">
                <label class="block text-xs font-bold text-stone-700">
                  Sleep Timer Stop
                  <select
                    name="kid_sleep_timer"
                    class="mt-1 w-full rounded-lg border border-stone-300 px-2.5 py-2 text-sm font-semibold bg-white"
                  >
                    {SLEEP_TIMER_PRESETS.map((p) => (
                      <option value={p.minutes} selected={p.minutes === 60}>
                        {p.label}
                      </option>
