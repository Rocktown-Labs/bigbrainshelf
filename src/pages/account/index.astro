---
// /account is the family dashboard (CG, 2026-11-01): Welcome, stat
// cards, action buttons, a shelf preview, and a View all that goes to
// the library (/account/library), which is its own page. The reader
// never lives here; books open their overview page, and the overview
// opens the reader.
import "../../styles/global.css";
import { env } from "cloudflare:workers";
import Tracking from "../../components/Tracking.astro";
import { ClientRouter } from "astro:transitions";
import TransitionHooks from "../../components/TransitionHooks.astro";
import { parseItems } from "../../lib/orders";
import { publicSlugFor } from "../../lib/public-slugs";
import { coverDerivative } from "../../lib/derivatives";
import { ensureClubTable, clubPlanOf, getClubSignupForUser } from "../../lib/club";
import { getNextClubBox } from "../../lib/club-cycles";
import { formatClubDate } from "../../lib/club-cycle-dates";
import CustomerShell from "../../components/CustomerShell.astro";
import { loadCustomerHubContext } from "../../lib/account-data";

const e = env as any;
const hub = await loadCustomerHubContext(Astro.request, Astro.locals, e.DB, Astro.url.origin);
if (!hub) {
  return Astro.redirect("/login?next=/account");
}

const {
  session,
  books,
  audioBooksCount,
  parentOnboarding,
  kidProfiles,
  readingProgressList,
  onboardingChecklist,
} = hub;

const R2 = "https://media.bigbrainshelf.com/";
const firstName =
  String(parentOnboarding?.parent_name || session.user.name || "").trim().split(/\s+/)[0] ||
  String(session.user.email || "").split("@")[0];
const ownedCount = (books as any[]).filter((b: any) => b.owned).length;

// Continue reading: the furthest-along unfinished book.
const inProgress = (books as any[])
  .map((b: any) => {
    const prog = readingProgressList.find((p) => p.book_slug === b.slug);
    const pct =
      prog && prog.total_pages > 0
        ? Math.min(100, Math.round((prog.current_page / prog.total_pages) * 100))
        : 0;
    return { b, prog, pct };
  })
  .filter((x) => x.pct > 0 && x.pct < 100)
  .sort((a, b) => b.pct - a.pct)[0];

// Club state for the stat card + club panel.
let clubSignup: any = null;
let nextBox: any = null;
try {
  await ensureClubTable(e.DB);
  // SECURITY (F1): member match by user_id first, by email only for a
  // verified session, so registering someone else's address never
  // shows their membership, plan, or next box on the dashboard.
  clubSignup = await getClubSignupForUser(e.DB, {
    id: String(session.user.id),
    email: String(session.user.email || ""),
    emailVerified: session.user.emailVerified === true,
  });
  if (clubSignup && clubSignup.status === "paid" && clubPlanOf(clubSignup) === "physical") {
    nextBox = await getNextClubBox(e.DB, clubSignup.id);
  }
} catch { /* the dashboard renders fine without club state */ }
const clubIsMember = Boolean(clubSignup && clubSignup.status === "paid");
const clubLabel = !clubSignup
  ? "No club yet"
  : clubIsMember
    ? clubPlanOf(clubSignup) === "physical"
      ? "The Book Club"
      : "The Audio Club"
    : "Signup started";

// Shelf preview: the first board only (4 books).
const previewCards = (books as any[]).slice(0, 4).map((b: any) => {
  const prog = readingProgressList.find((p) => p.book_slug === b.slug);
  const pct =
    prog && prog.total_pages > 0
      ? Math.min(100, Math.round((prog.current_page / prog.total_pages) * 100))
      : 0;
  return {
    b,
    cover: coverDerivative(b.slug, "card", b.cover_key) || (b.cover_key ? R2 + b.cover_key : null),
    href: `/account/book/${publicSlugFor(b)}`,
    audioOnly: Boolean(b.audioOnly),
    owned: Boolean(b.owned),
    pct,
  };
});

const showSuccess = Astro.url.searchParams.get("checkout") === "success";
let purchaseEvent: { name: string; data: Record<string, unknown> } | null = null;
let purchaseTraksEvent: { name: string; props: Record<string, string>; value: number; onceKey: string } | null = null;
if (showSuccess) {
  const orders = await e.DB.prepare(
    "SELECT * FROM orders WHERE user_id = ? AND status = 'complete' ORDER BY created_at DESC LIMIT 1"
  )
    .bind(session.user.id)
    .all();
  const rows = (orders.rows || orders.results || []) as any[];
  const latest = rows[0];
  if (latest) {
    let ids: string[] = [];
    try {
      ids = JSON.parse(latest.book_slugs || "[]").map(String);
    } catch {}
    purchaseEvent = {
      name: "Purchase",
      data: {
        content_ids: ids,
        content_type: "product",
        num_items: ids.length,
        value: Math.round(Number(latest.amount || 0)) / 100,
        currency: "USD",
      },
    };
    const formats = [...new Set(parseItems(latest).map((i: any) => String(i.format || "digital")))].sort();
    purchaseTraksEvent = {
      name: "purchase",
      props: {
        format_mix: formats.join("+") || "digital",
        has_printed: formats.some((f) => f === "printed" || f === "giftset") ? "yes" : "no",
      },
      value: Math.round(Number(latest.amount || 0)) / 100,
      onceKey: String(latest.id || ""),
    };
  }
}
---
<!doctype html>
<html lang="en">
<head>
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#1a3454" />
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Dashboard · Big Brain Shelf</title>
  <ClientRouter />
  <TransitionHooks />
  <Tracking pageEvent={purchaseEvent} traksEvent={purchaseTraksEvent} />
</head>
<body class="bg-white text-stone-900 antialiased pb-28">
  <CustomerShell
    currentSection="dashboard"
    userEmail={String(session.user.email || "")}
    username={session.user.displayUsername || session.user.username}
    displayName={parentOnboarding?.parent_name || session.user.name}
    isAdmin={session.user.isAdmin}
    kidProfiles={kidProfiles}
    hasParentPin={Boolean(parentOnboarding?.parent_pin)}
    bookCount={books.length}
    audioCount={audioBooksCount}
    onboardingComplete={onboardingChecklist.isComplete}
  />

  <main class="max-w-6xl mx-auto px-4 py-7 sm:py-9">
    {showSuccess && (
      <div class="mb-6 rounded-2xl bg-green-50 border border-green-200 px-4 py-3 text-sm font-semibold text-green-800">
        Payment complete. Your books are in your library, and the newest one is on your shelf below.
      </div>
    )}

    {/* F1 soft gate: unverified password accounts see what they are
        missing (guest orders + email-keyed club rows) and get a
        one-click resend. Magic-link and Google users never see this. */}
    {session.user.emailVerified === false && (
      <div class="mb-6 rounded-2xl bg-orange-50 border border-orange-200 px-4 py-3 text-sm text-orange-900" data-verify-banner="true">
        <strong>Verify your email.</strong> Books bought as a guest with {session.user.email}, and any
        club membership tied to that address, join this library once the address is verified.
        <button
          id="resend-verification"
          type="button"
          data-email={String(session.user.email || "")}
          class="mt-3 rounded-full bg-orange-600 text-white px-4 py-1.5 text-xs font-extrabold hover:bg-orange-700 disabled:opacity-60"
        >
          Resend verification email
        </button>
        <span id="resend-verification-msg" class="block mt-2 text-xs font-semibold"></span>
      </div>
    )}
    {Astro.url.searchParams.get("verified") === "1" && (
      <div class="mb-6 rounded-2xl bg-green-50 border border-green-200 px-4 py-3 text-sm font-semibold text-green-800">
        Your email is verified. Any guest purchases made with this address are on your shelf.
      </div>
    )}

    <div class="flex flex-wrap items-end justify-between gap-3">
      <div>
        <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-stone-900">
          Welcome, {firstName}
        </h1>
        <p class="text-sm text-stone-600 mt-1">
          Here is your family's shelf at a glance.
        </p>
      </div>
      {(session.user.displayUsername || session.user.username) && (
        <span class="rounded-full bg-orange-100 text-orange-800 px-2.5 py-0.5 text-xs font-extrabold">
          @{session.user.displayUsername || session.user.username}
        </span>
      )}
    </div>

    <!-- Action buttons -->
    <div class="mt-5 flex flex-wrap items-center gap-2" data-parent-only="true">
      {inProgress && (
        <a
          href={`/read/${publicSlugFor(inProgress.b)}`}
          class="cust-pressable rounded-full bg-orange-600 px-4 py-2 text-xs font-extrabold text-white hover:bg-orange-700"
        >
          ▶ Continue {inProgress.b.title} ({inProgress.pct}%)
        </a>
      )}
      {nextBox && nextBox.status === "awaiting_selection" && (
        <a
          href="/account/club"
          class="cust-pressable rounded-full bg-[#1a3454] px-4 py-2 text-xs font-extrabold text-white hover:bg-[#132741]"
        >
          📦 Make your picks for the next box
        </a>
      )}
      <a
        href="/books"
        class="cust-pressable rounded-full border border-stone-300 bg-white px-4 py-2 text-xs font-extrabold text-stone-700 hover:border-stone-500"
      >
        Browse New Books →
      </a>
      {!onboardingChecklist.isComplete && (
        <a
          href="/onboarding"
          class="cust-pressable rounded-full border border-orange-300 bg-orange-50 px-4 py-2 text-xs font-extrabold text-orange-800 hover:border-orange-400"
        >
          Finish Family Setup ({onboardingChecklist.percent}%)
        </a>
      )}
    </div>

    <!-- Stat cards -->
    <section class="mt-6 grid grid-cols-2 lg:grid-cols-4 gap-3" aria-label="Your family at a glance">
      <a href="/account/library" class="rounded-2xl border border-stone-200 bg-[#fcfaf6] p-4 hover:border-stone-300 transition block">
        <p class="text-[11px] font-extrabold uppercase tracking-wider text-stone-500">Books on your shelf</p>
        <p class="text-3xl font-extrabold text-stone-900 mt-1">{books.length}</p>
        <p class="text-xs text-stone-500 mt-0.5">{ownedCount} owned · {books.length - ownedCount} with the club</p>
      </a>
      <a href="/account/library" class="rounded-2xl border border-stone-200 bg-[#fcfaf6] p-4 hover:border-stone-300 transition block">
        <p class="text-[11px] font-extrabold uppercase tracking-wider text-stone-500">Audiobooks</p>
        <p class="text-3xl font-extrabold text-stone-900 mt-1">{audioBooksCount}</p>
        <p class="text-xs text-stone-500 mt-0.5">Ready to listen, bedtime included</p>
      </a>
      <a href="/account/club" class="rounded-2xl border border-stone-200 bg-[#fcfaf6] p-4 hover:border-stone-300 transition block" data-parent-only="true">
        <p class="text-[11px] font-extrabold uppercase tracking-wider text-stone-500">Club</p>
        <p class="text-lg font-extrabold text-stone-900 mt-1.5 leading-snug">{clubLabel}</p>
        <p class="text-xs text-stone-500 mt-0.5">
          {nextBox
            ? `Next box ships ${formatClubDate(String(nextBox.ship_date))}`
            : clubIsMember
              ? "Membership active"
              : "Printed boxes or the listening shelf"}
        </p>
      </a>
      <a href="/account/kids" class="rounded-2xl border border-stone-200 bg-[#fcfaf6] p-4 hover:border-stone-300 transition block" data-parent-only="true">
        <p class="text-[11px] font-extrabold uppercase tracking-wider text-stone-500">Readers</p>
        <p class="text-3xl font-extrabold text-stone-900 mt-1">{kidProfiles.length}</p>
        <p class="text-xs text-stone-500 mt-0.5">
          {kidProfiles.length === 0 ? "Add a child profile for Kid View" : "Child profiles with limits and timers"}
        </p>
      </a>
    </section>

    <!-- Continue reading -->
    {inProgress && (
      <section class="mt-6 rounded-3xl border border-orange-200 bg-orange-50/60 p-5 flex flex-wrap items-center gap-4" aria-label="Continue reading">
        {inProgress.b.cover_key && (
          <img
            src={coverDerivative(inProgress.b.slug, "card", inProgress.b.cover_key) || R2 + inProgress.b.cover_key}
            alt=""
            width="72"
            height="72"
            class="w-[72px] h-[72px] rounded-xl object-cover border border-orange-200"
          />
        )}
        <div class="min-w-0 flex-1">
          <p class="text-[11px] font-extrabold uppercase tracking-wider text-orange-700">Continue reading</p>
          <h2 class="text-base sm:text-lg font-extrabold text-stone-900 truncate">{inProgress.b.title}</h2>
          <div class="mt-2 max-w-sm">
            <div class="h-1.5 rounded-full bg-white overflow-hidden border border-orange-100">
              <div class="h-full bg-orange-500 rounded-full" style={`width:${inProgress.pct}%`}></div>
            </div>
            <p class="text-[11px] font-bold text-stone-500 mt-1">Page {inProgress.prog?.current_page} of {inProgress.prog?.total_pages} · {inProgress.pct}%</p>
          </div>
        </div>
        <a
          href={`/read/${publicSlugFor(inProgress.b)}`}
          class="cust-pressable rounded-full bg-orange-600 px-5 py-2.5 text-sm font-extrabold text-white hover:bg-orange-700"
        >
          Keep reading →
        </a>
      </section>
    )}

    <!-- Shelf preview -->
    <section class="mt-8" aria-label="From your shelf">
      <div class="flex items-baseline justify-between gap-3">
        <h2 class="text-lg font-extrabold tracking-tight text-stone-900">From your shelf</h2>
        <a href="/account/library" class="text-xs font-extrabold text-orange-700 hover:underline">View all →</a>
      </div>
      {books.length === 0 ? (
        <div class="mt-3 rounded-3xl border border-stone-200 bg-[#fcfaf6] p-6">
          <h3 class="text-base font-extrabold text-stone-900">Your family shelf is ready for its first story</h3>
          <p class="text-sm text-stone-600 mt-1 max-w-xl leading-relaxed">
            When you add a book, it appears here with its read-along, audiobook, and coloring pages.
          </p>
          <div class="mt-4 flex flex-wrap gap-2" data-parent-only="true">
            <a href="/books" class="cust-pressable rounded-full bg-orange-600 px-4 py-2 text-xs font-extrabold text-white hover:bg-orange-700">
              Explore Digital Bundles ($8.99) →
            </a>
            <a href="/clubs" class="cust-pressable rounded-full border border-stone-300 bg-white px-4 py-2 text-xs font-extrabold text-stone-800 hover:border-stone-500">
              See the Clubs →
            </a>
          </div>
        </div>
      ) : (
        <div class="shelf-board mt-3">
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 px-1">
            {previewCards.map((c) => (
              <a href={c.href} class="shelf-card group block" data-book-card-slug={c.b.slug}>
                <div
                  class="aspect-[3/4] rounded-xl bg-stone-100 overflow-hidden border border-stone-200 relative shadow-sm"
                  transition:name={`book-cover-${c.b.slug}`}
                >
                  {c.cover && (
                    <img
                      src={c.cover}
                      alt={c.b.title}
                      width="300"
                      height="400"
                      loading="lazy"
                      decoding="async"
                      class="w-full h-full object-cover group-hover:scale-[1.02] transition duration-200"
                    />
                  )}
                </div>
                <h3 class="font-extrabold text-xs sm:text-sm leading-snug text-stone-900 line-clamp-2 mt-2">{c.b.title}</h3>
                <p class="text-[11px] text-stone-500 mt-0.5">{c.b.topic}{c.audioOnly && <span class="font-bold text-stone-600"> · 🎧 Audio</span>}{!c.owned && <span class="font-bold text-[#1a3454]"> · Club</span>}</p>
                {c.pct > 0 && (
                  <div class="mt-1.5">
                    <div class="h-1 rounded-full bg-stone-200 overflow-hidden">
                      <div class="h-full bg-orange-500 rounded-full" style={`width:${c.pct}%`}></div>
                    </div>
                    <p class="text-[10px] font-bold text-stone-500 mt-0.5">{c.pct}% read</p>
                  </div>
                )}
              </a>
            ))}
          </div>
          <div class="shelf-plank" aria-hidden="true"></div>
        </div>
      )}
    </section>

    <p class="text-[11px] text-stone-400 mt-8">For your family's personal use.</p>
  </main>

  <style is:global>
    .shelf-plank {
      height: 0.65rem;
      margin-top: 0.55rem;
      border-radius: 0.3rem;
      background: linear-gradient(180deg, #b08954 0%, #8a6844 55%, #6f5133 100%);
      box-shadow: 0 10px 14px -8px rgba(90, 62, 27, 0.55), inset 0 1px 0 rgba(255, 235, 200, 0.5);
    }
  </style>
  <script is:inline>
    (function () {
      function initDashboard() {
        // F1 soft gate: resend the email-verification link for the
        // signed-in address (better-auth send-verification-email is
        // session-gated and verifies the body email against it).
        var resendBtn = document.getElementById("resend-verification");
        if (resendBtn && !resendBtn.dataset.bound) {
          resendBtn.dataset.bound = "1";
          resendBtn.addEventListener("click", async function () {
            var msg = document.getElementById("resend-verification-msg");
            var email = resendBtn.getAttribute("data-email") || "";
            resendBtn.disabled = true;
            msg.textContent = "Sending…";
            msg.className = "block mt-2 text-xs font-semibold text-stone-600";
            try {
              var r = await fetch("/api/auth/send-verification-email", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ email: email, callbackURL: "/account?verified=1" }),
              });
              var d = await r.json().catch(function () { return {}; });
              if (!r.ok) throw new Error(d.message || "Could not send the email right now.");
              msg.textContent = "Verification email sent. Check your inbox.";
              msg.className = "block mt-2 text-xs font-semibold text-green-700";
            } catch (ex) {
              msg.textContent = (ex && ex.message) || "Could not send the email right now.";
              msg.className = "block mt-2 text-xs font-semibold text-red-600";
              resendBtn.disabled = false;
            }
          });
        }
      }

      initDashboard();
      document.addEventListener("astro:page-load", initDashboard);
    })();
  </script>
</body>
</html>
