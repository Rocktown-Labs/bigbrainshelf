  </main>

  <script is:inline>
    // Audiobook-only unlock: starts a checkout for just the digital
    // format of that book. The server recomputes the price from the
    // account's entitlements (digital price minus the audio credit);
    // the amount printed on the button is only the display copy.
    // Bind-once per button, like the other account scripts.
    function initUnlock() {
      document.querySelectorAll(".unlock-digital").forEach(function (btn) {
        if (btn.__unlockBound) return;
        btn.__unlockBound = true;
        btn.addEventListener("click", async function () {
          var card = btn.closest("div");
          var msg = card ? card.querySelector(".unlock-msg") : null;
          btn.disabled = true;
          if (msg) { msg.classList.remove("hidden"); msg.textContent = "Taking you to checkout..."; }
          try {
            var r = await fetch("/api/checkout", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ items: [{ slug: btn.getAttribute("data-slug"), format: "digital" }] }),
            });
            var data = await r.json().catch(function () { return {}; });
            if (!r.ok || !data.url) throw new Error(data.error || "Checkout failed.");
            window.location.href = data.url;
          } catch (err) {
            if (msg) msg.textContent = err.message;
            btn.disabled = false;
          }
        });
      });
    }
    initUnlock();
    document.addEventListener("astro:page-load", initUnlock);
  </script>
  <script is:inline>
    // Sign-out wiring. Runs on first render and again on
    // astro:page-load so the button works after view-transition
    // navigations; the flag keeps it from binding twice.
    function initSignout() {
      var btn = document.getElementById("signout");
      if (!btn || btn.__signoutBound) return;
      btn.__signoutBound = true;
      btn.addEventListener("click", async function () {
        await fetch("/api/auth/sign-out", { method: "POST", headers: { "Content-Type": "application/json" }, body: "{}" });
        await fetch("/api/admin-auth/logout", { method: "POST" }).catch(function () {});
        window.location.href = "/";
      });
    }
    initSignout();
    document.addEventListener("astro:page-load", initSignout);
  </script>
  <script is:inline>
    // Book Club book choice. Bind-once like the sign-out wiring, so the
    // form works after view-transition navigations too.
    function initClubPick() {
      var form = document.getElementById("club-pick-form");
      if (!form || form.__clubPickBound) return;
      form.__clubPickBound = true;
      var repeat = document.getElementById("club-allow-repeat");
      var msg = document.getElementById("club-pick-msg");
      function syncBlocked() {
        var on = !!(repeat && repeat.checked);
        form.querySelectorAll("input[data-blocked='1']").forEach(function (r) {
          if (!r.checked) r.disabled = !on;
        });
      }
      if (repeat) repeat.addEventListener("change", syncBlocked);
      syncBlocked();
      form.addEventListener("submit", async function (ev) {
        ev.preventDefault();
        var sel = form.querySelector("input[name='club-pick']:checked");
        var sel2 = form.querySelector("input[name='club-pick-2']:checked");
        msg.textContent = "Saving...";
        try {
          var r = await fetch("/api/club/selection", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              ship_date: form.getAttribute("data-ship-date"),
              selection: sel ? sel.value : "surprise",
              selection_2: sel2 ? sel2.value : "surprise",
              allow_repeat: !!(repeat && repeat.checked),
            }),
          });
          var data = await r.json().catch(function () { return {}; });
          if (!r.ok) {
            msg.textContent = data.error || "Could not save your pick.";
            return;
          }
          msg.textContent = "Saved.";
          window.location.reload();
        } catch (err) {
          msg.textContent = "Could not save your pick. Please try again.";
        }
      });
    }
    initClubPick();
    document.addEventListener("astro:page-load", initClubPick);
  </script>
  <script is:inline>
    function initFamilyAndProfiles() {
      // Quick "QC Viewer" buttons on shelf cards
      document.querySelectorAll("[data-open-qc-book]").forEach(function (btn) {
        if (btn.__qcBound) return;
        btn.__qcBound = true;
        btn.addEventListener("click", function () {
          var slug = btn.getAttribute("data-open-qc-book");
          if (window.bbsCustomerHub && slug) {
            window.bbsCustomerHub.openBookInViewer(slug, "story");
          }
        });
      });

      // Family Onboarding Form + Live Username Availability Checker
      var obUsernameInput = document.getElementById("onboarding-username-input");
      var obUsernameCheckBtn = document.getElementById("onboarding-username-check-btn");
      var obUsernameStatus = document.getElementById("onboarding-username-status");
      var modeUsernameRadio = document.getElementById("identity-mode-username");
      var modeEmailRadio = document.getElementById("identity-mode-email");
      var obUsernameTimer = null;

      async function runOnboardingUsernameCheck(rawVal) {
        if (!obUsernameStatus) return true;
        var clean = String(rawVal || "").trim().replace(/^@+/, "");
        if (!clean) {
          obUsernameStatus.textContent = "Using email";
          obUsernameStatus.className = "text-[11px] font-bold text-stone-500";
          return true;
        }
        if (clean.length < 3 || clean.length > 30 || !/^[a-zA-Z0-9_.]+$/.test(clean)) {
          obUsernameStatus.textContent = "3–30 letters, numbers, _ or .";
          obUsernameStatus.className = "text-[11px] font-bold text-amber-700";
          return false;
        }
        obUsernameStatus.textContent = "Checking...";
        obUsernameStatus.className = "text-[11px] font-bold text-stone-500";
        try {
          var r = await fetch("/api/auth/is-username-available", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ username: clean }),
          });
          var d = await r.json().catch(function () { return null; });
          if (!r.ok || !d || typeof d.available !== "boolean") {
            var rFallback = await fetch("/api/account/me", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ action: "check_username", username: clean }),
            });
            d = await rFallback.json().catch(function () { return {}; });
          }
          if (d && d.available) {
            obUsernameStatus.textContent = "✓ @" + clean.toLowerCase() + " available";
            obUsernameStatus.className = "text-[11px] font-bold text-green-700";
            return true;
          } else {
            obUsernameStatus.textContent = "✗ Already taken";
            obUsernameStatus.className = "text-[11px] font-bold text-red-600";
            return false;
          }
        } catch {
          obUsernameStatus.textContent = "Could not check";
          return false;
        }
      }

      if (obUsernameInput && !obUsernameInput.__bound) {
        obUsernameInput.__bound = true;
        obUsernameInput.addEventListener("input", function () {
          if (modeUsernameRadio && obUsernameInput.value.trim()) {
            modeUsernameRadio.checked = true;
          }
          if (obUsernameTimer) clearTimeout(obUsernameTimer);
          obUsernameTimer = setTimeout(function () {
            runOnboardingUsernameCheck(obUsernameInput.value);
          }, 250);
        });
      }
      if (obUsernameCheckBtn && obUsernameInput && !obUsernameCheckBtn.__bound) {
        obUsernameCheckBtn.__bound = true;
        obUsernameCheckBtn.addEventListener("click", function () {
          runOnboardingUsernameCheck(obUsernameInput.value);
        });
      }
      if (modeEmailRadio && obUsernameInput && !modeEmailRadio.__bound) {
        modeEmailRadio.__bound = true;
        modeEmailRadio.addEventListener("change", function () {
          if (modeEmailRadio.checked) {
            obUsernameInput.value = "";
            if (obUsernameStatus) {
              obUsernameStatus.textContent = "Using email";
              obUsernameStatus.className = "text-[11px] font-bold text-stone-500";
            }
          }
        });
      }

      var obForm = document.getElementById("family-onboarding-form");
      if (obForm && !obForm.__bound) {
        obForm.__bound = true;
        obForm.addEventListener("submit", async function (ev) {
          ev.preventDefault();
          var msg = document.getElementById("onboarding-save-msg");
          if (msg) msg.textContent = "Saving family setup...";
          var fd = new FormData(obForm);
          var ageGroup = String(fd.get("kid_age_group") || "4-8");
          var ageNum = ageGroup === "4-8" ? 6 : ageGroup === "9-12" ? 10 : 14;
          var favTopics = fd.getAll("favorite_topics").map(String);
          var futTopics = fd.getAll("future_topics").map(String);
          var birthDate = String(fd.get("kid_birth_date") || "").trim();
          var tosAccepted = fd.get("tos_accepted") === "1";
          var marketingOptIn = fd.get("marketing_opt_in") === "1";
          var identityMode = String(fd.get("login_identity_mode") || "email");
          var rawUsername = identityMode === "email"
            ? ""
            : String(fd.get("username") || "").trim().replace(/^@+/, "");

          if (rawUsername) {
            try {
              await fetch("/api/auth/update-user", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                  username: rawUsername.toLowerCase(),
                  displayUsername: rawUsername,
                }),
              });
            } catch {}
          }

          try {
            var r = await fetch("/api/account/family", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({
                action: "save_onboarding",
                parent_name: fd.get("parent_name"),
                username: rawUsername || undefined,
                parent_pin: fd.get("parent_pin"),
                reading_goal: fd.get("reading_goal") || "bedtime",
                discovery_source: fd.get("discovery_source") || "",
                favorite_topics: favTopics,
                future_topics: futTopics,
                custom_topic_request: fd.get("custom_topic_request") || "",
                tos_accepted: tosAccepted,
                marketing_opt_in: marketingOptIn,
                mark_complete: true,
                kid_profile: {
                  name: fd.get("kid_name"),
                  birth_date: birthDate || null,
                  age: ageNum,
                  age_group: ageGroup,
                  avatar_key: fd.get("kid_avatar") || "mira",
                  favorite_topics: favTopics,
                  default_sleep_timer_minutes: Number(fd.get("kid_sleep_timer") ?? 60),
                  daily_limit_minutes: Number(fd.get("kid_daily_limit") ?? 60),
                },
              }),
            });
            var respData = await r.json().catch(function () { return {}; });
            if (r.ok) {
              try {
                if (typeof window.bbsTraks === "function") {
                  window.bbsTraks("onboarding_step_completed", {
                    age_group: ageGroup,
                    topics_count: favTopics.length,
                    future_topics_count: futTopics.length,
                    has_birth_date: Boolean(birthDate),
                    has_username: Boolean(rawUsername),
                    marketing_opt_in: marketingOptIn,
                  });
                }
              } catch {}
              if (msg) msg.textContent = "Family shelf ready! Reloading...";
              window.location.reload();
            } else {
              if (msg) msg.textContent = respData.error || "Could not save setup. Please try again.";
            }
          } catch (e) {
            if (msg) msg.textContent = "Network error saving setup.";
          }
        });
      }

      // Add Child Profile Toggle & Form
      var toggleAddBtn = document.getElementById("toggle-add-kid-btn");
      var addKidForm = document.getElementById("add-kid-profile-form");
      if (toggleAddBtn && addKidForm && !toggleAddBtn.__bound) {
        toggleAddBtn.__bound = true;
        toggleAddBtn.addEventListener("click", function () {
          addKidForm.classList.toggle("hidden");
        });
      }
      if (addKidForm && !addKidForm.__bound) {
        addKidForm.__bound = true;
        addKidForm.addEventListener("submit", async function (ev) {
          ev.preventDefault();
          var msg = document.getElementById("add-kid-msg");
          if (msg) msg.textContent = "Saving...";
          var fd = new FormData(addKidForm);
          var ageGroup = String(fd.get("age_group") || "4-8");
          var ageNum = ageGroup === "4-8" ? 6 : ageGroup === "9-12" ? 10 : 14;
          var r = await fetch("/api/account/family", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              action: "upsert_kid",
              profile: {
                name: fd.get("name"),
                birth_date: String(fd.get("birth_date") || "").trim() || null,
                age: ageNum,
                age_group: ageGroup,
                avatar_key: fd.get("avatar_key") || "mira",
                default_sleep_timer_minutes: Number(fd.get("default_sleep_timer_minutes") ?? 60),
                daily_limit_minutes: Number(fd.get("daily_limit_minutes") ?? 60),
              },
            }),
          });
          if (r.ok) {
            window.location.reload();
          } else {
            if (msg) msg.textContent = "Could not save profile.";
          }
        });
      }

      // Send Birthday Gift Email buttons
      document.querySelectorAll("[data-send-birthday-gift]").forEach(function (btn) {
        if (btn.__bound) return;
        btn.__bound = true;
        btn.addEventListener("click", async function () {
          var kidId = btn.getAttribute("data-send-birthday-gift");
          if (!kidId) return;
          var orig = btn.textContent;
          btn.textContent = "Sending 🎂...";
          try {
            var r = await fetch("/api/account/family", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ action: "send_birthday_gift", kid_id: kidId }),
            });
            if (r.ok) {
              btn.textContent = "🎂 Gift Queued!";
              try {
                if (typeof window.bbsTraks === "function") {
                  window.bbsTraks("birthday_gift_requested", { kid_id: kidId });
                }
              } catch {}
            } else {
              btn.textContent = orig;
            }
          } catch {
            btn.textContent = orig;
          }
        });
      });

      // Copy Family Referral Link
      var copyRefBtn = document.getElementById("copy-referral-btn");
      var copyRefMsg = document.getElementById("referral-copy-msg");
      if (copyRefBtn && !copyRefBtn.__bound) {
        copyRefBtn.__bound = true;
        copyRefBtn.addEventListener("click", async function () {
          var url = copyRefBtn.getAttribute("data-referral-url") || "";
          var code = copyRefBtn.getAttribute("data-referral-code") || "";
          try {
            await navigator.clipboard.writeText(url);
            if (copyRefMsg) {
              copyRefMsg.textContent = "Copied your family link! Share it with a friend for $10 / $10.";
              copyRefMsg.classList.remove("hidden");
            }
            if (typeof window.bbsTraks === "function") {
              window.bbsTraks("referral_link_shared", { channel: "clipboard", code: code });
            }
          } catch {}
        });
      }

      // Remove Kid Profile buttons
      document.querySelectorAll("[data-delete-kid-profile]").forEach(function (btn) {
        if (btn.__bound) return;
        btn.__bound = true;
        btn.addEventListener("click", async function () {
          var id = btn.getAttribute("data-delete-kid-profile");
          if (!id) return;
          var r = await fetch("/api/account/family?id=" + encodeURIComponent(id), { method: "DELETE" });
          if (r.ok) window.location.reload();
        });
      });

      // Switch between Parent View and Kid View (with Parent PIN gate when exiting Kid View)
      var profileSelect = document.getElementById("active-profile-select");
      var switcherBox = document.getElementById("sidebar-profile-switcher");
      var avatarBadge = document.getElementById("active-profile-avatar");
      var limitPill = document.getElementById("active-kid-limit-pill");
      var limitText = document.getElementById("active-kid-limit-text");
      var mobileBadge = document.getElementById("mobile-active-mode-badge");
      var pinModal = document.getElementById("parent-pin-modal");
      var pinForm = document.getElementById("parent-pin-form");
      var pinInput = document.getElementById("parent-pin-input");
      var pinError = document.getElementById("parent-pin-error");
      var pinCancel = document.getElementById("parent-pin-cancel");
      var exitKidBtn = document.getElementById("exit-kid-mode-btn");
      var limitUnlockBtn = document.getElementById("audio-limit-unlock-btn");

      var currentActiveProfile = "parent";

      function applyProfileSelection(val) {
        currentActiveProfile = val;
        if (profileSelect && profileSelect.value !== val) {
          profileSelect.value = val;
        }
        if (val === "parent") {
          document.documentElement.removeAttribute("data-kid-mode");
          if (avatarBadge) avatarBadge.textContent = "👨‍👩‍👧";
          if (limitPill) limitPill.classList.add("hidden");
          if (mobileBadge) mobileBadge.textContent = "Family Hub";
          if (window.bbsCustomerHub) window.bbsCustomerHub.setProfile("default", 60);
        } else if (profileSelect) {
          var opt = profileSelect.querySelector('option[value="' + val + '"]');
          var emoji = (opt && opt.getAttribute("data-emoji")) || "🦊";
          var name = (opt && opt.getAttribute("data-name")) || "Kid";
          var sleep = Number((opt && opt.getAttribute("data-sleep")) || 60);
          var limit = Number((opt && opt.getAttribute("data-limit")) || 60);
          var used = Number((opt && opt.getAttribute("data-used")) || 0);
          document.documentElement.setAttribute("data-kid-mode", "active");
          if (avatarBadge) avatarBadge.textContent = emoji;
          if (limitPill) limitPill.classList.remove("hidden");
          if (limitText) {
            limitText.textContent =
              limit > 0 ? ("Limit: " + Math.max(0, limit - used) + "m left") : "Unlimited time";
          }
          if (mobileBadge) mobileBadge.textContent = emoji + " " + name;
          if (window.bbsCustomerHub) window.bbsCustomerHub.setProfile(val, sleep);
        }
      }

      function promptParentPin() {
        var hasPin = switcherBox && switcherBox.getAttribute("data-has-pin") === "1";
        if (!hasPin) {
          applyProfileSelection("parent");
          return;
        }
        if (pinModal) {
          pinModal.classList.remove("hidden");
          if (pinError) pinError.classList.add("hidden");
          if (pinInput) {
            pinInput.value = "";
            pinInput.focus();
          }
        }
      }

      if (profileSelect && !profileSelect.__bound) {
        profileSelect.__bound = true;
        profileSelect.addEventListener("change", function () {
          var nextVal = profileSelect.value;
          if (currentActiveProfile !== "parent" && nextVal === "parent") {
            profileSelect.value = currentActiveProfile;
            promptParentPin();
          } else {
            applyProfileSelection(nextVal);
          }
        });
      }

      document.querySelectorAll("[data-activate-kid-profile]").forEach(function (btn) {
        if (btn.__bound) return;
        btn.__bound = true;
        btn.addEventListener("click", function () {
          var id = btn.getAttribute("data-activate-kid-profile");
          if (id) {
            applyProfileSelection(id);
            window.scrollTo({ top: 0, behavior: "smooth" });
          }
        });
      });

      if (exitKidBtn && !exitKidBtn.__bound) {
        exitKidBtn.__bound = true;
        exitKidBtn.addEventListener("click", promptParentPin);
      }
      if (limitUnlockBtn && !limitUnlockBtn.__bound) {
        limitUnlockBtn.__bound = true;
        limitUnlockBtn.addEventListener("click", promptParentPin);
      }
      if (pinCancel && !pinCancel.__bound) {
        pinCancel.__bound = true;
        pinCancel.addEventListener("click", function () {
          if (pinModal) pinModal.classList.add("hidden");
        });
      }
      if (pinForm && !pinForm.__bound) {
        pinForm.__bound = true;
        pinForm.addEventListener("submit", async function (ev) {
          ev.preventDefault();
          var pin = pinInput ? pinInput.value : "";
          var r = await fetch("/api/account/family", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ action: "verify_pin", pin: pin }),
          });
          if (r.ok) {
            if (pinModal) pinModal.classList.add("hidden");
            applyProfileSelection("parent");
          } else if (pinError) {
            pinError.textContent = "Incorrect Parent PIN. Please try again.";
            pinError.classList.remove("hidden");
          }
        });
      }
    }
    initFamilyAndProfiles();
    document.addEventListener("astro:page-load", initFamilyAndProfiles);
  </script>
</body>
</html>
