---
import "../../styles/global.css";
import { env } from "cloudflare:workers";
import Tracking from "../../components/Tracking.astro";
import { ClientRouter } from "astro:transitions";
import TransitionHooks from "../../components/TransitionHooks.astro";
import CustomerShell from "../../components/CustomerShell.astro";
import { loadCustomerHubContext } from "../../lib/account-data";

const e = env as any;
const hub = await loadCustomerHubContext(Astro.request, Astro.locals, e.DB, Astro.url.origin);
if (!hub) {
  return Astro.redirect("/login?next=/account/settings");
}

const {
  session,
  books,
  audioBooksCount,
  parentOnboarding,
  kidProfiles,
  onboardingChecklist,
} = hub;
---
<!doctype html>
<html lang="en">
<head>
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="theme-color" content="#1a3454" />
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Settings · Big Brain Shelf</title>
  <ClientRouter />
  <TransitionHooks />
  <Tracking />
</head>
<body class="bg-white text-stone-900 antialiased pb-28">
  <CustomerShell
    currentSection="settings"
    userEmail={String(session.user.email || "")}
    username={session.user.displayUsername || session.user.username}
    displayName={parentOnboarding?.parent_name || session.user.name}
    isAdmin={session.user.isAdmin}
    kidProfiles={kidProfiles}
    hasParentPin={Boolean(parentOnboarding?.parent_pin)}
    bookCount={books.length}
    audioCount={audioBooksCount}
    onboardingComplete={onboardingChecklist.isComplete}
  />

  <main class="max-w-4xl mx-auto px-4 py-7 sm:py-10">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div>
        <span class="rounded-full bg-orange-100 text-orange-800 px-3 py-0.5 text-[11px] font-extrabold uppercase tracking-wider">
          Account
        </span>
        <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-stone-900 mt-1.5">
          Settings
        </h1>
        <p class="text-sm text-stone-600 mt-1">
          Your family profile, email preferences, sign-in, and security, all in one place.
        </p>
      </div>
      <a
        href="/account"
        class="cust-pressable rounded-full border border-stone-300 bg-white px-4 py-2 text-xs font-extrabold text-stone-700 hover:border-stone-500"
      >
        ← Back to Dashboard
      </a>
    </div>

    <!-- Family profile: the same fields as /onboarding, editable here -->
    <section class="mt-6 rounded-2xl border border-stone-200 bg-[#fcfaf6] p-6 sm:p-8">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
          <h2 class="text-lg font-extrabold text-stone-900">Family profile</h2>
          <p class="text-xs text-stone-600 mt-0.5">
            {parentOnboarding?.parent_name
              ? <>Parent: <strong>{parentOnboarding.parent_name}</strong> · </>
              : null}
            {kidProfiles.length === 0
              ? "No child readers yet"
              : <>{kidProfiles.length} reader{kidProfiles.length === 1 ? "" : "s"}: <strong>{kidProfiles.map((k) => k.name).join(", ")}</strong></>}
            {" · "}
            {onboardingChecklist.isComplete ? "Setup complete" : `Setup ${onboardingChecklist.percent}% complete`}
          </p>
        </div>
        <div class="flex flex-wrap gap-2">
          <a
            href="/onboarding"
            class="cust-pressable rounded-full border border-stone-300 bg-white px-4 py-2 text-xs font-extrabold text-stone-700 hover:border-stone-500"
          >
            Edit family setup →
          </a>
          <a
            href="/account/kids"
            class="cust-pressable rounded-full border border-stone-300 bg-white px-4 py-2 text-xs font-extrabold text-stone-700 hover:border-stone-500"
          >
            Readers &amp; limits →
          </a>
        </div>
      </div>
    </section>

    <!-- Account Identity & @username -->
    <section class="mt-6 rounded-2xl border border-stone-200 bg-[#fcfaf6] p-6 sm:p-8">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
          <h2 class="text-lg font-extrabold text-stone-900">Account handle &amp; email</h2>
          <p class="text-xs text-stone-600 mt-0.5">
            Signed in as <strong>{session.user.email}</strong>
            {(session.user.displayUsername || session.user.username) && (
              <span> · Handle: <strong>@{session.user.displayUsername || session.user.username}</strong></span>
            )}
          </p>
        </div>
        <a
          href="/onboarding"
          class="cust-pressable rounded-full border border-stone-300 bg-white px-4 py-2 text-xs font-extrabold text-stone-700 hover:border-stone-500"
        >
          Update @username or Parent PIN →
        </a>
      </div>
    </section>

    <!-- Email preferences: which optional mail this family gets -->
    <section class="mt-6 rounded-2xl border border-stone-200 bg-[#fcfaf6] p-6 sm:p-8">
      <h2 class="text-lg font-extrabold text-stone-900">Email preferences</h2>
      <p class="text-sm text-stone-600 mt-1">Choose the optional emails you want. Order, shipping, and billing emails always send, so nothing you bought ever goes quiet.</p>
      <form id="notif-prefs-form" class="mt-4 space-y-3">
        <label class="flex items-start gap-3 rounded-2xl border border-stone-200 bg-white p-4 cursor-pointer">
          <input type="checkbox" name="new_releases" checked={parentOnboarding?.notification_prefs?.new_releases ?? false} class="mt-0.5 h-4 w-4 accent-[#1a3454]" />
          <span>
            <span class="block text-sm font-bold text-stone-900">New books and releases</span>
            <span class="block text-xs text-stone-500 mt-0.5">A note when a new Big Brain Shelf book or audiobook comes out.</span>
          </span>
        </label>
        <label class="flex items-start gap-3 rounded-2xl border border-stone-200 bg-white p-4 cursor-pointer">
          <input type="checkbox" name="club_news" checked={parentOnboarding?.notification_prefs?.club_news ?? true} class="mt-0.5 h-4 w-4 accent-[#1a3454]" />
          <span>
            <span class="block text-sm font-bold text-stone-900">Club news and pick reminders</span>
            <span class="block text-xs text-stone-500 mt-0.5">Box pick reminders, cycle updates, and club announcements.</span>
          </span>
        </label>
        <label class="flex items-start gap-3 rounded-2xl border border-stone-200 bg-white p-4 cursor-pointer">
          <input type="checkbox" name="family_notes" checked={parentOnboarding?.notification_prefs?.family_notes ?? true} class="mt-0.5 h-4 w-4 accent-[#1a3454]" />
          <span>
            <span class="block text-sm font-bold text-stone-900">Family notes</span>
            <span class="block text-xs text-stone-500 mt-0.5">Birthday gifts for your readers and reading milestone notes.</span>
          </span>
        </label>
        <div class="flex items-center gap-3 pt-1">
          <button type="submit" class="cust-pressable rounded-full bg-[#1a3454] px-5 py-2.5 text-xs font-extrabold text-white hover:bg-[#132741]">Save preferences</button>
          <p id="notif-prefs-msg" class="text-xs text-stone-500" role="status"></p>
        </div>
      </form>
    </section>

    <!-- Sign-in & security: passkeys + active sessions (better-auth) -->
    <section id="security" class="mt-6 mb-6 rounded-2xl border border-stone-200 bg-white p-6 sm:p-8">
      <h2 class="text-xl font-bold tracking-tight">Passkeys &amp; active sessions</h2>
      <p id="security-note" class="text-sm text-stone-500 mt-1">
        Passkeys let you sign in with Face ID, Touch ID, or a security key. Sessions show where your account is signed in.
      </p>

      <h3 class="text-sm font-bold mt-6">Your passkeys</h3>
      <div id="passkey-list" class="mt-2 space-y-2 text-sm text-stone-600">Loading...</div>
      <div class="mt-3 flex flex-wrap items-center gap-2">
        <input
          id="passkey-name"
          type="text"
          placeholder="Name this passkey (e.g. My iPhone)"
          class="rounded-lg border border-stone-300 px-3 py-2 text-sm w-64"
        />
        <button
          id="add-passkey-btn"
          type="button"
          class="cust-pressable rounded-lg bg-orange-600 text-white px-4 py-2 text-sm font-semibold hover:bg-orange-700 cursor-pointer"
        >
          Add a passkey
        </button>
      </div>
      <p id="passkey-msg" class="text-sm mt-2 hidden"></p>

      <h3 class="text-sm font-bold mt-8">Active sessions</h3>
      <div id="session-list" class="mt-2 space-y-2 text-sm text-stone-600">Loading...</div>
    </section>
  </main>

  <script is:inline>
    function initNotifPrefs() {
      var form = document.getElementById("notif-prefs-form");
      if (!form || form.__bound) return;
      form.__bound = true;
      form.addEventListener("submit", async function (ev) {
        ev.preventDefault();
        var msg = document.getElementById("notif-prefs-msg");
        var fd = new FormData(form);
        if (msg) msg.textContent = "Saving...";
        try {
          var r = await fetch("/api/account/family", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              action: "save_notification_prefs",
              new_releases: fd.get("new_releases") === "on",
              club_news: fd.get("club_news") === "on",
              family_notes: fd.get("family_notes") === "on",
            }),
          });
          var data = await r.json().catch(function () { return {}; });
          if (msg) msg.textContent = r.ok ? "Saved. Your inbox, your rules." : (data.error || "Could not save.");
        } catch {
          if (msg) msg.textContent = "Could not save. Please try again.";
        }
      });
    }
    initNotifPrefs();
    document.addEventListener("astro:page-load", initNotifPrefs);

    function secB64urlToBuf(s) {
      s = String(s).replace(/-/g, "+").replace(/_/g, "/");
      while (s.length % 4) s += "=";
      var bin = atob(s);
      var b = new Uint8Array(bin.length);
      for (var i = 0; i < bin.length; i++) b[i] = bin.charCodeAt(i);
      return b.buffer;
    }
    function secBufToB64url(buf) {
      var b = new Uint8Array(buf);
      var s = "";
      for (var i = 0; i < b.length; i++) s += String.fromCharCode(b[i]);
      return btoa(s).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "");
    }

    function initSecurity() {
      var list = document.getElementById("passkey-list");
      if (!list || list.__secBound) return;
      list.__secBound = true;
      var sessionsEl = document.getElementById("session-list");
      var msg = document.getElementById("passkey-msg");

      function showMsg(text, ok) {
        if (!msg) return;
        msg.textContent = text;
        msg.className = "text-sm mt-2 " + (ok ? "text-green-700" : "text-red-600");
      }
      async function jget(url) {
        var r = await fetch(url, { headers: { "Content-Type": "application/json" } });
        var d = await r.json().catch(function () { return null; });
        if (!r.ok) throw new Error((d && d.message) || "request failed");
        return d;
      }
      async function jpost(url, body) {
        var r = await fetch(url, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(body || {}),
        });
        var d = await r.json().catch(function () { return null; });
        if (!r.ok) throw new Error((d && d.message) || "request failed");
        return d;
      }

      async function renderPasskeys() {
        try {
          var keys = await jget("/api/auth/passkey/list-user-passkeys");
          if (!Array.isArray(keys)) throw new Error("unauthorized");
          if (!keys.length) {
            list.textContent = "No passkeys yet. Add one below to sign in faster next time.";
            return;
          }
          list.innerHTML = "";
          keys.forEach(function (k) {
            var row = document.createElement("div");
            row.className = "flex items-center justify-between gap-3 rounded-lg border border-stone-200 px-3 py-2";
            var label = document.createElement("span");
            var when = k.createdAt ? new Date(k.createdAt).toLocaleDateString() : "";
            label.textContent = (k.name || "Passkey") + (when ? " · added " + when : "");
            var del = document.createElement("button");
            del.type = "button";
            del.textContent = "Remove";
            del.className = "text-xs font-semibold text-red-600 hover:underline";
            del.addEventListener("click", async function () {
              del.disabled = true;
              try {
                await jpost("/api/auth/passkey/delete-passkey", { id: k.id });
                showMsg("Passkey removed.", true);
                renderPasskeys();
              } catch (ex) {
                showMsg("That passkey could not be removed.", false);
                del.disabled = false;
              }
            });
            row.appendChild(label);
            row.appendChild(del);
            list.appendChild(row);
          });
        } catch (ex) {
          list.textContent = "Sign in with email or Google to manage passkeys and sessions.";
          if (sessionsEl) sessionsEl.textContent = "";
          var addBtn = document.getElementById("add-passkey-btn");
          if (addBtn) addBtn.disabled = true;
        }
      }

      async function renderSessions() {
        if (!sessionsEl) return;
        try {
          var cur = await jget("/api/auth/get-session").catch(function () { return null; });
          var curToken = cur && cur.session ? cur.session.token : null;
          var sessions = await jget("/api/auth/list-sessions");
          if (!Array.isArray(sessions)) throw new Error("unauthorized");
          if (!sessions.length) { sessionsEl.textContent = "No active sessions found."; return; }
          sessionsEl.innerHTML = "";
          sessions.forEach(function (s) {
            var row = document.createElement("div");
            row.className = "flex items-center justify-between gap-3 rounded-lg border border-stone-200 px-3 py-2";
            var label = document.createElement("span");
            var ua = s.userAgent ? String(s.userAgent).slice(0, 60) : "Unknown device";
            var isCur = curToken && s.token === curToken;
            label.textContent = ua + (s.ipAddress ? " · " + s.ipAddress : "") + (isCur ? " · this device" : "");
            row.appendChild(label);
            if (!isCur) {
              var btn = document.createElement("button");
              btn.type = "button";
              btn.textContent = "Sign out";
              btn.className = "text-xs font-semibold text-red-600 hover:underline";
              btn.addEventListener("click", async function () {
                btn.disabled = true;
                await jpost("/api/auth/revoke-session", { token: s.token }).catch(function () {});
                renderSessions();
              });
              row.appendChild(btn);
            }
            sessionsEl.appendChild(row);
          });
        } catch (ex) {
          sessionsEl.textContent = "";
        }
      }

      var addBtn = document.getElementById("add-passkey-btn");
      if (addBtn) addBtn.addEventListener("click", async function () {
        addBtn.disabled = true;
        try {
          var name = (document.getElementById("passkey-name").value || "").trim();
          var opts = await jget("/api/auth/passkey/generate-register-options");
          var pub = {
            challenge: secB64urlToBuf(opts.challenge),
            rp: opts.rp,
            user: {
              id: secB64urlToBuf(opts.user.id),
              name: opts.user.name,
              displayName: opts.user.displayName,
            },
            pubKeyCredParams: opts.pubKeyCredParams,
            timeout: opts.timeout,
            attestation: opts.attestation,
            authenticatorSelection: opts.authenticatorSelection,
            excludeCredentials: (opts.excludeCredentials || []).map(function (c) {
              return { id: secB64urlToBuf(c.id), type: c.type, transports: c.transports };
            }),
          };
          var cred = await navigator.credentials.create({ publicKey: pub });
          if (!cred) throw new Error("Passkey setup was cancelled.");
          var body = {
            response: {
              id: cred.id,
              rawId: secBufToB64url(cred.rawId),
              type: cred.type,
              authenticatorAttachment: cred.authenticatorAttachment || undefined,
              response: {
                clientDataJSON: secBufToB64url(cred.response.clientDataJSON),
                attestationObject: secBufToB64url(cred.response.attestationObject),
                transports: cred.response.getTransports ? cred.response.getTransports() : [],
              },
            },
            name: name || undefined,
          };
          await jpost("/api/auth/passkey/verify-registration", body);
          showMsg("Passkey added. You can sign in with it on the sign-in page.", true);
          renderPasskeys();
        } catch (ex) {
          showMsg((ex && ex.message) || "Passkey setup did not finish.", false);
        }
        addBtn.disabled = false;
      });

      renderPasskeys();
      renderSessions();
    }
    initSecurity();
    document.addEventListener("astro:page-load", initSecurity);
  </script>
</body>
</html>
