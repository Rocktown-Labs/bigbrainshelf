---
// The Audio Club's home inside the account (CG's hub brief,
// 2026-11-01): a condensed listening shelf. Every audiobook the
// membership opens is one tap from playing; books the family owns
// are here too. Non-members see the whole shelf and can join from
// this page, without being bounced to the public join page.
import "../../styles/global.css";
import { env } from "cloudflare:workers";
import Tracking from "../../components/Tracking.astro";
import { ClientRouter } from "astro:transitions";
import TransitionHooks from "../../components/TransitionHooks.astro";
import { publicSlugFor } from "../../lib/public-slugs";
import { coverDerivative } from "../../lib/derivatives";
import { ensureClubTable, clubPlanOf } from "../../lib/club";
import { AUDIO_CLUB_PRICE_CENTS, AUDIO_CLUB_ANNUAL_PRICE_CENTS } from "../../lib/offers";
import CustomerShell from "../../components/CustomerShell.astro";
import { loadCustomerHubContext } from "../../lib/account-data";

const e = env as any;
const hub = await loadCustomerHubContext(Astro.request, Astro.locals, e.DB, Astro.url.origin);
if (!hub) {
  return Astro.redirect("/login?next=/account/listen");
}
const { session, books, audioBooksCount, parentOnboarding, kidProfiles, onboardingChecklist } = hub;

const R2 = "https://media.bigbrainshelf.com/";
const money = (cents: number) => "$" + (Number(cents || 0) / 100).toFixed(2);

const entitled = new Map<string, any>((books as any[]).map((b: any) => [String(b.slug), b]));
let catalog: any[] = [];
try {
  const rows = await e.DB.prepare(
    "SELECT slug, title, topic, cover_key, public_slug FROM books WHERE cover_key IS NOT NULL AND audiobook_key IS NOT NULL ORDER BY title ASC"
  ).all();
  catalog = (rows.rows || rows.results || []) as any[];
} catch { /* the shelf renders from entitlements alone */ }

let isMember = false;
let memberPlan: string | null = null;
try {
  await ensureClubTable(e.DB);
  const rows = await e.DB.prepare(
    `SELECT plan, club_plan FROM club_signups WHERE (user_id = ? OR LOWER(email) = ?) AND status = 'paid' LIMIT 1`
  )
    .bind(session.user.id, String(session.user.email || "").toLowerCase())
    .all();
  const signup = ((rows.rows || rows.results || []) as any[])[0];
  if (signup) {
    isMember = true;
    memberPlan = clubPlanOf(signup);
  }
} catch { /* banner falls back to the join strip */ }

const shelfRows = catalog
  .map((b: any) => {
    const ent = entitled.get(String(b.slug));
    return {
      b,
      pub: publicSlugFor(b),
      cover: coverDerivative(b.slug, "card", b.cover_key) || R2 + b.cover_key,
      entitled: Boolean(ent),
      owned: Boolean(ent?.owned),
    };
  })
  .sort((a, b) => Number(b.entitled) - Number(a.entitled) || a.b.title.localeCompare(b.b.title));
---

<!doctype html>
<html lang="en">
<head>
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#1a3454" />
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Listening Shelf · Big Brain Shelf</title>
  <ClientRouter />
  <TransitionHooks />
  <Tracking />
</head>
<body class="bg-white text-stone-900 antialiased pb-28">
  <CustomerShell
    currentSection="listen"
    userEmail={String(session.user.email || "")}
    username={session.user.displayUsername || session.user.username}
    displayName={parentOnboarding?.parent_name || session.user.name}
    isAdmin={session.user.isAdmin}
    kidProfiles={kidProfiles}
    hasParentPin={Boolean(parentOnboarding?.parent_pin)}
    bookCount={books.length}
    audioCount={audioBooksCount}
    onboardingComplete={onboardingChecklist.isComplete}
  />

  <main class="max-w-4xl mx-auto px-4 py-7 sm:py-10">
    <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-stone-900">🎧 Listening Shelf</h1>
    <p class="text-sm text-stone-600 mt-1 max-w-xl leading-relaxed">
      Every Big Brain Shelf audiobook, in one place. Press Listen and the story starts, with the
      read-along pages turning as it plays.
    </p>

    {isMember ? (
      <div class="mt-5 rounded-2xl bg-green-50 border border-green-200 px-4 py-3 text-sm font-semibold text-green-800">
        {memberPlan === "physical" ? "The Book Club" : "The Audio Club"} membership active: every audiobook below is open to your family.
      </div>
    ) : (
      <div class="mt-5 rounded-3xl bg-[#1a3454] text-white p-5 sm:p-6" data-parent-only="true">
        <h2 class="text-base font-extrabold">The Audio Club opens this whole shelf</h2>
        <p class="text-sm text-white/80 mt-1 leading-relaxed max-w-xl">
          {money(AUDIO_CLUB_PRICE_CENTS)}/month or {money(AUDIO_CLUB_ANNUAL_PRICE_CENTS)}/year. Every audiobook and
          read-along, in your library while your membership is active. Books you buy stay yours forever.
        </p>
        <div class="mt-4 flex flex-wrap gap-2">
          <button type="button" data-club-join="audio:monthly" class="cust-pressable rounded-full bg-orange-500 px-4 py-2 text-xs font-extrabold text-white hover:bg-orange-600 cursor-pointer">
            Join · {money(AUDIO_CLUB_PRICE_CENTS)}/month
          </button>
          <button type="button" data-club-join="audio:annual" class="cust-pressable rounded-full border border-white/30 bg-white/10 px-4 py-2 text-xs font-extrabold text-white hover:bg-white/20 cursor-pointer">
            Join · {money(AUDIO_CLUB_ANNUAL_PRICE_CENTS)}/year
          </button>
        </div>
        <p id="club-join-msg" class="hidden mt-3 text-xs font-bold text-orange-200" role="status"></p>
      </div>
    )}

    {shelfRows.length === 0 ? (
      <div class="mt-6 rounded-3xl border border-dashed border-stone-300 bg-[#fcfaf6] p-8 text-center">
        <p class="text-base font-extrabold text-stone-900">The listening shelf is being stocked</p>
        <p class="mt-1 text-xs text-stone-600">New audiobooks land here as they are published.</p>
      </div>
    ) : (
      <div class="mt-6 divide-y divide-stone-100 rounded-3xl border border-stone-200 overflow-hidden">
        {shelfRows.map((r) => (
          <div class="flex items-center gap-4 bg-white px-4 py-3">
            <a href={r.entitled ? `/account/book/${r.pub}` : `/books/${r.pub}`} class="shrink-0">
              <img
                src={r.cover}
                alt=""
                width="45"
                height="60"
                loading="lazy"
                decoding="async"
                class="w-[45px] h-[60px] rounded-md object-cover border border-stone-200"
              />
            </a>
            <div class="min-w-0 flex-1">
              <h2 class="text-sm font-extrabold text-stone-900 truncate">{r.b.title}</h2>
              <p class="text-[11px] text-stone-500 mt-0.5">
                {r.b.topic}
                {r.entitled
                  ? r.owned
                    ? " · Yours to keep"
                    : " · Open with your club"
                  : " · Audiobook available"}
              </p>
            </div>
            {r.entitled ? (
              <div class="flex shrink-0 items-center gap-2">
                <a
                  href={`/account/book/${r.pub}`}
                  class="hidden sm:inline-block rounded-full border border-stone-300 bg-white px-3.5 py-1.5 text-xs font-extrabold text-stone-700 hover:border-stone-500"
                >
                  Overview
                </a>
                <a
                  href={`/read/${r.pub}?listen=1`}
                  class="cust-pressable rounded-full bg-orange-600 px-4 py-1.5 text-xs font-extrabold text-white hover:bg-orange-700"
                >
                  ▶ Listen
                </a>
              </div>
            ) : (
              <a
                href={`/books/${r.pub}`}
                data-parent-only="true"
                class="shrink-0 rounded-full border border-stone-300 bg-white px-3.5 py-1.5 text-xs font-extrabold text-stone-700 hover:border-stone-500"
              >
                View book →
              </a>
            )}
          </div>
        ))}
      </div>
    )}

    <p class="text-[11px] text-stone-400 mt-6">
      Listening is unlimited while your membership is active. Downloads belong to books your family owns.
    </p>
  </main>

  <script is:inline>
    function initListenJoin() {
      document.querySelectorAll("[data-club-join]").forEach(function (btn) {
        if (btn.__joinBound) return;
        btn.__joinBound = true;
        btn.addEventListener("click", async function () {
          var msg = document.getElementById("club-join-msg");
          var parts = String(btn.getAttribute("data-club-join") || "").split(":");
          btn.disabled = true;
          try {
            var r = await fetch("/api/club/checkout", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ club_plan: parts[0], plan: parts[1], return_to: "account" }),
            });
            var data = await r.json().catch(function () { return {}; });
            if (r.ok && data.url) { window.location.href = data.url; return; }
            if (data.alreadyMember) { window.location.reload(); return; }
            btn.disabled = false;
            if (msg) { msg.textContent = data.error || "Could not start checkout. Please try again."; msg.classList.remove("hidden"); }
          } catch (err) {
            btn.disabled = false;
            if (msg) { msg.textContent = "Could not start checkout. Please try again."; msg.classList.remove("hidden"); }
          }
        });
      });
    }
    initListenJoin();
    document.addEventListener("astro:page-load", initListenJoin);
  </script>
</body>
</html>
