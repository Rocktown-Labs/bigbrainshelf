---
import "../../styles/global.css";
import { env } from "cloudflare:workers";
import Tracking from "../../components/Tracking.astro";
import { ClientRouter } from "astro:transitions";
import TransitionHooks from "../../components/TransitionHooks.astro";
import CustomerShell from "../../components/CustomerShell.astro";
import { loadCustomerHubContext } from "../../lib/account-data";
import {
  clubPriceLabel,
  CLUB_ANNUAL_PRICE_CENTS,
  AUDIO_CLUB_PRICE_CENTS,
  AUDIO_CLUB_ANNUAL_PRICE_CENTS,
} from "../../lib/offers";
import { ensureClubTable, shelfLabel, clubPlanOf } from "../../lib/club";
import {
  ensureClubCycleTables,
  generateUpcomingCyclesForMember,
  getNextClubBox,
  getClubSelectionOptions,
} from "../../lib/club-cycles";
import { addDaysToDateString, boxCreatedDateString, CLUB_PROCESSING_DAYS, clubCycleTiming, formatClubDate } from "../../lib/club-cycle-dates";
import { coverDerivative } from "../../lib/derivatives";

const R2 = "https://media.bigbrainshelf.com/";

const e = env as any;
const hub = await loadCustomerHubContext(Astro.request, Astro.locals, e.DB, Astro.url.origin);
if (!hub) {
  return Astro.redirect("/login?next=/account/club");
}

const {
  session,
  books,
  audioBooksCount,
  parentOnboarding,
  kidProfiles,
  onboardingChecklist,
} = hub;

const money = (cents: number) => "$" + (Number(cents || 0) / 100).toFixed(2);
const justJoined = Astro.url.searchParams.get("joined") === "1";

await ensureClubTable(e.DB);
const clubSignup = (await e.DB.prepare("SELECT * FROM club_signups WHERE email = ?")
  .bind(String(session.user.email || "").toLowerCase())
  .first()) as any;
const clubPlan = clubSignup ? clubPlanOf(clubSignup) : null;

let clubBox: any = null;
let clubTiming: any = null;
let clubPickOptions: any[] = [];
let clubPickOptions2: any[] = [];
let clubGridOptions: any[] = [];
let clubCurrentTitle: string | null = null;
let clubSecondTitle: string | null = null;
let clubBillingPaused = false;

if (clubSignup?.status === "paid") {
  clubBillingPaused = ["past_due", "paused"].includes(String(clubSignup.subscription_status || ""));
  try {
    await ensureClubCycleTables(e.DB);
    await generateUpcomingCyclesForMember(e.DB, clubSignup);
    clubBox = await getNextClubBox(e.DB, clubSignup.id);
    if (clubBox) {
      clubTiming = clubCycleTiming(String(clubBox.ship_date), boxCreatedDateString(clubBox.created_at));
      const opts = await getClubSelectionOptions(e.DB, clubSignup, clubBox);
      const slot1Slug = clubBox.resolved_book_slug || clubBox.selected_book_slug;
      const slot2Slug = clubBox.second_resolved_book_slug || clubBox.second_selected_book_slug;
      const toOptions = (otherSlug: any) =>
        opts.books.map((b: any) => ({
          slug: b.slug,
          title: b.title,
          cover: coverDerivative(b.slug, "card", b.cover_key) || (b.cover_key ? R2 + b.cover_key : null),
          blocked: opts.owned.has(b.slug) || opts.committed.has(b.slug) || b.slug === otherSlug,
          blockKind:
            b.slug === otherSlug
              ? "box"
              : opts.owned.has(b.slug)
                ? "owned"
                : opts.committed.has(b.slug)
                  ? "committed"
                  : null,
          reason:
            b.slug === otherSlug
              ? "Already in this box"
              : opts.owned.has(b.slug)
                ? "Already in your library"
                : "Already coming in a club box",
        }));
      clubPickOptions = toOptions(slot2Slug);
      clubPickOptions2 = toOptions(slot1Slug);
      // One unified grid list for the cover selector: blocked only
      // for books the family owns or already has coming. The two
      // slots police each other in the picker script instead.
      clubGridOptions = opts.books.map((b: any) => ({
        slug: b.slug,
        title: b.title,
        cover: coverDerivative(b.slug, "card", b.cover_key) || (b.cover_key ? R2 + b.cover_key : null),
        blockKind: opts.owned.has(b.slug)
          ? "owned"
          : opts.committed.has(b.slug)
            ? "committed"
            : null,
      }));
      clubCurrentTitle = clubPickOptions.find((o: any) => o.slug === slot1Slug)?.title || null;
      clubSecondTitle = clubPickOptions2.find((o: any) => o.slug === slot2Slug)?.title || null;
    }
  } catch (err) {
    console.error("account club cycle load failed", err);
    clubBox = null;
  }
}
---
<!doctype html>
<html lang="en">
<head>
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="theme-color" content="#1a3454" />
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Book &amp; Audio Club · Big Brain Shelf</title>
  <ClientRouter />
  <TransitionHooks />
  <Tracking />

  <style is:global>
    /* Box picker: the Shelf (CG picked it from the HTML prototype,
       2026-11-01). Two box slots on top, a shelf of covers on a
       plank below; tap a book and it goes in the box. */
    .pick-boxslots { display: flex; gap: .6rem; margin-top: .9rem; }
    .pick-boxslot { flex: 1; border: 1.5px dashed rgba(255,255,255,.35); border-radius: .9rem; min-height: 118px; padding: .5rem; background: rgba(255,255,255,.04); color: #fff; text-align: center; cursor: pointer; transition: border-color .15s, background .15s, transform .12s; }
    .pick-boxslot:active { transform: scale(.98); }
    .pick-boxslot.active { border-color: #fb923c; border-style: solid; background: rgba(251,146,60,.12); }
    .pick-boxslot-label { display: block; font-size: 10px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; color: rgba(255,255,255,.55); margin-bottom: .35rem; }
    .pick-boxslot img { width: 52px; aspect-ratio: 3/4; object-fit: cover; border-radius: .35rem; display: block; margin: 0 auto; }
    .pick-boxslot-title { display: block; font-size: 11px; font-weight: 700; line-height: 1.3; margin-top: .35rem; }
    .pick-boxslot-empty { display: block; font-size: 24px; font-weight: 800; color: #fdba74; margin-top: .55rem; line-height: 1; }
    .pick-boxslot-emptytxt { display: block; font-size: 11.5px; color: rgba(255,255,255,.7); font-weight: 700; margin-top: .35rem; }
    .pick-shelfbooks { display: flex; gap: .6rem; overflow-x: auto; padding: .25rem .1rem 0; scrollbar-width: none; }
    .pick-shelfbooks::-webkit-scrollbar { display: none; }
    .pick-sbook { flex: none; width: 86px; background: none; border: 0; padding: 0; cursor: pointer; color: #fff; text-align: center; font: inherit; transition: transform .16s, opacity .16s; }
    .pick-sbook:active { transform: translateY(-4px); }
    .pick-sbook img { width: 86px; aspect-ratio: 3/4; object-fit: cover; border-radius: .45rem .45rem .2rem .2rem; display: block; box-shadow: 0 4px 10px rgba(0,0,0,.35); }
    .pick-sbook-title { display: block; font-size: 10.5px; font-weight: 700; line-height: 1.3; margin-top: .35rem; }
    .pick-sbook-tag { display: inline-block; margin-top: .2rem; font-size: 9.5px; font-weight: 800; padding: 2px 7px; border-radius: 999px; background: rgba(255,255,255,.14); color: rgba(255,255,255,.85); }
    .pick-sbook-tag:empty { display: none; }
    .pick-sbook.inbox { opacity: .35; }
    .pick-sbook.is-blocked { opacity: .5; cursor: not-allowed; }
    .pick-plank { height: 12px; border-radius: 3px; background: linear-gradient(#b07a45, #8a5a2e); box-shadow: 0 6px 12px rgba(0,0,0,.35); margin-top: .5rem; }
  </style>
</head>
<body class="bg-white text-stone-900 antialiased pb-28">
  <CustomerShell
    currentSection="club"
    userEmail={String(session.user.email || "")}
    username={session.user.displayUsername || session.user.username}
    displayName={parentOnboarding?.parent_name || session.user.name}
    isAdmin={session.user.isAdmin}
    kidProfiles={kidProfiles}
    hasParentPin={Boolean(parentOnboarding?.parent_pin)}
    bookCount={books.length}
    audioCount={audioBooksCount}
    onboardingComplete={onboardingChecklist.isComplete}
  />

  <main class="max-w-4xl mx-auto px-4 py-7 sm:py-10">
    {justJoined && (
      <div class="mb-6 rounded-2xl bg-green-50 border border-green-200 px-4 py-3 text-sm font-semibold text-green-800">
        Welcome to the club. Your membership is active, and your library already reflects it.
      </div>
    )}
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div>
        <span class="rounded-full bg-orange-100 text-orange-800 px-3 py-0.5 text-[11px] font-extrabold uppercase tracking-wider">
          Club Membership
        </span>
        <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-stone-900 mt-1.5">
          {clubPlan === "audio" ? "The Audio Club" : "Book & Audio Club"}
        </h1>
        <p class="text-sm text-stone-600 mt-1">
          Manage your quarterly printed Book Club boxes, monthly Audio Club stories, and upcoming book picks.
        </p>
      </div>
      <a
        href="/account/library"
        class="cust-pressable rounded-full border border-stone-300 bg-white px-4 py-2 text-xs font-extrabold text-stone-700 hover:border-stone-500"
      >
        My Library →
      </a>
    </div>

    <section class="mt-6 rounded-3xl bg-[#1a3454] text-white p-6 sm:p-8 shadow-md">
      {clubSignup?.status === "paid" && clubPlan === "audio" ? (
        <>
          <div class="flex flex-wrap items-start justify-between gap-4">
            <p class="text-white/90 text-sm leading-relaxed max-w-xl">
              You are a member of <strong class="text-white">The Audio Club</strong> ({clubSignup.plan === "annual" ? money(AUDIO_CLUB_ANNUAL_PRICE_CENTS) + "/year" : money(AUDIO_CLUB_PRICE_CENTS) + "/month"}) on the <strong class="text-white">{shelfLabel(clubSignup.shelf)}</strong> shelf. Every audiobook on the shelf is unlocked in your library while your membership is active.
            </p>
            {clubSignup.stripe_customer_id && (
              <form method="post" action="/api/club/portal">
                <button
                  type="submit"
                  class="cust-pressable rounded-full border border-white/30 bg-white/10 px-4 py-2 text-xs font-bold text-white hover:bg-white/20 cursor-pointer"
                >
                  Manage billing
                </button>
              </form>
            )}
          </div>
          <div class="mt-5">
            <a href="/account/library" class="cust-pressable inline-block rounded-full bg-orange-500 px-5 py-2.5 text-xs font-extrabold text-white hover:bg-orange-600">
              Browse My Library →
            </a>
          </div>
          {clubBillingPaused && (
            <p class="mt-4 rounded-xl bg-orange-400/20 border border-orange-300/40 px-4 py-3 text-sm text-orange-100">
              Your membership billing needs attention. Use <strong>Manage billing</strong> above to update your payment method.
            </p>
          )}
          <div class="mt-6 border-t border-white/15 pt-5">
            <h3 class="font-bold">Want the printed books too?</h3>
            <p class="text-white/80 text-sm leading-relaxed mt-1">
              Upgrade to The Book Club: a printed gift set plus a second printed book every 3 months, the whole shelf in your library, and the club book yours to keep digitally. Your Audio Club subscription is cancelled the moment the upgrade lands, so you are never billed for both.
            </p>
            <div class="flex flex-wrap gap-3 mt-4">
              <button type="button" data-club-upgrade="quarterly" class="rounded-full bg-orange-600 text-white text-sm font-semibold px-6 py-2.5 hover:bg-orange-700 transition">Upgrade · {clubPriceLabel()} every 3 months</button>
              <button type="button" data-club-upgrade="annual" class="rounded-full bg-white text-[#1a3454] text-sm font-semibold px-6 py-2.5 hover:bg-orange-50 transition">Upgrade · {clubPriceLabel(CLUB_ANNUAL_PRICE_CENTS)} a year</button>
            </div>
            <p id="club-upgrade-msg" class="text-sm mt-3 hidden" role="status"></p>
          </div>
        </>
      ) : clubSignup?.status === "paid" ? (
        <>
          <div class="flex flex-wrap items-start justify-between gap-4">
            <p class="text-white/90 text-sm leading-relaxed max-w-xl">
              You are a member of the Book Club ({clubSignup.plan === "annual" ? money(CLUB_ANNUAL_PRICE_CENTS) + "/year" : clubPriceLabel() + "/quarter"}) with the <strong class="text-white">{shelfLabel(clubSignup.shelf)}</strong> shelf. Your digital books and audiobooks live on <a href="/account/library" class="underline font-bold text-orange-300">My Library</a>.
            </p>
            {clubSignup.stripe_customer_id && (
              <form method="post" action="/api/club/portal">
                <button
                  type="submit"
                  class="cust-pressable rounded-full border border-white/30 bg-white/10 px-4 py-2 text-xs font-bold text-white hover:bg-white/20 cursor-pointer"
                >
                  Manage billing
                </button>
              </form>
            )}
          </div>
          <div class="mt-5">
            <a href="/account/library" class="cust-pressable inline-block rounded-full bg-orange-500 px-5 py-2.5 text-xs font-extrabold text-white hover:bg-orange-600">
              Browse My Library →
            </a>
          </div>
          {Number(clubSignup.downgrade_to_audio_at || 0) > 0 ? (
            <div class="mt-5 rounded-2xl bg-white/10 p-5">
              <h2 class="text-base font-bold">Switching to The Audio Club</h2>
              <p class="text-sm text-white/85 mt-1 leading-relaxed">
                Your Book Club stays fully active until {new Date(Number(clubSignup.downgrade_to_audio_at) * 1000).toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" })}. On that day it ends, boxes stop, and we email you a one tap start for The Audio Club ({clubSignup.downgrade_audio_period === "annual" ? `${money(AUDIO_CLUB_ANNUAL_PRICE_CENTS)} a year` : `${money(AUDIO_CLUB_PRICE_CENTS)} a month`}). Books you bought to own stay yours.
              </p>
              <button type="button" data-club-downgrade-undo class="cust-pressable mt-3 rounded-full border border-white/30 bg-white/10 px-4 py-2 text-xs font-bold text-white hover:bg-white/20 cursor-pointer">
                Keep The Book Club instead
              </button>
              <p class="club-downgrade-msg text-sm mt-3 hidden" role="status"></p>
            </div>
          ) : (
            <div class="mt-5 rounded-2xl bg-white/5 border border-white/10 p-5">
              <h2 class="text-base font-bold">Listening more than reading lately?</h2>
              <p class="text-sm text-white/85 mt-1 leading-relaxed">
                Switch to The Audio Club at the end of your paid period: every audiobook stays in your library, printed boxes stop, and nothing changes until the day you already paid for arrives.
              </p>
              <div class="mt-3 flex flex-wrap gap-2">
                <button type="button" data-club-downgrade="monthly" class="cust-pressable rounded-full bg-white text-[#1a3454] text-sm font-semibold px-5 py-2.5 hover:bg-orange-50 transition">Switch · {money(AUDIO_CLUB_PRICE_CENTS)} a month</button>
                <button type="button" data-club-downgrade="annual" class="cust-pressable rounded-full border border-white/30 bg-white/10 text-white text-sm font-semibold px-5 py-2.5 hover:bg-white/20 transition">Switch · {money(AUDIO_CLUB_ANNUAL_PRICE_CENTS)} a year</button>
              </div>
              <p class="club-downgrade-msg text-sm mt-3 hidden" role="status"></p>
            </div>
          )}
          {clubBillingPaused && (
            <p class="mt-4 rounded-xl bg-orange-400/20 border border-orange-300/40 px-4 py-3 text-sm text-orange-100">
              Your membership billing needs attention, so new cycle boxes are paused. Use <strong>Manage billing</strong> above to update your payment method.
            </p>
          )}
          {!clubBillingPaused && clubBox && clubTiming ? (
            <div class="mt-6 rounded-2xl bg-white/10 p-5">
              <div class="flex flex-wrap items-baseline justify-between gap-2">
                <h2 class="text-base font-bold">
                  {String(clubBox.ship_date) === String(clubSignup.first_ship_date || "")
                    ? `Your first box · ships by ${formatClubDate(addDaysToDateString(String(clubBox.ship_date), CLUB_PROCESSING_DAYS))}`
                    : `Your next box · ships ${formatClubDate(String(clubBox.ship_date))}`}
                </h2>
                <span class="text-xs font-semibold text-orange-300">
                  {clubBox.status === "shipped"
                    ? "Shipped"
                    : clubBox.status === "locked" || clubTiming.isLocked
                      ? `Locked ${formatClubDate(clubTiming.lockDate)}`
                      : `Choose by ${formatClubDate(clubTiming.lockDate)}`}
                </span>
              </div>
              {clubBox.status === "shipped" ? (
                <p class="text-sm text-white/80 mt-2">
                  Your box is on its way:{" "}
                  <strong class="text-white">
                    {[clubCurrentTitle, clubSecondTitle].filter(Boolean).join(" + ") || "your two shelf books"}
                  </strong>
                  {clubBox.tracking_number
                    ? ` · ${clubBox.carrier ? clubBox.carrier + " " : ""}tracking ${clubBox.tracking_number}`
                    : ""}.
                </p>
              ) : clubBox.status === "locked" || clubTiming.isLocked ? (
                <p class="text-sm text-white/80 mt-2">
                  This box is locked for packing:{" "}
                  <strong class="text-white">
                    {[clubCurrentTitle, clubSecondTitle].filter(Boolean).join(" + ") || "two surprise picks from your shelf"}
                  </strong>.
                </p>
              ) : (
                <form id="club-pick-form" class="mt-3" data-ship-date={clubBox.ship_date} data-pick-1={clubBox.selected_book_slug || "surprise"} data-pick-2={clubBox.second_selected_book_slug || "surprise"}>
                  <p class="text-xs text-white/70">
                    Each box ships two printed books plus their coloring books. Tap a book on the shelf and it goes in the box. Tap a filled slot to swap it back to Surprise. Books already on your shelf sit dimmed, and a slot left on Surprise means we pick from your {shelfLabel(clubSignup.shelf)} shelf.
                  </p>
                  <div class="pick-boxslots">
                    {[1, 2].map((slot) => (
                      <button type="button" class="pick-boxslot" data-boxslot={slot}>
                        <span class="pick-boxslot-label">Book {slot}<span data-picking /></span>
                        <span class="pick-boxslot-body" />
                      </button>
                    ))}
                  </div>
                  <div class="mt-5" data-pick-shelf>
                    <div class="pick-shelfbooks">
                      {clubGridOptions.map((o: any) => (
                        <button
                          type="button"
                          class="pick-sbook"
                          data-book={o.slug}
                          data-kind={o.blockKind || ""}
                        >
                          {o.cover && <img src={o.cover} alt="" loading="lazy" />}
                          <span class="pick-sbook-title">{o.title}</span>
                          <span class="pick-sbook-tag" data-label={o.blockKind === "owned" ? "On your shelf" : o.blockKind === "committed" ? "In another box" : ""} />
                        </button>
                      ))}
                    </div>
                    <div class="pick-plank" />
                  </div>
                  <label class="mt-4 flex items-start gap-2 text-xs text-white/75 cursor-pointer">
                    <input
                      type="checkbox"
                      id="club-allow-repeat"
                      checked={clubBox.allow_repeat === 1}
                      class="mt-0.5"
                    />
                    <span>Sending a second copy or a gift? Allow books already on your shelf.</span>
                  </label>
                  <div class="mt-4 flex items-center gap-3">
                    <button
                      type="submit"
                      class="cust-pressable rounded-full bg-orange-400 px-5 py-2 text-xs font-extrabold text-[#1a3454] hover:bg-orange-300 cursor-pointer"
                    >
                      Save my picks
                    </button>
                    <p id="club-pick-msg" class="text-xs text-white/80" role="status"></p>
                  </div>
                </form>
              )}
            </div>
          ) : (
            !clubBillingPaused && (
              <p class="text-white/80 text-sm leading-relaxed mt-3">
                Your next box will appear here with its book choices as its ship date approaches.
              </p>
            )
          )}
        </>
      ) : clubSignup?.status === "canceled" ? (
        <div>
          {Number(clubSignup.downgrade_to_audio_at || 0) > 0 ? (
            <>
              <h2 class="text-lg font-extrabold">Your Book Club ended. The Audio Club is ready when you are.</h2>
              <p class="text-white/80 text-sm leading-relaxed mt-1.5">
                This is the switch you scheduled, not a cancellation surprise. Start The Audio Club below and every audiobook is back in your library today. Books you bought to own never left.
              </p>
              <div class="mt-4 flex flex-wrap gap-2">
                <button type="button" data-club-join="audio:monthly" class="cust-pressable rounded-full bg-orange-500 px-5 py-2.5 text-xs font-extrabold text-white hover:bg-orange-600 cursor-pointer">
                  Start The Audio Club · {money(AUDIO_CLUB_PRICE_CENTS)}/month
                </button>
                <button type="button" data-club-join="audio:annual" class="cust-pressable rounded-full border border-white/30 bg-white/10 px-5 py-2.5 text-xs font-extrabold text-white hover:bg-white/20 cursor-pointer">
                  {money(AUDIO_CLUB_ANNUAL_PRICE_CENTS)}/year
                </button>
              </div>
            </>
          ) : (
            <>
              <h2 class="text-lg font-extrabold">Your Book Club membership is paused/canceled</h2>
              <p class="text-white/80 text-sm leading-relaxed mt-1.5">
                No further sets will ship unless you rejoin. All digital books you already unlocked stay on your shelf forever.
              </p>
              <a
                href="#join-club"
                class="cust-pressable mt-4 inline-block rounded-full bg-orange-500 px-5 py-2.5 text-xs font-extrabold text-white hover:bg-orange-600"
              >
                Rejoin the Club ↓
              </a>
            </>
          )}
        </div>
      ) : clubSignup ? (
        <div>
          <h2 class="text-lg font-extrabold">
            Spot reserved on the {shelfLabel(clubSignup.shelf)} shelf
          </h2>
          <p class="text-white/80 text-sm leading-relaxed mt-1.5">
            Membership is open to join, and joining activates your reservation with instant digital &amp; audiobook access.
          </p>
          <a
            href="#join-club"
            class="cust-pressable mt-4 inline-block rounded-full bg-orange-500 px-5 py-2.5 text-xs font-extrabold text-white hover:bg-orange-600"
          >
            Activate Membership ↓
          </a>
        </div>
      ) : (
        <div>
          <h2 class="text-lg font-extrabold">Join The Book Club or The Audio Club</h2>
          <p class="text-white/80 text-sm leading-relaxed mt-1.5 max-w-xl">
            Get a quarterly box of two printed books + coloring books ({clubPriceLabel()}/quarter or {money(CLUB_ANNUAL_PRICE_CENTS)}/year), or unlock every audiobook and Read-Along story with The Audio Club ({money(AUDIO_CLUB_PRICE_CENTS)}/month or {money(AUDIO_CLUB_ANNUAL_PRICE_CENTS)}/year).
          </p>
          <a
            href="#join-club"
            class="cust-pressable mt-4 inline-block rounded-full bg-orange-500 px-5 py-2.5 text-xs font-extrabold text-white hover:bg-orange-600"
          >
            See Club Options ↓
          </a>
        </div>
      )}
    </section>

    {clubSignup?.status !== "paid" && (
      <section id="join-club" class="mt-6 rounded-3xl border border-stone-200 bg-[#fcfaf6] p-6 sm:p-8" data-parent-only="true">
        <h2 class="text-lg font-extrabold text-stone-900">Join right here</h2>
        <p class="text-sm text-stone-600 mt-1 max-w-xl leading-relaxed">
          Pick a club and check out without leaving your account. Membership activates the moment payment lands.
        </p>
        <div class="mt-5 grid sm:grid-cols-2 gap-4">
          <div class="rounded-2xl border border-stone-200 bg-white p-5">
            <p class="text-[11px] font-extrabold uppercase tracking-wider text-stone-500">🎧 The Audio Club</p>
            <p class="text-sm text-stone-600 mt-1.5 leading-relaxed">Every audiobook and read-along in your library while you are a member.</p>
            <div class="mt-4 flex flex-wrap gap-2">
              <button type="button" data-club-join="audio:monthly" class="cust-pressable rounded-full bg-[#1a3454] px-4 py-2 text-xs font-extrabold text-white hover:bg-[#132741] cursor-pointer">
                {money(AUDIO_CLUB_PRICE_CENTS)}/month
              </button>
              <button type="button" data-club-join="audio:annual" class="cust-pressable rounded-full border border-stone-300 bg-white px-4 py-2 text-xs font-extrabold text-stone-700 hover:border-stone-500 cursor-pointer">
                {money(AUDIO_CLUB_ANNUAL_PRICE_CENTS)}/year
              </button>
            </div>
          </div>
          <div class="rounded-2xl border border-stone-200 bg-white p-5">
            <p class="text-[11px] font-extrabold uppercase tracking-wider text-stone-500">📦 The Book Club</p>
            <p class="text-sm text-stone-600 mt-1.5 leading-relaxed">A printed gift set plus a second printed book every 3 months, and the digital editions in your library from day one.</p>
            <div class="mt-4 flex flex-wrap gap-2">
              <button type="button" data-club-join="physical:quarterly" class="cust-pressable rounded-full bg-orange-600 px-4 py-2 text-xs font-extrabold text-white hover:bg-orange-700 cursor-pointer">
                {clubPriceLabel()}/quarter
              </button>
              <button type="button" data-club-join="physical:annual" class="cust-pressable rounded-full border border-stone-300 bg-white px-4 py-2 text-xs font-extrabold text-stone-700 hover:border-stone-500 cursor-pointer">
                {money(CLUB_ANNUAL_PRICE_CENTS)}/year
              </button>
            </div>
          </div>
        </div>
        <p id="club-join-msg" class="hidden mt-4 text-xs font-bold text-red-700" role="status"></p>
      </section>
    )}
  </main>

  <script is:inline define:vars={{ shelfBooks: clubGridOptions }}>
    // The Shelf picker (CG's pick from the prototype, 2026-11-01):
    // tap a book and it goes into the active box slot, tap a filled
    // slot to swap it back to Surprise. Same save payload as the
    // grid it replaced.
    function initClubPick() {
      var form = document.getElementById("club-pick-form");
      if (!form || form.__clubPickBound) return;
      form.__clubPickBound = true;
      var repeat = document.getElementById("club-allow-repeat");
      var msg = document.getElementById("club-pick-msg");
      var bySlug = {};
      (shelfBooks || []).forEach(function (b) { bySlug[b.slug] = b; });
      var picks = {
        "1": form.getAttribute("data-pick-1") || "surprise",
        "2": form.getAttribute("data-pick-2") || "surprise",
      };
      var activeSlot = picks["1"] === "surprise" ? "1" : picks["2"] === "surprise" ? "2" : "1";
      function esc(s) {
        return String(s || "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
      }
      function paint() {
        form.querySelectorAll("[data-boxslot]").forEach(function (el) {
          var slot = el.getAttribute("data-boxslot");
          el.classList.toggle("active", activeSlot === slot);
          var picking = el.querySelector("[data-picking]");
          if (picking) picking.textContent = activeSlot === slot ? " · picking" : "";
          var body = el.querySelector(".pick-boxslot-body");
          var v = picks[slot];
          if (!body) return;
          if (v === "surprise" || !bySlug[v]) {
            body.innerHTML = '<span class="pick-boxslot-empty">?</span><span class="pick-boxslot-emptytxt">Surprise me</span>';
          } else {
            body.innerHTML =
              (bySlug[v].cover ? '<img src="' + esc(bySlug[v].cover) + '" alt="">' : "") +
              '<span class="pick-boxslot-title">' + esc(bySlug[v].title) + "</span>";
          }
        });
        form.querySelectorAll(".pick-sbook").forEach(function (el) {
          var slug = el.getAttribute("data-book");
          var kind = el.getAttribute("data-kind") || "";
          var inBox = picks["1"] === slug || picks["2"] === slug;
          var blocked = kind !== "" && !(repeat && repeat.checked) && !inBox;
          el.classList.toggle("inbox", inBox);
          el.classList.toggle("is-blocked", blocked);
          var tag = el.querySelector(".pick-sbook-tag");
          if (tag) tag.textContent = inBox ? "In the box" : blocked ? tag.getAttribute("data-label") || "" : "";
        });
      }
      form.querySelectorAll("[data-boxslot]").forEach(function (el) {
        el.addEventListener("click", function () {
          var slot = el.getAttribute("data-boxslot");
          if (activeSlot === slot && picks[slot] !== "surprise") {
            picks[slot] = "surprise";
          } else {
            activeSlot = slot;
          }
          paint();
        });
      });
      form.querySelectorAll(".pick-sbook").forEach(function (el) {
        el.addEventListener("click", function () {
          var slug = el.getAttribute("data-book");
          var kind = el.getAttribute("data-kind") || "";
          if (picks["1"] === slug || picks["2"] === slug) return;
          if (kind !== "" && !(repeat && repeat.checked)) return;
          picks[activeSlot] = slug;
          var other = activeSlot === "1" ? "2" : "1";
          if (picks[other] === slug) picks[other] = "surprise";
          activeSlot = other;
          paint();
        });
      });
      if (repeat) repeat.addEventListener("change", paint);
      paint();
      form.addEventListener("submit", async function (ev) {
        ev.preventDefault();
        if (msg) msg.textContent = "Saving...";
        try {
          var r = await fetch("/api/club/selection", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              ship_date: form.getAttribute("data-ship-date"),
              selection: picks["1"],
              selection_2: picks["2"],
              allow_repeat: !!(repeat && repeat.checked),
            }),
          });
          var data = await r.json().catch(function () {
            return {};
          });
          if (!r.ok) {
            if (msg) msg.textContent = data.error || "Could not save your pick.";
            return;
          }
          if (msg) msg.textContent = "Saved!";
          window.location.reload();
        } catch {
          if (msg) msg.textContent = "Could not save your pick. Please try again.";
        }
      });
    }
    initClubPick();
    document.addEventListener("astro:page-load", initClubPick);
  </script>
  <script is:inline>
    // Audio Club member upgrading to The Book Club: post the
    // physical join and ride the Stripe redirect, same as /clubs.
    function initClubUpgrade() {
      document.querySelectorAll("[data-club-upgrade]").forEach(function (btn) {
        if (btn.__upgradeBound) return;
        btn.__upgradeBound = true;
        btn.addEventListener("click", async function () {
          var msg = document.getElementById("club-upgrade-msg");
          btn.disabled = true;
          try {
            var r = await fetch("/api/club/checkout", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ club_plan: "physical", plan: btn.getAttribute("data-club-upgrade") }),
            });
            var data = await r.json().catch(function () { return {}; });
            if (r.ok && data.url) { window.location.href = data.url; return; }
            if (data.alreadyMember) { window.location.reload(); return; }
            btn.disabled = false;
            if (msg) { msg.textContent = data.error || "Could not start the upgrade. Please try again."; msg.classList.remove("hidden"); }
          } catch (err) {
            btn.disabled = false;
            if (msg) { msg.textContent = "Could not start the upgrade. Please try again."; msg.classList.remove("hidden"); }
          }
        });
      });
    }
    initClubUpgrade();
    document.addEventListener("astro:page-load", initClubUpgrade);
  </script>
  <script is:inline>
    // Book Club member scheduling (or undoing) a switch to The
    // Audio Club at the end of the paid period.
    function initClubDowngrade() {
      function wire(btn, payload) {
        if (!btn || btn.__dgBound) return;
        btn.__dgBound = true;
        btn.addEventListener("click", async function () {
          var msg = document.querySelector(".club-downgrade-msg");
          btn.disabled = true;
          try {
            var r = await fetch("/api/club/downgrade", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify(payload),
            });
            var data = await r.json().catch(function () { return {}; });
            if (r.ok && data.ok) { window.location.reload(); return; }
            btn.disabled = false;
            if (msg) { msg.textContent = data.error || "Could not update your membership. Please try again."; msg.classList.remove("hidden"); }
          } catch (err) {
            btn.disabled = false;
            if (msg) { msg.textContent = "Could not update your membership. Please try again."; msg.classList.remove("hidden"); }
          }
        });
      }
      document.querySelectorAll("[data-club-downgrade]").forEach(function (btn) {
        wire(btn, { action: "schedule", plan: btn.getAttribute("data-club-downgrade") });
      });
      document.querySelectorAll("[data-club-downgrade-undo]").forEach(function (btn) {
        wire(btn, { action: "undo" });
      });
    }
    initClubDowngrade();
    document.addEventListener("astro:page-load", initClubDowngrade);
  </script>
  <script is:inline>
    // In-account join: same checkout endpoint as /clubs, with the
    // account return path so Stripe lands back here, never on the
    // public join page.
    function initClubJoin() {
      document.querySelectorAll("[data-club-join]").forEach(function (btn) {
        if (btn.__joinBound) return;
        btn.__joinBound = true;
        btn.addEventListener("click", async function () {
          var msg = document.getElementById("club-join-msg");
          var parts = String(btn.getAttribute("data-club-join") || "").split(":");
          btn.disabled = true;
          try {
            var r = await fetch("/api/club/checkout", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ club_plan: parts[0], plan: parts[1], return_to: "account" }),
            });
            var data = await r.json().catch(function () { return {}; });
            if (r.ok && data.url) { window.location.href = data.url; return; }
            if (data.alreadyMember) { window.location.reload(); return; }
            btn.disabled = false;
            if (msg) { msg.textContent = data.error || "Could not start checkout. Please try again."; msg.classList.remove("hidden"); }
          } catch (err) {
            btn.disabled = false;
            if (msg) { msg.textContent = "Could not start checkout. Please try again."; msg.classList.remove("hidden"); }
          }
        });
      });
    }
    initClubJoin();
    document.addEventListener("astro:page-load", initClubJoin);
  </script>
</body>
</html>
