---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import Tracking from "../components/Tracking.astro";
import { ClientRouter } from "astro:transitions";
import TransitionHooks from "../components/TransitionHooks.astro";
import SeoHead from "../components/SeoHead.astro";
import { env } from "cloudflare:workers";
export const prerender = false;
// Same Turnstile widget + site key as the newsletter form; the
// better-auth captcha plugin verifies the token server-side.
const turnstileSiteKey = String((env as any)?.TURNSTILE_SITE_KEY || "").trim();
const next = Astro.url.searchParams.get("next") || "";
if (Astro.locals.user) {
  return Astro.redirect(next && next.startsWith("/") && !next.startsWith("/login") ? next : "/admin", 302);
}
---

<!doctype html>
<html lang="en">
<head>
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#1a3454" />
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>Sign in · Big Brain Shelf</title>
  <SeoHead title="Sign in · Big Brain Shelf" />
    <ClientRouter />
  <TransitionHooks />
  <Tracking />
</head>
<body class="bg-stone-50 text-stone-900 antialiased">
  <SiteHeader authAction={{ href: "/signup", label: "Create account" }} />

  <main class="max-w-md mx-auto px-4 py-14">
    <div class="bg-white border border-stone-200 rounded-2xl p-7 shadow-sm">
      <h1 class="text-2xl font-bold tracking-tight">Sign in</h1>
      <p class="text-sm text-stone-500 mt-1">One sign-in for everything. Owners land in the admin, readers land in their library.</p>
      <div id="already" class="hidden mt-5 rounded-lg bg-stone-100 px-4 py-3 text-sm"></div>
      <button id="google-btn" type="button" class="mt-6 flex w-full items-center justify-center gap-3 rounded-lg border border-stone-300 bg-white px-4 py-2.5 text-sm font-semibold text-stone-700 hover:bg-stone-50">
        <svg width="18" height="18" viewBox="0 0 48 48" aria-hidden="true"><path fill="#FFC107" d="M43.6 20.1H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 8 3l5.7-5.7C34.5 6.1 29.3 4 24 4 13 4 4 13 4 24s9 20 20 20 20-9 20-20c0-1.3-.1-2.6-.4-3.9z"/><path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 8 3l5.7-5.7C34.5 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.1H42V20H24v8h11.3c-.8 2.3-2.3 4.3-4.1 5.6l6.2 5.2C36.9 39.2 44 34 44 24c0-1.3-.1-2.6-.4-3.9z"/></svg>
        Continue with Google
        <span data-last-used-badge="google" class="hidden rounded-full bg-orange-100 px-2 py-0.5 text-[11px] font-semibold text-orange-800">Last used</span>
      </button>
      <div class="mt-6 flex items-center gap-3 text-xs text-stone-400"><span class="h-px flex-1 bg-stone-200"></span>or sign in with email or username<span class="h-px flex-1 bg-stone-200"></span></div>
      <form id="form" class="mt-6 space-y-4">
        <div>
          <label class="block text-sm font-medium mb-1" for="email">Email or username</label>
          <input id="email" type="text" required autocomplete="username webauthn" placeholder="you@example.com or username" class="w-full rounded-lg border border-stone-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-orange-600" />
        </div>
        <div>
          <label class="block text-sm font-medium mb-1" for="password">Password</label>
          <input id="password" type="password" required autocomplete="current-password" class="w-full rounded-lg border border-stone-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-orange-600" />
        </div>
        {turnstileSiteKey && (
          <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="light"></div>
        )}
        {turnstileSiteKey && (
          <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
        )}
        <p id="err" class="text-sm text-red-600 hidden"></p>
        <button id="btn" class="w-full rounded-lg bg-orange-600 text-white text-sm font-semibold py-2.5 hover:bg-orange-700"><span id="btn-label">Sign in</span> <span data-last-used-badge="email username" class="hidden rounded-full bg-white/25 px-2 py-0.5 text-[11px] font-semibold text-white">Last used</span></button>
        <div class="flex items-center gap-3 pt-1">
          <span class="h-px bg-stone-200 flex-1"></span>
          <span class="text-xs text-stone-400">or</span>
          <span class="h-px bg-stone-200 flex-1"></span>
        </div>
        <button id="magic-btn" type="button" class="w-full rounded-lg bg-white border border-stone-300 text-sm font-semibold py-2.5 hover:border-stone-500"><span id="magic-label">Email me a sign-in link</span> <span data-last-used-badge="magic-link" class="hidden rounded-full bg-orange-100 px-2 py-0.5 text-[11px] font-semibold text-orange-800">Last used</span></button>
        <p id="magic-note" class="text-sm text-green-700 hidden"></p>
        <p class="text-xs text-stone-400">Bought as a guest? Use the link: it signs you in with no password, and your books are already in your library.</p>
        <button id="passkey-btn" type="button" class="w-full rounded-lg bg-white border border-stone-300 text-sm font-semibold py-2.5 hover:border-stone-500">Sign in with a passkey <span data-last-used-badge="passkey" class="hidden rounded-full bg-orange-100 px-2 py-0.5 text-[11px] font-semibold text-orange-800">Last used</span></button>
        <p class="text-xs text-stone-400">Face ID, Touch ID, or a security key. Set one up in your account after signing in.</p>
      </form>
      <p class="text-sm text-stone-500 mt-6">New here? <a id="signup-link" href="/signup" class="text-orange-700 font-medium">Create an account</a></p>
    </div>
  </main>

  <script is:inline>
  // Sign-in wiring. Runs on first render and again on astro:page-load
  // so the form works after view-transition navigations; the path
  // check and the form flag keep it from ever binding the wrong page
  // or binding twice.
  function initLogin() {
    if (window.location.pathname !== "/login") return;
    var form = document.getElementById("form");
    if (!form || form.__loginBound) return;
    form.__loginBound = true;

    var next = new URLSearchParams(window.location.search).get("next") || "";
    var signupLink = document.getElementById("signup-link");
    if (next) signupLink.href = "/signup?next=" + encodeURIComponent(next);

    // Google sign-in: one flow for everyone. After Google, /auth/land
    // checks the account role and routes admins to /admin and
    // customers to their library (or their intended page).
    document.getElementById("google-btn").addEventListener("click", async function () {
      var btn = document.getElementById("google-btn");
      btn.disabled = true;
      try {
        var land = "/auth/land";
        if (next && next.startsWith("/") && !next.startsWith("//") && !next.startsWith("/login")) {
          land += "?next=" + encodeURIComponent(next);
        }
        var r = await fetch("/api/auth/sign-in/social", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ provider: "google", callbackURL: land }),
        });
        var d = await r.json().catch(function () { return {}; });
        if (!r.ok || !d.url) throw new Error(d.message || "Google sign-in could not start.");
        window.location.href = d.url;
      } catch (ex) {
        var err = document.getElementById("err");
        err.textContent = ex.message;
        err.classList.remove("hidden");
        btn.disabled = false;
      }
    });

    // Passwordless: email a one-click sign-in link (better-auth
    // magic link). Guest buyers live here: no password was ever
    // set, and the library matches their orders by email.
    var magicBtn = document.getElementById("magic-btn");
    if (magicBtn) magicBtn.addEventListener("click", async function () {
      var email = (document.getElementById("email").value || "").trim();
      var err = document.getElementById("err");
      var note = document.getElementById("magic-note");
      err.classList.add("hidden");
      note.classList.add("hidden");
      if (!email || email.indexOf("@") < 1) {
        err.textContent = "Type your email above first, then ask for the link.";
        err.classList.remove("hidden");
        return;
      }
      magicBtn.disabled = true;
      document.getElementById("magic-label").textContent = "Sending...";
      try {
        var land = "/auth/land";
        if (next && next.startsWith("/") && !next.startsWith("//") && !next.startsWith("/login")) {
          land += "?next=" + encodeURIComponent(next);
        }
        // The magic-link endpoint is Turnstile-gated too (it sends
        // real email): share the credential form's widget token.
        // captchaToken/resetCaptcha are declared below in this same
        // scope and hoist, so they are callable from here.
        var mToken = captchaToken();
        if (mToken !== null && !mToken) {
          throw new Error("Please complete the check above and try again.");
        }
        var mHeaders = { "Content-Type": "application/json" };
        if (mToken) mHeaders["x-captcha-response"] = mToken;
        var r = await fetch("/api/auth/sign-in/magic-link", {
          method: "POST",
          headers: mHeaders,
          body: JSON.stringify({ email: email, callbackURL: land }),
        });
        resetCaptcha();
        if (!r.ok) {
          var d = await r.json().catch(function () { return {}; });
          if (d.code === "MISSING_RESPONSE" || d.code === "VERIFICATION_FAILED") {
            throw new Error("Please complete the check above and try again.");
          }
          throw new Error(d.message || "The link could not be sent. Try again in a moment.");
        }
        note.textContent = "Check your email: your sign-in link is on its way. It works once and expires in 15 minutes.";
        note.classList.remove("hidden");
        document.getElementById("magic-label").textContent = "Link sent";
      } catch (ex) {
        err.textContent = ex.message;
        err.classList.remove("hidden");
        magicBtn.disabled = false;
        document.getElementById("magic-label").textContent = "Email me a sign-in link";
      }
    });

    // Already signed in as a customer? Say so, and offer the way in.
    fetch("/api/auth/get-session").then(function (r) { return r.json(); }).then(function (s) {
      if (s && s.user) {
        var el = document.getElementById("already");
        el.classList.remove("hidden");
        el.innerHTML = 'You are signed in as <strong>' + (s.user.email || "") + '</strong>. ' +
          '<a class="text-orange-700 font-medium" href="/account">Go to your library</a>';
      }
    }).catch(function () {});

    // Turnstile (same pattern as the newsletter form): the token
    // lives in the widget's hidden field, is sent to better-auth as
    // the x-captcha-response header, and is single-use, so the
    // widget resets after any failed attempt. The widget may still
    // be rendering after a view-transition navigation; render it
    // explicitly if the script is already loaded and it has not
    // appeared yet. Google sign-in is an OAuth redirect and cannot
    // carry a token, so it stays ungated by design.
    var tsDiv = form.querySelector(".cf-turnstile");
    if (tsDiv && !tsDiv.querySelector("input[name='cf-turnstile-response']") && window.turnstile) {
      try { window.turnstile.render(tsDiv, { sitekey: tsDiv.getAttribute("data-sitekey"), theme: "light" }); } catch (ex) {}
    }
    function captchaToken() {
      var f = form.querySelector("input[name='cf-turnstile-response']");
      return f ? (f.value || "") : null; // null = no widget on this page
    }
    function resetCaptcha() {
      if (window.turnstile) { try { window.turnstile.reset(); } catch (ex) {} }
    }

    form.addEventListener("submit", async function (e) {
      e.preventDefault();
      var btn = document.getElementById("btn");
      var err = document.getElementById("err");
      var email = document.getElementById("email").value.trim();
      var password = document.getElementById("password").value;
      var token = captchaToken();
      if (token !== null && !token) {
        err.textContent = "Please complete the check and try again.";
        err.classList.remove("hidden");
        return;
      }
      btn.disabled = true;
      document.getElementById("btn-label").textContent = "Signing in...";
      err.classList.add("hidden");
      // 1) Owner sign-in (admin session cookie).
      try {
        var r1 = await fetch("/api/admin-auth/login", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email: email, password: password }),
        });
        if (r1.ok) {
          window.location.href = next && next.startsWith("/") && !next.startsWith("/login") ? next : "/admin";
          return;
        }
      } catch (ex) { /* fall through to customer sign-in */ }
      // 2) Customer sign-in (better-auth email OR username, Turnstile-gated).
      try {
        var headers = { "Content-Type": "application/json" };
        if (token) headers["x-captcha-response"] = token;
        var isEmailLogin = email.indexOf("@") !== -1;
        var cleanUsername = email.replace(/^@+/, "");
        var r2 = await fetch(isEmailLogin ? "/api/auth/sign-in/email" : "/api/auth/sign-in/username", {
          method: "POST",
          headers: headers,
          body: JSON.stringify(
            isEmailLogin
              ? { email: email, password: password }
              : { username: cleanUsername, password: password }
          ),
        });
        var data = await r2.json().catch(function () { return {}; });
        if (!r2.ok) {
          if (data.code === "MISSING_RESPONSE" || data.code === "VERIFICATION_FAILED") {
            throw new Error("Please complete the check and try again.");
          }
          throw new Error(data.message || "That email/username and password did not match an account.");
        }
        var dest = next && next.startsWith("/") && !next.startsWith("/login") ? next : "/auth/land";
        window.location.href = dest;
      } catch (ex) {
        err.textContent = ex.message;
        err.classList.remove("hidden");
        btn.disabled = false;
        document.getElementById("btn-label").textContent = "Sign in";
        resetCaptcha();
      }
    });
  }
  initLogin();
  document.addEventListener("astro:page-load", initLogin);
</script>
<script is:inline>
  // Passkey sign-in + "Last used" badges. is:inline like every other
  // script on this page (module scripts with imports ship verbatim
  // in this build and die), so WebAuthn is hand-rolled against the
  // passkey plugin's endpoints with plain fetch + navigator.credentials.
  function b64urlToBuf(s) {
    s = String(s).replace(/-/g, "+").replace(/_/g, "/");
    while (s.length % 4) s += "=";
    var bin = atob(s);
    var b = new Uint8Array(bin.length);
    for (var i = 0; i < bin.length; i++) b[i] = bin.charCodeAt(i);
    return b.buffer;
  }
  function bufToB64url(buf) {
    var b = new Uint8Array(buf);
    var s = "";
    for (var i = 0; i < b.length; i++) s += String.fromCharCode(b[i]);
    return btoa(s).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "");
  }
  function landUrl() {
    var next = new URLSearchParams(window.location.search).get("next") || "";
    var land = "/auth/land";
    if (next && next.startsWith("/") && !next.startsWith("//") && !next.startsWith("/login")) {
      land += "?next=" + encodeURIComponent(next);
    }
    return land;
  }

  function initPasskeyLogin() {
    if (window.location.pathname !== "/login") return;

    // "Last used" badges from the last-login-method cookie.
    try {
      var m = document.cookie.match(/(?:^|;\s*)better-auth\.last_used_login_method=([^;]*)/);
      var last = m ? decodeURIComponent(m[1]) : null;
      if (last) {
        document.querySelectorAll("[data-last-used-badge]").forEach(function (el) {
          var methods = (el.getAttribute("data-last-used-badge") || "").split(" ");
          if (methods.indexOf(last) !== -1) el.classList.remove("hidden");
        });
      }
    } catch (ex) {}

    var pkBtn = document.getElementById("passkey-btn");
    if (!pkBtn || pkBtn.__pkBound) return;
    pkBtn.__pkBound = true;
    var conditionalAbort = null;

    async function passkeySignIn(useConditional) {
      var r = await fetch("/api/auth/passkey/generate-authenticate-options", {
        method: "GET",
        headers: { "Content-Type": "application/json" },
      });
      var opts = await r.json().catch(function () { return null; });
      if (!r.ok || !opts || !opts.challenge) throw new Error("Passkey sign-in could not start.");
      var pub = {
        challenge: b64urlToBuf(opts.challenge),
        rpId: opts.rpId,
        timeout: opts.timeout,
        userVerification: opts.userVerification,
        allowCredentials: (opts.allowCredentials || []).map(function (c) {
          return { id: b64urlToBuf(c.id), type: c.type, transports: c.transports };
        }),
      };
      var getOpts = { publicKey: pub };
      if (useConditional) {
        getOpts.mediation = "conditional";
        conditionalAbort = new AbortController();
        getOpts.signal = conditionalAbort.signal;
      }
      var cred = await navigator.credentials.get(getOpts);
      if (!cred) throw new Error("Passkey sign-in was cancelled.");
      var body = {
        response: {
          id: cred.id,
          rawId: bufToB64url(cred.rawId),
          type: cred.type,
          authenticatorAttachment: cred.authenticatorAttachment || undefined,
          response: {
            clientDataJSON: bufToB64url(cred.response.clientDataJSON),
            authenticatorData: bufToB64url(cred.response.authenticatorData),
            signature: bufToB64url(cred.response.signature),
            userHandle: cred.response.userHandle ? bufToB64url(cred.response.userHandle) : null,
          },
        },
      };
      var v = await fetch("/api/auth/passkey/verify-authentication", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(body),
      });
      if (!v.ok) {
        var d = await v.json().catch(function () { return {}; });
        throw new Error(d.message || "That passkey did not match an account.");
      }
      window.location.href = landUrl();
    }

    pkBtn.addEventListener("click", async function () {
      var err = document.getElementById("err");
      err.classList.add("hidden");
      if (conditionalAbort) { try { conditionalAbort.abort(); } catch (ex) {} }
      pkBtn.disabled = true;
      try {
        await passkeySignIn(false);
      } catch (ex) {
        err.textContent = (ex && ex.message) || "Passkey sign-in did not work. Try another way in.";
        err.classList.remove("hidden");
        pkBtn.disabled = false;
      }
    });

    // Conditional UI: a passkey for this site is offered in the
    // email field's autofill when the browser supports it.
    try {
      if (window.PublicKeyCredential && PublicKeyCredential.isConditionalMediationAvailable) {
        PublicKeyCredential.isConditionalMediationAvailable().then(function (ok) {
          if (ok) passkeySignIn(true).catch(function () {});
        }).catch(function () {});
      }
    } catch (ex) {}
  }
  initPasskeyLogin();
  document.addEventListener("astro:page-load", initPasskeyLogin);
</script>
</body>
</html>
