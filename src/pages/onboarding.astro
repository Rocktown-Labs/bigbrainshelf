---
import "../styles/global.css";
import { env } from "cloudflare:workers";
import Tracking from "../components/Tracking.astro";
import { ClientRouter } from "astro:transitions";
import TransitionHooks from "../components/TransitionHooks.astro";
import SiteHeader from "../components/SiteHeader.astro";
import CartSheet from "../components/CartSheet.astro";
import { loadCustomerHubContext } from "../lib/account-data";
import {
  KID_AVATARS,
  SLEEP_TIMER_PRESETS,
  DAILY_LIMIT_PRESETS,
  READING_GOAL_OPTIONS,
  CURRENT_TOPIC_OPTIONS,
  FUTURE_TOPIC_OPTIONS,
  DISCOVERY_SOURCE_OPTIONS,
} from "../lib/family";

const e = env as any;
const hub = await loadCustomerHubContext(Astro.request, Astro.locals, e.DB, Astro.url.origin);
if (!hub) {
  return Astro.redirect("/login?next=/onboarding");
}

const {
  session,
  books,
  audioBooksCount,
  parentOnboarding,
  kidProfiles,
  onboardingChecklist,
  defaultKidProfile,
  defaultSleepMinutes,
} = hub;
---
<!doctype html>
<html lang="en">
<head>
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="theme-color" content="#1a3454" />
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Family Setup · Big Brain Shelf</title>
  <ClientRouter />
  <TransitionHooks />
  <Tracking />
</head>
<body class="bg-white text-stone-900 antialiased pb-16">
  <SiteHeader search cartMode="sheet" />
  <CartSheet />

  <main class="max-w-3xl mx-auto px-4 py-7 sm:py-10">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div>
        <span class="rounded-full bg-orange-100 text-orange-800 px-3 py-0.5 text-[11px] font-extrabold uppercase tracking-wider">
          1-Minute Family Setup · {onboardingChecklist.percent}% Ready
        </span>
        <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-stone-900 mt-1.5">
          Set up your child's reader profile &amp; bedtime timer
        </h1>
        <p class="text-sm text-stone-600 mt-1">
          Personalize Kid View, set a gentle bedtime sleep timer, and tell us which topics your family wants to explore next.
        </p>
        {onboardingChecklist.isComplete && (
          <p class="text-xs font-bold text-green-700 mt-2">Your family setup is complete. Update anything below and save.</p>
        )}
      </div>
      <button
        type="button"
        id="onboarding-skip-btn"
        class="cust-pressable rounded-full border border-stone-300 bg-white px-4 py-2 text-xs font-extrabold text-stone-700 hover:border-stone-500 cursor-pointer"
      >
        Skip for now →
      </button>
    </div>

    <!-- Step Indicator Pills -->
    <div class="mt-6 grid grid-cols-3 gap-2" role="tablist" aria-label="Onboarding steps">
      <button
        type="button"
        data-ob-step-tab="1"
        class="ob-step-pill cust-pressable rounded-2xl border border-orange-400 bg-orange-50 px-3 py-2.5 text-left cursor-pointer"
      >
        <p class="text-[10px] font-extrabold uppercase tracking-wider text-orange-700">Step 1</p>
        <p class="text-xs font-extrabold text-stone-900 mt-0.5">Parent &amp; Sign-In</p>
      </button>
      <button
        type="button"
        data-ob-step-tab="2"
        class="ob-step-pill cust-pressable rounded-2xl border border-stone-200 bg-stone-50 px-3 py-2.5 text-left cursor-pointer"
      >
        <p class="text-[10px] font-extrabold uppercase tracking-wider text-stone-400">Step 2</p>
        <p class="text-xs font-extrabold text-stone-900 mt-0.5">Child &amp; Sleep Timer</p>
      </button>
      <button
        type="button"
        data-ob-step-tab="3"
        class="ob-step-pill cust-pressable rounded-2xl border border-stone-200 bg-stone-50 px-3 py-2.5 text-left cursor-pointer"
      >
        <p class="text-[10px] font-extrabold uppercase tracking-wider text-stone-400">Step 3</p>
        <p class="text-xs font-extrabold text-stone-900 mt-0.5">Topics &amp; Finish</p>
      </button>
    </div>

    <form id="onboarding-wizard-form" class="mt-6 rounded-3xl border border-stone-200 bg-[#fcfaf6] p-5 sm:p-7 shadow-xs">
      <!-- STEP 1: PARENT & USERNAME -->
      <div data-ob-step-panel="1" class="space-y-4">
        <div>
          <h2 class="text-lg font-extrabold text-stone-900">Step 1: Parent details &amp; optional @username</h2>
          <p class="text-xs text-stone-600 mt-0.5">
            Set a family username (or sign in with your email) and an optional 4-digit PIN so kids stay inside Kid View.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="ob-parent-name" class="block text-xs font-bold text-stone-700">Parent / Guardian Name</label>
            <input
              id="ob-parent-name"
              name="parent_name"
              type="text"
              value={parentOnboarding?.parent_name || session.user.name || ""}
              placeholder="e.g., Alex"
              class="mt-1 w-full rounded-xl border border-stone-300 bg-white px-3.5 py-2.5 text-sm font-semibold focus:border-orange-500 focus:outline-none"
            />
          </div>

          <div>
            <label for="ob-parent-pin" class="block text-xs font-bold text-stone-700">
              Optional 4-Digit Parent PIN (locks Kid View)
            </label>
            <input
              id="ob-parent-pin"
              name="parent_pin"
              type="password"
              inputmode="numeric"
              maxlength="8"
              data-pin-set={Boolean(parentOnboarding?.parent_pin) ? "1" : undefined}
              value=""
              placeholder={parentOnboarding?.parent_pin ? "Leave blank to keep your current PIN" : "e.g., 1234"}
              class="mt-1 w-full rounded-xl border border-stone-300 bg-white px-3.5 py-2.5 text-sm font-semibold focus:border-orange-500 focus:outline-none"
            />
          </div>
        </div>

        <!-- Username or Email Switcher -->
        <div class="rounded-2xl border border-stone-200 bg-white p-4">
          <div class="flex items-center justify-between gap-2">
            <label for="ob-username" class="block text-xs font-extrabold text-stone-800">
              Sign-in Handle (@username or email)
            </label>
            <span class="text-[10px] font-bold text-stone-400">3–30 letters, numbers, _ or .</span>
          </div>
          <div class="mt-2 flex flex-wrap items-center gap-4 text-xs font-semibold text-stone-700">
            <label class="inline-flex items-center gap-1.5 cursor-pointer">
              <input
                type="radio"
                name="username_choice"
                value="set"
                checked
                class="text-orange-600 focus:ring-orange-500"
              />
              <span>Choose a @username</span>
            </label>
            <label class="inline-flex items-center gap-1.5 cursor-pointer">
              <input
                type="radio"
                name="username_choice"
                value="email"
                class="text-orange-600 focus:ring-orange-500"
              />
              <span>Just use my email ({session.user.email})</span>
            </label>
          </div>
          <div id="ob-username-input-wrap" class="mt-2.5 flex items-center gap-2">
            <div class="relative flex-1">
              <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-xs font-extrabold text-stone-400">@</span>
              <input
                id="ob-username"
                name="username"
                type="text"
                minlength="3"
                maxlength="30"
                autocomplete="username"
                value={session.user.displayUsername || session.user.username || ""}
                placeholder="alex_family"
                class="w-full rounded-xl border border-stone-300 bg-stone-50 pl-7 pr-3 py-2 text-xs font-bold text-stone-900 focus:border-orange-500 focus:bg-white focus:outline-none"
              />
            </div>
            <button
              type="button"
              id="ob-check-username-btn"
              class="cust-pressable rounded-xl border border-stone-300 bg-stone-100 px-3.5 py-2 text-xs font-extrabold text-stone-700 hover:border-stone-400 cursor-pointer shrink-0"
            >
              Check
            </button>
          </div>
          <p id="ob-username-status" class="mt-1.5 text-[11px] font-semibold text-stone-500">
            Sign in anytime with your @username or {session.user.email}.
          </p>
        </div>

        <div class="flex items-center justify-end pt-2">
          <button
            type="button"
            data-ob-next="2"
            class="cust-pressable rounded-full bg-orange-600 px-5 py-2.5 text-xs font-extrabold text-white hover:bg-orange-700 cursor-pointer"
          >
            Next: Child &amp; Bedtime Timer →
          </button>
        </div>
      </div>

      <!-- STEP 2: CHILD PROFILE, SLEEP TIMER & BIRTHDAY GIFT -->
      <div data-ob-step-panel="2" class="hidden space-y-4">
        <div>
          <h2 class="text-lg font-extrabold text-stone-900">Step 2: First child profile &amp; bedtime timer</h2>
          <p class="text-xs text-stone-600 mt-0.5">
            Create your child's reader profile (you can add more kids anytime on the Kids page).
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="ob-kid-name" class="block text-xs font-bold text-stone-700">Child's First Name</label>
            <input
              id="ob-kid-name"
              name="first_kid_name"
              type="text"
              value={defaultKidProfile?.name || ""}
              placeholder="e.g., Maya"
              class="mt-1 w-full rounded-xl border border-stone-300 bg-white px-3.5 py-2.5 text-sm font-semibold focus:border-orange-500 focus:outline-none"
            />
          </div>

          <div>
            <label for="ob-kid-dob" class="block text-xs font-bold text-stone-700">
              Child's Birthday (for their annual $10 Birthday Gift email 🎂)
            </label>
            <input
              id="ob-kid-dob"
              name="first_kid_dob"
              type="date"
              value={defaultKidProfile?.dob || parentOnboarding?.child_dob || ""}
              class="mt-1 w-full rounded-xl border border-stone-300 bg-white px-3.5 py-2.5 text-sm font-semibold focus:border-orange-500 focus:outline-none"
            />
          </div>

          <div>
            <label for="ob-kid-handle" class="block text-xs font-bold text-stone-700">Child's @handle (optional)</label>
            <input
              id="ob-kid-handle"
              name="first_kid_handle"
              type="text"
              value={defaultKidProfile?.handle ? "@" + defaultKidProfile.handle : ""}
              placeholder="e.g., @rubyjoyhs"
              class="mt-1 w-full rounded-xl border border-stone-300 bg-white px-3.5 py-2.5 text-sm font-semibold focus:border-orange-500 focus:outline-none"
            />
          </div>

          <div>
            <label for="ob-kid-age" class="block text-xs font-bold text-stone-700">Age Group</label>
            <select
              id="ob-kid-age"
              name="first_kid_age_group"
              class="mt-1 w-full rounded-xl border border-stone-300 bg-white px-3.5 py-2.5 text-sm font-semibold"
            >
              <option value="4-5" selected={defaultKidProfile?.age_group === "4-5"}>Ages 4–5 (Pre-K &amp; Kinder)</option>
              <option value="4-8" selected={!defaultKidProfile || defaultKidProfile?.age_group === "4-8"}>Ages 4–8 (Core Early Reader)</option>
              <option value="6-8" selected={defaultKidProfile?.age_group === "6-8"}>Ages 6–8 (Growing Reader)</option>
              <option value="9-12" selected={defaultKidProfile?.age_group === "9-12"}>Ages 9–12 (Chapter Explorer)</option>
              <option value="13-18" selected={defaultKidProfile?.age_group === "13-18"}>Ages 13–18 (Teen Shelf)</option>
            </select>
          </div>

          <div>
            <label for="ob-kid-avatar" class="block text-xs font-bold text-stone-700">Character Buddy</label>
            <select
              id="ob-kid-avatar"
              name="first_kid_avatar"
              class="mt-1 w-full rounded-xl border border-stone-300 bg-white px-3.5 py-2.5 text-sm font-semibold"
            >
              {KID_AVATARS.map((a) => (
                <option value={a.key} selected={defaultKidProfile?.avatar_key === a.key}>
                  {a.emoji} {a.label}
                </option>
              ))}
            </select>
          </div>

          <div>
            <label for="ob-sleep-timer" class="block text-xs font-bold text-stone-700">Bedtime Sleep Timer</label>
            <select
              id="ob-sleep-timer"
              name="first_kid_sleep_minutes"
              class="mt-1 w-full rounded-xl border border-stone-300 bg-white px-3.5 py-2.5 text-sm font-semibold"
            >
              {SLEEP_TIMER_PRESETS.map((p) => (
                <option value={p.minutes} selected={p.minutes === defaultSleepMinutes}>
                  {p.label}
                </option>
              ))}
            </select>
          </div>

          <div>
            <label for="ob-daily-limit" class="block text-xs font-bold text-stone-700">Daily Reading/Listening Limit</label>
            <select
              id="ob-daily-limit"
              name="first_kid_daily_limit"
              class="mt-1 w-full rounded-xl border border-stone-300 bg-white px-3.5 py-2.5 text-sm font-semibold"
            >
              {DAILY_LIMIT_PRESETS.map((d) => (
                <option value={d.minutes} selected={(defaultKidProfile?.daily_limit_minutes ?? 60) === d.minutes}>
                  {d.label}
                </option>
              ))}
            </select>
          </div>
        </div>

        <div class="flex items-center justify-between pt-2">
          <button
            type="button"
            data-ob-prev="1"
            class="cust-pressable rounded-full border border-stone-300 bg-white px-4 py-2 text-xs font-extrabold text-stone-700 hover:border-stone-500 cursor-pointer"
          >
            ← Back
          </button>
          <button
            type="button"
            data-ob-next="3"
            class="cust-pressable rounded-full bg-orange-600 px-5 py-2.5 text-xs font-extrabold text-white hover:bg-orange-700 cursor-pointer"
          >
            Next: Favorite Topics →
          </button>
        </div>
      </div>

      <!-- STEP 3: TOPICS, GOALS & CONSENT -->
      <div data-ob-step-panel="3" class="hidden space-y-4">
        <div>
          <h2 class="text-lg font-extrabold text-stone-900">Step 3: What would your child love to learn next?</h2>
          <p class="text-xs text-stone-600 mt-0.5">
            Help us pick our next stories and recommend the right books for your family.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="ob-goal" class="block text-xs font-bold text-stone-700">Primary Reading Goal</label>
            <select
              id="ob-goal"
              name="reading_goal"
              class="mt-1 w-full rounded-xl border border-stone-300 bg-white px-3.5 py-2.5 text-sm font-semibold"
            >
              {READING_GOAL_OPTIONS.map((g) => (
                <option value={g.key} selected={parentOnboarding?.reading_goal === g.key}>
                  {g.label}
                </option>
              ))}
            </select>
          </div>

          <div>
            <label for="ob-discovery" class="block text-xs font-bold text-stone-700">How did you find Big Brain Shelf?</label>
            <select
              id="ob-discovery"
              name="discovery_source"
              class="mt-1 w-full rounded-xl border border-stone-300 bg-white px-3.5 py-2.5 text-sm font-semibold"
            >
              <option value="">Choose one (optional)</option>
              {DISCOVERY_SOURCE_OPTIONS.map((d) => (
                <option value={d.key} selected={parentOnboarding?.discovery_source === d.key}>
                  {d.label}
                </option>
              ))}
            </select>
          </div>
        </div>

        <!-- Current & Future Topics -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1">
          <div class="rounded-2xl border border-stone-200 bg-white p-3.5">
            <p class="text-xs font-extrabold text-stone-900">Which current shelves does your child enjoy?</p>
            <div class="mt-2.5 flex flex-wrap gap-1.5">
              {CURRENT_TOPIC_OPTIONS.map((t) => {
                const checked = parentOnboarding?.favorite_topics?.includes(t.key) ?? false;
                return (
                  <label class="inline-flex items-center gap-1.5 rounded-xl border border-stone-200 bg-stone-50 px-2.5 py-1.5 text-xs font-semibold text-stone-700 cursor-pointer hover:border-orange-300">
                    <input
                      type="checkbox"
                      name="favorite_topics"
                      value={t.key}
                      checked={checked}
                      class="rounded border-stone-300 text-orange-600 focus:ring-orange-500"
                    />
                    <span>{t.emoji} {t.label}</span>
                  </label>
                );
              })}
            </div>
          </div>

          <div class="rounded-2xl border border-stone-200 bg-white p-3.5">
            <p class="text-xs font-extrabold text-stone-900">What future topics should we write next?</p>
            <div class="mt-2.5 flex flex-wrap gap-1.5">
              {FUTURE_TOPIC_OPTIONS.map((t) => {
                const checked = parentOnboarding?.future_topics?.includes(t.key) ?? false;
                return (
                  <label class="inline-flex items-center gap-1.5 rounded-xl border border-stone-200 bg-stone-50 px-2.5 py-1.5 text-xs font-semibold text-stone-700 cursor-pointer hover:border-orange-300">
                    <input
                      type="checkbox"
                      name="future_topics"
                      value={t.key}
                      checked={checked}
                      class="rounded border-stone-300 text-orange-600 focus:ring-orange-500"
                    />
                    <span>{t.emoji} {t.label}</span>
                  </label>
                );
              })}
            </div>
            <input
              type="text"
              name="learning_notes"
              value={parentOnboarding?.learning_notes || ""}
              placeholder="Any specific topic idea? (e.g., Dinosaurs, Ancient Rome)"
              class="mt-2.5 w-full rounded-xl border border-stone-200 bg-stone-50 px-3 py-1.5 text-xs text-stone-800 focus:border-orange-500 focus:bg-white focus:outline-none"
            />
          </div>
        </div>

        <!-- Consent & Birthday Gift Opt-in -->
        <div class="rounded-2xl border border-stone-200 bg-white p-4 space-y-2.5">
          <label class="flex items-start gap-2.5 text-xs text-stone-700 cursor-pointer">
            <input
              type="checkbox"
              name="tos_accepted"
              checked={parentOnboarding?.tos_accepted ?? true}
              required
              class="mt-0.5 rounded border-stone-300 text-orange-600 focus:ring-orange-500"
            />
            <span>
              I am a parent or guardian and agree to the <a href="/terms" target="_blank" class="underline font-semibold">Terms of Service</a> and <a href="/privacy" target="_blank" class="underline font-semibold">Privacy Policy</a>.
            </span>
          </label>
          <label class="flex items-start gap-2.5 text-xs text-stone-700 cursor-pointer">
            <input
              type="checkbox"
              name="marketing_opt_in"
              checked={parentOnboarding?.marketing_opt_in ?? true}
              class="mt-0.5 rounded border-stone-300 text-orange-600 focus:ring-orange-500"
            />
            <span>
              Send me new book releases, reading tips, and my child's annual <strong>Birthday Gift email ($10 off code BDAY10)</strong>.
            </span>
          </label>
        </div>

        <div class="flex flex-wrap items-center justify-between gap-3 pt-2">
          <button
            type="button"
            data-ob-prev="2"
            class="cust-pressable rounded-full border border-stone-300 bg-white px-4 py-2 text-xs font-extrabold text-stone-700 hover:border-stone-500 cursor-pointer"
          >
            ← Back
          </button>
          <div class="flex items-center gap-3">
            <span id="onboarding-save-msg" class="text-xs font-bold text-green-700 hidden">
              Saved! Taking you to your shelf…
            </span>
            <button
              type="submit"
              class="cust-pressable rounded-full bg-orange-600 px-6 py-2.5 text-xs font-extrabold text-white hover:bg-orange-700 shadow-xs cursor-pointer"
            >
              Save Family Setup →
            </button>
          </div>
        </div>
      </div>
    </form>
  </main>

  <script is:inline>
    (function () {
      function initOnboardingWizard() {
        var form = document.getElementById("onboarding-wizard-form");
        if (!form || form.dataset.boundWizard === "1") return;
        form.dataset.boundWizard = "1";

        function showStep(stepNum) {
          document.querySelectorAll("[data-ob-step-panel]").forEach(function (panel) {
            var isMatch = panel.getAttribute("data-ob-step-panel") === String(stepNum);
            panel.classList.toggle("hidden", !isMatch);
          });
          document.querySelectorAll("[data-ob-step-tab]").forEach(function (tab) {
            var isMatch = tab.getAttribute("data-ob-step-tab") === String(stepNum);
            tab.classList.toggle("border-orange-400", isMatch);
            tab.classList.toggle("bg-orange-50", isMatch);
            tab.classList.toggle("border-stone-200", !isMatch);
            tab.classList.toggle("bg-stone-50", !isMatch);
          });
        }

        document.querySelectorAll("[data-ob-step-tab]").forEach(function (tab) {
          tab.addEventListener("click", function () {
            showStep(tab.getAttribute("data-ob-step-tab"));
          });
        });
        document.querySelectorAll("[data-ob-next]").forEach(function (btn) {
          btn.addEventListener("click", function () {
            showStep(btn.getAttribute("data-ob-next"));
          });
        });
        document.querySelectorAll("[data-ob-prev]").forEach(function (btn) {
          btn.addEventListener("click", function () {
            showStep(btn.getAttribute("data-ob-prev"));
          });
        });

        var usernameInput = document.getElementById("ob-username");
        var usernameWrap = document.getElementById("ob-username-input-wrap");
        var checkUsernameBtn = document.getElementById("ob-check-username-btn");
        var usernameStatus = document.getElementById("ob-username-status");
        var choiceRadios = form.querySelectorAll('input[name="username_choice"]');

        choiceRadios.forEach(function (r) {
          r.addEventListener("change", function () {
            var useEmail = r.value === "email" && r.checked;
            if (usernameWrap) usernameWrap.classList.toggle("hidden", useEmail);
          });
        });

        function checkUsernameAvailability(raw) {
          var clean = String(raw || "").trim().replace(/^@+/, "");
          if (!clean) return Promise.resolve(null);
          if (!/^[a-zA-Z0-9_.]{3,30}$/.test(clean)) {
            if (usernameStatus) {
              usernameStatus.textContent = "Use 3–30 letters, numbers, underscores, or dots.";
              usernameStatus.className = "mt-1.5 text-[11px] font-bold text-amber-700";
            }
            return Promise.resolve(false);
          }
          if (usernameStatus) {
            usernameStatus.textContent = "Checking @" + clean + "…";
            usernameStatus.className = "mt-1.5 text-[11px] font-semibold text-stone-500";
          }
          return fetch("/api/auth/is-username-available", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ username: clean }),
          })
            .then(function (r) {
              return r.json();
            })
            .then(function (res) {
              var available = Boolean(res && res.available);
              if (usernameStatus) {
                usernameStatus.textContent = available
                  ? "✓ @" + clean + " is available!"
                  : "✕ @" + clean + " is already taken.";
                usernameStatus.className = available
                  ? "mt-1.5 text-[11px] font-extrabold text-green-700"
                  : "mt-1.5 text-[11px] font-extrabold text-red-600";
              }
              return available;
            })
            .catch(function () {
              return null;
            });
        }

        if (checkUsernameBtn && usernameInput) {
          checkUsernameBtn.addEventListener("click", function () {
            checkUsernameAvailability(usernameInput.value);
          });
        }

        var skipBtn = document.getElementById("onboarding-skip-btn");
        if (skipBtn) {
          skipBtn.addEventListener("click", function () {
            skipBtn.disabled = true;
            fetch("/api/account/family", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ action: "save_onboarding", mark_complete: true }),
            })
              .catch(function () {})
              .then(function () {
                window.location.href = "/account/library";
              });
          });
        }

        var saveMsg = document.getElementById("onboarding-save-msg");
        form.addEventListener("submit", function (ev) {
          ev.preventDefault();
          var fd = new FormData(form);
          var favTopics = fd.getAll("favorite_topics").map(String);
          var futTopics = fd.getAll("future_topics").map(String);
          var usernameChoice = String(fd.get("username_choice") || "set");
          var desiredUsername =
            usernameChoice === "set"
              ? String(fd.get("username") || "").trim().replace(/^@+/, "")
              : "";

          // The family API creates the first child ONLY from a
          // nested kid_profile object (the shape the account page
          // has always sent); flat first_kid_* keys are ignored by
          // it, which silently left wizard families with no kid
          // profile, no birthday on file, and a setup checklist
          // that could never complete. Send the nested shape, plus
          // the custom topic and the completion stamp.
          var kidDob = String(fd.get("first_kid_dob") || "");
          var kidAge = null;
          if (kidDob) {
            var dobDate = new Date(kidDob + "T00:00:00");
            if (!isNaN(dobDate.getTime())) {
              var yrs = Math.floor((Date.now() - dobDate.getTime()) / (365.25 * 24 * 3600 * 1000));
              if (yrs >= 1 && yrs <= 18) kidAge = yrs;
            }
          }
          var pinValue = String(fd.get("parent_pin") || "");
          // The form no longer echoes the stored PIN (it is a secret —
          // now a hash server-side, F9). A blank field means "keep the
          // current PIN" when one exists, and "no PIN" otherwise.
          var pinEl = document.getElementById("ob-parent-pin");
          var pinPayload =
            pinValue || !(pinEl && pinEl.dataset.pinSet)
              ? pinValue
              : undefined;
          var payload = {
            action: "save_onboarding",
            parent_name: String(fd.get("parent_name") || ""),
            reading_goal: String(fd.get("reading_goal") || "bedtime_calm"),
            parent_pin: pinPayload,
            tos_accepted: fd.get("tos_accepted") !== null,
            marketing_opt_in: fd.get("marketing_opt_in") !== null,
            favorite_topics: favTopics,
            future_topics: futTopics,
            custom_topic_request: String(fd.get("learning_notes") || ""),
            discovery_source: String(fd.get("discovery_source") || ""),
            mark_complete: true,
          };
          var kidName = String(fd.get("first_kid_name") || "").trim();
          if (kidName) {
            payload.kid_profile = {
              name: kidName,
              handle: String(fd.get("first_kid_handle") || "").trim() || null,
              birth_date: kidDob || null,
              age: kidAge,
              age_group: String(fd.get("first_kid_age_group") || "4-8"),
              avatar_key: String(fd.get("first_kid_avatar") || "mira"),
              favorite_topics: favTopics,
              default_sleep_timer_minutes: Number(fd.get("first_kid_sleep_minutes") || 60),
              daily_limit_minutes: Number(fd.get("first_kid_daily_limit") || 60),
            };
          }

          var usernamePromise = desiredUsername
            ? fetch("/api/auth/update-user", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                  username: desiredUsername.toLowerCase(),
                  displayUsername: desiredUsername,
                }),
              }).catch(function () {})
            : Promise.resolve();

          Promise.all([
            usernamePromise,
            fetch("/api/account/family", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify(payload),
            }).then(function (r) {
              return r.json();
            }),
          ]).then(function (results) {
            var data = results[1];
            if (data && data.ok) {
              if (saveMsg) saveMsg.classList.remove("hidden");
              setTimeout(function () {
                window.location.href = "/account/library";
              }, 500);
            } else if (saveMsg) {
              saveMsg.textContent =
                (data && data.error) || "Could not save setup. Please try again.";
              saveMsg.classList.remove("hidden");
            }
          });
        });
      }

      initOnboardingWizard();
      document.addEventListener("astro:page-load", initOnboardingWizard);
    })();
  </script>
</body>
</html>
